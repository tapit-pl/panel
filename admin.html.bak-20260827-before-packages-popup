  async function tourDrop(e, id) {
    e.preventDefault();
    document.querySelectorAll('#tour-config-tbody tr[data-tour-id]').forEach(r => r.style.borderTop = '');
    if (!_dragTourId || _dragTourId === id) { _dragTourId = null; return; }
    const fromIdx = allTourConfig.findIndex(t => t.id === _dragTourId);
    const toIdx   = allTourConfig.findIndex(t => t.id === id);
    if (fromIdx === -1 || toIdx === -1) { _dragTourId = null; return; }
    const [moved] = allTourConfig.splice(fromIdx, 1);
    const newTo   = allTourConfig.findIndex(t => t.id === id);
    allTourConfig.splice(fromIdx < toIdx ? newTo + 1 : newTo, 0, moved);
    allTourConfig.forEach((t, i) => { t.sort_order = (i + 1) * 10; });
    await Promise.all(allTourConfig.map(t => db.from('tour_config').update({ sort_order: t.sort_order }).eq('id', t.id)));
    _dragTourId = null;
    renderTourConfigTable();
  }

