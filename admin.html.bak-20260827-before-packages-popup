async function abLoadTours() {
  const grid = document.getElementById('ab-tour-grid');
  grid.innerHTML = '<div class="text-slate-400 text-sm col-span-full py-8 text-center">Loading tours…</div>';
  try {
    if (!allCommissions?.length) {
      const { data: comms } = await db.from('tour_commissions').select('*').order('sort_order');
      if (comms) { allCommissions.length = 0; comms.forEach(c => allCommissions.push(c)); }
    }
    const { data: configs } = await db.from('tour_config').select('*').eq('active', true).order('sort_order');
    if (!configs) return;
    const commConfigIds = new Set(allCommissions.filter(c => c.active && c.tour_config_id != null).map(c => c.tour_config_id));
    const results = await Promise.all(configs.map(async (t, idx) => {
      const base = {
        idx,
        configId: t.id,
        hasPackage: commConfigIds.has(t.id),
        bokunId: t.bokun_id || null,
        title: t.title,
        dbTitle: t.title,
        meetingPoint: t.meeting_point || null,
        allowHotelPickup: t.allow_hotel_pickup ?? true,
        allowMeetingPoint: t.allow_meeting_point ?? true,
        requireGuestNames: t.require_guest_names || false,
        maxPax: t.max_pax || null,
        bokunForceRateId: t.bokun_force_rate_id || null,
        bokunForcePickupPlaceId: t.bokun_force_pickup_place_id || null,
        bokunRequiresDob: t.bokun_require_dob || false,
        pricingType: t.pricing_type || 'per_person',
        pricing: [],
        photo: t.photo_url || abGetTourPhoto(t.title),
        durationMins: t.duration_mins || null,
        manualSlots: t.manual_slots || [],
        emailBlocks: t.email_blocks || [],
        description: t.description || null,
      };
      if (t.bokun_id) {
        try {
          const { data: det } = await invokeEdge('bokun-sync', {
            body: { path: `/activity.json/${t.bokun_id}`, method: 'GET' }
          });
          const body = det?.body || det || {};
          const _pickPhoto = (p) => p?.originalUrl || p?.largeUrl || p?.mediumUrl || p?.url || null;
          const _featured = (body.photos||[]).find(x=>x.featured);
          const _photoUrl = _pickPhoto(_featured) || _pickPhoto((body.photos||[])[0]) || null;
          if (_photoUrl) base.photo = _photoUrl;
          base.title = body.title || base.title;
          base.durationMins = body.durationInMinutes || body.durationMins || base.durationMins;
          base.pricing = body.pricingCategories || [];
          base.description = body.shortDescription || body.description || base.description;
        } catch(e) { /* keep base */ }
      }
      return base;
    }));
    abTours = results;
    abToursLoaded = true;
    abRenderTourGrid();
  } catch(e) {
    grid.innerHTML = '<div class="text-red-400 text-sm col-span-full py-8 text-center">Failed to load tours</div>';
  }
}

