  function renderTicketsTable(data) {
    // Badge is cheap and must stay accurate regardless of which tab is visible —
    // update it unconditionally, but skip the (potentially large) DOM rebuild below
    // when the Support tab isn't on screen. Avoids a full table rebuild every 20s /
    // on every realtime event while the admin is elsewhere in the panel.
    const unreadCount = allTickets.filter(t => t.unread).length;
    const sidebarBadge = document.getElementById('sidebar-support-badge');
    if (sidebarBadge) { sidebarBadge.classList.toggle('hidden', unreadCount === 0); }
    if (!document.getElementById('section-support')?.classList.contains('active')) return;

    const tbody = document.getElementById('tickets-tbody');
    if (!tbody) return;
    const rows = data !== undefined ? data : (currentTicketFilter === 'active' ? allTickets.filter(t => t.status === 'open' || t.status === 'in_progress') : allTickets.filter(t => t.status === currentTicketFilter));
    tbody.innerHTML = '';
    const SLABELS = { open:'Open', in_progress:'In Progress', resolved:'Resolved' };
    const PLABELS = { low:'Low', normal:'Normal', high:'High', urgent:'Urgent' };
    rows.forEach(t => {
      const sClass = t.status==='open' ? 'bg-red-100 text-red-700' : t.status==='in_progress' ? 'bg-yellow-100 text-yellow-700' : t.status==='resolved' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500';
      const pClass = t.priority==='urgent' ? 'bg-red-50 text-red-600' : t.priority==='high' ? 'bg-orange-50 text-orange-600' : 'bg-gray-100 text-gray-500';
      const rowOpacity = t.unread ? '' : 'opacity-40';
      tbody.insertAdjacentHTML('beforeend', `
        <tr class="hover:bg-gray-50 transition-colors cursor-pointer text-xs ${rowOpacity}" onclick="openTicketDetail('${t.id}')">
          <td class="px-5 py-3 font-mono text-gray-400">${escapeHtml(t.id.substring(0,8).toUpperCase())}</td>
          <td class="px-4 py-3 font-medium text-dark">${escapeHtml(t.partner)}</td>
          <td class="px-4 py-3 text-gray-600 max-w-xs truncate">${escapeHtml(t.subject)}</td>
          <td class="px-4 py-3 text-gray-500 whitespace-nowrap">${escapeHtml(t.category||'—')}</td>
          <td class="px-4 py-3 text-gray-400 whitespace-nowrap">${escapeHtml(t.received)}</td>
          <td class="px-4 py-3 text-center"><span class="text-xs font-semibold px-2 py-0.5 rounded-full ${pClass}">${PLABELS[t.priority]||t.priority}</span></td>
          <td class="px-4 py-3 text-center"><span class="text-xs font-semibold px-2 py-0.5 rounded-full ${sClass}">${SLABELS[t.status]||t.status}</span></td>
          <td class="px-4 py-3 text-right"><button class="text-gray-300 hover:text-brand text-xs"><i class="fa-solid fa-arrow-right"></i></button></td>
        </tr>`);
    });
  }

