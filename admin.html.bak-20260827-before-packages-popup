  function initDatePicker(inputId, cbFn) {
    const inp = document.getElementById(inputId);
    if (!inp || inp._dpopDone) return;
    inp._dpopDone = true;
    const wrap = inp.closest('.dpop');
    if (!wrap) return;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dpop-btn';
    btn.innerHTML = `<i class="fa-regular fa-calendar" style="font-size:10px;color:#64748b;flex-shrink:0"></i><span class="dpop-label">${_dpopFmtLabel(inp.value)}</span>`;
    wrap.appendChild(btn);

    const panel = document.createElement('div');
    panel.className = 'dpop-panel';
    wrap.appendChild(panel);

    const state = { inp, btn, panel, cbFn, curMonth: new Date(new Date().getFullYear(), new Date().getMonth(), 1) };
    _dpopMap[inputId] = state;

    state.render = function() {
      const m = state.curMonth;
      const today = new Date().toISOString().slice(0,10);
      const curVal = inp.value;
      const firstDay = new Date(m.getFullYear(), m.getMonth(), 1);
      const startDow = (firstDay.getDay() + 6) % 7;
      const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
      const CELL = 'display:table-cell;width:14.2857%;text-align:center;padding:2px 0;';
      let cells = [];
      for (let i = 0; i < startDow; i++) cells.push('<td></td>');
      for (let d = 1; d <= daysInMonth; d++) {
        const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const isToday = ds === today;
        const isSel = ds === curVal;
        const todayColor = isToday && !isSel ? '#f97316' : isSel ? '#fff' : '#cbd5e1';
        let inner;
        if (isSel) {
          inner = `<div onclick="dpopPick('${inputId}','${ds}')" style="width:26px;height:26px;border-radius:50%;background:#E8751A;color:#fff;font-weight:700;font-size:11px;display:flex;align-items:center;justify-content:center;margin:auto;cursor:pointer">${d}</div>`;
        } else {
          const todayBorder = isToday ? ';outline:2px solid rgba(232,117,26,0.5)' : '';
          inner = `<div onclick="dpopPick('${inputId}','${ds}')"
            style="width:26px;height:26px;border-radius:50%;color:${todayColor};font-size:11px;display:flex;align-items:center;justify-content:center;margin:auto;cursor:pointer${todayBorder}"
            onmouseenter="this.style.background='rgba(232,117,26,0.18)';this.style.color='#f97316'"
            onmouseleave="this.style.background='';this.style.color='${todayColor}'">${d}</div>`;
        }
        cells.push(`<td style="${CELL}">${inner}</td>`);
      }
      while (cells.length % 7 !== 0) cells.push('<td></td>');
      let rows = '';
      for (let i = 0; i < cells.length; i += 7) rows += '<tr>' + cells.slice(i, i+7).join('') + '</tr>';
      panel.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
          <button type="button" onclick="dpopNav('${inputId}',-1)" style="background:none;border:none;cursor:pointer;color:#64748b;padding:3px 8px;border-radius:6px" onmouseenter="this.style.color='#e2e8f0'" onmouseleave="this.style.color='#64748b'"><i class="fa-solid fa-chevron-left" style="font-size:10px"></i></button>
          <span style="font-size:12px;font-weight:600;color:#e2e8f0">${_DPOP_MONTHS[m.getMonth()]} ${m.getFullYear()}</span>
          <button type="button" onclick="dpopNav('${inputId}',1)" style="background:none;border:none;cursor:pointer;color:#64748b;padding:3px 8px;border-radius:6px" onmouseenter="this.style.color='#e2e8f0'" onmouseleave="this.style.color='#64748b'"><i class="fa-solid fa-chevron-right" style="font-size:10px"></i></button>
        </div>
        <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
          <tr>${_DPOP_DOW.map(d => `<td style="${CELL}font-size:10px;color:#64748b;padding-bottom:5px">${d}</td>`).join('')}</tr>
          ${rows}
        </table>
        <div style="display:flex;justify-content:space-between;margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.07)">
          <button type="button" onclick="dpopClear('${inputId}')" style="font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;padding:0" onmouseenter="this.style.color='#94a3b8'" onmouseleave="this.style.color='#64748b'">Clear</button>
          <button type="button" onclick="dpopToday('${inputId}')" style="font-size:11px;color:#f97316;font-weight:600;background:none;border:none;cursor:pointer;padding:0">Today</button>
        </div>`;
    };

    function openPanel() {
      document.querySelectorAll('.dpop-panel.open').forEach(p => {
        p.classList.remove('open');
        p.closest('.dpop')?.querySelector('.dpop-btn')?.classList.remove('open');
      });
      if (inp.value) {
        const [y, mo] = inp.value.split('-').map(Number);
        state.curMonth = new Date(y, mo-1, 1);
      }
      state.render();
      panel.classList.add('open');
      btn.classList.add('open');
    }

    btn.addEventListener('click', e => {
      e.stopPropagation();
      panel.classList.contains('open')
        ? (panel.classList.remove('open'), btn.classList.remove('open'))
        : openPanel();
    });
    panel.addEventListener('click', e => e.stopPropagation());
    document.addEventListener('click', () => { panel.classList.remove('open'); btn.classList.remove('open'); });
  }

