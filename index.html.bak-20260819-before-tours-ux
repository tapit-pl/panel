<script>
  function escapeHtml(str) {
    if (str == null) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function generatePartnerInitials(name) {
    if (!name) return '??';
    const SKIP = new Set(['i','w','na','de','z','sp.','o.o.','s.c.','s.a.','sp.k.','&','i.']);
    const words = name.trim().split(/\s+/).filter(Boolean);
    const letters = words.filter(w => !SKIP.has(w.toLowerCase())).map(w => w[0].toUpperCase());
    if (!letters.length) return name.substring(0, 2).toUpperCase();
    return letters.slice(0, 3).join('');
  }
  function partnerBadgeTextColor(bgHex) {
    const hex = (bgHex || '').replace('#', '');
    if (hex.length !== 6) return '#ffffff';
    const toLinear = c => { c /= 255; return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
    const L = 0.2126 * toLinear(parseInt(hex.substring(0,2),16))
            + 0.7152 * toLinear(parseInt(hex.substring(2,4),16))
            + 0.0722 * toLinear(parseInt(hex.substring(4,6),16));
    return (1.05 / (L + 0.05)) >= 4.5 ? '#ffffff' : '#1a2332';
  }

  let cart = [];
  let guestCount = 2;
  let helpTicketCounter = 1;
  let currentPartner = null;
  let partnerBookings = [];

  const { createClient } = supabase;
  const db = createClient(
    'https://jzsiuvcgpwukxpcjxcsg.supabase.co',
    'sb_publishable_jTg5-5J24uo7BNBVBLTTLA_xAeB9iK4'
  );

  let COMM_MAP = {}; // normalized name → entry (for name-based lookups)
  let COMM_MAP_BY_TOUR = {}; // tour_config_id → best entry (most category prices)
  let COMM_MAP_BY_TOUR_RATE = {}; // "tour_config_id:lang" → entry (per-language override)
  let COMM_PACKAGES_BY_TOUR = {}; // tour_config_id → all packages (for non-Bokun picker)

  async function buildCommMap() {
    COMM_MAP = {};
    COMM_MAP_BY_TOUR = {};
    COMM_MAP_BY_TOUR_RATE = {};
    COMM_PACKAGES_BY_TOUR = {};
    try {
      const { data, error } = await db.from('tour_commissions').select('*').eq('active', true).order('sort_order');
      if (!error && data && data.length > 0) {
        data.forEach(c => {
          const entry = { pricePln: c.price_pln ?? null, priceStudent: c.price_student ?? null, priceChild: c.price_child ?? null, priceInfant: c.price_infant ?? null, priceSenior: c.price_senior ?? null, commPln: c.commission_pln || 0, transportPricePln: c.transport_price_pln || null, cat: c.category || '', originalName: c.title, tourConfigId: c.tour_config_id || null };
          const key = _normComm(c.title);
          // For name-based map: prefer entry with more configured category prices
          const existing = COMM_MAP[key];
          const countNew = [entry.priceStudent, entry.priceChild, entry.priceInfant, entry.priceSenior].filter(p => p !== null && p !== undefined).length;
          const countExisting = existing ? [existing.priceStudent, existing.priceChild, existing.priceInfant, existing.priceSenior].filter(p => p !== null && p !== undefined).length : -1;
          if (countNew >= countExisting) COMM_MAP[key] = entry;
          // For ID-based map: also prefer entry with more configured prices
          if (c.tour_config_id) {
            const langKey = LANGUAGE_KEYWORDS.find(l => c.title.toLowerCase().includes(l.toLowerCase()));
            if (langKey) {
              COMM_MAP_BY_TOUR_RATE[`${c.tour_config_id}:${langKey.toLowerCase()}`] = entry;
            } else {
              const existingById = COMM_MAP_BY_TOUR[c.tour_config_id];
              const countExistingById = existingById ? [existingById.priceStudent, existingById.priceChild, existingById.priceInfant, existingById.priceSenior].filter(p => p !== null && p !== undefined).length : -1;
              if (countNew >= countExistingById) COMM_MAP_BY_TOUR[c.tour_config_id] = entry;
            }
            if (!COMM_PACKAGES_BY_TOUR[c.tour_config_id]) COMM_PACKAGES_BY_TOUR[c.tour_config_id] = [];
            COMM_PACKAGES_BY_TOUR[c.tour_config_id].push(entry);
          }
        });
        _commDataSource = 'supabase';
        return;
      }
    } catch(e) {}
    // Fallback: parse static HTML table
    _commDataSource = 'static';
    document.querySelectorAll('#comm-tbody .comm-row').forEach(row => {
      const nameEl = row.querySelector('td:first-child');
      const priceEl = row.querySelector('[data-price]');
      if (!nameEl || !priceEl) return;
      const name = nameEl.textContent.trim();
      const pricePln = parseInt(priceEl.dataset.price || '0') || 0;
      const commPln  = parseInt(row.dataset.comm || '0') || 0;
      const cat      = row.dataset.cat || '';
      if (!name || !pricePln) return;
      COMM_MAP[_normComm(name)] = { pricePln, commPln, cat, originalName: name };
    });
  }
  let _commDataSource = 'static';

  function renderPartnerCommissionsTab(commData) {
    const tbody = document.getElementById('comm-tbody');
    if (!tbody) return;
    if (!commData || commData.length === 0) {
      tbody.innerHTML = `<tr><td colspan="4" class="py-10 text-center text-gray-400 text-sm">
        <i class="fa-solid fa-circle-info text-xl mb-2 block"></i>
        No commission rates configured yet. Please ask your administrator.
      </td></tr>`;
      return;
    }
    const cats = [...new Set(commData.map(c => c.cat || c.category || ''))];
    const CAT_LABELS = { shooting: 'Shooting Range', zakopane: 'Zakopane', krakow: 'Kraków Tours', auschwitz: 'Auschwitz & Wieliczka', active: 'Active & Adventure', other: 'Other' };
    tbody.innerHTML = '';
    cats.forEach(cat => {
      const rows = commData.filter(c => (c.cat || c.category || '') === cat);
      if (!rows.length) return;
      tbody.insertAdjacentHTML('beforeend',
        `<tr class="comm-group-row bg-orange-50/50" data-cat="${cat}"><td colspan="4" class="px-4 py-2 text-xs font-bold text-brand uppercase tracking-wide">${CAT_LABELS[cat] || cat}</td></tr>`);
      rows.forEach(c => {
        const commVal = c.commPln || c.commission_pln || 0;
        const priceVal = c.pricePln || c.price_pln || 0;
        const isTop = commVal >= 100;
        const name = c.originalName || c.title || '';
        const normName = (name).toLowerCase().replace(/[^a-z0-9]/g,' ').replace(/\s+/g,' ').trim();
        tbody.insertAdjacentHTML('beforeend', `
          <tr class="comm-row hover:bg-gray-50" data-cat="${cat}" data-name="${normName}" data-comm="${commVal}">
            <td class="px-4 py-3 font-medium">${escapeHtml(name)}</td>
            <td class="px-4 py-3 text-gray-600" data-price="${priceVal}">${priceVal} pln</td>
            <td class="px-4 py-3 text-center"><span class="font-bold text-brand ${isTop ? 'comm-top-badge' : ''}">${commVal} pln${isTop ? ' <i class="fa-solid fa-star text-xs"></i>' : ''}</span></td>
            <td class="px-4 py-3 text-right"><button data-tour-name="${escapeHtml(name)}" onclick="quickBook(this.dataset.tourName)" class="text-xs px-3 py-1.5 bg-brand text-white rounded-lg hover:bg-brand-dark transition-colors whitespace-nowrap">Book</button></td>
          </tr>`);
      });
    });
    if (typeof filterCommTable === 'function') filterCommTable();
  }

  function _normComm(name) {
    return (name || '').toLowerCase().replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function lookupCommPln(name) {
    if (!name || !Object.keys(COMM_MAP).length) return null;
    const key = _normComm(name);
    if (COMM_MAP[key]) return COMM_MAP[key].pricePln;
    const words = key.split(' ').filter(w => w.length > 2);
    if (!words.length) return null;
    // all search words appear in a map entry
    for (const [k, v] of Object.entries(COMM_MAP)) {
      if (words.every(w => k.includes(w))) return v.pricePln;
    }
    // all map-entry words appear in search key
    for (const [k, v] of Object.entries(COMM_MAP)) {
      const kw = k.split(' ').filter(w => w.length > 2);
      if (kw.length && kw.every(w => key.includes(w))) return v.pricePln;
    }
    return null;
  }

  function lookupCommCommissionPln(name) {
    if (!name || !Object.keys(COMM_MAP).length) return null;
    const key = _normComm(name);
    if (COMM_MAP[key]) return COMM_MAP[key].commPln;
    const words = key.split(' ').filter(w => w.length > 2);
    if (!words.length) return null;
    for (const [k, v] of Object.entries(COMM_MAP)) {
      if (words.every(w => k.includes(w))) return v.commPln;
    }
    for (const [k, v] of Object.entries(COMM_MAP)) {
      const kw = k.split(' ').filter(w => w.length > 2);
      if (kw.length && kw.every(w => key.includes(w))) return v.commPln;
    }
    return null;
  }

  function lookupCommTransportPln(name) {
    if (!name || !Object.keys(COMM_MAP).length) return null;
    const key = _normComm(name);
    if (COMM_MAP[key]) return COMM_MAP[key].transportPricePln;
    const words = key.split(' ').filter(w => w.length > 2);
    if (!words.length) return null;
    for (const [k, v] of Object.entries(COMM_MAP)) {
      if (words.every(w => k.includes(w))) return v.transportPricePln;
    }
    return null;
  }

  function fmtPln(pln) { return pln ? `${pln} pln` : null; }

  // Returns PLN price for a specific Bokun category title from COMM_MAP.
  // null = category disabled, 0 = FREE, >0 = price.
  function lookupCategoryPricePln(tourName, categoryTitle) {
    const configId = tdCurrentTour?.configId || null;
    const entry = (() => {
      // Per-language override: check if selected rate matches a language-specific entry
      if (configId && tdSelectedRate?.title) {
        const lang = LANGUAGE_KEYWORDS.find(l => tdSelectedRate.title.toLowerCase().includes(l.toLowerCase()));
        if (lang) {
          const rateEntry = COMM_MAP_BY_TOUR_RATE[`${configId}:${lang.toLowerCase()}`];
          if (rateEntry) return rateEntry;
        }
      }
      // Per-package: match selected rate title against COMM_PACKAGES_BY_TOUR
      if (configId && tdSelectedRate?.title) {
        const pkgs = COMM_PACKAGES_BY_TOUR[configId] || [];
        const rateNorm = _normComm(tdSelectedRate.title);
        const rateWords = rateNorm.split(' ').filter(w => w.length > 2);
        const matched = pkgs.find(p => _normComm(p.originalName) === rateNorm)
          || pkgs.find(p => rateWords.length > 0 && rateWords.every(w => _normComm(p.originalName).includes(w)));
        if (matched) return matched;
      }
      // Prefer ID-based lookup — immune to package name collisions
      if (configId && COMM_MAP_BY_TOUR[configId]) return COMM_MAP_BY_TOUR[configId];
      const key = _normComm(tourName);
      if (COMM_MAP[key]) return COMM_MAP[key];
      const words = key.split(' ').filter(w => w.length > 2);
      for (const [k, v] of Object.entries(COMM_MAP)) {
        if (words.every(w => k.includes(w))) return v;
      }
      for (const [k, v] of Object.entries(COMM_MAP)) {
        const kw = k.split(' ').filter(w => w.length > 2);
        if (kw.length && kw.every(w => key.includes(w))) return v;
      }
      return null;
    })();
    if (!entry) return undefined; // no config — fall back to Bokun price
    const t = (categoryTitle || '').toLowerCase();
    if (t.includes('student')) return entry.priceStudent ?? null;
    if (t.includes('child') || t.includes('kid')) return entry.priceChild ?? null;
    if (t.includes('infant') || t.includes('baby')) return entry.priceInfant ?? null;
    if (t.includes('senior') || t.includes('elder')) return entry.priceSenior ?? null;
    // Exclude group/private/package categories from individual ticket pricing
    if (t.includes('group') || t.includes('private') || t.includes(' van') || t.includes('offer')) return null;
    return entry.pricePln ?? null; // adult / default
  }

  document.addEventListener('DOMContentLoaded', async function() {
    // Capture URL signals BEFORE any async calls — Supabase clears hash via history.replaceState
    const savedUrl = window.location.hash + window.location.search;
    const isInviteOrRecovery = savedUrl.includes('type=invite') || savedUrl.includes('type=recovery');

    await buildCommMap();
    renderPartnerCommissionsTab(Object.values(COMM_MAP));

    if (isInviteOrRecovery) {
      const { data: { session } } = await db.auth.getSession();
      if (session) {
        goTo('screen-set-password');
        return;
      }
    }

    const { data: { session } } = await db.auth.getSession();
    if (session) {
      await redirectByRole(session.user);
    } else {
      goTo('screen-login');
    }
  });

  async function finishWelcome() {
    await initPartnerDashboard();
  }

  // ──────────────────────────────────────────────────────────────────────────

  async function logPartnerActivity(action, details) {
    const { data: { session } } = await db.auth.getSession();
    const email = session?.user?.email || 'unknown';
    await db.from('audit_log').insert({ action, details: details || '', ref: '', user_email: email });
  }

  async function redirectByRole(user) {
    const { data: adminUser } = await db.from('admin_users').select('role').eq('email', user.email).maybeSingle();
    if (adminUser) {
      window.location.href = 'admin.html';
      return;
    }
    const { data: partnerRows } = await db.from('partners').select('*').eq('email', user.email);
    const partner = Array.isArray(partnerRows) ? (partnerRows[0] || null) : partnerRows;
    if (partner) {
      if (partner.active === false) {
        await db.auth.signOut();
        goTo('screen-login');
        document.getElementById('login-error').textContent = 'Your account has been deactivated. Please contact Thousand Miles.';
        document.getElementById('login-error').classList.remove('hidden');
        return;
      }
      currentPartner = partner;
      await logPartnerActivity('partner_login', `Partner logged in: ${currentPartner.name}`);
      await initPartnerDashboard();
      return;
    }
    await db.auth.signOut();
    goTo('screen-login');
  }

  async function initPartnerDashboard() {
    const p = currentPartner;

    await db.removeAllChannels();

    // Watch for partner deletion or profile changes (e.g. tour_groups updated by admin)
    db.channel('partner-account-watch')
      .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'partners', filter: `id=eq.${p.id}` }, async () => {
        await db.auth.signOut()
        window.location.reload()
      })
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'partners', filter: `id=eq.${p.id}` }, async (payload) => {
        if (payload.new.active === false) {
          await db.auth.signOut();
          window.location.reload();
          return;
        }
        currentPartner = { ...currentPartner, ...payload.new };
        bokunProducts = [];
        loadToursFromBokun();
      })
      .subscribe()

    // Watch for new or updated bookings belonging to this partner
    db.channel('partner-bookings-watch')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'bookings', filter: `partner_id=eq.${p.id}` }, async () => {
        await loadPartnerBookings();
      })
      .subscribe()

    const staffInitials = p._staffName ? p._staffName.split(' ').filter(Boolean).map(w=>w[0]).join('').substring(0,2).toUpperCase() : null;
    const generatedInitials = p.initials || generatePartnerInitials(p.name) || staffInitials || '??';
