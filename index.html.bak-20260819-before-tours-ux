    tdRateDateStr = null;
    tdCategorySelections = [];
    document.getElementById('td-category-section').classList.add('hidden');
    document.getElementById('td-language-section').classList.add('hidden');

    const hiddenIds = (tdCurrentTour?.hiddenSlotIds || []);
    const allSlots = (currentTourAvailability[dateStr] || [])
      .filter(s => !hiddenIds.includes(String(s.startTimeId)));
    // Deduplicate by startTimeId — keep entry with highest availability
    const slotMap = new Map();
    allSlots.forEach(s => {
      const key = s.startTimeId != null ? String(s.startTimeId) : s.startTime;
      const existing = slotMap.get(key);
      if (!existing || (s.availabilityCount || 0) > (existing.availabilityCount || 0)) slotMap.set(key, s);
    });
    const slots = Array.from(slotMap.values());

    // If only one slot and no startTime label (or manual non-Bokun slot), skip picker
    if (slots.length === 1 && (!slots[0].startTime || slots[0].startTimeId === 'manual')) {
      tdSelectedTimeSlot = slots[0];
      if (!tdCurrentTour?.bokunId) {
        const configId = tdCurrentTour?.configId;
        const nonBokunPkgs = configId ? (COMM_PACKAGES_BY_TOUR[configId] || []) : [];
        if (nonBokunPkgs.length > 1) { showNonBokunPackagePicker(dateStr, nonBokunPkgs); return; }
        if (nonBokunPkgs.length === 1 && tdCurrentTour?.pricingType === 'package') { _selectedNonBokunPkg = nonBokunPkgs[0]; }
      }
      showBookingForm(dateStr);
      return;
    }

    const section = document.getElementById('td-timeslot-section');
    document.getElementById('td-timeslot-date').textContent = formatDate(dateStr);
    const list = document.getElementById('td-timeslot-list');
    if (slots.length === 0) { section.classList.add('hidden'); return; }
    list.innerHTML = slots.flatMap((s, slotIdx) => {
      const cnt = s.availabilityCount;
      const isFull = cnt !== null && cnt === 0;
      const seatLabel = isFull
        ? `<span class="text-xs font-normal text-red-500">Full</span>`
        : cnt !== null && cnt <= 4
          ? `<span class="text-xs font-normal text-orange-500">Only ${cnt} left</span>`
          : cnt !== null
            ? `<span class="text-xs font-normal text-gray-400">${cnt} seats</span>`
            : '';
      const disabledAttr = isFull ? 'disabled' : '';
      const baseCls = `px-4 py-2.5 rounded-xl border-2 text-sm font-semibold text-dark transition-all flex flex-col items-center gap-0.5`;
      const activeCls = 'border-gray-200 hover:border-brand hover:bg-brand/5 cursor-pointer';
      const disabledCls = 'border-gray-100 opacity-40 cursor-not-allowed';
      const cls = `${baseCls} ${isFull ? disabledCls : activeCls}`;

      const slotUniqueRates = (s.rates || []).filter((r, idx, a) => a.findIndex(x => x.id === r.id) === idx);
      const langRates = slotUniqueRates.filter(r => LANGUAGE_KEYWORDS.some(l => r.title.includes(l)));
      const nonLangRates = slotUniqueRates.filter(r => !LANGUAGE_KEYWORDS.some(l => r.title.includes(l)));

      if (langRates.length > 1) {
        // Expand: one button per language rate + one per non-language rate
        return [
          ...langRates.map(r => {
            const lang = LANGUAGE_KEYWORDS.find(l => r.title.toLowerCase().includes(l.toLowerCase())) || r.title;
            return `<button onclick="selectTimeSlotWithRate('${dateStr}', ${slotIdx}, ${r.id}, '${s.startTime || ''}')" data-slot-key="${slotIdx}-${r.id}" ${disabledAttr} class="${cls}">
              <span>${s.startTime || 'Departure'}</span>
              <span class="text-xs font-normal text-gray-400">${lang}</span>
              ${seatLabel}
            </button>`;
          }),
          ...nonLangRates.map(r => `<button onclick="selectTimeSlotWithRate('${dateStr}', ${slotIdx}, ${r.id}, '${s.startTime || ''}')" data-slot-key="${slotIdx}-${r.id}" ${disabledAttr} class="${cls}">
              <span>${s.startTime || 'Departure'}</span>
              <span class="text-xs font-normal text-gray-400">${escapeHtml(r.title)}</span>
              ${seatLabel}
            </button>`)
        ];
      }

      // Normal: 1 button per slot
      const slotLang = langRates.length === 1
        ? LANGUAGE_KEYWORDS.find(l => langRates[0].title.toLowerCase().includes(l.toLowerCase()))
        : null;
      const slotPackageLabel = !slotLang && nonLangRates.length === 1 ? nonLangRates[0].title : null;
      const slotBtnOnclick = slotPackageLabel
        ? `selectTimeSlotWithRate('${dateStr}', ${slotIdx}, ${nonLangRates[0].id}, '${s.startTime || ''}')`
        : `selectTimeSlot('${dateStr}', ${slotIdx}, '${s.startTime || ''}')`;
      const slotBtnDataKey = slotPackageLabel ? `${slotIdx}-${nonLangRates[0].id}` : `${slotIdx}-`;
      return [`<button onclick="${slotBtnOnclick}" data-slot-key="${slotBtnDataKey}" ${disabledAttr} class="${cls}">
        <span>${s.startTime || 'Departure'}</span>
        ${(slotLang || slotPackageLabel) ? `<span class="text-xs font-normal text-gray-400">${escapeHtml(slotLang || slotPackageLabel)}</span>` : ''}
        ${seatLabel}
      </button>`];
    }).join('');
    section.classList.remove('hidden');
    scrollModalTo(section);
    section.dataset.date = dateStr;
  }

  function selectTimeSlot(dateStr, slotIdx, displayTime) {
    tdSelectedTimeSlot = { ...(currentTourAvailability[dateStr] || [])[slotIdx] };
    if (displayTime) tdSelectedTimeSlot._displayTime = displayTime;
    tdSelectedRate = null;
    tdRateSelections = [];
    tdCategorySelections = [];
    document.getElementById('td-booking-form').classList.add('hidden');
    document.getElementById('td-rate-section').classList.add('hidden');
    document.getElementById('td-category-section').classList.add('hidden');
    document.getElementById('td-language-section').classList.add('hidden');
    document.querySelectorAll('#td-timeslot-list button').forEach(btn => {
      const isSelected = btn.dataset.slotKey === `${slotIdx}-`;
      btn.classList.toggle('border-brand', isSelected);
      btn.classList.toggle('bg-brand/5', isSelected);
    });
    const rates = tdSelectedTimeSlot?.rates || [];
    const uniqueRates = rates
      .filter((r, i, a) => a.findIndex(x => x.id === r.id) === i)
      .filter(r => !r.title.toLowerCase().includes('meeting point'))
      .filter(r => {
        if (!tdCurrentTour?.hasPackage) return true;
        const configId = tdCurrentTour?.configId;
        const tourPkgs = configId ? (COMM_PACKAGES_BY_TOUR[configId] || []) : [];
        if (tourPkgs.length === 0) return true; // brak konfiguracji → pokaż wszystko
        const key = _normComm(r.title);
        const words = key.split(' ').filter(w => w.length > 2);
        return tourPkgs.some(p => {
          const pk = _normComm(p.originalName);
          if (pk === key) return true;
          return words.length > 0 && words.every(w => pk.includes(w));
        });
      });
    // Non-Bokun tours: check for packages
    if (!tdCurrentTour?.bokunId) {
      const configId = tdCurrentTour?.configId;
      const nonBokunPkgs = configId ? (COMM_PACKAGES_BY_TOUR[configId] || []) : [];
      if (nonBokunPkgs.length > 1) { showNonBokunPackagePicker(dateStr, nonBokunPkgs); return; }
      if (nonBokunPkgs.length === 1 && tdCurrentTour?.pricingType === 'package') { _selectedNonBokunPkg = nonBokunPkgs[0]; }
    }

    if (uniqueRates.length > 1) {
      if (areLanguageRates(uniqueRates)) {
        showLanguagePicker(dateStr, uniqueRates);
      } else {
        showRatePicker(dateStr, uniqueRates);
      }
    } else {
      tdSelectedRate = uniqueRates[0] || null;
      const slotCatPrices = uniqueRates[0]?.pricesByCategory || [];
      const categoriesToShow = _resolveCategoriesToShow(slotCatPrices);
      if (categoriesToShow.length > 0) {
        showCategoryPicker(dateStr, categoriesToShow, slotCatPrices);
      } else {
        showBookingForm(dateStr);
      }
    }
  }

  function selectTimeSlotWithRate(dateStr, slotIdx, rateId, displayTime) {
    tdSelectedTimeSlot = { ...(currentTourAvailability[dateStr] || [])[slotIdx] };
    if (displayTime) tdSelectedTimeSlot._displayTime = displayTime;
    tdSelectedRate = (tdSelectedTimeSlot.rates || []).find(r => r.id === rateId) || null;
    tdRateSelections = [];
    tdCategorySelections = [];
    document.getElementById('td-booking-form').classList.add('hidden');
    document.getElementById('td-rate-section').classList.add('hidden');
    document.getElementById('td-category-section').classList.add('hidden');
    document.getElementById('td-language-section').classList.add('hidden');
    document.querySelectorAll('#td-timeslot-list button').forEach(btn => {
      const isSelected = btn.dataset.slotKey === `${slotIdx}-${rateId}`;
      btn.classList.toggle('border-brand', isSelected);
      btn.classList.toggle('bg-brand/5', isSelected);
    });
    const slotCatPrices = tdSelectedRate?.pricesByCategory || [];
    const categoriesToShow = _resolveCategoriesToShow(slotCatPrices);
    if (categoriesToShow.length > 0) {
      showCategoryPicker(dateStr, categoriesToShow, slotCatPrices);
    } else {
      showBookingForm(dateStr);
    }
  }

  function showCategoryPicker(dateStr, categories, slotCatPrices) {
    const tourName = tdCurrentTour?.title || '';
    const allCats = categories.map(c => {
      const bokunPrice = slotCatPrices.find(p => p.id === c.id);
      const configPln = lookupCategoryPricePln(tourName, c.title);
      // configPln: undefined = no config (use Bokun price), null = disabled, >=0 = PLN price
      return { category: c, count: 0, configPln, bokunPrice: bokunPrice?.amount };
    });
    // Filter out explicitly disabled categories (configPln === null)
    tdCategorySelections = allCats.filter(s => s.configPln !== undefined && s.configPln !== null);

    const section = document.getElementById('td-category-section');
    const timeLabel = (tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime) ? ' · ' + (tdSelectedTimeSlot._displayTime || tdSelectedTimeSlot.startTime) : '';
    const catLang = LANGUAGE_KEYWORDS.find(l => tdSelectedRate?.title?.toLowerCase().includes(l.toLowerCase()));
    document.getElementById('td-category-subtitle').textContent = formatDate(dateStr) + timeLabel + (catLang ? ' · ' + catLang : '');
    document.getElementById('td-category-list').innerHTML = tdCategorySelections.map((s, i) => {
      const hasAgeInTitle = /\(\d/.test(s.category.title);
      const ageRange = (!hasAgeInTitle && s.category.ageQualified) ? ` (${s.category.minAge}–${s.category.maxAge})` : '';
      let priceStr = '';
      if (s.configPln !== undefined) {
        priceStr = s.configPln === 0
          ? `<span class="text-green-600 font-semibold text-sm">FREE</span>`
          : `<span class="text-brand font-semibold text-sm">${s.configPln} pln</span><span class="text-gray-400 text-xs">/os.</span>`;
      }
      return `<div class="flex items-center justify-between px-4 py-3 bg-white">
        <div class="flex-1 min-w-0 mr-3">
          <div class="text-sm font-semibold text-dark">${s.category.title}${ageRange}</div>
          <div class="flex items-center gap-1 mt-0.5">${priceStr}</div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="changeCategoryCount(${i}, -1)" class="w-8 h-8 rounded-lg border-2 border-gray-200 flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">−</button>
          <span id="cat-count-${i}" class="w-6 text-center text-sm font-bold text-dark">0</span>
          <button onclick="changeCategoryCount(${i}, 1)" class="w-8 h-8 rounded-lg border-2 border-gray-200 flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">+</button>
        </div>
      </div>`;
    }).join('');
    updateCategoryTotal();
    section.dataset.date = dateStr;
    section.classList.remove('hidden');
    scrollModalTo(section);
  }

  function changeCategoryCount(catIdx, delta) {
    const sel = tdCategorySelections[catIdx];
    if (!sel) return;
    const maxSlot = tdSelectedTimeSlot?.availabilityCount || 999;
    const totalOthers = tdCategorySelections.reduce((s, x, i) => i === catIdx ? s : s + x.count, 0);
    sel.count = Math.max(0, Math.min(maxSlot - totalOthers, sel.count + delta));
    document.getElementById('cat-count-' + catIdx).textContent = sel.count;
    updateCategoryTotal();
    syncFormSummary();
  }

  function updateCategoryTotal() {
    const totalPax = tdCategorySelections.reduce((s, x) => s + x.count, 0);
    const totalEl = document.getElementById('td-category-total');
    const btn = document.getElementById('td-category-proceed');
    if (totalPax === 0) {
      totalEl.textContent = '';
      btn.disabled = true;
      btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gray-100 text-gray-400 cursor-not-allowed';
    } else {
      const totalPln = tdCategorySelections.reduce((s, x) => {
        const pln = x.configPln !== undefined ? (x.configPln || 0) : (lookupCommPln(tdCurrentTour?.title || '') || 0);
        return s + x.count * pln;
      }, 0);
      const priceStr = totalPln > 0 ? ` · ~${totalPln} pln` : '';
      totalEl.textContent = `${totalPax} ${totalPax === 1 ? 'person' : 'people'}${priceStr}`;
      btn.disabled = false;
      btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-brand text-white hover:bg-brand/90 cursor-pointer';
    }
  }

  function proceedFromCategories() {
    const totalPax = tdCategorySelections.reduce((s, x) => s + x.count, 0);
    if (totalPax === 0) return;
    tdGuestCount = totalPax;
    showBookingForm(document.getElementById('td-timeslot-section').dataset.date
      || document.getElementById('td-category-section').dataset.date);
  }

  const LANGUAGE_KEYWORDS = ['English','Polish','German','French','Spanish','Italian','Czech','Slovak','Hungarian','Russian','Ukrainian','Chinese','Japanese','Korean','Portuguese','Dutch','Swedish','Norwegian','Danish','Hebrew','Arabic','Romanian','Bulgarian','Croatian','Serbian','Turkish'];

  function areLanguageRates(rates) {
    return rates.length > 1 && rates.every(r => LANGUAGE_KEYWORDS.some(lang => r.title.includes(lang)));
  }

  function showLanguagePicker(dateStr, rates) {
    const section = document.getElementById('td-language-section');
    const timeLabel = (tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime) ? ' · ' + (tdSelectedTimeSlot._displayTime || tdSelectedTimeSlot.startTime) : '';
    document.getElementById('td-language-subtitle').textContent = formatDate(dateStr) + timeLabel;
    document.getElementById('td-language-list').innerHTML = rates.map((r, i) => {
      const lang = LANGUAGE_KEYWORDS.find(l => r.title.toLowerCase().includes(l.toLowerCase())) || r.title.trim();
      const flag = { English:'🇬🇧', Polish:'🇵🇱', German:'🇩🇪', French:'🇫🇷', Spanish:'🇪🇸', Italian:'🇮🇹', Czech:'🇨🇿', Slovak:'🇸🇰', Hungarian:'🇭🇺', Russian:'🇷🇺', Ukrainian:'🇺🇦', Chinese:'🇨🇳', Japanese:'🇯🇵', Korean:'🇰🇷', Portuguese:'🇵🇹', Dutch:'🇳🇱', Hebrew:'🇮🇱', Arabic:'🇸🇦', Turkish:'🇹🇷', Romanian:'🇷🇴' }[lang] || '';
      return `<button onclick="selectLanguage('${dateStr}', ${i})"
        class="td-lang-btn px-5 py-2.5 rounded-xl border-2 border-gray-200 hover:border-brand hover:bg-brand/5 text-sm font-semibold text-dark transition-all flex items-center gap-2">
        ${flag ? `<span>${flag}</span>` : ''}<span>${lang}</span>
      </button>`;
    }).join('');
    section.dataset.date = dateStr;
    section.dataset.rates = JSON.stringify(rates);
    section.classList.remove('hidden');
    scrollModalTo(section);
  }

  function _resolveCategoriesToShow(slotCatPrices) {
    const tourName = tdCurrentTour?.title || '';

    // Non-Bokun tours: build categories from commission config (priceStudent/Child/Infant columns)
    if (!tdCurrentTour?.bokunId) {
      const configId = tdCurrentTour?.configId;
      const entry = (configId && COMM_MAP_BY_TOUR[configId])
        || (tourName && COMM_MAP[_normComm(tourName)])
        || null;
      if (!entry) return [];
      return [
        entry.pricePln    != null ? {id:'adult',   title:'Adult',   ageQualified:true, minAge:18, maxAge:99} : null,
        entry.priceStudent != null ? {id:'student', title:'Student', ageQualified:true, minAge:18, maxAge:24} : null,
        entry.priceChild  != null ? {id:'child',   title:'Child',   ageQualified:true, minAge:3,  maxAge:17} : null,
        entry.priceInfant != null ? {id:'infant',  title:'Infant',  ageQualified:true, minAge:0,  maxAge:2}  : null,
        entry.priceSenior != null ? {id:'senior',  title:'Senior',  ageQualified:true, minAge:60, maxAge:99} : null,
      ].filter(Boolean);
    }

    // Bokun tours: use Bokun categories filtered by configured PLN prices
    const allBokunCats = (tdCurrentTour?.pricing || []).filter(c => !c.internalUseOnly);
    const configured = allBokunCats.filter(c => {
      const pln = lookupCategoryPricePln(tourName, c.title);
      return pln !== null; // strict: undefined=brak konfiguracji (Bokun fallback), null=wyłączone
    });
    return configured;
  }

  function selectLanguage(dateStr, rateIdx) {
    const rates = JSON.parse(document.getElementById('td-language-section').dataset.rates || '[]');
    tdSelectedRate = rates[rateIdx];
    document.querySelectorAll('.td-lang-btn').forEach((btn, i) => {
      btn.classList.toggle('border-brand', i === rateIdx);
      btn.classList.toggle('bg-brand/5', i === rateIdx);
    });
    const slotCatPrices = tdSelectedTimeSlot?.rates?.find(r => r.id === tdSelectedRate?.id)?.pricesByCategory || tdSelectedTimeSlot?.rates?.[0]?.pricesByCategory || [];
    const categoriesToShow = _resolveCategoriesToShow(slotCatPrices);
    if (categoriesToShow.length > 0) {
      showCategoryPicker(dateStr, categoriesToShow, slotCatPrices);
    } else {
      showBookingForm(dateStr);
    }
  }

  function showRatePicker(dateStr, rates) {
    tdRateDateStr = dateStr;
    const configuredRates = rates.filter(r => lookupCommPln(r.title) != null);
    tdRateSelections = (configuredRates.length > 0 ? configuredRates : rates).map(r => ({ rate: r, count: 0 }));
    const section = document.getElementById('td-rate-section');
    const timeLabel = tdSelectedTimeSlot?.startTime ? ' · ' + tdSelectedTimeSlot.startTime : '';
    document.getElementById('td-rate-subtitle').textContent = formatDate(dateStr) + timeLabel;
    document.getElementById('td-rate-list').innerHTML = rates.map((r, i) => {
      const pln = lookupCommPln(r.title);
      const priceStr = pln
        ? `<span class="text-brand font-semibold text-sm">${pln} pln</span><span class="text-gray-400 text-xs">/os.</span>`
        : '';
      return `<div class="flex items-center justify-between px-4 py-3 bg-white">
        <div class="flex-1 min-w-0 mr-3">
          <div class="text-sm font-semibold text-dark leading-tight">${r.title}</div>
          <div class="flex items-center gap-1 mt-0.5">${priceStr}</div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="changeRateCount(${i}, -1)" class="w-8 h-8 rounded-lg border-2 border-gray-200 flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">−</button>
          <span id="rate-count-${i}" class="w-6 text-center text-sm font-bold text-dark">0</span>
          <button onclick="changeRateCount(${i}, 1)" class="w-8 h-8 rounded-lg border-2 border-gray-200 flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">+</button>
        </div>
      </div>`;
    }).join('');
    updateRateTotal();
    section.classList.remove('hidden');
    scrollModalTo(section);
  }

  function changeRateCount(rateIdx, delta) {
    const sel = tdRateSelections[rateIdx];
    if (!sel) return;
    const maxSlot = tdSelectedTimeSlot?.availabilityCount || 999;
    const totalOthers = tdRateSelections.reduce((s, x, i) => i === rateIdx ? s : s + x.count, 0);
    sel.count = Math.max(0, Math.min(maxSlot - totalOthers, sel.count + delta));
    document.getElementById('rate-count-' + rateIdx).textContent = sel.count;
    updateRateTotal();
    syncFormSummary();
  }

  function updateRateTotal() {
    const totalPax = tdRateSelections.reduce((s, x) => s + x.count, 0);
    const totalPln = tdRateSelections.reduce((s, x) => s + x.count * (lookupCommPln(x.rate.title) || x.rate.price?.amount || 0), 0);
    const totalEl = document.getElementById('td-rate-total');
    const btn = document.getElementById('td-rate-proceed');
    if (totalPax === 0) {
      totalEl.textContent = '';
      btn.disabled = true;
      btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gray-100 text-gray-400 cursor-not-allowed';
    } else {
      const priceStr = totalPln > 0 ? ` · ${totalPln} pln` : '';
      totalEl.textContent = `${totalPax} ${totalPax === 1 ? 'person' : 'people'}${priceStr}`;
      btn.disabled = false;
      btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-brand text-white hover:bg-brand/90 cursor-pointer';
    }
  }

  function proceedFromPackages() {
    const totalPax = tdRateSelections.reduce((s, x) => s + x.count, 0);
    if (totalPax === 0) return;
    tdGuestCount = totalPax;
    showBookingForm(tdRateDateStr);
  }

  let _nonBokunPkgDateStr = null;
  let _selectedNonBokunPkg = null;

  function showNonBokunPackagePicker(dateStr, pkgs) {
    _nonBokunPkgDateStr = dateStr;
    _selectedNonBokunPkg = null;
    const section = document.getElementById('td-rate-section');
    document.getElementById('td-rate-subtitle').textContent = formatDate(dateStr);
    const _pkgPerPerson = tdCurrentTour?.pricingType === 'per_person';
    document.getElementById('td-rate-list').innerHTML = pkgs.map((pkg, i) => {
      const priceStr = pkg.pricePln
        ? `<span class="font-bold text-brand">${pkg.pricePln} PLN</span>${_pkgPerPerson ? '<span class="text-gray-400"> / os.</span>' : ''}`
        : '';
      return `<label class="flex items-center gap-3 p-3 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-brand/40 transition-colors" onclick="selectNonBokunPkg(${i})">
        <input type="radio" name="nonbokun-pkg" value="${i}" class="accent-brand">
        <div class="flex-1">
          <div class="text-sm font-semibold text-dark">${escapeHtml(pkg.originalName)}</div>
          ${priceStr ? `<div class="text-xs text-gray-400 mt-0.5">${priceStr}</div>` : ''}
        </div>
      </label>`;
    }).join('');
    section._nonBokunPkgs = pkgs;
    const proceedBtn = document.getElementById('td-rate-proceed');
    proceedBtn.disabled = true;
    proceedBtn.onclick = proceedFromNonBokunPkg;
    section.classList.remove('hidden');
    document.getElementById('td-booking-form').classList.add('hidden');
    scrollModalTo(section);
  }

  function selectNonBokunPkg(idx) {
    const pkgs = document.getElementById('td-rate-section')._nonBokunPkgs || [];
    _selectedNonBokunPkg = pkgs[idx] || null;
    const btn = document.getElementById('td-rate-proceed');
    btn.disabled = false;
    btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-brand text-white hover:bg-brand/90 cursor-pointer';
  }

  function proceedFromNonBokunPkg() {
    if (!_selectedNonBokunPkg) return;
    showBookingForm(_nonBokunPkgDateStr);
  }

  function selectRate(dateStr, rateIdx) {
    // legacy — not used when packages cart is active
    const section = document.getElementById('td-rate-section');
    const rates = section._rates || [];
    tdSelectedRate = rates[rateIdx];
    showBookingForm(dateStr);
  }

  function showBookingForm(dateStr) {
    const form = document.getElementById('td-booking-form');
    form.classList.remove('hidden');
    document.getElementById('td-booking-success').classList.add('hidden');
    const timePart = (tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime) ? ' · ' + (tdSelectedTimeSlot._displayTime || tdSelectedTimeSlot.startTime) : '';
    const bookingLang = LANGUAGE_KEYWORDS.find(l => tdSelectedRate?.title?.toLowerCase().includes(l.toLowerCase()));
    document.getElementById('td-selected-date').textContent = formatDate(dateStr) + timePart + (bookingLang ? ' · ' + bookingLang : '');
    document.getElementById('td-booking-error').classList.add('hidden');
    document.getElementById('td-pickup-section').classList.remove('hidden');

    // Update meeting point label from tour config
    const mp = tdCurrentTour?.meetingPoint;
    const mpTitle = document.getElementById('td-pickup-meeting-title');
    const mpSub = document.getElementById('td-pickup-meeting-sub');
    if (mpTitle) mpTitle.textContent = mp || 'Meeting point';
    if (mpSub) mpSub.textContent = mp ? 'No hotel transfer' : 'No hotel transfer';

    // Show/hide pickup options based on partner + per-tour flags
    const hotelLabel = document.getElementById('td-pickup-hotel-label');
    const meetingLabel = document.getElementById('td-pickup-meeting-label');
    const hotelEnabled = currentPartner?.hotel_pickup_enabled !== false && tdCurrentTour?.allowHotelPickup !== false;
    const meetingEnabled = tdCurrentTour?.allowMeetingPoint !== false;
    if (hotelLabel) hotelLabel.classList.toggle('hidden', !hotelEnabled);
    if (meetingLabel) meetingLabel.classList.toggle('hidden', !meetingEnabled);
    const hotelRadio = document.querySelector('input[name="td-pickup"][value="hotel"]');
    const meetingRadio = document.querySelector('input[name="td-pickup"][value="meeting"]');
    if (hotelEnabled) {
      if (hotelRadio) hotelRadio.checked = true;
      if (meetingRadio) meetingRadio.checked = false;
    } else {
      if (meetingRadio) meetingRadio.checked = true;
      if (hotelRadio) hotelRadio.checked = false;
    }

    // Update hotel address label
    const addrEl = document.querySelector('.td-pickup-hotel-address');
    if (addrEl) {
      const addr = currentPartner?.address && !currentPartner.address.includes('@') ? currentPartner.address : currentPartner?.name || '';
      addrEl.textContent = addr || '—';
    }

    // Show transport surcharge in hotel pickup label — look up from COMM_MAP per selected rate
    const transportPriceEl = document.getElementById('td-pickup-transport-price');
    const _rateNameForTransport = tdSelectedRate?.title || tdRateSelections?.find(r => r.count > 0)?.rate?.title || '';
    const tp = lookupCommTransportPln(_rateNameForTransport);
    if (transportPriceEl) {
      if (tp && hotelEnabled) {
        transportPriceEl.textContent = `(+${tp} PLN/os.)`;
        transportPriceEl.classList.remove('hidden');
      } else {
        transportPriceEl.classList.add('hidden');
      }
    }

    // Show appropriate guest section
    const hasPackages = tdRateSelections.some(x => x.count > 0);
    const hasCategories = tdCategorySelections.some(x => x.count > 0);
    const hasSummary = hasPackages || hasCategories;
    document.getElementById('td-guest-section').classList.toggle('hidden', hasSummary);
    document.getElementById('td-packages-summary').classList.toggle('hidden', !hasSummary);
    if (hasPackages) {
      renderStaticSummary(tdRateSelections.filter(x => x.count > 0).map(x => ({
        label: x.rate.title, count: x.count, price: x.rate.price
      })));
    } else if (hasCategories) {
      renderStaticSummary(tdCategorySelections.filter(x => x.count > 0).map(x => ({
        label: x.category.title, count: x.count, price: x.price
      })));
    } else {
      tdGuestCount = 1;
      document.getElementById('td-guest-count').textContent = 1;
    }
    document.getElementById('td-first').value = '';
    document.getElementById('td-last').value = '';
    document.getElementById('td-email').value = '';
    document.getElementById('td-phone-number').value = '';
    document.getElementById('td-phone-prefix').value = '+48';
    document.getElementById('td-phone-prefix-val').textContent = '🇵🇱 +48';

    document.getElementById('td-notes').value = '';
    renderAdditionalGuestFields(tdGuestCount);
    const linkOpt = document.querySelector('.pay-opt[data-payment="link"]');
    if (linkOpt) linkOpt.style.display = '';
    selectTdPayment('driver');
    tdUpdatePickup();
    _updateNonBokunPkgTotal();
    scrollModalTo(form);
    form.dataset.date = dateStr;
  }

  function tdUpdatePickup() {}

  function tdGetPickupDescription() {
    const val = document.querySelector('input[name="td-pickup"]:checked')?.value;
    if (val === 'meeting') return tdCurrentTour?.meetingPoint || 'Meeting point';
    const addr = currentPartner?.address;
    const validAddr = addr && !addr.includes('@') ? addr : null;
    return validAddr || currentPartner?.name || '';
  }

  function formatDate(dateStr) {
    const d = new Date(dateStr + 'T12:00:00');
    return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
  }

  function renderStaticSummary(items) {
    const totalPax = items.reduce((s, x) => s + x.count, 0);
    const totalPln = items.reduce((s, x) => s + x.count * (lookupCommPln(x.label) || 0), 0);
    const priceStr = totalPln > 0 ? ` · ${totalPln} pln` : '';
    document.getElementById('td-packages-summary-list').innerHTML = items.map(x => {
      const pln = lookupCommPln(x.label);
      const itemPrice = pln ? ` — ${pln * x.count} pln` : x.price ? ` — ${x.price.amount * x.count} ${x.price.currency}` : '';
      return `<div class="flex items-center justify-between py-1 border-b border-gray-100 last:border-0">
        <span class="text-gray-700">${x.label}</span>
        <span class="font-semibold text-dark ml-2 shrink-0">${x.count} ×${itemPrice}</span>
      </div>`;
    }).join('') + (totalPax > 0 ? `<div class="pt-1 text-xs text-gray-400">${totalPax} ${totalPax === 1 ? 'person' : 'people'}${priceStr}</div>` : '');
    tdGuestCount = totalPax;
    renderAdditionalGuestFields(totalPax);
  }

  function syncFormSummary() {
    if (document.getElementById('td-booking-form').classList.contains('hidden')) return;
    const hasPackages = tdRateSelections.some(x => x.count > 0);
    const hasCategories = tdCategorySelections.some(x => x.count > 0);
    if (hasPackages) {
      renderStaticSummary(tdRateSelections.filter(x => x.count > 0).map(x => ({ label: x.rate.title, count: x.count, price: x.rate.price })));
    } else if (hasCategories) {
      renderStaticSummary(tdCategorySelections.filter(x => x.count > 0).map(x => ({ label: x.category.title, count: x.count, price: x.price })));
    }
  }

