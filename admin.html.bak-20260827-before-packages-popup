  function setBookingView(view) {
    currentBookingView = view;
    const recentBtn   = document.getElementById('view-recent-btn');
    const upcomingBtn = document.getElementById('view-upcoming-btn');
    if (recentBtn && upcomingBtn) {
      recentBtn.className   = view === 'recent'   ? 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-dark transition-all' : 'px-3 py-1.5 rounded-lg text-gray-400 transition-all';
      upcomingBtn.className = view === 'upcoming' ? 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-dark transition-all' : 'px-3 py-1.5 rounded-lg text-gray-400 transition-all';
    }
    const upcomingDate = view === 'upcoming' ? new Date().toISOString().slice(0, 10) : '';
    if (upcomingDate) dpopPick('booking-filter-from', upcomingDate);
    else dpopClear('booking-filter-from', true);

    if (view === 'recent') {
      allBookings.sort((a, b) => (b._creationTs || 0) - (a._creationTs || 0));
    } else {
      allBookings.sort((a, b) => (a._startTs || 0) - (b._startTs || 0));
    }
    filterAllBookings();
  }

  const STATUS_GROUPS = { paid: ['paid','confirmed'], to_be_paid: ['to_be_paid','pending'], payment_pending: ['payment_pending','pending_payment'], cancelled: ['cancelled'] };

  function filterAllBookings() {
    ensurePartnerDropdowns();
    const q       = (document.getElementById('booking-search')?.value || '').toLowerCase();
    const hotels  = mselGetVals('msel-ab-hotel');
    const sources = mselGetVals('msel-ab-source');
    const statuses = mselGetVals('msel-ab-status');
    const tours   = mselGetVals('msel-ab-tour');
    const fromVal = document.getElementById('booking-filter-from')?.value || '';
    const toVal   = document.getElementById('booking-filter-to')?.value || '';
    const fromTs  = fromVal ? new Date(fromVal).setHours(0,0,0,0) : null;
    const toTs    = toVal   ? new Date(toVal).setHours(23,59,59,999) : null;
    const createdFromVal = document.getElementById('booking-filter-created-from')?.value || '';
    const createdToVal   = document.getElementById('booking-filter-created-to')?.value || '';
    const createdFromTs  = createdFromVal ? new Date(createdFromVal).setHours(0,0,0,0) : null;
    const createdToTs    = createdToVal   ? new Date(createdToVal).setHours(23,59,59,999) : null;

    const filtered = allBookings.filter(b => {
      const matchQ      = !q        || b.tour.toLowerCase().includes(q) || b.guest.toLowerCase().includes(q) || String(b.id).toLowerCase().includes(q) || (b.phone || '').toLowerCase().includes(q) || (b.email || '').toLowerCase().includes(q) || (b.displayId || '').toLowerCase().includes(q);
      const matchHotel  = hotels.length === 0  || hotels.some(h => h === 'none' ? b.hotel === '—' : b.hotel === h);
      const matchSource = sources.length === 0 || sources.includes(b.source);
      const matchStatus = statuses.length === 0 || statuses.some(s => (STATUS_GROUPS[s] || [s]).includes((b.status||'').toLowerCase()));
      const matchTour   = tours.length === 0   || tours.includes(b.tour);
      const ts = b._startTs || 0;
      const matchFrom   = !fromTs || ts >= fromTs;
      const matchTo     = !toTs   || ts <= toTs;
      const cts = b._creationTs || 0;
      const matchCreatedFrom = !createdFromTs || cts >= createdFromTs;
      const matchCreatedTo   = !createdToTs   || cts <= createdToTs;
      return matchQ && matchHotel && matchSource && matchStatus && matchTour && matchFrom && matchTo && matchCreatedFrom && matchCreatedTo;
    });
    renderBookingsTable(filtered);
  }

  function clearBookingDates() {
    dpopClear('booking-filter-from', true);
    dpopClear('booking-filter-to', true);
    filterAllBookings();
  }

  function clearBookingCreatedDates() {
    dpopClear('booking-filter-created-from', true);
    dpopClear('booking-filter-created-to', true);
    filterAllBookings();
