  async function openTicketDetail(id) {
    const t = allTickets.find(x => x.id === id);
    if (!t) return;
    editingTicketId = id;
    document.getElementById('td-ref').textContent     = '#' + t.id.substring(0,8).toUpperCase();
    document.getElementById('td-meta').textContent    = t.partner + (t.partner_email ? ' · ' + t.partner_email : '') + ' · ' + t.received;
    document.getElementById('td-subject').textContent = t.subject;
    const tdStatusSel = document.getElementById('td-status-select');
    tdStatusSel.value = t.status;
    const tdCdropVal = tdStatusSel.closest('.cdrop')?.querySelector('.cdrop-val');
    if (tdCdropVal) tdCdropVal.textContent = tdStatusSel.options[tdStatusSel.selectedIndex]?.text || '';
    updateTicketReplyVisibility(t.status);
    document.getElementById('td-reply').value         = '';
    tdClearAttachments();
    document.getElementById('td-messages').innerHTML  = '<div class="text-xs text-gray-400 text-center py-4">Loading…</div>';
    const CAT_STYLE = { 'Booking issue':'background:#DBEAFE;color:#1E40AF', 'Voucher':'background:#D1FAE5;color:#065F46', 'Commission':'background:#FEF3C7;color:#92400E', 'Technical':'background:rgba(201,169,110,0.15);color:#c9a96e', 'Other':'background:rgba(255,255,255,0.08);color:#94a3b8' };
    const catChip = document.getElementById('td-cat-chip');
    if (catChip) { catChip.textContent = t.category || 'Other'; catChip.style.cssText = CAT_STYLE[t.category] || CAT_STYLE.Other; }
    const prioChip = document.getElementById('td-priority-chip');
    if (prioChip) {
      if (t.priority === 'urgent') { prioChip.textContent = 'Urgent'; prioChip.style.cssText = 'background:#FEE2E2;color:#991B1B'; prioChip.classList.remove('hidden'); }
      else { prioChip.classList.add('hidden'); }
    }

    const panel = document.getElementById('ticket-detail-panel');
    panel.classList.remove('hidden');
    panel.style.display = 'flex';
    requestAnimationFrame(() => document.getElementById('ticket-detail-drawer').classList.add('open'));

    const { data: msgs, error } = await db.from('support_messages').select('*').eq('ticket_id', id).order('created_at', { ascending: true });
    if (error) { document.getElementById('td-messages').innerHTML = '<div class="text-xs text-red-400 text-center py-4">Failed to load messages.</div>'; return; }
    renderMessageThread(msgs||[]);

    const myEmail = currentAdminEmail || '';
    if (myEmail) {
      await db.from('support_reads').upsert({ ticket_id: id, user_email: myEmail, last_read_at: new Date().toISOString() }, { onConflict: 'ticket_id,user_email' });
      const idx = allTickets.findIndex(x => x.id === id);
      if (idx >= 0) allTickets[idx].unread = false;
      applyTicketFilters();
    }
  }

  function renderMessageThread(msgs) {
    const el = document.getElementById('td-messages');
    if (!el) return;
    if (!msgs.length) { el.innerHTML = '<div style="font-size:12px;color:#64748b;text-align:center;padding:16px 0">No messages yet.</div>'; return; }
    el.innerHTML = msgs.map(m => {
      const isAdmin = m.sender_type === 'admin';
      const time = new Date(m.created_at).toLocaleString('en',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
      const bubbleBg    = isAdmin ? 'rgba(255,255,255,0.12)' : '#E8751A';
      const bubbleText  = '#f1f5f9';
      const metaColor   = isAdmin ? 'rgba(241,245,249,0.5)' : 'rgba(255,255,255,0.55)';
      const atts = Array.isArray(m.attachments) ? m.attachments : (m.attachment_url ? [{name: m.attachment_name||'Attachment', url: m.attachment_url, type: ''}] : []);
      const att = renderAttachmentBubbles(atts, true);
      return `<div style="display:flex;justify-content:${isAdmin?'flex-start':'flex-end'}">
        <div style="max-width:75%;background:${bubbleBg};color:${bubbleText};border-radius:16px;padding:10px 14px;${isAdmin?'border:1px solid rgba(255,255,255,0.08)':''}">
          <div style="font-size:11px;margin-bottom:4px;color:${metaColor}">${escapeHtml(m.sender_name||m.sender_email)} · ${time}</div>
          <div style="font-size:13px;line-height:1.5;white-space:pre-wrap">${escapeHtml(m.message)}</div>
          ${att}
        </div>
      </div>`;
    }).join('');
    el.scrollTop = el.scrollHeight;
  }

