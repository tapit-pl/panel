function initPhonePrefixDrop() {
  renderPhonePrefixItems(PHONE_PREFIXES);
}

function renderPhonePrefixItems(items) {
  const el = document.getElementById('phone-prefix-items');
  if (!el) return;
  const cur = document.getElementById('ord-phone-prefix')?.value || '+48';
  el.innerHTML = items.map(p =>
    `<div class="cdrop-item${p.d === cur ? ' active' : ''}" onclick="selectPhonePrefix('${p.d}','${p.f} ${p.d}')">${p.f} ${p.c} <span style="color:#64748b">${p.d}</span></div>`
  ).join('') || '<div style="padding:8px 10px;font-size:12px;color:#64748b">No results</div>';
}

function filterPhonePrefixes(q) {
  const ql = q.toLowerCase();
  renderPhonePrefixItems(PHONE_PREFIXES.filter(p => p.c.toLowerCase().includes(ql) || p.d.includes(q)));
}

function selectPhonePrefix(code, label) {
  document.getElementById('ord-phone-prefix').value = code;
  document.getElementById('phone-prefix-val').textContent = label;
  const list = document.getElementById('phone-prefix-list');
  list.style.display = 'none';
  document.getElementById('phone-prefix-btn')?.classList.remove('open');
  const search = document.getElementById('phone-prefix-search');
  if (search) { search.value = ''; renderPhonePrefixItems(PHONE_PREFIXES); }
}

function togglePhonePrefix(e) {
  e.stopPropagation();
  const list = document.getElementById('phone-prefix-list');
  const btn = document.getElementById('phone-prefix-btn');
  const isOpen = list.style.display !== 'none';
  document.querySelectorAll('.cdrop-list.open').forEach(l => { l.classList.remove('open'); l.closest('.cdrop')?.querySelector('.cdrop-btn')?.classList.remove('open'); });
  if (isOpen) {
    list.style.display = 'none'; btn?.classList.remove('open');
  } else {
    list.style.display = 'block'; btn?.classList.add('open');
    document.getElementById('phone-prefix-search')?.focus();
    renderPhonePrefixItems(PHONE_PREFIXES);
  }
}

// Close phone prefix on outside click
document.addEventListener('click', function(e) {
  if (!e.target.closest('#cdrop-phone-prefix')) {
    const list = document.getElementById('phone-prefix-list');
    if (list) { list.style.display = 'none'; document.getElementById('phone-prefix-btn')?.classList.remove('open'); }
