async function loadStaffUsers() {
  document.getElementById('staff-loading').classList.remove('hidden');
  document.getElementById('staff-table-wrap').classList.add('hidden');
  document.getElementById('staff-empty').classList.add('hidden');

  const { data: users, error } = await db.from('admin_users').select('*').order('email');
  document.getElementById('staff-loading').classList.add('hidden');

  if (error || !users?.length) {
    document.getElementById('staff-empty').classList.remove('hidden');
    return;
  }

  const ROLE_RANK = { admin: 0, manager: 1, staff: 2 };
  users.sort((a, b) => (ROLE_RANK[a.role] ?? 3) - (ROLE_RANK[b.role] ?? 3) || a.email.localeCompare(b.email));

  const { data: { session } } = await db.auth.getSession();
  _meEmailForStaff = session?.user?.email || '';
  allStaffUsers = users;
  _staffPage = 0;
  renderStaffGrid();
}

function renderStaffGrid() {
  const q = (document.getElementById('staff-search-input')?.value || '').toLowerCase();
  const list = q ? allStaffUsers.filter(u => {
    const name = [u.first_name, u.last_name].filter(Boolean).join(' ');
    return (name + ' ' + u.email).toLowerCase().includes(q);
  }) : allStaffUsers;

  document.getElementById('staff-subtitle').textContent = `${allStaffUsers.length} member${allStaffUsers.length !== 1 ? 's' : ''}`;
  const grid = document.getElementById('staff-grid');
  const totalPages = Math.ceil(list.length / _STAFF_PER_PAGE);
  if (_staffPage >= totalPages) _staffPage = Math.max(0, totalPages - 1);
  const start = _staffPage * _STAFF_PER_PAGE;
  const pageItems = list.slice(start, start + _STAFF_PER_PAGE);

  grid.innerHTML = pageItems.map(u => {
    const isMe = u.email === _meEmailForStaff;
    const firstName = u.first_name || '';
    const lastName = u.last_name || '';
    const name = [firstName, lastName].filter(Boolean).join(' ') || '—';
    const r = ROLE_LABELS[u.role] || ROLE_LABELS['staff'];
    const initials = name !== '—' ? name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase() : u.email[0].toUpperCase();
    const isActive = u.active !== false;
    return `<div class="bg-white rounded-xl shadow-sm border-l-4 flex items-center gap-3 px-4 py-3 cursor-pointer hover:shadow-md transition-shadow" style="border-left-color:${r.color};opacity:${isActive ? 1 : 0.55}" onclick="openEditStaffModal('${escapeHtml(u.email)}','${escapeHtml(firstName)}','${escapeHtml(lastName)}','${escapeHtml(u.role)}',${isActive})">
      <div class="w-9 h-9 rounded-lg flex items-center justify-center text-white font-bold text-xs shrink-0" style="background:${r.color}">${escapeHtml(initials)}</div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="font-semibold text-dark text-sm">${escapeHtml(name)}${isMe ? ' <span class="text-xs font-normal text-gray-400">(you)</span>' : ''}</span>
          ${roleChip(u.role)}
          ${!isActive ? '<span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-red-100 text-red-500">Deactivated</span>' : ''}
        </div>
        <div class="text-xs text-gray-400 mt-0.5 truncate">${escapeHtml(u.email)}</div>
      </div>
      <div class="text-gray-300 shrink-0">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </div>
    </div>`;
  }).join('');
  document.getElementById('staff-table-wrap').classList.remove('hidden');

  let pager = document.getElementById('staff-pager');
  if (totalPages > 1) {
    if (!pager) {
      pager = document.createElement('div');
      pager.id = 'staff-pager';
      pager.className = 'flex items-center justify-between mt-3 text-xs text-gray-500';
      grid.parentElement.appendChild(pager);
    }
    pager.innerHTML = `<span>${start + 1}–${Math.min(start + _STAFF_PER_PAGE, list.length)} of ${list.length}</span>
      <div class="flex gap-2">
        <button onclick="_staffPage=Math.max(0,_staffPage-1);renderStaffGrid()" class="px-3 py-1.5 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-40" ${_staffPage === 0 ? 'disabled' : ''}>← Previous</button>
        <button onclick="_staffPage=Math.min(${totalPages-1},_staffPage+1);renderStaffGrid()" class="px-3 py-1.5 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-40" ${_staffPage >= totalPages - 1 ? 'disabled' : ''}>Next →</button>
      </div>`;
  } else if (pager) {
    pager.remove();
  }
}

