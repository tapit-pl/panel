  function parsePolishAddress(addr) {
    // Input: "UL. FLORIANSKA 12/4, 31-021 KRAKOW" or "ALEJA NIEPODLEGLOSCI 208, 00-925 WARSZAWA"
    if (!addr) return {};
    const commaIdx = addr.lastIndexOf(',');
    if (commaIdx === -1) return { street: addr };
    const streetRaw = addr.slice(0, commaIdx).trim();
    const cityRaw   = addr.slice(commaIdx + 1).trim();
    // Postal + city
    const postalMatch = cityRaw.match(/^(\d{2}-\d{3})\s+(.+)$/);
    const postal = postalMatch ? postalMatch[1] : '';
    const city   = postalMatch ? postalMatch[2] : cityRaw;
    // Street + house number [/ apt]
    const numMatch = streetRaw.match(/^(.*?)\s+(\d+[A-Za-z]?)(?:\/(\d+[A-Za-z]?))?$/);
    let street = streetRaw, house = '', apt = '';
    if (numMatch) {
      street = numMatch[1];
      house  = numMatch[2];
      apt    = numMatch[3] || '';
    }
    // Normalize case: "UL. FLORIANSKA" → "ul. Floriańska" — keep as-is (user can edit)
    return { street, house, apt, postal, city };
  }

  async function lookupNIP() {
    const raw = (document.getElementById('ap-nip').value || '').replace(/[-\s]/g, '');
    const statusEl = document.getElementById('ap-nip-status');
    const vatBadge = document.getElementById('ap-vat-badge');
    if (raw.length !== 10 || !/^\d+$/.test(raw)) {
      statusEl.textContent = 'Please enter a valid NIP (10 digits).';
      statusEl.className = 'text-xs mt-1.5 text-red-400';
      return;
    }
    statusEl.textContent = 'Looking up...';
    statusEl.className = 'text-xs mt-1.5 text-gray-400';
    vatBadge.className = 'hidden text-center';
    try {
      const today = new Date().toISOString().slice(0, 10);
      const resp = await fetch(`https://wl-api.mf.gov.pl/api/search/nip/${raw}?date=${today}`);
      if (!resp.ok) throw new Error('not found');
      const data = await resp.json();
      if (data.code === 'WL-115') throw new Error('invalid nip');
      const subj = data?.result?.subject;
      if (!subj) throw new Error('no subject');

      // Normalize ALL CAPS → Title Case (e.g. "HOTEL MACIEJEWSKI" → "Hotel Maciejewski")
      const toTitleCase = str => str
        ? str.toLowerCase().replace(/(?:^|\s|[-–/])\S/g, c => c.toUpperCase())
        : str;

      // Company name
      if (subj.name) document.getElementById('ap-invoice-company').value = toTitleCase(subj.name);

      // Address → split into fields
      const addrRaw = subj.workingAddress || subj.residenceAddress || null;
      if (addrRaw) {
        const { street, house, apt, postal, city } = parsePolishAddress(addrRaw);
        if (street) document.getElementById('ap-inv-street').value = toTitleCase(street);
        if (house)  document.getElementById('ap-inv-house').value  = house;
        if (apt)    document.getElementById('ap-inv-apt').value    = apt;
        if (postal) document.getElementById('ap-inv-postal').value = postal;
        if (city)   document.getElementById('ap-inv-city').value   = toTitleCase(city);
      }

      // VAT status badge
      const vatActive = subj.statusVat === 'Czynny';
      vatBadge.innerHTML = vatActive
        ? '<span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-100 px-2 py-1 rounded-lg"><span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span>VAT active</span>'
        : '<span class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 bg-red-50 px-2 py-1 rounded-lg"><span class="w-1.5 h-1.5 rounded-full bg-red-400 inline-block"></span>VAT inactive</span>';
      vatBadge.className = 'text-center';

      statusEl.textContent = addrRaw ? 'Data retrieved successfully.' : 'Name retrieved. Address not available in the register — please enter manually.';
      statusEl.className = 'text-xs mt-1.5 ' + (addrRaw ? 'text-green-500' : 'text-amber-500');
    } catch(e) {
      const msg = e.message === 'invalid nip' ? 'Invalid NIP.' : 'No company found for this NIP.';
      statusEl.textContent = msg;
      statusEl.className = 'text-xs mt-1.5 text-red-400';
      vatBadge.className = 'hidden text-center';
    }
  }

