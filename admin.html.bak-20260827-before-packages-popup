  const MONTH_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  // Deterministic pseudo-random based on date string — same date always = same value
  function dayHash(dateStr, salt) {
    let h = salt || 0;
    for (let i = 0; i < dateStr.length; i++) h = (Math.imul(31, h) + dateStr.charCodeAt(i)) | 0;
    return Math.abs(h);
  }

  function generateDayData(dateStr) {
    const dayStart = new Date(dateStr + 'T00:00:00').getTime();
    const dayEnd   = dayStart + 86400000;
    let src;
    if (dashFilter === 'seller') {
      src = cpData.map(p => ({ _creationTs: p._creationTs || 0, status: p.status, _plnAmount: p.guest_price || 0 }));
    } else if (dashFilter === 'all') {
      const cpExtra = cpData.filter(p => p.status !== 'cancelled').map(p => ({ _creationTs: p._creationTs || 0, status: p.status, _plnAmount: p.guest_price || 0 }));
      src = [...getFilteredBookings(), ...cpExtra];
    } else {
      src = getFilteredBookings();
    }
    const items = src.filter(b => (b._creationTs||0) >= dayStart && (b._creationTs||0) < dayEnd && (b.status||'').toLowerCase() !== 'cancelled');
    const r     = items.reduce((s,b) => s + (b._plnAmount != null ? b._plnAmount : toPlnAmount(b)), 0);
    return { b: items.length, r };
  }

  function fmtDateLabel(d) {
    return MONTH_SHORT[d.getMonth()] + ' ' + d.getDate();
  }

  function fmtDateShort(isoStr) {
    const d = new Date(isoStr + 'T00:00:00');
    return MONTH_SHORT[d.getMonth()] + ' ' + d.getDate();
  }

  function renderDashboardChart(kpiTotals) {
    const ctx = document.getElementById('dashboard-chart');
    if (!ctx) return;
    if (dashChart) dashChart.destroy();

    const fromVal = document.getElementById('chart-date-from').value;
    const toVal   = document.getElementById('chart-date-to').value;
    if (!fromVal || !toVal) return;

    const fromDate = new Date(fromVal + 'T00:00:00');
    const toDate   = new Date(toVal   + 'T00:00:00');
    if (fromDate > toDate) return;

    const labels = [], bookings = [], revenue = [];
    for (let d = new Date(fromDate); d <= toDate; d.setDate(d.getDate() + 1)) {
      const iso = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      const { b, r } = generateDayData(iso);
      labels.push(fmtDateLabel(new Date(iso + 'T00:00:00')));
      bookings.push(b);
      revenue.push(r);
    }

    const fromY = fromDate.getFullYear(), toY = toDate.getFullYear();
    const sameYear = fromY === toY;
    const periodLabel = fmtDateShort(fromVal) + (sameYear ? '' : ', ' + fromY) + ' – ' + fmtDateShort(toVal) + ', ' + toY;
    const pl = document.getElementById('chart-period-label');
    if (pl) pl.textContent = periodLabel;

    const totalB = kpiTotals ? kpiTotals.b : bookings.reduce((a,b)=>a+b,0);
    const totalR = kpiTotals ? kpiTotals.r : revenue.reduce((a,b)=>a+b,0);
    const avgB   = (totalB / labels.length).toFixed(1);
    const maxB   = Math.max(...bookings);
    const bestIdx = bookings.indexOf(maxB);

    document.getElementById('cstat-bookings').textContent = totalB;
    document.getElementById('cstat-revenue').textContent  = Math.round(totalR).toLocaleString('pl') + ' zł';
    document.getElementById('cstat-avg').textContent      = avgB;
    document.getElementById('cstat-best').textContent     = labels[bestIdx] + ' · ' + maxB;

    const days = labels.length;
    const barThickness = days <= 14 ? 18 : undefined;

    dashChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [
          {
            label: 'Bookings',
            data: bookings,
            backgroundColor: 'rgba(232,117,26,0.85)',
            borderRadius: 3,
            order: 1,
            yAxisID: 'yLeft',
            ...(barThickness ? { barThickness } : {})
          },
          {
            label: 'Revenue (zł)',
            data: revenue,
            type: 'line',
            borderColor: 'rgba(99,153,233,0.85)',
            backgroundColor: 'rgba(99,153,233,0.07)',
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 4,
            fill: true,
            tension: 0.4,
            order: 0,
            yAxisID: 'yRight'
          }
        ]
      },
      options: {
        animation: false,
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: item => item.dataset.label === 'Bookings'
                ? 'Bookings: ' + item.parsed.y
                : 'Revenue: ' + Math.round(item.parsed.y).toLocaleString('pl') + ' zł'
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { size: 10 }, color: '#64748b', maxTicksLimit: days <= 31 ? 15 : 10, maxRotation: 0 }
          },
          yLeft: {
