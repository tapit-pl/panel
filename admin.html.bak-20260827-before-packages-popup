    const totalPages = Math.ceil(sentNotifications.length / _NOTIF_PER_PAGE);
    if (_notifPage >= totalPages) _notifPage = Math.max(0, totalPages - 1);
    const start = _notifPage * _NOTIF_PER_PAGE;
    const pageItems = sentNotifications.slice(start, start + _NOTIF_PER_PAGE);
