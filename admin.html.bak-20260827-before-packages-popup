  async function invokeEdge(name, options = {}) {
    if (!_authToken) {
      const { data: { session } } = await db.auth.getSession();
      if (session?.access_token) _authToken = session.access_token;
    }
    const headers = {
      'Content-Type': 'application/json',
      'apikey': _SUPA_ANON,
      'Authorization': `Bearer ${_authToken || _SUPA_ANON}`,
      ...(options.headers || {}),
    };
    const res = await fetch(`${_SUPA_FUNC_BASE}/${name}`, {
      method: 'POST',
      headers,
      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
    }).catch(err => ({ ok: false, status: 0, _fetchErr: err }));
    if (res._fetchErr) return { data: null, error: res._fetchErr };
    if (res.status === 401) {
      const { data: { session } } = await db.auth.refreshSession();
      if (session?.access_token) {
        _authToken = session.access_token;
        return invokeEdge(name, options);
      }
      db.auth.signOut().then(() => window.location.replace('/'));
      return { data: null, error: new Error('Session expired') };
    }
    if (!res.ok) {
      const errBody = await res.json().catch(() => ({ error: res.statusText }));
      const err = Object.assign(new Error('Edge Function returned a non-2xx status code'), { context: res, status: res.status, body: errBody });
      return { data: null, error: err };
    }
    const data = await res.json().catch(() => null);
    return { data, error: null };
  }

  function escapeHtml(str) {
    if (str == null) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function showScreen(id) {
