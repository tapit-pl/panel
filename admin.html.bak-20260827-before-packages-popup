  async function syncToursFromBokun() {
    const btn = document.getElementById('btn-sync-tours');
    btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin"></i> Syncing…';
    btn.disabled = true;
    try {
      const existingIds    = new Set(allTourConfig.map(t => String(t.bokun_id)).filter(Boolean));
      const existingTitles = new Set(allTourConfig.map(t => (t.title || '').toLowerCase().trim()));
      let page = 0, newCount = 0;
      const newTitles = [];
      while (true) {
        const { data: res } = await invokeEdge('bokun-sync', {
          body: { path: '/activity.json/search', method: 'POST', payload: { pageSize: 100, page } }
        });
        const items = res?.body?.items;
        if (!Array.isArray(items) || items.length === 0) break;
        for (const item of items) {
          const bokunId = String(item.id);
          const title   = (item.title || item.name || '').trim();
          if (!title || !bokunId) continue;
          const existing = allTourConfig.find(t => String(t.bokun_id) === bokunId);
          if (existing) {
            if (existing.title !== title) {
              await db.from('tour_config').update({ title }).eq('id', existing.id);
              existing.title = title;
            }
            continue;
          }
          if (existingTitles.has(title.toLowerCase())) continue;
          const maxOrder = allTourConfig.reduce((m, t) => Math.max(m, t.sort_order || 0), 0);
          const { data: newT } = await db.from('tour_config').insert({ title, bokun_id: bokunId, sort_order: maxOrder + 10, active: true, groups: [] }).select().single();
          if (newT) {
            allTourConfig.push(newT);
            existingIds.add(bokunId);
            existingTitles.add(title.toLowerCase());
            newCount++;
            newTitles.push(title);
          }
        }
        if (items.length < 100) break;
        page++;
      }
      allTourConfig.sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
      // Reset cached Bokun categories so refreshBokunPricingCategories re-fetches fresh data
      allTourConfig.forEach(t => { t.bokun_pricing_categories = null; });
      await db.from('tour_config').update({ bokun_pricing_categories: null }).not('bokun_id', 'is', null);
      renderTourConfigTable();
      showToast(newCount > 0 ? `Sync done — ${newCount} new tour${newCount !== 1 ? 's' : ''} added.` : 'Sync done — no new tours found.');
      if (newCount > 0) logActivity('tours_synced_from_bokun', `${newCount} new tour(s) added from Bokun: ${newTitles.join(', ')}`).catch(() => {});
      refreshBokunPricingCategories();
    } catch(e) {
      showToast('Sync failed: ' + e.message);
    }
    btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Sync from Bokun';
    btn.disabled = false;
  }

