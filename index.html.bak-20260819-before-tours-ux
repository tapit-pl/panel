    const container = document.getElementById('td-cal');
    container.innerHTML = '<div class="py-8 text-center text-gray-400 text-sm">Loading…</div>';
    await fetchAvailabilityForMonth(tdCurrentTour, y, m);
    renderAvailabilityCal(container, y, m);
  };

