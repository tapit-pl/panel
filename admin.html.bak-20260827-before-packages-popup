async function toggleStaffStatus(email, currentlyActive) {
  if (currentAdminRole !== 'admin') { showToast('Requires admin role', 'error'); return; }
  const action = currentlyActive ? 'deactivate' : 'activate';
  const label = currentlyActive ? 'Deactivate' : 'Activate';
  if (!await showConfirm(`${label} account for ${email}?\n\n${currentlyActive ? 'They will immediately lose panel access and cannot log in.' : 'They will regain panel access.'}`, { okLabel: label, okColor: currentlyActive ? '#dc2626' : '#16a34a' })) return;
