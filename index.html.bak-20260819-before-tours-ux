    const _badgeInitialsEl = document.getElementById('partner-header-initials');
    const _badgeNameEl = document.getElementById('partner-header-name');
    const _badgeWrapEl = document.getElementById('partner-header-badge');
    if (_badgeInitialsEl) { _badgeInitialsEl.textContent = generatedInitials; _badgeInitialsEl.style.background = _badgeBg; _badgeInitialsEl.style.color = '#ffffff'; }
    if (_badgeNameEl) _badgeNameEl.textContent = p.name || '—';
    if (_badgeWrapEl) _badgeWrapEl.title = p.name || '—';
    document.querySelectorAll('.td-pickup-hotel-label').forEach(el => el.textContent = p.name || '—');
    document.querySelectorAll('.partner-type').forEach(el => el.textContent = p.type || '');

    // Filter payment options based on partner config
    const allowedPayments = p.payment_options && p.payment_options.length ? p.payment_options : ['driver', 'hotel', 'link'];
    const payGrid = document.getElementById('td-payment-grid');
    if (payGrid) {
      const visible = payGrid.querySelectorAll('.pay-opt[data-payment]');
      visible.forEach(el => {
        el.style.display = allowedPayments.includes(el.dataset.payment) ? '' : 'none';
      });
      const count = allowedPayments.length;
      payGrid.className = `grid gap-2 grid-cols-${count}`;
      const firstVisible = payGrid.querySelector(`.pay-opt[data-payment="${allowedPayments[0]}"]`);
      if (firstVisible) selectTdPayment(allowedPayments[0]);
    }

    // Reload commission map now that user is authenticated (RLS requires auth token)
    buildCommMap().then(() => renderPartnerCommissionsTab(Object.values(COMM_MAP)));

    // Prefetch tours in background (no await — doesn't block dashboard load)
    loadToursFromBokun();
    loadAndRenderCatFilters();

    await loadPartnerBookings();

    await loadPartnerNotifications();

    loadPartnerBanner().catch(e => console.warn('loadPartnerBanner:', e));
    loadPartnerTickets().catch(e => console.warn('loadPartnerTickets:', e));

    db.channel('partner-support-watch')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'support_messages' }, async (payload) => {
        const msg = payload?.new;
        if (!msg || msg.sender_type !== 'admin') return;
        const { data: ticket } = await db.from('support_tickets')
          .select('id, subject').eq('id', msg.ticket_id).eq('partner_email', currentPartner.email).maybeSingle();
        if (!ticket) return;
        showPartnerToast('Thousand Miles replied to your ticket: ' + (ticket.subject || ''));
        await loadPartnerTickets();
        if (openTicketId === msg.ticket_id) {
          await refreshTicketThread(msg.ticket_id);
          // Auto-mark as read if panel is open
          const now = new Date().toISOString();
          await db.from('support_reads').upsert(
            { ticket_id: msg.ticket_id, user_email: currentPartner.email, last_read_at: now },
            { onConflict: 'ticket_id,user_email' }
          );
          partnerReadMap[msg.ticket_id] = now;
          showHelpBadge(countUnreadTickets());
          renderPartnerTickets();
        }
      })
      .subscribe();

    db.channel('partner-ticket-status-watch')
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'support_tickets', filter: `partner_email=eq.${currentPartner.email}` }, async () => {
        await loadPartnerTickets();
        // If ticket panel is open, refresh its status badge live
        if (openTicketId) {
          const ticket = partnerTickets.find(t => t.id === openTicketId);
          if (ticket) {
            const statusLabel = { open: 'Open', in_progress: 'In Progress', resolved: 'Resolved' };
            const statusColor = { open: 'background:#FEF3C7;color:#92400E', in_progress: 'background:#DBEAFE;color:#1E40AF', resolved: 'background:#D1FAE5;color:#065F46' };
            const badge = document.getElementById('tp-status-badge');
            if (badge) { badge.textContent = statusLabel[ticket.status] || ticket.status; badge.style.cssText = statusColor[ticket.status] || statusColor.open; }
            const isClosed = ticket.status === 'resolved';
            document.getElementById('tp-reply-wrap')?.classList.toggle('hidden', isClosed);
            document.getElementById('tp-closed-notice')?.classList.toggle('hidden', !isClosed);
          }
        }
      })
      .subscribe();

    db.channel('partner-notif-watch')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'notifications' }, (payload) => {
        const n = payload?.new;
        if (!n) return;
        if (n.target === 'all' || n.target === currentPartner?.id) {
          loadPartnerNotifications();
        }
      })
      .subscribe();
    setInterval(() => loadPartnerTickets().catch(() => {}), 15000);

    goTo('screen-dashboard');
  }

