  async function saveTicketStatus() {
    if (!editingTicketId) return;
    const status = document.getElementById('td-status-select').value;
    const { error } = await db.from('support_tickets').update({ status }).eq('id', editingTicketId);
    if (error) { showToast('Error updating status', 'error'); return; }
    const t = allTickets.find(x => x.id === editingTicketId);
    if (t) { t.status = status; }
    updateTicketReplyVisibility(status);
    const action = status === 'resolved' ? 'ticket_resolved' : 'ticket_updated';
    await logActivity(action, `Ticket "${t?.subject}" → ${status}`, editingTicketId);
    applyTicketFilters();
    showToast('Status updated');
  }

  async function saveTicket() {
    const t = allTickets.find(x => x.id === editingTicketId);
    if (!t) return;
    const status = document.getElementById('td-status-select').value;
    const reply  = (document.getElementById('td-reply').value || '').trim();
    try {
      await db.from('support_tickets').update({ status, updated_at: new Date().toISOString() }).eq('id', editingTicketId);
      if (reply || tdAttachFiles.length) {
        const attachments = tdAttachFiles.length ? await uploadSupportAttachments(tdAttachFiles, editingTicketId) : [];
        await db.from('support_messages').insert({
          ticket_id:    editingTicketId,
          sender_type:  'admin',
          sender_email: currentAdminEmail || 'admin',
          sender_name:  currentAdminName || 'Thousand Miles Team',
          message:      reply,
          attachments:  attachments.length ? attachments : null,
        });
        const myEmail = currentAdminEmail || '';
        if (myEmail) await db.from('support_reads').upsert({ ticket_id: editingTicketId, user_email: myEmail, last_read_at: new Date().toISOString() }, { onConflict: 'ticket_id,user_email' });
      }
      const action = status==='resolved' ? 'ticket_resolved' : reply ? 'ticket_replied' : 'ticket_updated';
      await logActivity(action, `Ticket "${t.subject}" → ${status}${reply?' (reply sent)':''}`, editingTicketId);
      t.status = status; t.unread = false;
      document.getElementById('td-reply').value = '';
      tdClearAttachments();
      const { data: msgs } = await db.from('support_messages').select('*').eq('ticket_id', editingTicketId).order('created_at', { ascending: true });
      renderMessageThread(msgs||[]);
      applyTicketFilters();
      showToast('Ticket updated.');
    } catch(e) { console.error('saveTicket', e); showToast('Error saving ticket.'); }
  }

  async function saveTicketAndResolve() {
    const t = allTickets.find(x => x.id === editingTicketId);
    if (!t) return;
    const reply = (document.getElementById('td-reply').value || '').trim();
    try {
      await db.from('support_tickets').update({ status: 'resolved', updated_at: new Date().toISOString() }).eq('id', editingTicketId);
      if (reply || tdAttachFiles.length) {
        const attachments = tdAttachFiles.length ? await uploadSupportAttachments(tdAttachFiles, editingTicketId) : [];
        await db.from('support_messages').insert({
          ticket_id:    editingTicketId,
          sender_type:  'admin',
          sender_email: currentAdminEmail || 'admin',
          sender_name:  currentAdminName || 'Thousand Miles Team',
          message:      reply,
          attachments:  attachments.length ? attachments : null,
        });
        const myEmail = currentAdminEmail || '';
        if (myEmail) await db.from('support_reads').upsert({ ticket_id: editingTicketId, user_email: myEmail, last_read_at: new Date().toISOString() }, { onConflict: 'ticket_id,user_email' });
      }
      await logActivity('ticket_resolved', `Ticket "${t.subject}" → resolved${reply ? ' (reply sent)' : ''}`, editingTicketId);
