  async function renameTourGroup(oldName, newName) {
    if (!newName || newName === oldName) return;
    const toursToUpdate = allTourConfig.filter(t => (t.groups || []).includes(oldName));
    await Promise.all(toursToUpdate.map(t => {
      t.groups = t.groups.map(g => g === oldName ? newName : g);
      return db.from('tour_config').update({ groups: t.groups }).eq('id', t.id);
    }));
    const partnersToUpdate = allPartners.filter(p => (p.tourGroups || []).includes(oldName));
    await Promise.all(partnersToUpdate.map(p => {
      p.tourGroups = (p.tourGroups || []).map(g => g === oldName ? newName : g);
      return db.from('partners').update({ tour_groups: p.tourGroups }).eq('id', p.id);
    }));
    renderTourGroupsSection();
    renderTourConfigTable();
    showToast(`Group renamed to "${newName}".`);
    logActivity('tour_group_renamed', `Group "${oldName}" → "${newName}" (${toursToUpdate.length} tours, ${partnersToUpdate.length} partners)`).catch(() => {});
  }

  async function confirmDeleteTourGroup(name) {
    const ok = await showConfirm(`Delete group "${name}"?\nThis will remove it from all tours and partners.`, { okLabel: 'Delete', okColor: '#dc2626' });
    if (!ok) return;
    const toursToUpdate = allTourConfig.filter(t => (t.groups || []).includes(name));
    await Promise.all(toursToUpdate.map(t => {
      t.groups = (t.groups || []).filter(g => g !== name);
      return db.from('tour_config').update({ groups: t.groups }).eq('id', t.id);
    }));
    const partnersToUpdate = allPartners.filter(p => (p.tourGroups || []).includes(name));
    await Promise.all(partnersToUpdate.map(p => {
      p.tourGroups = (p.tourGroups || []).filter(g => g !== name);
      return db.from('partners').update({ tour_groups: p.tourGroups }).eq('id', p.id);
    }));
    renderTourGroupsSection();
    renderTourConfigTable();
    showToast(`Group "${name}" deleted.`);
    logActivity('tour_group_deleted', `Group "${name}" deleted (${toursToUpdate.length} tours, ${partnersToUpdate.length} partners)`).catch(() => {});
  }

