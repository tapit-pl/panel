  async function submitTailorOrder() {
    let valid = true;

    const clientName = document.getElementById('tailor-client-name');
    if (!clientName.value.trim()) {
      clientName.style.borderColor = '#E8751A'; valid = false;
    } else { clientName.style.borderColor = ''; }

    const pax = document.getElementById('tailor-pax');
    if (!pax.value || parseInt(pax.value) < 1) {
      pax.style.borderColor = '#E8751A'; valid = false;
    } else { pax.style.borderColor = ''; }

    const dateVal = document.getElementById('tailor-date-from').value;
    const dateBtn = document.getElementById('tailor-from-btn');
    if (!dateVal) {
      dateBtn.style.borderColor = '#E8751A'; valid = false;
    } else { dateBtn.style.borderColor = ''; }

    const msg = document.getElementById('tailor-message');
    if (!msg.value.trim()) {
      msg.style.borderColor = '#E8751A'; valid = false;
    } else { msg.style.borderColor = ''; }

    if (!valid) return;

    const submitBtn = document.getElementById('tailor-submit-btn');
    const errEl = document.getElementById('tailor-error');
    errEl.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';

    const enquiryType = document.querySelector('input[name="tailor-type"]:checked')?.value || 'other';
    const urgency = document.querySelector('input[name="tailor-urgency"]:checked')?.value || 'relaxed';
    const budget = (document.getElementById('tailor-budget')?.value || '').trim();

    try {
      const { error } = await db.from('tailor_enquiries').insert({
        partner_email: currentPartner?.email || '',
        partner_name:  currentPartner?.name  || '',
        client_name:   clientName.value.trim(),
        enquiry_type:  enquiryType,
        pax:           parseInt(pax.value),
        date_from:     dateVal,
        budget:        budget || null,
        urgency,
        message:       msg.value.trim(),
      });
      if (error) throw error;

      document.getElementById('tailor-confirm').classList.remove('hidden');
      document.getElementById('tailor-confirm').scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch(e) {
      console.error('[tailor submit]', e);
      errEl.textContent = 'Something went wrong. Please try again.';
      errEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send enquiry';
    }
  }

