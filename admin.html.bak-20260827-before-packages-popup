        <button type="button" onclick="this.parentElement.remove()" class="text-gray-300 hover:text-red-400"><i class="fa-solid fa-xmark text-xs"></i></button>`;
    }
    list.appendChild(div);
  }

  function readManualSlots(prefix, listId) {
    const list = document.getElementById(listId || prefix + '-tour-slots-list');
    if (!list) return [];
    return Array.from(list.querySelectorAll('.flex.items-center')).map((row, i) => {
      const time = row.querySelector('.manual-slot-time')?.value || '';
      const label = row.querySelector('.manual-slot-label')?.value.trim() || '';
      if (!time) return null;
      return { id: 'slot_' + i, time, label: label || time };
    }).filter(Boolean);
  }

  async function saveAddTour() {
    const title = document.getElementById('add-tour-title').value.trim();
    if (!title) { showToast('Tour name is required.', 'error'); return; }
    const allowHotelPickup  = document.getElementById('add-tour-allow-hotel-pickup').checked;
    const allowMeetingPoint = document.getElementById('add-tour-allow-meeting-point').checked;
    const meetingPoint = document.getElementById('add-tour-meeting-point').value.trim() || null;
    if (allowMeetingPoint && !meetingPoint) { showToast('Please enter a meeting point address.', 'error'); return; }
    const description  = document.getElementById('add-tour-description').value.trim() || null;
    const bokunId      = parseInt(document.getElementById('add-tour-bokun-id').value) || null;
    const requireGuestNames = document.getElementById('add-tour-require-guest-names').checked;
    const pricingType  = document.getElementById('add-tour-pricing-type')?.value || 'per_person';
    const groups       = [...document.querySelectorAll('#add-tour-groups-wrap .tg-group-cb:checked')].map(cb => cb.value);
    const categories   = [...document.querySelectorAll('#add-tour-categories-wrap .atc-cat-cb:checked')].map(cb => cb.value);
    const manualSlots  = readManualSlots('add');
    const cutoffHours  = parseInt(document.getElementById('add-tour-cutoff-hours').value) || null;
    const slotCapacity = parseInt(document.getElementById('add-tour-slot-capacity').value) || null;
    const maxOrder     = allTourConfig.reduce((m, t) => Math.max(m, t.sort_order || 0), 0);
    const { data, error } = await db.from('tour_config').insert({
      title,
      description,
      bokun_id: bokunId,
      photo_url: _addTourPhotoUrl,
      pricing_type: pricingType,
      sort_order: maxOrder + 10,
      active: true,
      allow_hotel_pickup: allowHotelPickup,
      allow_meeting_point: allowMeetingPoint,
      meeting_point: meetingPoint,
      require_guest_names: requireGuestNames,
      groups,
      categories,
      manual_slots: manualSlots.length ? manualSlots : null,
      booking_cutoff_hours: cutoffHours,
      slot_capacity: slotCapacity,
    }).select().single();
    if (error) { showToast('Failed to add tour.', 'error', error.message); return; }
    allTourConfig.push(data);
    renderTourConfigTable();
    document.getElementById('modal-add-tour').classList.add('hidden');
    showToast('Tour added.');
    logActivity('tour_added', `Tour "${title}" added (manual)`, data.id);
    if (bokunId) refreshBokunPricingCategories();
  }

