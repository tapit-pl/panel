async function abFetchAvailabilityForMonth() {
  if (!abCurrentTour?.bokunId) {
    // Non-Bokun: fill all future days with manual slots, respecting per-day overrides
    const baseSlots = abCurrentTour.manualSlots?.length
      ? abCurrentTour.manualSlots.map(s => ({ startTime: s.time, startTimeId: String(s.id || s.time || 'manual') }))
      : [{ startTime: null, startTimeId: 'manual' }];
    const today = new Date().toISOString().slice(0,10);
    const m = abCurrentMonth;
    const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
    const mStart = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-01`;
    const mEnd = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(daysInMonth).padStart(2,'0')}`;
    let overrideMap = new Map();
    let bookedMap = new Map();
    try {
      const [{ data: overrideRows }, bm] = await Promise.all([
        db.from('tour_slot_overrides').select('slot_date,start_time_id,max_guests,disabled')
          .eq('tour_config_id', abCurrentTour.configId).gte('slot_date', mStart).lte('slot_date', mEnd),
        fetchSlotBookedMap(abCurrentTour.dbTitle || abCurrentTour.title, mStart, mEnd)
      ]);
      overrideMap = new Map((overrideRows || []).map(o => [`${o.slot_date}|${o.start_time_id}`, o]));
      bookedMap = bm;
    } catch(e) { /* silent */ }
    for (let d = 1; d <= daysInMonth; d++) {
      const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      if (ds < today) continue;
      abAvailability[ds] = baseSlots
        .filter(s => !overrideMap.get(`${ds}|${s.startTimeId}`)?.disabled)
        .map(s => {
          const ov = overrideMap.get(`${ds}|${s.startTimeId}`);
          const cap = ov?.max_guests != null ? ov.max_guests : (abCurrentTour.maxPax ?? null);
          let cnt = null;
          if (cap != null) {
            const alreadyBooked = bookedMap.get(`${ds}|${s.startTimeId}`) || 0;
            cnt = Math.max(0, cap - alreadyBooked);
          }
          return { ...s, availabilityCount: cnt };
        });
    }
    abRenderCalendar();
    return;
  }
  document.getElementById('ab-cal-loading').classList.remove('hidden');
  try {
    const m = abCurrentMonth;
    const start = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-01`;
    const lastDay = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
    const end = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${lastDay}`;
    const [{ data: res }, { data: overrideRows }, bookedMap] = await Promise.all([
      invokeEdge('bokun-sync', { body: { path: `/activity.json/${abCurrentTour.bokunId}/availabilities?start=${start}&end=${end}`, method: 'GET' } }),
      db.from('tour_slot_overrides').select('slot_date,start_time_id,max_guests,disabled')
        .eq('tour_config_id', abCurrentTour.configId).gte('slot_date', start).lte('slot_date', end),
      fetchSlotBookedMap(abCurrentTour.dbTitle || abCurrentTour.title, start, end)
    ]);
    const overrideMap = new Map((overrideRows || []).map(o => [`${o.slot_date}|${o.start_time_id}`, o]));
    const items = res?.body;
    if (Array.isArray(items) && items.length > 0) {
      items.forEach(entry => {
        if (entry.unavailable || entry.soldOut) return;
        const ds = new Date(entry.date).toISOString().slice(0, 10);
        if (!ds) return;
        const ov = overrideMap.get(`${ds}|${entry.startTimeId}`);
        if (ov?.disabled) return;
        if (!abAvailability[ds]) abAvailability[ds] = [];
        const rates = (entry.rates || []).map(r => {
          const priceInfo = (entry.pricesByRate || []).find(p => p.activityRateId === r.id);
          const cats = priceInfo?.pricePerCategoryUnit || [];
          return {
            id: r.id,
            title: r.title.trim(),
            price: cats[0]?.amount,
            pricesByCategory: cats,
          };
        });
        let availabilityCount = entry.availabilityCount || 0;
        if (ov?.max_guests != null) {
          const alreadyBooked = bookedMap.get(`${ds}|${entry.startTimeId}`) || 0;
          const remainingUnderCap = Math.max(0, ov.max_guests - alreadyBooked);
          availabilityCount = Math.min(availabilityCount, remainingUnderCap);
        }
        abAvailability[ds].push({
          startTime: entry.startTime || '',
          startTimeId: entry.startTimeId,
          startTimeStr: entry.startTimeStr || '',
          availabilityCount,
          rates,
        });
      });
    }
  } catch(e) { /* silent */ }
  document.getElementById('ab-cal-loading').classList.add('hidden');
  abRenderCalendar();
}

function abRenderCalendar() {
  const m = abCurrentMonth;
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('ab-month-label').textContent = `${months[m.getMonth()]} ${m.getFullYear()}`;
  const today = new Date().toISOString().slice(0,10);
  const startDow = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
  const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();

  const DOW = ['Mo','Tu','We','Th','Fr','Sa','Su'];
  const G = 'display:grid;grid-template-columns:repeat(7,1fr);';
  let html = `<div style="${G}margin-bottom:4px;">
    ${DOW.map(d => `<div style="text-align:center;font-size:11px;color:#9ca3af;font-weight:600;padding:4px 0;">${d}</div>`).join('')}
  </div>
  <div style="${G}gap:2px;">`;

  for (let i = 0; i < startDow; i++) html += '<div></div>';
  for (let d = 1; d <= daysInMonth; d++) {
    const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const avail = abAvailability[ds];
    const isPast = ds < today;
    const isSelected = ds === abSelectedDate;
    let style, onclick = '';
    if (isSelected) {
      style = 'background:#E8751A;color:#fff;font-weight:700;border-radius:8px;cursor:pointer;';
      onclick = `onclick="abSelectDate('${ds}')"`;
    } else if (avail && !isPast) {
      style = 'background:#dcfce7;color:#166534;font-weight:700;border-radius:8px;cursor:pointer;';
      onclick = `onclick="abSelectDate('${ds}')" onmouseenter="this.style.background='#bbf7d0'" onmouseleave="this.style.background='#dcfce7'"`;
    } else if (isPast) {
      style = 'color:#d1d5db;cursor:not-allowed;';
    } else {
      style = 'color:#9ca3af;cursor:default;';
    }
    html += `<div style="text-align:center;font-size:12px;padding:5px 2px;transition:background .15s;${style}" ${onclick}>${d}</div>`;
  }
  html += `</div>
  <div style="display:flex;align-items:center;gap:16px;margin-top:12px;font-size:11px;color:#6b7280;">
    <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:3px;background:#dcfce7;display:inline-block;"></span>Available</span>
    <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:3px;background:#f3f4f6;display:inline-block;"></span>No tours</span>
  </div>`;
  document.getElementById('ab-calendar-grid').innerHTML = html;
}

function abPrevMonth() {
