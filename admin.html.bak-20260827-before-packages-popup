let cpeServices = [];

function addCpeService() {
  cpeServices.push({ name: '', net: 0, vat: 23, gross: 0, margin_net: 0, margin_vat: 23, margin_gross: 0 });
  renderCpeServiceRows();
  recalcCpeTotals();
}
function removeCpeService(idx) {
  cpeServices.splice(idx, 1);
  renderCpeServiceRows();
  recalcCpeTotals();
}
function updateCpeService(idx, field, val) {
  if (!cpeServices[idx]) return;
  if (field === 'name') { cpeServices[idx].name = val; return; }
  cpeServices[idx][field] = parseFloat(val) || 0;
  cpeServices[idx].gross = parseFloat((cpeServices[idx].net * (1 + cpeServices[idx].vat / 100)).toFixed(2));
  const el = document.getElementById('cpe-gross-' + idx);
  if (el) el.textContent = fmtPln(cpeServices[idx].gross);
  recalcCpeTotals();
}
function renderCpeServiceRows() {
  const container = document.getElementById('cpe-services-list');
  if (!container) return;
  if (!cpeServices.length) { container.innerHTML = '<p class="text-xs text-center py-3" style="color:#64748b">No services yet.</p>'; return; }
  const fieldStyle = 'background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);color:#e2e8f0';
  container.innerHTML = cpeServices.map((s, i) => `
    <div class="mb-2 p-3 rounded-xl" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08)">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <input type="text" value="${escapeHtml(s.name)}" placeholder="Service name" oninput="updateCpeService(${i},'name',this.value)"
          class="w-full text-xs rounded-lg px-2 py-1.5 focus:outline-none" style="${fieldStyle}">
        <button onclick="removeCpeService(${i})" type="button" tabindex="-1" style="flex-shrink:0;width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:8px;color:#f87171;background:none;border:none;cursor:pointer"><i class="fa-solid fa-xmark text-xs"></i></button>
      </div>
      <div style="display:grid;grid-template-columns:1fr 70px 1fr;gap:8px">
        <div><div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:3px">Net</div>
          <input type="number" value="${s.net || ''}" placeholder="0.00" step="0.01" oninput="updateCpeService(${i},'net',this.value)" class="w-full text-xs rounded-lg px-2 py-1.5 font-mono text-right focus:outline-none" style="${fieldStyle}"></div>
        <div><div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:3px">VAT %</div>
          <input type="number" value="${s.vat}" placeholder="23" step="1" oninput="updateCpeService(${i},'vat',this.value)" class="w-full text-xs rounded-lg px-2 py-1.5 font-mono text-right focus:outline-none" style="${fieldStyle}"></div>
        <div><div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:3px">Gross</div>
          <div class="text-xs font-mono" id="cpe-gross-${i}" style="padding:7px 4px;color:#94a3b8">${fmtPln(s.gross)}</div></div>
      </div>
    </div>`).join('');
}
function recalcCpeTotals() {
  const totalNet = cpeServices.reduce((s, x) => s + (x.net || 0), 0);
  const totalGross = cpeServices.reduce((s, x) => s + (x.gross || 0), 0);
  const totalMarginGross = cpeServices.reduce((s, x) => s + (x.margin_gross ?? x.margin ?? 0), 0);
  const guestPrice = totalGross + totalMarginGross;
  const commRate = parseFloat(document.getElementById('cpe-commission-rate')?.value) || 0;
  const commAmount = totalMarginGross * commRate / 100;
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  set('cpe-total-net', fmtPln(totalNet)); set('cpe-total-gross', fmtPln(totalGross));
  set('cpe-total-margin', fmtPln(totalMarginGross)); set('cpe-guest-price', fmtPln(guestPrice));
  set('cpe-commission-amount', fmtPln(commAmount));
}

function cpeOnPaymentMethodChange(val, isUserChange) {
  if (isUserChange && val === 'stripe') {
    const s = document.getElementById('cpe-status');
    if (s) s.value = 'pending';
  }
  const bankEl = document.getElementById('cpe-bank-fields');
  if (bankEl) bankEl.classList.toggle('hidden', val !== 'bank_transfer');
  if (val === 'bank_transfer') {
    const isAdmin = currentAdminRole === 'admin';
    ['cpe-bt-bank','cpe-bt-account'].forEach(id => {
      const inp = document.getElementById(id);
      if (!inp) return;
      inp.readOnly = !isAdmin;
      inp.style.opacity = isAdmin ? '' : '0.5';
      inp.style.cursor = isAdmin ? '' : 'not-allowed';
      inp.title = isAdmin ? '' : 'Only admin can change bank details';
    });
  }
}

function openCpEdit(id) {
  const p = cpData.find(x => x.id === id);
  if (!p) return;
  closeCpDetail();
  cpeServices = JSON.parse(JSON.stringify(p.services || []));

  const cpStatusLabels = { pending: 'Pending', paid: 'Paid', cancelled: 'Cancelled' };
