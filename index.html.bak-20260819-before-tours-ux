  function navTailorCal(dir, e) {
    e.stopPropagation();
    _tailorCalMonth += dir;
    if (_tailorCalMonth > 11) { _tailorCalMonth = 0; _tailorCalYear++; }
    if (_tailorCalMonth < 0)  { _tailorCalMonth = 11; _tailorCalYear--; }
    renderTailorCal();
  }

  function renderTailorCal() {
    const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const today = new Date();
    const todayY = today.getFullYear(), todayM = today.getMonth(), todayD = today.getDate();
    const y = _tailorCalYear, m = _tailorCalMonth;
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const firstDay = (new Date(y, m, 1).getDay() + 6) % 7;
    const isPrevDisabled = (y === todayY && m === todayM);
    const selected = document.getElementById('tailor-date-from').value;

    const days = Array.from({length: daysInMonth}, (_, i) => {
      const d = i + 1;
      const dateStr = y + '-' + String(m+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
      const isPast = (y < todayY) || (y === todayY && m < todayM) || (y === todayY && m === todayM && d < todayD);
      const isSelected = dateStr === selected;
      let cls;
      if (isPast)         cls = 'text-gray-300 cursor-not-allowed';
      else if (isSelected) cls = 'rounded-lg font-bold cursor-pointer text-white bg-brand';
      else                 cls = 'text-gray-700 rounded-lg cursor-pointer hover:bg-orange-50 hover:text-brand';
      return `<div class="text-center text-xs py-1.5 transition-colors ${cls}" ${isPast ? '' : `onclick="selectTailorDate('${dateStr}')"`}>${d}</div>`;
    }).join('');

    document.getElementById('tailor-cal-inner').innerHTML = `
      <div class="border border-gray-200 rounded-2xl overflow-hidden bg-white shadow-lg">
        <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-100">
          <button type="button" onclick="navTailorCal(-1,event)" ${isPrevDisabled ? 'disabled' : ''}
            class="w-7 h-7 flex items-center justify-center rounded-lg transition-colors ${isPrevDisabled ? 'text-gray-300 cursor-not-allowed' : 'hover:bg-gray-200 text-gray-600'}">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </button>
          <span class="text-xs font-bold text-dark">${monthNames[m]} ${y}</span>
          <button type="button" onclick="navTailorCal(1,event)"
            class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-200 text-gray-600 transition-colors">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </button>
        </div>
        <div class="p-3">
          <div class="grid grid-cols-7 mb-1">
            ${['Mo','Tu','We','Th','Fr','Sa','Su'].map(d => `<div class="text-center text-xs text-gray-400 font-semibold py-1">${d}</div>`).join('')}
          </div>
          <div class="grid grid-cols-7 gap-0.5">
            ${'<div></div>'.repeat(firstDay)}
            ${days}
          </div>
        </div>
      </div>`;
  }

