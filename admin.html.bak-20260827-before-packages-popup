  async function deletePartner() {
    if (currentAdminRole !== 'admin') { showToast('Admin role required.', 'error'); return; }
    const p = allPartners.find(x => x.id === editingPartnerId);
    if (!p) return;
    if (!await showConfirm(`Are you sure you want to permanently delete "${p.name}"? This cannot be undone.`, { okLabel: 'Delete permanently' })) return;

    if (p.email) {
      const { error: delErr } = await invokeEdge('delete-partner', { body: { email: p.email } });
      if (delErr) {
        let msg = delErr.message;
        try { const b = await delErr.context?.json?.(); if (b?.error) msg = b.error; } catch {}
        console.error('[deletePartner] edge function error:', msg);
        showToast('Delete failed: ' + msg, 'error');
        return;
      }
    }

    const idx = allPartners.findIndex(x => x.id === editingPartnerId);
    if (idx !== -1) allPartners.splice(idx, 1);
    renderPartnersTable();
    closePartnerDetail();
    showToast('Partner deleted.');
    await logActivity('partner_deleted', `Partner "${p.name}" (${p.email}) permanently deleted`, editingPartnerId);
    await loadPartners();
  }

  function renderContractStatus(expiryStr) {
    const el = document.getElementById('pd-contract-status');
    if (!expiryStr) { el.classList.add('hidden'); return; }
    const expiry = new Date(expiryStr);
    const today  = new Date();
    const days   = Math.round((expiry - today) / 86400000);
    el.classList.remove('hidden');
    if (days < 0) {
      el.className = 'text-xs rounded-xl px-3 py-2 bg-red-50 text-red-600 font-medium';
      el.textContent = '⚠️ Contract expired ' + Math.abs(days) + ' days ago';
    } else if (days <= 60) {
      el.className = 'text-xs rounded-xl px-3 py-2 bg-yellow-50 text-yellow-700 font-medium';
      el.textContent = '⏳ Expires in ' + days + ' days — renewal needed';
    } else {
      el.className = 'text-xs rounded-xl px-3 py-2 bg-green-50 text-green-700 font-medium';
      el.textContent = '✅ Valid for ' + days + ' more days';
    }
  }

