  async function adminResendPaymentLink(bookingId) {
    const b = allBookings.find(x => x.id === bookingId);
    if (!b) return;
    const btn = document.querySelector(`button[onclick="adminResendPaymentLink('${bookingId}')"]`);
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i>'; }
    try {
      // Guard against double-charge: check current status from DB before creating new session
      const { data: fresh } = await db.from('bookings').select('status').eq('id', bookingId).single();
      const freshStatus = (fresh?.status || '').toLowerCase();
      if (['paid', 'confirmed', 'arrived'].includes(freshStatus)) {
        showToast('This booking has already been paid — link not resent.');
        const bIdx = allBookings.findIndex(x => x.id === bookingId);
        if (bIdx !== -1) allBookings[bIdx].status = fresh.status;
        return;
      }

      const { data: stripeRes, error: stripeErr } = await invokeEdge('create-stripe-session', {
        body: { booking_id: b.id, bokun_reservation_code: b._bokunCode || b.id, amount_pln: b.total || 0, pax: b.pax || 1, tour_name: b.tour, date: b.date, guest_name: b.guest, guest_email: b.email || null }
      });
      if (stripeErr || !stripeRes?.session_url) throw new Error(stripeErr?.message || 'No session URL');
      await db.from('bookings').update({ stripe_session_id: stripeRes.session_id, stripe_session_url: stripeRes.session_url }).eq('id', bookingId);
      if (!b.email) {
        await navigator.clipboard.writeText(stripeRes.session_url).catch(() => {});
        showToast('Payment link copied to clipboard');
      } else {
        showToast('Payment link resent to ' + b.email);
      }
      logActivity('booking_payment_link_resent', `Payment link resent for booking ${b._bokunCode || b.bokun_confirmation_code || b.id} (${b.guest})`, b.id).catch(() => {});
    } catch(e) {
      console.error('[adminResendPaymentLink]', e.message);
      const t = document.createElement('div');
      t.className = 'fixed bottom-6 right-6 z-50 bg-red-500 text-white text-sm font-semibold px-5 py-3.5 rounded-xl shadow-xl flex items-center gap-2';
      t.innerHTML = '<i class="fa-solid fa-xmark"></i> Failed to resend — check console';
      document.body.appendChild(t); setTimeout(() => t.remove(), 4000);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = `<i class="fa-solid fa-${b.email ? 'paper-plane' : 'copy'} text-xs"></i>`; }
    }
  }

