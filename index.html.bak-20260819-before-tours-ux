  async function loadChartData(year, month) {
    const days = new Date(year, month + 1, 0).getDate();
    const pad = n => String(n).padStart(2,'0');
    const from = `${year}-${pad(month+1)}-01`;
    const to   = `${year}-${pad(month+1)}-${pad(days)}`;
    const partnerId = currentPartner?.id;
    if (!partnerId) return null;
    const { data: rows } = await db.from('bookings')
      .select('date, total, comm, status')
      .eq('partner_id', partnerId)
      .gte('date', from).lte('date', to)
      .in('status', ['confirmed', 'paid', 'arrived', 'no_show']);
    const salesByDay = {}, commByDay = {};
    for (let d = 1; d <= days; d++) { salesByDay[d] = 0; commByDay[d] = 0; }
    let maxComm = 0;
    for (const b of rows || []) {
      const d = parseInt((b.date || '').split('-')[2], 10);
      const isNoShow = (b.status || '').toLowerCase() === 'no_show';
      if (d) { salesByDay[d] += b.total || 0; commByDay[d] += isNoShow ? 0 : (b.comm || 0); }
      const commVal = isNoShow ? 0 : (b.comm || 0);
      if (commVal > maxComm) maxComm = commVal;
    }
    const labels = [], sales = [], commissions = [];
    for (let d = 1; d <= days; d++) { labels.push(d); sales.push(salesByDay[d]); commissions.push(commByDay[d]); }
    return { labels, sales, commissions, maxComm };
  }

