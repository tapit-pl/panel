  async function moveTourToPosition(id, rawPos) {
    if (!editingUnlocked) return;
    // Build same display order as renderTourConfigTable
    const sorted = [...allTourConfig].sort((a, b) => {
      if (b.active !== a.active) return b.active ? 1 : -1;
      return (a.sort_order || 0) - (b.sort_order || 0);
    });
    const targetPos = Math.max(1, Math.min(parseInt(rawPos) || 1, sorted.length));
    const fromIdx = sorted.findIndex(t => t.id === id);
    if (fromIdx === -1 || fromIdx === targetPos - 1) return;
    const [moved] = sorted.splice(fromIdx, 1);
    sorted.splice(targetPos - 1, 0, moved);
    sorted.forEach((t, i) => { t.sort_order = (i + 1) * 10; });
    sorted.forEach(st => {
      const tc = allTourConfig.find(t => t.id === st.id);
      if (tc) tc.sort_order = st.sort_order;
    });
    await Promise.all(sorted.map(t => db.from('tour_config').update({ sort_order: t.sort_order }).eq('id', t.id)));
    renderTourConfigTable();
  }

  function _allTourGroupNames() {
    const fromTours = allTourConfig.flatMap(t => t.groups || []);
    const pending = window._pendingTourGroups || [];
    return [...new Set([...fromTours, ...pending])].sort();
  }

  function renderTourGroupsSection() {
    const wrap = document.getElementById('tour-groups-list');
    if (!wrap) return;
    const allGroups = _allTourGroupNames();
    if (allGroups.length === 0) {
      wrap.innerHTML = '<span class="text-xs text-gray-400 italic">No groups yet — add one below.</span>';
      return;
    }
    const pending = new Set(window._pendingTourGroups || []);
    const fromTours = new Set(allTourConfig.flatMap(t => t.groups || []));
    const locked = currentAdminRole === 'staff' || !editingUnlocked;
    wrap.innerHTML = allGroups.map(g => {
      const isPending = pending.has(g) && !fromTours.has(g);
      return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium ${isPending ? 'bg-gray-100 text-gray-400' : groupColor(g)}">
        ${escapeHtml(g)}${isPending ? ' <span class="text-gray-300 text-xs">(pending)</span>' : ''}
        ${!isPending ? `<button title="Rename" onclick="startRenameTourGroup('${escapeHtml(g)}')" ${locked ? 'disabled' : ''} class="ml-0.5 text-gray-500 hover:text-gray-700 ${locked ? 'pointer-events-none opacity-50' : ''}">✏</button>
