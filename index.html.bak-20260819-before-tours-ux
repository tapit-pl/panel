  function countUnreadTickets() {
    return partnerTickets.filter(t => {
      const adminMsgs = (t.support_messages || []).filter(m => m.sender_type === 'admin');
      if (!adminMsgs.length) return false;
      const latestAt = Math.max(...adminMsgs.map(m => new Date(m.created_at).getTime()));
      const readAt   = partnerReadMap[t.id] ? new Date(partnerReadMap[t.id]).getTime() : 0;
      return latestAt > readAt;
    }).length;
  }

  async function loadPartnerTickets() {
    if (!currentPartner?.email) return;
    const { data } = await db.from('support_tickets')
      .select('id, subject, category, priority, status, created_at, updated_at, support_messages(id, sender_type, created_at)')
      .eq('partner_email', currentPartner.email)
      .order('updated_at', { ascending: false });
    partnerTickets = data || [];

    const ticketIds = partnerTickets.map(t => t.id);
    if (ticketIds.length > 0) {
      const { data: reads } = await db.from('support_reads')
        .select('ticket_id, last_read_at')
        .eq('user_email', currentPartner.email)
        .in('ticket_id', ticketIds);
      partnerReadMap = {};
      (reads || []).forEach(r => { partnerReadMap[r.ticket_id] = r.last_read_at; });
    }

    showHelpBadge(countUnreadTickets());
    renderPartnerTickets();
    const wrap = document.getElementById('support-tab-form-wrap');
