  // ===== HOTEL BOOKINGS =====
  let partnerBookings = [];
  let _hbLoaded = false;
  let _hbFiltered = [];
  let _hbPage = 0;
  const HB_PER_PAGE = 50;

  async function loadHotelBookings() {
    _hbLoaded = true;
    const sub = document.getElementById('hb-subtitle');
    if (sub) sub.textContent = 'Loading…';

    const { data: rows, error } = await db.from('bookings').select('*')
      .or('partner_id.not.is.null,source.eq.admin')
      .order('created_at', { ascending: false })
      .limit(50000);

    if (error) { if (sub) sub.textContent = 'Error loading bookings'; return; }

    partnerBookings = (rows || []).map(b => {
      const partner = allPartners.find(p => p.id === b.partner_id);
      const dateFormatted = b.date ? new Date(b.date + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      return {
        id: b.id, displayId: b.bokun_confirmation_code || b.id, tour: b.tour || '', guest: b.guest || '',
        email: b.email, phone: b.phone, hotel: partner?.name || b.created_by_name || (b.source === 'admin' ? 'Admin' : '—'), date: dateFormatted, time: b.time,
        pickup: b.pickup, language: b.language || '', pax: b.pax, total: b.total || 0, currency: b.currency || 'PLN',
        comm: b.comm, source: b.source === 'admin' ? 'Admin' : 'Partner Panel', status: b.status, notes: b.notes || '',
        additional_guests: b.additional_guests || '', payment_method: b.payment_method || '',
        package_lines: b.package_lines || null,
        _dbBooking: true, _stripeSessionId: b.stripe_session_id, _bokunCode: b.bokun_confirmation_code,
        _bokunBookingId: b.bokun_booking_id || null, _paymentType: b.payment_type || null,
        _creationTs: b.created_at ? new Date(b.created_at).getTime() : 0,
        _startTs: b.date ? new Date(b.date).getTime() : 0,
      };
    });

    // Populate msel filters
    const hbTours = [...new Set(partnerBookings.map(b => b.tour).filter(Boolean))].sort();
    mselSetOptions('msel-hb-tour', hbTours.map(t => ({value: t, label: t})));
    const hbHotels = [...new Set(partnerBookings.map(b => b.hotel).filter(h => h && h !== '—'))].sort();
    mselSetOptions('msel-hb-hotel', hbHotels.map(h => ({value: h, label: h})));

    filterHotelBookings();
  }

  function setHbView(view) {
    currentHbView = view;
    const recentBtn   = document.getElementById('hb-view-recent-btn');
    const upcomingBtn = document.getElementById('hb-view-upcoming-btn');
    if (recentBtn && upcomingBtn) {
      recentBtn.className   = view === 'recent'   ? 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-dark transition-all' : 'px-3 py-1.5 rounded-lg text-gray-400 transition-all';
      upcomingBtn.className = view === 'upcoming' ? 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-dark transition-all' : 'px-3 py-1.5 rounded-lg text-gray-400 transition-all';
    }
    const upcomingDate = view === 'upcoming' ? new Date().toISOString().slice(0, 10) : '';
    if (upcomingDate) dpopPick('hb-filter-from', upcomingDate);
    else dpopClear('hb-filter-from', true);
    if (view === 'recent') {
      partnerBookings.sort((a, b) => (b._creationTs || 0) - (a._creationTs || 0));
    } else {
      partnerBookings.sort((a, b) => (a._startTs || 0) - (b._startTs || 0));
    }
    filterHotelBookings();
  }

  function filterHotelBookings() {
    const q       = (document.getElementById('hb-search')?.value || '').toLowerCase();
    const hotels  = mselGetVals('msel-hb-hotel');
    const statuses = mselGetVals('msel-hb-status');
    const tours   = mselGetVals('msel-hb-tour');
    const fromVal = document.getElementById('hb-filter-from')?.value || '';
    const toVal   = document.getElementById('hb-filter-to')?.value || '';
    const fromTs  = fromVal ? new Date(fromVal).setHours(0,0,0,0) : null;
    const toTs    = toVal   ? new Date(toVal).setHours(23,59,59,999) : null;
    const cFromVal = document.getElementById('hb-filter-created-from')?.value || '';
    const cToVal   = document.getElementById('hb-filter-created-to')?.value || '';
    const cFromTs  = cFromVal ? new Date(cFromVal).setHours(0,0,0,0) : null;
    const cToTs    = cToVal   ? new Date(cToVal).setHours(23,59,59,999) : null;

    _hbFiltered = partnerBookings.filter(b => {
      const matchQ      = !q        || b.tour.toLowerCase().includes(q) || b.guest.toLowerCase().includes(q) || String(b.id).toLowerCase().includes(q) || (b.phone || '').toLowerCase().includes(q) || (b.email || '').toLowerCase().includes(q) || (b.displayId || '').toLowerCase().includes(q);
      const matchHotel  = hotels.length === 0  || hotels.includes(b.hotel);
      const matchStatus = statuses.length === 0 || statuses.some(s => (STATUS_GROUPS[s] || [s]).includes((b.status||'').toLowerCase()));
      const matchTour   = tours.length === 0   || tours.includes(b.tour);
      const matchFrom   = !fromTs  || b._startTs >= fromTs;
      const matchTo     = !toTs    || b._startTs <= toTs;
      const matchCFrom  = !cFromTs || b._creationTs >= cFromTs;
      const matchCTo    = !cToTs   || b._creationTs <= cToTs;
      return matchQ && matchHotel && matchStatus && matchTour && matchFrom && matchTo && matchCFrom && matchCTo;
    });
    _hbPage = 0;
    renderHotelBookingsPage();
  }

  function changeHbPage(delta) {
    const maxPage = Math.ceil(_hbFiltered.length / HB_PER_PAGE) - 1;
    _hbPage = Math.max(0, Math.min(_hbPage + delta, maxPage));
    renderHotelBookingsPage();
  }

  function renderHotelBookingsPage() {
    const start = _hbPage * HB_PER_PAGE;
    const page  = _hbFiltered.slice(start, start + HB_PER_PAGE);
