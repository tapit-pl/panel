  async function tsaSaveSlotOverride() {
    if (!tsaCurrentTour || !tsaSelectedSlot || !tsaSelectedDate) return;
    const disabled = document.getElementById('tsa-disable-cb').checked;
    const input = document.getElementById('tsa-max-guests-input');
    const liveCount = tsaSelectedSlot.availabilityCount; // null = no configured ceiling
    const key = `${tsaSelectedDate}|${tsaSelectedSlot.startTimeId}`;
    const existing = tsaOverrides.get(key);
    const _tsaT = tsaSelectedSlot.startTime || '';
    const tsaTimeStr = _tsaT ? (_tsaT.length > 8 ? _tsaT.slice(11,16) : _tsaT.slice(0,5)) : 'Flexible time';
    const _tsaUniqueRates = (tsaSelectedSlot.rates || []).filter((r,idx,a) => a.findIndex(x=>x.id===r.id)===idx);
    const _tsaSlotLang = _tsaUniqueRates.length === 1
      ? (LANGUAGE_KEYWORDS.find(l => (_tsaUniqueRates[0].title||'').toLowerCase().includes(l.toLowerCase())) || null)
      : null;
    const tsaTimeLabel = tsaTimeStr + (_tsaSlotLang ? ' · ' + _tsaSlotLang : '');
    const tsaLogPrefix = `Tour "${tsaCurrentTour.title}" — ${tsaSelectedDate} ${tsaTimeStr}`;

    if (!disabled) {
      const raw = input.value.trim();
      if (raw === '') {
        if (existing) {
          const { error } = await db.from('tour_slot_overrides').delete().eq('id', existing.id);
          if (error) { showToast('Failed to remove availability override.', 'error', error.message); return; }
          tsaOverrides.delete(key);
          showToast('Override removed — slot follows default availability.');
          logActivity('tour_slot_override_saved', `${tsaLogPrefix}: override removed`, tsaCurrentTour.id).catch(() => {});
        } else {
          showToast('No changes to save.');
        }
        tsaRenderCalendar(); tsaSelectDate(tsaSelectedDate); renderTourOverridesOverview();
        return;
      }
      const maxGuests = parseInt(raw, 10);
      if (isNaN(maxGuests) || maxGuests < 1) { showToast('Enter a valid number of guests.', 'error'); return; }
      if (liveCount != null && maxGuests > liveCount) {
        const msg = tsaCurrentTour.bokun_id ? `Cannot exceed Bokun's live availability (${liveCount}).` : `Cannot exceed this tour's configured max guests (${liveCount}).`;
        showToast(msg, 'error'); return;
      }
      const alreadyBooked = tsaBookedMap.get(key) || 0;
      const row = { tour_config_id: tsaCurrentTour.id, slot_date: tsaSelectedDate, start_time_id: String(tsaSelectedSlot.startTimeId), max_guests: maxGuests, disabled: false, start_time_label: tsaTimeLabel };
      const { data, error } = await db.from('tour_slot_overrides')
        .upsert(row, { onConflict: 'tour_config_id,slot_date,start_time_id' }).select().single();
      if (error) { showToast('Failed to save availability override.', 'error', error.message); return; }
      tsaOverrides.set(key, data);
      if (alreadyBooked > maxGuests) {
        showToast(`Saved — but ${alreadyBooked} guests are already booked, above this new limit. No further bookings will be possible for this slot until some are cancelled.`, 'error');
        logActivity('tour_slot_override_saved', `${tsaLogPrefix}: capped at ${maxGuests} (already ${alreadyBooked} booked)`, tsaCurrentTour.id).catch(() => {});
        tsaRenderCalendar(); tsaSelectDate(tsaSelectedDate); renderTourOverridesOverview();
        return;
      }
      showToast('Slot capped for this date.');
      logActivity('tour_slot_override_saved', `${tsaLogPrefix}: capped at ${maxGuests}`, tsaCurrentTour.id).catch(() => {});
    } else {
      const row = { tour_config_id: tsaCurrentTour.id, slot_date: tsaSelectedDate, start_time_id: String(tsaSelectedSlot.startTimeId), max_guests: null, disabled: true, start_time_label: tsaTimeLabel };
      const { data, error } = await db.from('tour_slot_overrides')
        .upsert(row, { onConflict: 'tour_config_id,slot_date,start_time_id' }).select().single();
      if (error) { showToast('Failed to save availability override.', 'error', error.message); return; }
      tsaOverrides.set(key, data);
      showToast('Slot disabled for this date.');
      logActivity('tour_slot_override_saved', `${tsaLogPrefix}: disabled`, tsaCurrentTour.id).catch(() => {});
    }
    tsaRenderCalendar();
    tsaSelectDate(tsaSelectedDate);
    renderTourOverridesOverview();
    document.getElementById('tsa-editor-section').classList.add('hidden');
  }
