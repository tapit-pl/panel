  async function fetchAvailabilityForMonth(tour, year, month) {
    const firstDay = `${year}-${String(month+1).padStart(2,'0')}-01`;
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const lastDay = `${year}-${String(month+1).padStart(2,'0')}-${String(daysInMonth).padStart(2,'0')}`;
    if (tour.bokunId) {
      try {
        const { data: avail } = await db.functions.invoke('bokun-sync', {
          body: { path: `/activity.json/${tour.bokunId}/availabilities?start=${firstDay}&end=${lastDay}`, method: 'GET' }
        });
        const items = avail?.body;
        if (Array.isArray(items) && items.length > 0) {
          items.forEach(entry => {
            if (entry.unavailable || entry.soldOut) return;
            const d = new Date(entry.date).toISOString().slice(0, 10);
            if (!d) return;
            if (!currentTourAvailability[d]) currentTourAvailability[d] = [];
            const rates = (entry.rates || []).map(r => {
              const priceInfo = (entry.pricesByRate || []).find(p => p.activityRateId === r.id);
              const cats = priceInfo?.pricePerCategoryUnit || [];
              return { id: r.id, title: r.title.trim(), price: cats[0]?.amount, pricesByCategory: cats };
            });
            currentTourAvailability[d].push({
              startTime: entry.startTime || '',
              startTimeId: entry.startTimeId,
              availabilityCount: entry.availabilityCount || 0,
              rates,
            });
          });
          return;
        }
      } catch(e) {}
    }
    // non-Bokun tour: all future dates available with manual slots
    if (!tour.bokunId) {
      const manualSlots = tour.manualSlots?.length
        ? tour.manualSlots.map(s => ({ startTime: s.time || null, startTimeId: s.id || 'manual', availabilityCount: null, label: s.label || s.time || '' }))
        : [{ startTime: null, startTimeId: 'manual', availabilityCount: null }];
      const today = new Date().toISOString().slice(0, 10);
      const cur = new Date(firstDay + 'T12:00:00');
      const end = new Date(lastDay + 'T12:00:00');
      while (cur <= end) {
        const d = cur.toISOString().slice(0, 10);
        if (d >= today) currentTourAvailability[d] = manualSlots;
        cur.setDate(cur.getDate() + 1);
      }
    }
  }

  window.navAvCal = async function(btn, year, month, delta) {
    let m = month + delta, y = year;
    if (m > 11) { m = 0; y++; }
