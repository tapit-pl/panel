  // ===================== SUPPORT ATTACHMENTS =====================

  let tdAttachFiles = [];

  function tdHandleFiles() {
    const input = document.getElementById('td-attach-input');
    const newFiles = Array.from(input.files || []);
    input.value = '';
    for (const f of newFiles) {
      if (tdAttachFiles.length >= 3) { showToast('Max 3 attachments per message.', 'error'); break; }
      if (f.size > 5 * 1024 * 1024) { showToast(f.name + ' exceeds 5 MB limit.', 'error'); continue; }
      tdAttachFiles.push(f);
    }
    tdRenderAttachPreview();
  }

  function tdRenderAttachPreview() {
    const wrap = document.getElementById('td-attach-preview');
    if (!wrap) return;
    if (!tdAttachFiles.length) { wrap.innerHTML = ''; wrap.classList.add('hidden'); return; }
    wrap.classList.remove('hidden');
    wrap.innerHTML = tdAttachFiles.map((f, i) =>
      '<div style="display:flex;align-items:center;justify-content:space-between;padding:5px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;font-size:12px">' +
      '<span style="color:#4b5563;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:220px"><i class="fa-solid fa-paperclip" style="margin-right:5px;color:#9ca3af"></i>' + escapeHtml(f.name) + '</span>' +
      '<button onclick="tdRemoveAttach(' + i + ')" style="margin-left:8px;color:#9ca3af;background:none;border:none;cursor:pointer;font-size:13px" title="Remove"><i class="fa-solid fa-xmark"></i></button>' +
      '</div>'
    ).join('');
  }

  function tdRemoveAttach(i) { tdAttachFiles.splice(i, 1); tdRenderAttachPreview(); }

  function tdClearAttachments() {
    tdAttachFiles = [];
    const inp = document.getElementById('td-attach-input'); if (inp) inp.value = '';
    tdRenderAttachPreview();
  }

  async function uploadSupportAttachments(files, ticketId) {
    const results = [];
    for (const file of files) {
      const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
      const path = ticketId + '/' + Date.now() + '_' + safeName;
      const { error } = await db.storage.from('support-attachments').upload(path, file, { upsert: false });
      if (error) { console.error('upload error', error); continue; }
      const { data: urlData } = db.storage.from('support-attachments').getPublicUrl(path);
      results.push({ name: file.name, url: urlData.publicUrl, type: file.type, size: file.size });
    }
    return results;
  }

  function renderAttachmentBubbles(attachments, dark) {
    if (!attachments || !attachments.length) return '';
    return '<div style="margin-top:8px;display:flex;flex-direction:column;gap:6px">' +
      attachments.map(function(a) {
        var isImg = a.type && a.type.startsWith('image/');
        if (isImg) return '<a href="' + escapeHtml(a.url) + '" target="_blank"><img src="' + escapeHtml(a.url) + '" style="max-width:220px;max-height:160px;border-radius:8px;display:block;object-fit:cover"></a>';
        return '<a href="' + escapeHtml(a.url) + '" target="_blank" style="display:inline-flex;align-items:center;gap:6px;font-size:11px;padding:5px 10px;border-radius:8px;text-decoration:none;' + (dark ? 'background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.9)' : 'background:#f1f5f9;color:#374151') + '"><i class="fa-solid fa-paperclip"></i>' + escapeHtml(a.name) + '</a>';
      }).join('') + '</div>';
  }

