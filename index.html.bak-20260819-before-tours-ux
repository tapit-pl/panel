  function fillAndShowVoucher(data) {
    const pad = n => String(n).padStart(2, '0');
    const now = new Date();
    const todayStr = `Kraków, ${pad(now.getDate())}.${pad(now.getMonth()+1)}.${now.getFullYear()}`;

    const hotelName = currentPartner?.name || '—';
    const hotelAddr = (currentPartner?.address && !currentPartner.address.includes('@')) ? currentPartner.address : '';
    const hotelPhone = currentPartner?.phone ? 'tel. ' + currentPartner.phone : '';

    let bookingNr = '—';
    if (data) {
      if (data.bokunConfirmationCode) bookingNr = data.bokunConfirmationCode;
      else if (data.bokunBookingId) bookingNr = 'TM-' + data.bokunBookingId;
      else if (data.bookingId) bookingNr = '#' + data.bookingId.split('-')[0].toUpperCase();
    }

    const guestsList = data?.guestName
      ? [data.guestName, ...(data.extraGuests || [])].map(g => escapeHtml(g)).join('<br>')
      : null;

    const timePart = escapeHtml(data?.time || '');
    const pickupPart = escapeHtml(data?.pickup || '');
    const timePickup = [timePart, pickupPart].filter(Boolean).join('<br>');

    const fields = [
      ['Offer name', escapeHtml(data?.tourName || '—')],
      ...(data?.packageLines ? [['Package', escapeHtml(data.packageLines)]] : []),
