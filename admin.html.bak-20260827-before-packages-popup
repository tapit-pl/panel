async function createSellerOrder(skipCommWarn = false) {
  const packageName = document.getElementById('ord-package-name').value.trim();
  const guestFirstname = document.getElementById('ord-guest-firstname').value.trim();
  const guestSurname = document.getElementById('ord-guest-surname').value.trim();
  const guestName = [guestFirstname, guestSurname].filter(Boolean).join(' ');
  const guestEmail = document.getElementById('ord-guest-email').value.trim();
  const phonePrefix = document.getElementById('ord-phone-prefix')?.value || '+48';
  const phoneNumber = document.getElementById('ord-guest-phone').value.trim();
  const phone = phoneNumber ? (phonePrefix + ' ' + phoneNumber) : '';
  const pax = parseInt(document.getElementById('ord-pax').value) || 1;
  const meetingPoint = document.getElementById('ord-meeting-point').value.trim();
  const date = document.getElementById('ord-date').value;
  const time = document.getElementById('ord-time').value || null;
  const notes = document.getElementById('ord-notes').value.trim() || null;
  const guestNote = document.getElementById('ord-guest-note').value.trim() || null;
  const paymentMethod = document.querySelector('input[name="ord-payment"]:checked')?.value || 'stripe';
  const commRate = parseFloat(document.getElementById('ord-commission-rate').value) || 0;

  const totalNet = parseFloat(cpServices.reduce((s, x) => s + (x.net || 0), 0).toFixed(2));
  const totalGross = parseFloat(cpServices.reduce((s, x) => s + (x.gross || 0), 0).toFixed(2));
  const totalMargin = parseFloat(cpServices.reduce((s, x) => s + (x.margin_gross ?? x.margin ?? 0), 0).toFixed(2));
  const guestPrice = parseFloat((totalGross + totalMargin).toFixed(2));
  const commAmount = parseFloat((totalMargin * commRate / 100).toFixed(2));

  const errEl = document.getElementById('ord-error');
  const showErr = msg => { errEl.textContent = msg; errEl.classList.remove('hidden'); };

  if (!packageName) { showErr('Package name is required.'); return; }
  if (!cpServices.length) { showErr('Add at least one service.'); return; }
  if (!isValidName(guestFirstname)) { showErr('Please enter a valid first name (letters, spaces, hyphens and apostrophes only).'); return; }
  if (!isValidName(guestSurname)) { showErr('Please enter a valid last name (letters, spaces, hyphens and apostrophes only).'); return; }
  if (!guestEmail) { showErr('Email is required.'); return; }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(guestEmail)) { showErr('Enter a valid email address (e.g. jan@example.com).'); return; }
  if (!phoneNumber) { showErr('Phone number is required.'); return; }
  const ordPhoneDigits = phoneNumber.replace(/[\s\-\(\)]/g, '');
  if (!/^\d{7,15}$/.test(ordPhoneDigits)) { showErr('Enter a valid phone number (7–15 digits, without country prefix).'); return; }
  if (!date) { showErr('Date is required.'); return; }
  if (guestPrice <= 0) { showErr('Total guest price must be greater than 0.'); return; }
  if (paymentMethod === 'stripe' && guestPrice < 2) { showErr('Stripe requires a minimum payment of 2 PLN. Increase the price or use cash/bank transfer instead.'); return; }

  if (!skipCommWarn && commRate === 0) {
    document.getElementById('ord-comm-warn').classList.remove('hidden');
    return;
  }
  document.getElementById('ord-comm-warn').classList.add('hidden');
  errEl.classList.add('hidden');
  const btn = document.getElementById('ord-submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin mr-1.5"></i>Processing…';

  const packageId = crypto.randomUUID();

  // 1. Save to custom_packages first
  const { error: dbErr } = await db.from('custom_packages').insert({
    id: packageId,
    package_name: packageName,
    services: cpServices,
    total_net: totalNet,
    total_gross: totalGross,
    total_margin: totalMargin,
    guest_price: guestPrice,
    commission_rate: commRate,
    commission_amount: commAmount,
    guest_name: guestName,
    guest_email: guestEmail || null,
    guest_phone: phone || null,
    pax,
    date: date || null,
    time: time || null,
    meeting_point: meetingPoint || null,
    notes: notes || null,
    guest_note: guestNote,
    payment_method: paymentMethod,
    status: paymentMethod === 'cash' ? 'paid' : 'pending',
    sold_by_email: currentAdminEmail || null,
    sold_by_name: currentAdminName || null,
  });

  if (dbErr) {
    showErr('Error saving package: ' + dbErr.message);
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-check mr-1.5"></i>Create package';
    return;
  }

  // 2. Payment-specific actions
  if (paymentMethod === 'stripe') {
    const { data: stripeRes, error: stripeErr } = await invokeEdge('create-stripe-session', {
      body: { custom_package_id: packageId, pax, tour_name: packageName, date, guest_name: guestName, guest_email: guestEmail }
    });
    if (stripeErr) {
      showErr('Package saved but Stripe error: ' + (stripeErr.message || JSON.stringify(stripeErr)));
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-check mr-1.5"></i>Create package';
      return;
    }
  } else if (paymentMethod === 'bank_transfer') {
    const shortId = 'TM-PKG-' + packageId.split('-')[0].toUpperCase();
    const btBank    = document.getElementById('bt-bank')?.value.trim()    || cpBankDefaults.bank;
    const btAccount = document.getElementById('bt-account')?.value.trim() || cpBankDefaults.account;
    const btTitle   = document.getElementById('bt-title')?.value.trim()   || shortId;
    const btAmount  = guestPrice.toFixed(2) + ' PLN';
    await invokeEdge('send-booking-confirmation', {
      body: {
        booking_id: packageId, tour_name: packageName, date, time,
        guest_name: guestName, guest_email: guestEmail, phone: phone || null,
        pax, total: guestPrice, pickup: meetingPoint || null,
        payment_type: 'bank_transfer',
        email_blocks: [{ name: 'Bank transfer details:', info: `Bank: ${btBank}\nAccount: ${btAccount}\nTitle: ${btTitle}\nAmount: ${btAmount}` }],
        guest_note: guestNote,
      }
    });
  } else if (paymentMethod === 'cash' && guestEmail) {
    await invokeEdge('send-booking-confirmation', {
      body: {
        booking_id: packageId, tour_name: packageName, date, time,
        guest_name: guestName, guest_email: guestEmail, phone: phone || null,
        pax, total: guestPrice, pickup: meetingPoint || null,
        payment_type: 'cash',
        guest_note: guestNote,
      }
    });
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fa-solid fa-check mr-1.5"></i>Create package';
  logActivity('seller_order_created', `Seller package "${packageName}" · ${guestName} · ${pax} pax · ${guestPrice} PLN · ${paymentMethod}`, packageId);
  closeOrderBuilder();
  await loadCustomTours();

  const msgs = {
    stripe: guestEmail ? `Package created! Stripe payment link sent to ${guestEmail}.` : 'Package created!',
    bank_transfer: `Package created! Bank transfer details sent to ${guestEmail}.`,
    cash: guestEmail ? `Package created! Confirmation sent to ${guestEmail}.` : 'Package created!',
  };
  showToast(msgs[paymentMethod] || 'Package created!');
}

function renderCustomTours() {
  const tbody = document.getElementById('custom-tours-tbody');
  const table = document.getElementById('custom-tours-table');
  const empty = document.getElementById('custom-tours-empty');
  document.getElementById('custom-tours-loading').classList.add('hidden');

  const isStaff = currentAdminRole === 'staff';
  const isAdminOrManager = currentAdminRole === 'admin' || currentAdminRole === 'manager';

  // Show/hide UI elements based on role
  const filterWrap = document.getElementById('cp-staff-filter-wrap');
  const exportBtn = document.getElementById('cp-export-btn');
  if (isAdminOrManager) {
    filterWrap?.classList.remove('hidden');
    exportBtn?.classList.remove('hidden');
    exportBtn?.classList.add('flex');
  }

  // Populate staff msel filter (admin/manager only)
  if (isAdminOrManager) {
    const sellers = [...new Set(cpData.map(p => p.sold_by_name).filter(Boolean))].sort();
    mselSetOptions('msel-ct-staff', sellers.map(s => ({value: s, label: s})));
  }

  // Filter data
  let filtered = cpData;
  if (isStaff) {
    filtered = cpData.filter(p => p.sold_by_email === currentAdminEmail);
  } else {
    const selFilter = mselGetVals('msel-ct-staff');
    if (selFilter.length > 0) filtered = filtered.filter(p => selFilter.includes(p.sold_by_name));
  }

  // Apply additional filters
  const ctSearch = (document.getElementById('ct-search')?.value || '').toLowerCase().trim();
  const ctDateFrom = document.getElementById('ct-date-from')?.value || '';
  const ctDateTo   = document.getElementById('ct-date-to')?.value   || '';
  const ctStatus   = mselGetVals('msel-ct-status');
  const ctPayment  = mselGetVals('msel-ct-payment');

  if (ctSearch) {
    filtered = filtered.filter(p => {
      const hay = [p.package_name, p.id, p.guest_name, p.guest_email, p.guest_phone].filter(Boolean).join(' ').toLowerCase();
      return hay.includes(ctSearch);
    });
  }
  if (ctDateFrom) filtered = filtered.filter(p => p.date && p.date >= ctDateFrom);
  if (ctDateTo)   filtered = filtered.filter(p => p.date && p.date <= ctDateTo);
  if (ctStatus.length  > 0) filtered = filtered.filter(p => ctStatus.includes(p.status));
  if (ctPayment.length > 0) filtered = filtered.filter(p => ctPayment.includes(p.payment_method));

  // Staff stats card
  if (isStaff) {
    const statsCard = document.getElementById('cp-my-stats');
    statsCard?.classList.remove('hidden');
    const now = new Date();
    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0,10);
    const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 1).toISOString().slice(0,10);
    const myMonth = filtered.filter(p => (p.status === 'paid' || p.status === 'confirmed' || p.status === 'arrived') && p.created_at >= monthStart && p.created_at < monthEnd);
    const totalVal = myMonth.reduce((s, p) => s + (p.guest_price || 0), 0);
    const totalComm = myMonth.reduce((s, p) => s + (p.commission_amount || 0), 0);
    document.getElementById('cp-stat-count').textContent = myMonth.length;
    document.getElementById('cp-stat-value').textContent = fmtPln(totalVal);
    document.getElementById('cp-stat-comm').textContent = fmtPln(totalComm);
  }

  // Manager stats card — dokładne dane "ten miesiąc", NIE liczone z cpData/filtered
  // (cpData ma limit 200 wierszy łącznie dla wszystkich sprzedawców — mogłoby zaniżać wynik).
  if (currentAdminRole === 'manager') {
    const statsCard = document.getElementById('cp-my-stats');
    statsCard?.classList.remove('hidden');
    const s = cpMyStats || { count: 0, totalVal: 0, totalComm: 0 };
    document.getElementById('cp-stat-count').textContent = s.count;
    document.getElementById('cp-stat-value').textContent = fmtPln(s.totalVal);
    document.getElementById('cp-stat-comm').textContent = fmtPln(s.totalComm);
  }

  if (!filtered.length) {
    table.classList.add('hidden');
    empty.classList.remove('hidden');
    const hasFilters = ctSearch || ctDateFrom || ctDateTo || ctStatus.length || ctPayment.length;
    const iconEl   = document.getElementById('ct-empty-icon');
    const iconI    = document.getElementById('ct-empty-icon-i');
    const titleEl  = document.getElementById('ct-empty-title');
    const subEl    = document.getElementById('ct-empty-sub');
    const actionEl = document.getElementById('ct-empty-action');
    if (hasFilters) {
      if (iconEl)   { iconEl.style.background = 'rgba(100,116,139,0.12)'; iconEl.style.border = '1px solid rgba(100,116,139,0.2)'; }
      if (iconI)    { iconI.className = 'fa-solid fa-filter-circle-xmark text-xl'; iconI.style.color = '#64748b'; }
      if (titleEl)  titleEl.textContent = 'No results';
      if (subEl)    subEl.textContent = 'No packages match the current filters. Try adjusting your search or date range.';
      if (actionEl) actionEl.innerHTML = `<button onclick="ctClearFilters()" class="inline-flex items-center gap-2 text-xs font-semibold px-5 py-2.5 rounded-xl transition-colors" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;margin-bottom:16px"><i class="fa-solid fa-xmark"></i>Clear all filters</button>`;
    } else {
      if (iconEl)   { iconEl.style.background = 'rgba(232,117,26,0.1)'; iconEl.style.border = '1px solid rgba(232,117,26,0.2)'; }
      if (iconI)    { iconI.className = 'fa-solid fa-boxes-stacked text-xl'; iconI.style.color = '#e8751a'; }
      if (titleEl)  titleEl.textContent = 'No custom packages yet';
      if (subEl)    subEl.textContent = 'Packages created in Seller Panel will appear here.';
      if (actionEl) actionEl.innerHTML = `<button onclick="showSection('sellerpanel')" class="btn-ol inline-flex items-center gap-2 text-xs font-semibold px-5 py-2.5 rounded-xl transition-colors"><i class="fa-solid fa-plus"></i>Create first package</button>`;
    }
    return;
  }
  empty.classList.add('hidden');
  table.classList.remove('hidden');

  const cpStatusBadge = (s) => {
    const map = { arrived: 'bg-blue-100 text-blue-700', paid: 'bg-green-100 text-green-700', confirmed: 'bg-green-100 text-green-700', pending: 'bg-amber-100 text-amber-700', cancelled: 'bg-red-100 text-red-700', refund_failed: 'bg-orange-100 text-orange-700' };
    const labels = { arrived: 'Arrived', paid: 'Paid', confirmed: 'Paid', pending: 'Pending', cancelled: 'Cancelled', refund_failed: 'Refund failed' };
    return `<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold ${map[s] || 'bg-gray-100 text-gray-500'}">${labels[s] || escapeHtml(s || '—')}</span>`;
  };
  const payIcon = m => {
    if (m === 'stripe') return '<i class="fa-brands fa-stripe" style="color:#635BFF" title="Stripe"></i>';
    if (m === 'bank_transfer') return '<i class="fa-solid fa-building-columns text-blue-400" title="Bank transfer"></i>';
    if (m === 'cash') return '<i class="fa-solid fa-money-bill text-green-500" title="Cash"></i>';
    return '';
  };

  tbody.innerHTML = filtered.map((p, i) => {
    const isCancelled = p.status === 'cancelled' || p.status === 'refund_failed';
    const isArrived = p.status === 'arrived';
    const rowStyle = isCancelled ? 'opacity:0.45' : '';
    const pdfBtn = `<button onclick="event.stopPropagation();openCpVoucher('${p.id}')" title="Print / Save PDF" style="background:rgba(239,68,68,0.13);border:1px solid rgba(239,68,68,0.35);color:#f87171" class="text-xs px-2 py-1.5 rounded-lg transition-colors hover:opacity-80"><i class="fa-solid fa-file-pdf text-xs mr-1"></i><span style="font-size:10px;font-weight:600">PDF</span></button>`;
    const cancelArrivedBtn = `<button onclick="event.stopPropagation();cancelArrivedCp('${p.id}')" title="Mark as cancelled" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#f87171" class="text-xs px-2 py-1.5 rounded-lg transition-colors hover:opacity-80"><i class="fa-solid fa-xmark text-xs"></i></button>`;
    const actions = isCancelled ? '' : isArrived ? `${pdfBtn}${cancelArrivedBtn}` : `
      ${pdfBtn}
      ${p.guest_email ? `<button onclick="event.stopPropagation();sendCpVoucherEmail('${p.id}')" title="Send voucher to ${escapeHtml(p.guest_email)}" style="background:rgba(232,117,26,0.13);border:1px solid rgba(232,117,26,0.35);color:#fb923c" class="text-xs px-2 py-1.5 rounded-lg transition-colors hover:opacity-80"><i class="fa-solid fa-envelope text-xs"></i></button>` : ''}
      ${p.status !== 'paid' && p.status !== 'confirmed' ? `<button onclick="markCpPaid('${p.id}')" title="${p.payment_method === 'bank_transfer' && p.guest_email ? 'Mark as paid · voucher → ' + p.guest_email : 'Mark as paid'}" class="text-xs px-2 py-1.5 border border-green-200 rounded-lg hover:bg-green-50 text-green-600 transition-colors"><i class="fa-solid fa-check text-xs"></i></button>` : ''}
      ${p.payment_method === 'stripe' && p.status !== 'paid' && p.status !== 'confirmed' ? `<button onclick="event.stopPropagation();resendCpStripeLink('${p.id}')" title="${p.guest_email ? 'Resend payment link to ' + p.guest_email : 'Generate payment link'}" class="text-xs px-2 py-1.5 border border-blue-200 rounded-lg hover:bg-blue-50 text-blue-400 hover:text-blue-300 transition-colors"><i class="fa-solid fa-paper-plane text-xs"></i></button>` : ''}
      <button onclick="event.stopPropagation();cancelCp('${p.id}','${escapeHtml(p.guest_name||'')}')" title="Cancel booking" class="text-xs px-2 py-1.5 border border-red-100 rounded-lg hover:bg-red-50 text-red-400 hover:text-red-600 transition-colors"><i class="fa-solid fa-xmark text-xs"></i></button>`;
    return `
    <tr onclick="openCpDetail('${p.id}')" class="hover:bg-gray-50/60 transition-colors cursor-pointer" style="${rowStyle}">
      <td class="px-4 py-3 font-mono text-xs" style="color:#64748b">${i + 1}</td>
      <td class="px-4 py-3">
        <div class="font-semibold text-xs" style="color:#e2e8f0">${escapeHtml(p.package_name)}</div>
        <div class="text-xs font-mono" style="color:#64748b">#${p.id.split('-')[0].toUpperCase()}</div>
      </td>
      <td class="px-4 py-3">
        <div class="text-xs font-medium" style="color:#e2e8f0">${escapeHtml(p.guest_name)}</div>
        ${p.guest_email ? `<div class="text-xs" style="color:#64748b">${escapeHtml(p.guest_email)}</div>` : ''}
        ${p.guest_phone ? `<div class="text-xs font-mono" style="color:#64748b">${escapeHtml(p.guest_phone)}</div>` : ''}
      </td>
      <td class="px-4 py-3 text-xs font-mono" style="color:#94a3b8">${p.date || '—'}</td>
      <td class="px-4 py-3 text-center text-xs font-mono" style="color:#cbd5e1">${p.pax ?? '—'}</td>
      <td class="px-4 py-3 text-xs" style="color:#94a3b8">${escapeHtml(p.sold_by_name || '—')}</td>
      <td class="px-4 py-3 text-right font-mono font-semibold text-xs" style="color:#f1f5f9">${fmtPln(p.guest_price)}</td>
      <td class="px-4 py-3 text-right font-mono text-xs" style="color:${p.commission_amount > 0 ? '#fbbf24' : '#64748b'}">${p.commission_amount > 0 ? fmtPln(p.commission_amount) : '—'}</td>
      <td class="px-4 py-3 text-center">${cpStatusBadge(p.status)}</td>
      <td class="px-4 py-3 text-center text-sm">${payIcon(p.payment_method)}</td>
      <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
        <div class="flex items-center justify-end gap-1">${actions}</div>
      </td>
    </tr>`;
  }).join('');
}

async function _fetchLogoBase64() {
  try {
    const res  = await fetch('assets/logo.png');
    const blob = await res.blob();
    return await new Promise(r => { const fr = new FileReader(); fr.onloadend = () => r(fr.result); fr.readAsDataURL(blob); });
  } catch(e) { return null; }
}

function _xlsDownload(html, filename) {
  const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
}

