function formatWebsiteDisplay(url) {
  try {
    const u = new URL(url.startsWith('http') ? url : 'https://' + url);
    return u.hostname.replace(/^www\./, '');
  } catch(e) { return url.length > 35 ? url.substring(0, 32) + '...' : url; }
}

