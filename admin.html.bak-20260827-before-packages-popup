  }
  function tsaPrevMonth() { tsaCurrentMonth.setMonth(tsaCurrentMonth.getMonth()-1); tsaRenderAndRefetch(); }
  function tsaNextMonth() { tsaCurrentMonth.setMonth(tsaCurrentMonth.getMonth()+1); tsaRenderAndRefetch(); }

  function tsaSelectDate(dateStr) {
    tsaSelectedDate = dateStr; tsaSelectedSlot = null;
    document.getElementById('tsa-editor-section').classList.add('hidden');
    tsaRenderCalendar();
    const slots = (tsaAvailability[dateStr] || []).filter((s,i,a) => a.findIndex(x => x.startTimeId === s.startTimeId) === i);
    tsaCurrentDaySlots = slots;
    const section = document.getElementById('tsa-slot-section');
    if (slots.length === 0) { section.classList.add('hidden'); return; }
    document.getElementById('tsa-slot-section-date').textContent = dateStr;
    document.getElementById('tsa-slot-list').innerHTML = slots.map((s, i) => {
      const t = s.startTime || '';
      const timeStr = t ? (t.length > 8 ? t.slice(11,16) : t.slice(0,5)) : 'Flexible time';
      const slotUniqueRates = (s.rates || []).filter((r,idx,a) => a.findIndex(x=>x.id===r.id)===idx);
      const slotLang = slotUniqueRates.length === 1
        ? (LANGUAGE_KEYWORDS.find(l => (slotUniqueRates[0].title||'').toLowerCase().includes(l.toLowerCase())) || null)
        : null;
      const ov = tsaOverrides.get(`${dateStr}|${s.startTimeId}`);
      const badge = ov?.disabled ? `<span style="font-size:10px;color:#f87171;font-weight:600">Disabled</span>`
        : ov?.max_guests != null ? `<span style="font-size:10px;color:#E8751A;font-weight:600">Capped ${ov.max_guests}</span>`
        : `<span style="font-size:10px;color:#64748b">${s.availabilityCount != null ? s.availabilityCount + ' seats' : 'No limit'}</span>`;
      return `<button onclick="tsaSelectSlot(${i})" style="padding:8px 14px;border-radius:10px;border:1px solid ${ov ? 'rgba(232,117,26,0.5)' : 'rgba(255,255,255,0.1)'};background:rgba(255,255,255,0.04);color:#e2e8f0;font-size:13px;font-weight:600;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px">
        <span>${timeStr}</span>${slotLang ? `<span style="font-size:10px;font-weight:400;color:#94a3b8">${escapeHtml(slotLang)}</span>` : ''}${badge}</button>`;
    }).join('');
    section.classList.remove('hidden');
  }

  function tsaSelectSlot(i) {
    const s = tsaCurrentDaySlots[i];
    if (!s) return;
    tsaSelectedSlot = s;
    const t = s.startTime || '';
    const timeStr = t ? (t.length > 8 ? t.slice(11,16) : t.slice(0,5)) : 'Flexible time';
    const slotUniqueRates = (s.rates || []).filter((r,idx,a) => a.findIndex(x=>x.id===r.id)===idx);
    const slotLang = slotUniqueRates.length === 1
      ? (LANGUAGE_KEYWORDS.find(l => (slotUniqueRates[0].title||'').toLowerCase().includes(l.toLowerCase())) || null)
      : null;
    document.getElementById('tsa-editor-slot-label').textContent = `${timeStr}${slotLang ? ' · ' + slotLang : ''} · ${tsaSelectedDate}`;
    const liveEl = document.getElementById('tsa-editor-live-count');
    if (tsaCurrentTour.bokun_id) {
      liveEl.textContent = `Bokun live availability: ${s.availabilityCount} seats`;
    } else if (s.availabilityCount != null) {
      liveEl.textContent = `Tour's configured max guests: ${s.availabilityCount}`;
    } else {
      liveEl.textContent = `No guest limit configured for this tour — enter any number.`;
    }
    const alreadyBooked = tsaBookedMap.get(`${tsaSelectedDate}|${s.startTimeId}`) || 0;
    document.getElementById('tsa-editor-booked-count').textContent = `Already booked (this system): ${alreadyBooked}`;
    const ov = tsaOverrides.get(`${tsaSelectedDate}|${s.startTimeId}`);
    const cb = document.getElementById('tsa-disable-cb');
    const input = document.getElementById('tsa-max-guests-input');
    cb.checked = !!ov?.disabled;
    input.value = (ov && !ov.disabled && ov.max_guests != null) ? ov.max_guests : '';
    input.max = s.availabilityCount != null ? String(s.availabilityCount) : '999';
    tsaToggleDisableUI();
    document.getElementById('tsa-editor-section').classList.remove('hidden');
    document.getElementById('tsa-editor-section').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

