    const totalPages = Math.ceil(total / HB_PER_PAGE);
    const tbody = document.getElementById('hb-tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    page.forEach(b => {
      tbody.insertAdjacentHTML('beforeend', `
        <tr class="hover:bg-gray-50 transition-colors text-xs cursor-pointer" data-id="${b.id}" onclick="openBookingDetail('${b.id}')" style="${(b.status||'').toLowerCase() === 'cancelled' ? 'opacity:0.45' : ''}">
          <td class="px-5 py-3 font-mono text-gray-400" style="white-space:nowrap">#${b.displayId || b.id}</td>
          <td class="px-4 py-3 font-medium text-dark" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(b.tour)}">${escapeHtml(b.tour)}</td>
          <td class="px-4 py-3 text-gray-600" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(b.guest)}">${escapeHtml(b.guest)}</td>
