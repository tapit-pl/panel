  async function getEurPlnRate() {
    if (_eurPlnRate) return _eurPlnRate;
    try {
      const res = await fetch('https://api.nbp.pl/api/exchangerates/rates/a/eur/?format=json');
      const data = await res.json();
      _eurPlnRate = data?.rates?.[0]?.mid || 4.25;
