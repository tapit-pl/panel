  async function loadPartnerBanner() {
    const bannerEl = document.getElementById('partner-banner');
    if (!bannerEl) return;
    const { data, error } = await db.from('app_settings').select('value').eq('key','partner_banner').limit(1);
    if (error) { bannerEl.style.display = 'none'; return; }
    if (!data?.[0]?.value) { bannerEl.style.display = 'none'; return; }
    let b;
    try { b = JSON.parse(data[0].value); } catch(e) { bannerEl.style.display = 'none'; return; }
    if (!b.enabled) { bannerEl.style.display = 'none'; return; }
    let html = '<div>';
    if (b.label) html += `<div class="flex items-center gap-2 mb-1"><span class="bg-brand text-white text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wide">${escapeHtml(b.label)}</span></div>`;
    let titleParts = [];
    if (b.title) titleParts.push(escapeHtml(b.title));
    if (b.subtitle) titleParts.push(`<span class="text-brand">${escapeHtml(b.subtitle)}</span>`);
    if (titleParts.length) html += `<h3 class="font-bold text-lg mt-2 leading-snug">${titleParts.join('<br>')}</h3>`;
    if (b.body) html += `<p class="text-gray-300 text-sm mt-1.5">${escapeHtml(b.body)}</p>`;
    html += '</div>';
    if (b.promo_icon || b.promo_text || b.promo_label) {
      const iconClass = _SAFE_BANNER_ICONS.has(b.promo_icon) ? b.promo_icon : 'fa-tag';
      html += '<div class="mt-4 pt-4 border-t border-white/10 flex items-center gap-3">';
      if (b.promo_icon) html += `<div class="w-8 h-8 bg-brand rounded-lg flex items-center justify-center shrink-0"><i class="fa-solid ${iconClass} text-white text-sm"></i></div>`;
      if (b.promo_label || b.promo_text) {
        html += '<p class="text-sm text-gray-200">';
        if (b.promo_label) html += `<span class="text-white font-semibold">${escapeHtml(b.promo_label)}</span> `;
        if (b.promo_text) html += escapeHtml(b.promo_text);
        html += '</p>';
      }
      html += '</div>';
    }
    bannerEl.innerHTML = html;
    bannerEl.style.display = 'block';
  }

