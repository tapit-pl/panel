    ${commAmount > 0 ? `<div class="flex justify-between text-xs" style="color:#64748b"><span>Seller commission (${commRate}% of margin)</span><span class="font-mono" style="color:#4ade80">−${fmtPln(commAmount)}</span></div>` : ''}`;

  // Guest + Booking
  const gf = (label, val) => val != null && val !== '' ? `<div><div class="text-xs mb-0.5" style="color:#64748b">${label}</div><div class="text-xs font-medium" style="color:#cbd5e1">${escapeHtml(String(val))}</div></div>` : '';
  document.getElementById('cpd-guest').innerHTML = gf('Name', p.guest_name) + gf('Email', p.guest_email) + gf('Phone', p.guest_phone) + gf('Pax', p.pax);
  document.getElementById('cpd-booking').innerHTML =
    gf('Date', p.date) + gf('Time', p.time) + gf('Meeting point', p.meeting_point) + gf('Sold by', p.sold_by_name) +
    (p.notes ? `<div class="col-span-2"><div class="text-xs mb-0.5" style="color:#64748b">Notes</div><div class="text-xs font-medium" style="color:#cbd5e1;white-space:pre-wrap">${escapeHtml(p.notes)}</div></div>` : '');

  // Payment
  const payLabels = { stripe: 'Stripe link', bank_transfer: 'Bank transfer', cash: 'Cash' };
  const payIcons = { stripe: '<i class="fa-brands fa-stripe" style="color:#635BFF;font-size:1.25rem"></i>', bank_transfer: '<i class="fa-solid fa-building-columns" style="color:#60a5fa"></i>', cash: '<i class="fa-solid fa-money-bill" style="color:#4ade80"></i>' };
  document.getElementById('cpd-payment').innerHTML = `<div class="flex items-center gap-2 text-sm font-medium" style="color:#cbd5e1">${payIcons[p.payment_method] || ''}<span>${payLabels[p.payment_method] || escapeHtml(p.payment_method || '—')}</span></div>`;

  // Actions
  const canEdit = currentAdminRole !== 'staff';
  const canRevertToPending = currentAdminRole === 'admin';
  const isCancelledPkg = p.status === 'cancelled';
  const isArrivedPkg = p.status === 'arrived';
  const canRestore = (p.status === 'cancelled' || p.status === 'refund_failed') && !p.stripe_refunded && currentAdminRole !== 'staff';
  const pdfBtnDetail = `<button onclick="openCpVoucher('${p.id}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(255,255,255,0.08);color:#cbd5e1" onmouseover="this.style.background='rgba(255,255,255,0.13)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'"><i class="fa-solid fa-file-invoice"></i>Print PDF</button>`;
  const cancelArrivedBtnDetail = `<button onclick="cancelArrivedCp('${p.id}');closeCpDetail()" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(239,68,68,0.15);color:#f87171" onmouseover="this.style.background='rgba(239,68,68,0.25)'" onmouseout="this.style.background='rgba(239,68,68,0.15)'"><i class="fa-solid fa-xmark"></i>Cancel</button>`;
  document.getElementById('cpd-actions').innerHTML = isArrivedPkg ? `${pdfBtnDetail}${cancelArrivedBtnDetail}` : `
    ${pdfBtnDetail}
    ${p.guest_email ? `<button onclick="sendCpVoucherEmail('${p.id}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(232,117,26,0.12);color:#f97316" onmouseover="this.style.background='rgba(232,117,26,0.22)'" onmouseout="this.style.background='rgba(232,117,26,0.12)'"><i class="fa-solid fa-envelope"></i>Send voucher</button>` : ''}
    ${!isCancelledPkg && canEdit ? `<button onclick="openCpEdit('${p.id}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(249,115,22,0.15);color:#f97316" onmouseover="this.style.background='rgba(249,115,22,0.25)'" onmouseout="this.style.background='rgba(249,115,22,0.15)'"><i class="fa-solid fa-pen"></i>Edit</button>` : ''}
