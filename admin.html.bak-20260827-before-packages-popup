const TSA_SLOT_CAP_EXCLUDED_STATUSES = ['cancelled','refund_failed','cancelling'];
async function fetchSlotBookedMap(tourTitle, start, end) {
  const map = new Map();
  const { data: bookedRows } = await db.from('bookings').select('date,start_time_id,pax')
    .eq('tour', tourTitle).gte('date', start).lte('date', end)
    .not('status', 'in', `(${TSA_SLOT_CAP_EXCLUDED_STATUSES.join(',')})`);
  (bookedRows || []).forEach(b => {
    if (!b.start_time_id) return;
    const key = `${b.date}|${b.start_time_id}`;
    map.set(key, (map.get(key) || 0) + (b.pax || 0));
  });
  return map;
}

