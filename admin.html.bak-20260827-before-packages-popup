}

function cpRenderCal() {
  const m = cpCalMonth;
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('cp-month-label').textContent = `${months[m.getMonth()]} ${m.getFullYear()}`;
  const today = new Date().toISOString().slice(0,10);
  const firstDay = new Date(m.getFullYear(), m.getMonth(), 1);
  const startDow = (firstDay.getDay() + 6) % 7;
  const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
  const CELL = 'display:table-cell;width:14.2857%;text-align:center;padding:3px 0;';
  const DOW = ['Mo','Tu','We','Th','Fr','Sa','Su'];
  let html = '<table style="width:100%;border-collapse:collapse;table-layout:fixed;">';
  html += '<tr>';
  DOW.forEach(d => { html += `<td style="${CELL}font-size:11px;color:#64748b;padding-bottom:6px;">${d}</td>`; });
  html += '</tr>';
  let cells = [];
  for (let i = 0; i < startDow; i++) cells.push('<td></td>');
  for (let d = 1; d <= daysInMonth; d++) {
    const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isPast = ds < today;
    const isSelected = ds === cpSelectedDateStr;
    const isToday = ds === today;
    let inner = '';
    if (isSelected) {
      inner = `<div style="width:28px;height:28px;border-radius:50%;background:#E8751A;color:#fff;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;margin:auto;cursor:pointer;" onclick="cpSelectDate('${ds}')">${d}</div>`;
    } else if (!isPast) {
      const outline = isToday ? 'outline:2px solid rgba(232,117,26,0.5);outline-offset:1px;' : '';
      inner = `<div style="width:28px;height:28px;border-radius:50%;color:#e2e8f0;font-size:12px;display:flex;align-items:center;justify-content:center;margin:auto;cursor:pointer;${outline}" onmouseover="this.style.background='rgba(232,117,26,0.2)'" onmouseout="this.style.background=''" onclick="cpSelectDate('${ds}')">${d}</div>`;
    } else {
      inner = `<span style="font-size:12px;color:rgba(255,255,255,0.15);">${d}</span>`;
    }
    cells.push(`<td style="${CELL}">${inner}</td>`);
  }
  while (cells.length % 7 !== 0) cells.push('<td></td>');
  for (let i = 0; i < cells.length; i += 7) {
    html += '<tr>' + cells.slice(i, i+7).join('') + '</tr>';
  }
  html += '</table>';
  document.getElementById('cp-calendar-grid').innerHTML = html;
}

function cpSelectDate(ds) {
  cpSelectedDateStr = ds;
  document.getElementById('ord-date').value = ds;
  const [y, mo, d] = ds.split('-');
  const dispEl = document.getElementById('ord-date-display');
  if (dispEl) {
    dispEl.textContent = `${d}.${mo}.${y}`;
    dispEl.classList.remove('text-gray-400');
    dispEl.classList.add('text-dark');
  }
  document.getElementById('ord-date-cal').classList.add('hidden');
}

function cpPrevMonth() {
  cpCalMonth = new Date(cpCalMonth.getFullYear(), cpCalMonth.getMonth()-1, 1);
  cpRenderCal();
}
function cpNextMonth() {
  cpCalMonth = new Date(cpCalMonth.getFullYear(), cpCalMonth.getMonth()+1, 1);
