  function updateBookingStats(bookings) {
    const total     = bookings.length;
    const confirmed = bookings.filter(b => ['paid','confirmed','arrived'].includes(b.status?.toLowerCase())).length;
    const pending   = bookings.filter(b => ['to_be_paid','pending','payment_pending','pending_payment'].includes(b.status?.toLowerCase())).length;
    const cancelled = bookings.filter(b => b.status?.toLowerCase() === 'cancelled').length;
    const noShow    = bookings.filter(b => b.status?.toLowerCase() === 'no_show').length;
    document.getElementById('stat-total').textContent     = total;
    document.getElementById('stat-paid').textContent      = confirmed;
    document.getElementById('stat-pending').textContent   = pending;
    document.getElementById('stat-cancelled').textContent = cancelled;
    document.getElementById('stat-noshow').textContent    = noShow;
  }


  async function resendPaymentLink(bookingId) {
    const b = (partnerBookings || []).find(x => x.id === bookingId);
    if (!b) return;
    const btn = document.querySelector(`button[onclick="resendPaymentLink('${bookingId}')"]`);
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i>'; }

    try {
      // Check current status from DB before creating a new session — guard against double-charge
      const { data: fresh } = await db.from('bookings').select('status').eq('id', bookingId).single();
      const freshStatus = (fresh?.status || '').toLowerCase();
      const PAID_STATUSES = ['paid', 'confirmed', 'arrived'];
      if (PAID_STATUSES.includes(freshStatus)) {
        showPartnerToast('This booking has already been paid — link not resent.', false);
        // Sync the in-memory record so the button disappears
        const bIdx = partnerBookings.findIndex(x => x.id === bookingId);
        if (bIdx !== -1) partnerBookings[bIdx].status = fresh.status;
        renderPartnerBookings(partnerBookings);
        return;
      }

      const { data: stripeRes, error: stripeErr } = await db.functions.invoke('create-stripe-session', {
        body: {
          booking_id: b.id,
          bokun_reservation_code: b.bokun_confirmation_code || b.id,
          amount_pln: b.total || 0,
          pax: b.pax || 1,
          tour_name: b.tour,
          date: b.date,
          guest_name: b.guest,
          guest_email: b.email || null,
        }
      });
      if (stripeErr || !stripeRes?.session_url) throw new Error(stripeErr?.message || 'No session URL');

      await db.from('bookings').update({
        stripe_session_id: stripeRes.session_id,
        stripe_session_url: stripeRes.session_url,
      }).eq('id', bookingId).eq('partner_id', currentPartner.id);

      const bIdx = partnerBookings.findIndex(x => x.id === bookingId);
      if (bIdx !== -1) {
        partnerBookings[bIdx].stripe_session_id = stripeRes.session_id;
        partnerBookings[bIdx].stripe_session_url = stripeRes.session_url;
      }

      if (!b.email) {
        await navigator.clipboard.writeText(stripeRes.session_url).catch(() => {});
        showPartnerToast('Payment link copied to clipboard!', false);
      } else {
        showPartnerToast('Payment link resent to ' + b.email, false);
      }
    } catch(e) {
      console.error('[resendPaymentLink]', e.message);
      showPartnerToast('Failed to resend link — check console', true);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = b.email
          ? '<i class="fa-solid fa-paper-plane text-xs"></i>'
          : '<i class="fa-solid fa-copy text-xs"></i>';
      }
    }
  }

