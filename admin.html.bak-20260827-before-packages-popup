async function loadManagerMonthStats() {
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0,10);
  const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 1).toISOString().slice(0,10);
  const { data, error } = await db.from('custom_packages')
    .select('guest_price,commission_amount')
    .eq('sold_by_email', currentAdminEmail)
    .in('status', ['paid', 'confirmed', 'arrived'])
    .gte('created_at', monthStart)
    .lt('created_at', monthEnd);
  if (error) { console.error('loadManagerMonthStats:', error); cpMyStats = null; return; }
  const rows = data || [];
  cpMyStats = {
    count: rows.length,
    totalVal: rows.reduce((s, p) => s + (p.guest_price || 0), 0),
    totalComm: rows.reduce((s, p) => s + (p.commission_amount || 0), 0),
  };
}

async function loadCustomTours() {
  let query = db.from('custom_packages').select('*').order('created_at', { ascending: false }).limit(200);
  if (currentAdminRole === 'staff') query = query.eq('sold_by_email', currentAdminEmail);
  const [{ data, error }] = await Promise.all([
    query,
    currentAdminRole === 'manager' ? loadManagerMonthStats() : Promise.resolve(),
  ]);
  if (error) { console.error('loadCustomTours:', error); return; }
  cpData = (data || []).map(p => ({ ...p, _creationTs: p.created_at ? new Date(p.created_at).getTime() : 0 }));
  customToursLoaded = true;
  initDatePicker('ct-date-from', renderCustomTours);
  initDatePicker('ct-date-to', renderCustomTours);
  renderCustomTours();
}

async function revertCpToPending(id) {
  if (!await showConfirm('Revert package status to "pending"?\n\nAny voucher already sent to the guest remains valid — cancel it manually if needed.', { okLabel: 'Revert', okColor: '#d97706' })) return;
  const { error } = await db.from('custom_packages').update({ status: 'pending' }).eq('id', id);
  if (error) { showToast('Failed to revert package status.', 'error', error.message); return; }
  showToast('Status cofnięty do pending');
  closeCpDetail();
  await loadCustomTours();
}

async function restoreCp(id) {
  if (currentAdminRole === 'staff') { showToast('Manager or admin role required', 'error'); return; }
  const p = cpData.find(x => x.id === id);
  if (!p) return;
  if (p.stripe_refunded) { showToast('Cannot restore — Stripe refund was already issued for this package.', 'error'); return; }
  const restoreStatus = p.status_before_cancel || 'pending';
  if (!await showConfirm(`Restore this package to "${restoreStatus}"?`, { okLabel: 'Restore', okColor: '#16a34a' })) return;
  const { error } = await db.from('custom_packages').update({ status: restoreStatus, status_before_cancel: null }).eq('id', id);
  if (error) { showToast('Failed to restore package.', 'error', error.message); return; }
  showToast('Package restored.');
  logActivity('package_restored', `Package "${p.package_name}" restored to "${restoreStatus}"`, id);
  closeCpDetail();
  await loadCustomTours();
}

async function resendCpStripeLink(id) {
  const pkg = cpData.find(x => x.id === id);
  if (!pkg) return;
  if (pkg.status === 'paid' || pkg.status === 'confirmed') {
    showToast('This package has already been paid — link not resent.', 'error'); return;
  }
  showToast('Sending payment link…');
  const { data: stripeRes, error: stripeErr } = await invokeEdge('create-stripe-session', {
    body: {
      custom_package_id: pkg.id,
      tour_name: pkg.package_name,
      date: pkg.date || '',
      pax: pkg.pax || 1,
      guest_name: pkg.guest_name,
      guest_email: pkg.guest_email || null,
    }
  });
  if (stripeErr || !stripeRes?.session_url) {
    const errMsg = stripeErr?.body?.error || stripeErr?.message || 'No session URL';
    showToast('Failed to generate payment link: ' + errMsg, 'error');
    console.error('[resendCpStripeLink] err:', stripeErr, 'data:', stripeRes);
    return;
  }
  if (!pkg.guest_email) {
    await navigator.clipboard.writeText(stripeRes.session_url).catch(() => {});
    showToast('Payment link copied to clipboard (no guest email set)');
  } else {
    showToast('Payment link sent to ' + pkg.guest_email);
  }
  logActivity('custom_package_link_resent', `Payment link resent for package "${pkg.package_name}" (${pkg.guest_name})`, id).catch(() => {});
  await loadCustomTours();
}

async function markCpPaid(id) {
  const pkg = cpData.find(x => x.id === id);
  const { error } = await db.from('custom_packages').update({ status: 'paid' }).eq('id', id);
  if (error) { showToast('Failed to mark package as paid.', 'error', error.message); return; }

  if (pkg?.payment_method === 'bank_transfer' && pkg?.guest_email) {
    const { data: emailRes, error: emailErr } = await invokeEdge('send-booking-confirmation', {
      body: {
        booking_id: id,
        tour_name: pkg.package_name,
        date: pkg.date,
        time: pkg.time || null,
        guest_name: pkg.guest_name,
        guest_email: pkg.guest_email,
        phone: pkg.guest_phone || null,
        pax: pkg.pax,
        total: pkg.guest_price,
        pickup: pkg.meeting_point || null,
        payment_type: 'cash',
      }
    });
    if (emailErr || emailRes?.sent === false) {
      showToast('Marked as paid — but email failed to send. Check Resend logs.', 'error');
    } else {
      showToast('Marked as paid · voucher sent to ' + pkg.guest_email);
    }
  } else {
    showToast('Marked as paid');
  }
  logActivity('custom_package_marked_paid', `Package "${pkg?.package_name}" (${pkg?.guest_name}) marked paid`, id).catch(() => {});

  await loadCustomTours();
}

async function cancelArrivedCp(id) {
  if (!confirm('Mark this arrived package as cancelled?')) return;
  const { error } = await db.from('custom_packages').update({ status: 'cancelled' }).eq('id', id);
  if (error) { showToast('Failed to cancel package.', 'error', error.message); return; }
  showToast('Package marked as cancelled', 'success');
  await loadCustomTours();
}

async function cancelCp(id, guestName) {
  if (currentAdminRole === 'staff') { showToast('Manager or admin role required', 'error'); return; }
  const pkg = cpData.find(x => x.id === id);
  if (!pkg) return;
  const hasStripe = !!(pkg?.stripe_session_id) && (pkg?.status === 'paid' || pkg?.status === 'confirmed');
  let stripeRefundDone = false;
  if (hasStripe) {
    const choice = await showStripeCancelDialog(guestName);
    if (!choice) return;
    if (choice === 'refund') {
      const { data, error } = await invokeEdge('cancel-booking', { body: { custom_package_id: id } });
      if (error || !data?.success) { showToast('Failed to cancel package.', 'error', error?.message || data?.error); return; }
      const refundFailed = data?.stripe?.ok === false;
      stripeRefundDone = !refundFailed;
      showToast(refundFailed ? 'Package cancelled — Stripe refund failed. Refund manually in Stripe dashboard.' : 'Package cancelled and Stripe payment refunded.', refundFailed ? 'error' : 'success');
    } else {
      const { error } = await db.from('custom_packages').update({ status: 'cancelled', status_before_cancel: pkg.status }).eq('id', id);
      if (error) { showToast('Failed to cancel package.', 'error', error.message); return; }
      showToast('Package cancelled (no refund).', 'success');
    }
  } else {
    if (!await showConfirm(`Cancel package for "${guestName || 'this guest'}"?`, { okLabel: 'Cancel booking', okColor: '#dc2626' })) return;
    const { error } = await db.from('custom_packages').update({ status: 'cancelled', status_before_cancel: pkg.status }).eq('id', id);
    if (error) { showToast('Failed to cancel package.', 'error', error.message); return; }
    showToast('Package cancelled.', 'success');
  }
  if (pkg.guest_email) {
    const shortId = 'TM-PKG-' + id.split('-')[0].toUpperCase();
    const cancelBlocks = stripeRefundDone
      ? [{ name: 'Refund information:', info: `A full refund of ${(pkg.guest_price || 0).toFixed(2)} PLN has been issued to your original payment method. It may take 5–10 business days to appear on your statement.` }]
      : null;
    await invokeEdge('send-booking-confirmation', { body: {
      booking_id: shortId,
      tour_name: pkg.package_name,
      date: pkg.date || '',
      time: pkg.time || null,
      guest_name: pkg.guest_name || null,
      guest_email: pkg.guest_email,
      phone: pkg.guest_phone || null,
      pax: pkg.pax ?? 1,
      total: pkg.guest_price || null,
      pickup: pkg.meeting_point || null,
      payment_type: 'cancelled',
      email_blocks: cancelBlocks,
    }});
  }
  await loadCustomTours();
}

async function cancelCpFromDetail(id, guestName) {
  closeCpDetail();
  await cancelCp(id, guestName);
}

let cpDetailId = null;

function openCpDetail(id) {
  const p = cpData.find(x => x.id === id);
  if (!p) return;
  cpDetailId = id;
