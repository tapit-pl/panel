    if (area) area.classList.remove('hidden');
  }

  function startHold(holdId) {
    const btn      = document.getElementById('hold-btn-' + holdId);
    const active   = document.getElementById('hold-active-' + holdId);
    const timerEl  = document.getElementById('hold-timer-' + holdId);
    if (!timerEl) return;

    btn.classList.add('hidden');
    active.classList.remove('hidden');

    let seconds = 10 * 60; // 10 minutes
    timerEl.textContent = formatHoldTime(seconds);

    if (holdTimers[holdId]) clearInterval(holdTimers[holdId]);
    holdTimers[holdId] = setInterval(() => {
      seconds--;
      timerEl.textContent = formatHoldTime(seconds);
      if (seconds <= 60) timerEl.classList.add('text-red-500');
      if (seconds <= 0) {
        clearInterval(holdTimers[holdId]);
        cancelHold(holdId);
        // Show expired message
        const area = document.getElementById('hold-area-' + holdId);
        if (area) area.innerHTML = '<div class="mt-2 bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-xs text-red-600 flex items-center gap-2"><i class="fa-solid fa-clock"></i>Hold expired — please select the slot again to rebook.</div>';
      }
    }, 1000);
  }

  function cancelHold(holdId) {
    const btn    = document.getElementById('hold-btn-' + holdId);
    const active = document.getElementById('hold-active-' + holdId);
    const timer  = document.getElementById('hold-timer-' + holdId);
    if (holdTimers[holdId]) clearInterval(holdTimers[holdId]);
    if (btn)    { btn.classList.remove('hidden'); }
    if (active) { active.classList.add('hidden'); }
    if (timer)  { timer.classList.remove('text-red-500'); }
  }

  function formatHoldTime(s) {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return m + ':' + String(sec).padStart(2, '0');
  }

  // Commission table: search + category filter
  let commSortCol = -1, commSortAsc = true;
