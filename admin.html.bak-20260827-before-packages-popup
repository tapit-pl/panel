<script>
// ===== CUSTOM PACKAGES (Seller Panel) =====
let cpData = [];
let customToursLoaded = false;
let cpMyStats = null; // manager-only: dokładne "ten miesiąc" totals z loadManagerMonthStats()
let cpServices = [];
let cpCalMonth = new Date();
let cpSelectedDateStr = '';
let cpBankDefaults = { bank: 'mBank S.A.', account: 'PL20 1140 2004 0000 3102 7618 3204' };

async function loadCpBankDefaults() {
  const { data, error } = await db.from('app_settings').select('value').eq('key','custom_package_bank_defaults').limit(1);
  if (error) { console.warn('loadCpBankDefaults:', error.message); return; }
  if (!data?.[0]?.value) return;
  try {
    const v = JSON.parse(data[0].value);
    if (v.bank) cpBankDefaults.bank = v.bank;
    if (v.account) cpBankDefaults.account = v.account;
  } catch(e) { return; }
  const bankEl = document.getElementById('bt-bank');
  const accEl = document.getElementById('bt-account');
  if (bankEl) bankEl.value = cpBankDefaults.bank;
  if (accEl) accEl.value = cpBankDefaults.account;
}

async function saveCpBankDefaults() {
  if (currentAdminRole !== 'admin') { showToast('Admin role required', 'error'); return; }
  const bank = document.getElementById('cps-bank').value.trim();
  const account = document.getElementById('cps-account').value.trim();
  if (!bank || !account) { showToast('Bank and account number are required.', 'error'); return; }
  await db.from('app_settings').delete().eq('key','custom_package_bank_defaults');
  await db.from('app_settings').insert({ key:'custom_package_bank_defaults', value: JSON.stringify({ bank, account }) });
  cpBankDefaults = { bank, account };
  const bankEl = document.getElementById('bt-bank');
  const accEl = document.getElementById('bt-account');
  if (bankEl) bankEl.value = bank;
  if (accEl) accEl.value = account;
  document.getElementById('cp-settings-modal')?.remove();
  showToast('Default bank details saved.');
  logActivity('custom_tours_bank_defaults_updated', `Bank: ${bank}, account: ${account}`).catch(() => {});
}

function openCpSettingsModal() {
  if (currentAdminRole !== 'admin') { showToast('Admin role required', 'error'); return; }
  if (document.getElementById('cp-settings-modal')) return;
  const html = `
<div id="cp-settings-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background:rgba(0,0,0,0.6)" onclick="if(event.target===this)document.getElementById('cp-settings-modal').remove()">
