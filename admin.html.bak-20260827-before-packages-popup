  function applyTicketFilters() {
    const search         = (document.getElementById('ticket-search')?.value || '').toLowerCase();
    const categoryVals   = mselGetVals('msel-ticket-category');
    const partnerVals    = mselGetVals('msel-ticket-partner');
    const fromFilter     = document.getElementById('ticket-filter-from')?.value || '';
    const toFilter       = document.getElementById('ticket-filter-to')?.value || '';

    let filtered = currentTicketFilter === 'active'
      ? allTickets.filter(t => t.status === 'open' || t.status === 'in_progress')
      : allTickets.filter(t => t.status === currentTicketFilter);

    if (categoryVals.length) filtered = filtered.filter(t => categoryVals.includes(t.category));
    if (partnerVals.length)  filtered = filtered.filter(t => partnerVals.includes(t.partner));
    if (fromFilter)      filtered = filtered.filter(t => t.createdAtRaw >= fromFilter);
    if (toFilter)        filtered = filtered.filter(t => (t.createdAtRaw || '').slice(0,10) <= toFilter);
    if (search) filtered = filtered.filter(t =>
      (t.partner || '').toLowerCase().includes(search) ||
      (t.subject || '').toLowerCase().includes(search) ||
      (t.category || '').toLowerCase().includes(search)
    );
    renderTicketsTable(filtered);
  }

