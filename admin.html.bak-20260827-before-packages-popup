  async function tryUnlockEditing() {
    const pin = document.getElementById('tours-pin-input').value;
    if (!pin) return;
    const { data: valid, error } = await db.rpc('verify_admin_pin', { input_pin: pin });
    document.getElementById('tours-pin-input').value = '';
    if (error || !valid) {
      showToast('Incorrect PIN.', 'error');
      document.getElementById('tours-pin-input').classList.add('border-red-400');
      setTimeout(() => document.getElementById('tours-pin-input').classList.remove('border-red-400'), 1500);
      return;
    }
    editingUnlocked = true;
    unlockSecondsLeft = 600; // 10 minutes
    document.getElementById('tours-locked-banner').classList.add('hidden');
    document.getElementById('tours-unlocked-banner').classList.remove('hidden');
    ['new-group-input','new-group-add-btn','new-cat-input','new-cat-add-btn','disc-add-btn'].forEach(id => { const el = document.getElementById(id); if (el) el.disabled = false; });
    renderTourConfigTable();
    renderCategories();
    renderDiscountCodes();
    if (unlockTimer) clearInterval(unlockTimer);
    unlockTimer = setInterval(() => {
      unlockSecondsLeft--;
      const m = Math.floor(unlockSecondsLeft / 60).toString().padStart(2, '0');
      const s = (unlockSecondsLeft % 60).toString().padStart(2, '0');
      const el = document.getElementById('tours-lock-countdown');
      if (el) el.textContent = `${m}:${s}`;
      if (unlockSecondsLeft <= 0) lockEditing();
    }, 1000);
  }

  function lockEditing() {
    editingUnlocked = false;
    if (unlockTimer) { clearInterval(unlockTimer); unlockTimer = null; }
    document.getElementById('tours-locked-banner').classList.remove('hidden');
    document.getElementById('tours-unlocked-banner').classList.add('hidden');
    ['new-group-input','new-group-add-btn','new-cat-input','new-cat-add-btn','disc-add-btn'].forEach(id => { const el = document.getElementById(id); if (el) el.disabled = true; });
    renderTourConfigTable();
    renderCategories();
    renderDiscountCodes();
  }

