  async function tsaFetchMonth() {
    const m = tsaCurrentMonth;
    const start = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-01`;
    const lastDay = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
    const end = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${lastDay}`;
    tsaAvailability = {};
    if (!tsaCurrentTour.bokun_id) {
      // Manual-slot tour — no Bokun ceiling; slots run every future day unless overridden.
      const maxPax = tsaCurrentTour.max_pax || null;
      const baseSlots = (tsaCurrentTour.manual_slots || []).map(s => ({
        startTime: s.time || null, startTimeId: String(s.id || s.time || 'manual'), startTimeStr: s.label || s.time || '',
      }));
      const [{ data: overrideRows }, bookedMap] = await Promise.all([
        db.from('tour_slot_overrides').select('*').eq('tour_config_id', tsaCurrentTour.id).gte('slot_date', start).lte('slot_date', end),
        fetchSlotBookedMap(tsaCurrentTour.title, start, end)
      ]);
      tsaOverrides = new Map((overrideRows || []).map(o => [`${o.slot_date}|${o.start_time_id}`, o]));
      tsaBookedMap = bookedMap;
      const today = new Date().toISOString().slice(0,10);
      const cur = new Date(start + 'T12:00:00');
      const endDate = new Date(end + 'T12:00:00');
      while (cur <= endDate) {
        const ds = cur.toISOString().slice(0,10);
        if (ds >= today) {
          tsaAvailability[ds] = baseSlots
            .filter(s => !tsaOverrides.get(`${ds}|${s.startTimeId}`)?.disabled)
            .map(s => ({ ...s, availabilityCount: maxPax }));
        }
        cur.setDate(cur.getDate() + 1);
      }
      return;
    }
    try {
      const [{ data: res }, { data: overrideRows }, bookedMap] = await Promise.all([
        invokeEdge('bokun-sync', { body: { path: `/activity.json/${tsaCurrentTour.bokun_id}/availabilities?start=${start}&end=${end}`, method: 'GET' } }),
        db.from('tour_slot_overrides').select('*').eq('tour_config_id', tsaCurrentTour.id).gte('slot_date', start).lte('slot_date', end),
        fetchSlotBookedMap(tsaCurrentTour.title, start, end)
      ]);
      tsaBookedMap = bookedMap;
      const items = res?.body;
      if (Array.isArray(items)) {
        items.forEach(entry => {
          if (entry.unavailable || entry.soldOut) return;
          const ds = new Date(entry.date).toISOString().slice(0,10);
          if (!ds) return;
          if (!tsaAvailability[ds]) tsaAvailability[ds] = [];
          tsaAvailability[ds].push({
            startTime: entry.startTime || '', startTimeId: entry.startTimeId,
            startTimeStr: entry.startTimeStr || '', availabilityCount: entry.availabilityCount || 0,
            rates: entry.rates || [],
          });
        });
      }
      tsaOverrides = new Map((overrideRows || []).map(o => [`${o.slot_date}|${o.start_time_id}`, o]));
    } catch(e) { /* silent */ }
  }

  function tsaDateHasOverride(ds) {
    for (const key of tsaOverrides.keys()) if (key.startsWith(ds + '|')) return true;
    return false;
  }

  function tsaRenderCalendar() {
    const m = tsaCurrentMonth;
    const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    document.getElementById('tsa-month-label').textContent = `${months[m.getMonth()]} ${m.getFullYear()}`;
    const today = new Date().toISOString().slice(0,10);
    const startDow = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
    const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
    const DOW = ['Mo','Tu','We','Th','Fr','Sa','Su'];
    const G = 'display:grid;grid-template-columns:repeat(7,1fr);';
    let html = `<div style="${G}margin-bottom:4px;">${DOW.map(d => `<div style="text-align:center;font-size:11px;color:#9ca3af;font-weight:600;padding:4px 0;">${d}</div>`).join('')}</div><div style="${G}gap:2px;">`;
    for (let i = 0; i < startDow; i++) html += '<div></div>';
    for (let d = 1; d <= daysInMonth; d++) {
      const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      const avail = tsaAvailability[ds];
      const isPast = ds < today;
      const isSelected = ds === tsaSelectedDate;
      const hasOverride = tsaDateHasOverride(ds);
      let style, onclick = '';
      if (isSelected) { style = 'background:#E8751A;color:#fff;font-weight:700;border-radius:8px;cursor:pointer;'; onclick = `onclick="tsaSelectDate('${ds}')"`; }
      else if (avail && avail.length && !isPast) { style = 'background:#dcfce7;color:#166534;font-weight:700;border-radius:8px;cursor:pointer;'; onclick = `onclick="tsaSelectDate('${ds}')" onmouseenter="this.style.background='#bbf7d0'" onmouseleave="this.style.background='#dcfce7'"`; }
      else if (isPast) { style = 'color:#d1d5db;cursor:not-allowed;'; }
      else { style = 'color:#9ca3af;cursor:default;'; }
      const dot = hasOverride ? `<span style="position:absolute;bottom:1px;left:50%;transform:translateX(-50%);width:5px;height:5px;border-radius:50%;background:${isSelected ? '#fff' : '#E8751A'};"></span>` : '';
      html += `<div style="position:relative;text-align:center;font-size:12px;padding:5px 2px;transition:background .15s;${style}" ${onclick}>${d}${dot}</div>`;
    }
    html += `</div><div style="display:flex;align-items:center;gap:16px;margin-top:12px;font-size:11px;color:#6b7280;flex-wrap:wrap;">
      <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:3px;background:#dcfce7;display:inline-block;"></span>Available</span>
      <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;border-radius:3px;background:#f3f4f6;display:inline-block;"></span>No tours</span>
      <span style="display:flex;align-items:center;gap:5px;"><span style="width:6px;height:6px;border-radius:50%;background:#E8751A;display:inline-block;"></span>Has override</span></div>`;
    document.getElementById('tsa-calendar-grid').innerHTML = html;
  }

  async function tsaRenderAndRefetch() {
    document.getElementById('tsa-cal-loading').classList.remove('hidden');
    document.getElementById('tsa-cal-outer').classList.add('hidden');
    ['tsa-slot-section','tsa-editor-section'].forEach(id => document.getElementById(id).classList.add('hidden'));
    tsaSelectedDate = null; tsaSelectedSlot = null;
