    if (s === 'paid' || s === 'confirmed') return `<span class="status-paid text-xs font-semibold px-2.5 py-0.5 rounded-full">Paid</span>`;
    if (s === 'to_be_paid' || s === 'pending') return `<span class="status-pending text-xs font-semibold px-2.5 py-0.5 rounded-full">Driver pay</span>`;
    if (s === 'payment_pending' || s === 'pending_payment') return `<span class="status-pending-payment text-xs font-semibold px-2.5 py-0.5 rounded-full">Link sent</span>`;
    if (s === 'cancelled') return `<span class="status-cancelled text-xs font-semibold px-2.5 py-0.5 rounded-full">Cancelled</span>`;
    if (s === 'cancelling') return `<span class="text-xs font-semibold px-2.5 py-0.5 rounded-full" style="background:#fef3c7;color:#d97706;">Cancelling…</span>`;
    if (s === 'arrived') return `<span class="status-arrived text-xs font-semibold px-2.5 py-0.5 rounded-full">Arrived ✓</span>`;
    if (s === 'no_show') return `<span class="text-xs font-semibold px-2.5 py-0.5 rounded-full" style="background:#fef2f2;color:#dc2626;">No Show</span>`;
    return `<span class="status-pending text-xs font-semibold px-2.5 py-0.5 rounded-full">${status || 'Pending'}</span>`;
  }

  function canMarkNoShow(b) {
    const s = (b.status || '').toLowerCase();
    if (['paid', 'cancelled', 'no_show', 'confirmed'].includes(s)) return false;
    const isDriverPay = b.payment_method === 'driver' || ['to_be_paid', 'pending'].includes(s);
    if (!isDriverPay) return false;
    return b._startTs > 0 && Date.now() + 24 * 60 * 60 * 1000 >= b._startTs;
  }

  async function markNoShow(id) {
    const b = allBookings.find(x => x.id === id) || partnerBookings.find(x => x.id === id);
    if (!await showConfirm(`Oznaczyć rezerwację "${b?.guest || id}" jako No Show?\n\nHotel zostanie obciążony pełną ceną wycieczki.`)) return;
    const { error } = await db.from('bookings').update({ status: 'no_show' }).eq('id', id);
    if (error) { showToast('Failed to mark as no-show.', 'error', error.message); return; }
    if (b) b.status = 'no_show';
    filterAllBookings();
    if (_hbLoaded) filterHotelBookings();
    showToast('Oznaczono jako No Show', 'success');
    logActivity('booking_no_show', `No Show: ${b?.guest || ''}`, id);
  }

