  function renderTdPhonePrefixItems(items) {
    const el = document.getElementById('td-phone-prefix-items');
    if (!el) return;
    const cur = document.getElementById('td-phone-prefix')?.value || '+48';
    el.innerHTML = items.map(p =>
      `<div onclick="selectTdPhonePrefix('${p.d}','${p.f} ${p.d}')"
        style="padding:6px 10px;font-size:12px;cursor:pointer;border-radius:8px;display:flex;align-items:center;gap:8px;color:${p.d===cur?'#e8751a':'#475569'};font-weight:${p.d===cur?'600':'400'}"
        onmouseover="this.style.background='rgba(232,117,26,0.06)'"
        onmouseout="this.style.background='transparent'">
        <span>${p.f}</span><span style="flex:1">${p.c}</span><span style="color:#94a3b8;flex-shrink:0">${p.d}</span>
      </div>`
    ).join('') || '<div style="padding:8px 10px;font-size:12px;color:#94a3b8">No results</div>';
  }

  function filterTdPhonePrefixes(q) {
    const ql = (q || '').toLowerCase();
    renderTdPhonePrefixItems(PHONE_PREFIXES.filter(p =>
      p.c.toLowerCase().includes(ql) || p.d.includes(q)
    ));
  }

  function selectTdPhonePrefix(code, label) {
    document.getElementById('td-phone-prefix').value = code;
    document.getElementById('td-phone-prefix-val').textContent = label;
    document.getElementById('td-phone-prefix-list').classList.add('hidden');
    const s = document.getElementById('td-phone-prefix-search');
    if (s) { s.value = ''; renderTdPhonePrefixItems(PHONE_PREFIXES); }
  }

  function toggleTdPhonePrefix(e) {
    e.stopPropagation();
    const list = document.getElementById('td-phone-prefix-list');
    const isOpen = !list.classList.contains('hidden');
    if (isOpen) {
      list.classList.add('hidden');
    } else {
      list.classList.remove('hidden');
      renderTdPhonePrefixItems(PHONE_PREFIXES);
      setTimeout(() => document.getElementById('td-phone-prefix-search')?.focus(), 50);
    }
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('#td-phone-prefix-wrap')) {
      document.getElementById('td-phone-prefix-list')?.classList.add('hidden');
    }
  });

  function changeTdGuests(delta) {
    const maxGuests = tdSelectedTimeSlot?.availabilityCount || tdCurrentTour?.maxPax || 16;
    tdGuestCount = Math.max(1, Math.min(maxGuests, tdGuestCount + delta));
    document.getElementById('td-guest-count').textContent = tdGuestCount;
    renderAdditionalGuestFields(tdGuestCount);
    _updateNonBokunPkgTotal();
  }

  function _updateNonBokunPkgTotal() {
    const el = document.getElementById('td-guest-pkg-total');
    if (!el) return;
    if (_selectedNonBokunPkg && tdCurrentTour?.pricingType === 'per_person') {
      const total = (_selectedNonBokunPkg.pricePln || 0) * tdGuestCount;
      el.textContent = `= ${total} PLN`;
      el.classList.remove('hidden');
    } else {
      el.classList.add('hidden');
    }
  }

  let tdPayment = 'driver';

  function selectTdPayment(value) {
    tdPayment = value;
    document.querySelectorAll('.pay-opt[data-payment]').forEach(opt => {
      const box = opt.querySelector('.pay-opt-box');
      const active = opt.dataset.payment === value;
