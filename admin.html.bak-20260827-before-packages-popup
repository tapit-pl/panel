function recalcOrder() {
  const totalNet = cpServices.reduce((s, x) => s + (x.net || 0), 0);
  const totalGross = cpServices.reduce((s, x) => s + (x.gross || 0), 0);
  const totalMarginGross = cpServices.reduce((s, x) => s + (x.margin_gross ?? x.margin ?? 0), 0);
  const guestPrice = totalGross + totalMarginGross;
  const commRate = parseFloat(document.getElementById('ord-commission-rate')?.value) || 0;
  const commAmount = totalMarginGross * commRate / 100;
  const tmRevenue = guestPrice - commAmount;
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  set('ord-total-net', fmtPln(totalNet));
  set('ord-total-gross', fmtPln(totalGross));
  set('ord-total-margin', fmtPln(totalMarginGross));
  set('ord-guest-price', fmtPln(guestPrice));
  set('ord-commission-amount', fmtPln(commAmount));
}

function cpToggleCal(e) {
