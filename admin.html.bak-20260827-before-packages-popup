function abShowForm() {
  const hasRates = abRateSelections.some(r => r.count > 0);
  const hasCats  = abCategorySelections.some(c => c.count > 0);

  if (hasRates || hasCats) {
    abGuestCount = hasRates
      ? abRateSelections.reduce((s,r) => s+r.count, 0)
      : abCategorySelections.reduce((s,c) => s+c.count, 0);
    document.getElementById('ab-pax-section').classList.add('hidden');
    const summary = hasRates
      ? abRateSelections.filter(r=>r.count>0).map(r=>`${r.count}× ${r.rate.title}`).join(', ')
      : abCategorySelections.filter(c=>c.count>0).map(c=>`${c.count}× ${c.category.pricingCategoryTitle||c.category.title}`).join(', ');
    const summaryEl = document.getElementById('ab-category-summary');
    summaryEl.textContent = summary;
    summaryEl.classList.remove('hidden');
  } else {
    document.getElementById('ab-pax-section').classList.remove('hidden');
    document.getElementById('ab-pax-display').textContent = abGuestCount;
    document.getElementById('ab-category-summary').classList.add('hidden');
  }

  document.getElementById('ab-price-row').textContent = '';
  document.getElementById('ab-error').classList.add('hidden');
  abSelectPayment('driver');

  // Render guest rows + clear contact fields
  abRenderGuestRows();
  abRenderPriceOverrideSection();
  ['ab-email','ab-phone','ab-notes','ab-pickup-address'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  // Reset + init phone prefix dropdown
  const _abPhPrefix = document.getElementById('ab-phone-prefix');
  const _abPhVal = document.getElementById('ab-phone-prefix-val');
  if (_abPhPrefix) _abPhPrefix.value = '+48';
  if (_abPhVal) _abPhVal.textContent = '🇵🇱 +48';
  initAbPhonePrefixDrop();

  // Transport pickup section — look up from allCommissions for selected rate
  const transportSection = document.getElementById('ab-transport-section');
  const _abRateKey = abSelectedRate?.title || abRateSelections?.[0]?.rate?.title || '';
  const _abCommEntry = allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour?.configId && _abNorm(c.title) === _abNorm(_abRateKey));
  const tp = _abCommEntry?.transport_price_pln || null;
  if (transportSection) {
    const hotelEnabled = abCurrentTour?.allowHotelPickup !== false;
    const meetingEnabled = abCurrentTour?.allowMeetingPoint !== false;
    const hotelRow = transportSection.querySelector('label:has(input[value="hotel"])');
    const meetingRow = transportSection.querySelector('label:has(input[value="meeting"])');
    const priceLabel = document.getElementById('ab-transport-price-label');
    const mpLabel = document.getElementById('ab-meeting-point-label');
    if (hotelRow) hotelRow.style.display = hotelEnabled ? '' : 'none';
    if (meetingRow) meetingRow.style.display = meetingEnabled ? '' : 'none';
    if (priceLabel) priceLabel.textContent = (tp && hotelEnabled) ? `(+${tp} PLN/os.)` : '';
    if (mpLabel) mpLabel.textContent = abCurrentTour?.meetingPoint || '';
    if (hotelEnabled || meetingEnabled) {
      transportSection.classList.remove('hidden');
      const hotelRadio = document.querySelector('input[name="ab-pickup"][value="hotel"]');
      const meetingRadio = document.querySelector('input[name="ab-pickup"][value="meeting"]');
      if (hotelEnabled) {
        if (hotelRadio) hotelRadio.checked = true;
      } else {
        if (meetingRadio) meetingRadio.checked = true;
      }
    } else {
      transportSection.classList.add('hidden');
    }
  }

  const formSection = document.getElementById('ab-modal-form-section');
  document.getElementById('ab-modal-form-date').textContent = abSelectedDate || '';
  formSection.classList.remove('hidden');
  formSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  abTogglePickupAddress();
  abUpdateTransportPrice();
}

function abChangePax(delta) {
  const _abMaxPax = abSelectedSlot?.availabilityCount ?? abCurrentTour?.maxPax ?? 100;
  abGuestCount = Math.max(1, Math.min(abGuestCount + delta, _abMaxPax));
  document.getElementById('ab-pax-display').textContent = abGuestCount;
  abRenderGuestRows();
  abRenderPriceOverrideSection();
  abUpdateTransportPrice();
}

function abTogglePickupAddress() {
  const pickupVal = document.querySelector('input[name="ab-pickup"]:checked')?.value || 'meeting';
  const addrInput = document.getElementById('ab-pickup-address');
  if (addrInput) addrInput.style.display = pickupVal === 'hotel' ? '' : 'none';
  const hotelLabel = document.getElementById('ab-pickup-hotel-label');
  const meetingLabel = document.getElementById('ab-pickup-meeting-label');
  const selectedCls = ['border-2', 'border-brand', 'bg-brand/5'];
  const unselectedCls = ['border', 'border-gray-200'];
  [[hotelLabel, pickupVal === 'hotel'], [meetingLabel, pickupVal === 'meeting']].forEach(([label, isSelected]) => {
    if (!label) return;
    label.classList.remove(...selectedCls, ...unselectedCls);
    label.classList.add(...(isSelected ? selectedCls : unselectedCls));
  });
}

function abUpdateTransportPrice() {
  const pickupVal = document.querySelector('input[name="ab-pickup"]:checked')?.value || 'meeting';
  const rateTitle = abSelectedRate?.title || abRateSelections?.[0]?.rate?.title || '';
  const commEntry = allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour?.configId && _abNorm(c.title) === _abNorm(rateTitle));
  const transportPln = commEntry?.transport_price_pln || 0;
  const transportSurcharge = pickupVal === 'hotel' ? transportPln * abGuestCount : 0;
  const baseTotal = abComputeBaseTotal();
  const total = baseTotal + transportSurcharge;
  const discountedTotal = applyDiscountToTotal(total, abAppliedDiscountPct);
  const priceText = total > 0
    ? (abAppliedDiscountPct
        ? `Estimated total: ${discountedTotal} PLN (was ${total} PLN, −${abAppliedDiscountPct}% ${abAppliedDiscountCode || ''})`
        : `Estimated total: ${total} PLN`) + (transportSurcharge ? ` (incl. ${transportSurcharge} PLN transport)` : '')
    : '';
  const priceRow = document.getElementById('ab-price-row');
  if (priceRow) priceRow.textContent = priceText;
  const ratesPriceRow = document.getElementById('ab-rates-price-row');
  if (ratesPriceRow) ratesPriceRow.textContent = priceText;
}

async function abApplyDiscountCode() {
  const input = document.getElementById('ab-discount-input');
  const msg = document.getElementById('ab-discount-msg');
  const code = (input?.value || '').trim();
  if (!code) return;
  msg.className = 'text-xs mt-1.5 text-gray-400';
  msg.textContent = 'Checking…';
  const { data, error } = await invokeEdge('validate-discount-code', { body: { code } });
  if (error || !data?.valid) {
    abAppliedDiscountCode = null; abAppliedDiscountPct = null;
    msg.className = 'text-xs mt-1.5 text-red-500';
    msg.textContent = 'Invalid or inactive code.';
    abUpdateTransportPrice();
    return;
  }
  abAppliedDiscountCode = data.code || code.toUpperCase();
  abAppliedDiscountPct = data.discount_pct;
  msg.className = 'text-xs mt-1.5 text-green-600';
  msg.innerHTML = `✓ ${escapeHtml(abAppliedDiscountCode)} applied — −${abAppliedDiscountPct}% <button onclick="abRemoveDiscountCode()" class="underline ml-1 text-gray-400 hover:text-gray-600">Remove</button>`;
  abUpdateTransportPrice();
}

function abRemoveDiscountCode() {
  abAppliedDiscountCode = null; abAppliedDiscountPct = null;
  const input = document.getElementById('ab-discount-input');
  if (input) input.value = '';
  const msg = document.getElementById('ab-discount-msg');
  if (msg) { msg.textContent = ''; msg.className = 'text-xs mt-1.5'; }
  abUpdateTransportPrice();
}

function abRenderGuestRows() {
  const container = document.getElementById('ab-guest-rows');
  if (!container) return;
  const INPUT = 'width:100%;font-size:13px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:8px 12px;color:#1a2332;outline:none;';
  const LABEL = 'display:block;font-size:11px;color:#6b7280;margin-bottom:4px;font-weight:600;';
  const rowCount = abCurrentTour?.requireGuestNames ? abGuestCount : 1;
  let html = '';
  for (let i = 1; i <= rowCount; i++) {
    const isFirst = i === 1;
    const req = ' <span style="color:#ef4444">*</span>';
    const label = rowCount > 1 ? `<div style="font-size:11px;color:#64748b;margin-bottom:6px;font-weight:600;">Guest ${i}${isFirst ? ' (lead contact)' : ''}</div>` : '';
    html += `<div style="margin-bottom:${i < rowCount ? '14px' : '0'}">
      ${label}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div>
          <label style="${LABEL}">First name${req}</label>
          <input id="ab-first-${i}" type="text" maxlength="40" style="${INPUT}" placeholder="">
        </div>
        <div>
          <label style="${LABEL}">Last name${req}</label>
          <input id="ab-last-${i}" type="text" maxlength="40" style="${INPUT}" placeholder="">
        </div>
      </div>
    </div>`;
  }
  // preserve values if already entered
  const old = {};
  container.querySelectorAll('input[id^="ab-first-"], input[id^="ab-last-"]').forEach(el => { old[el.id] = el.value; });
  container.innerHTML = html;
  Object.entries(old).forEach(([id, val]) => { const el = document.getElementById(id); if (el) el.value = val; });
}

function abSelectPayment(method) {
  abPayment = method;
  document.querySelectorAll('.ab-pay-btn').forEach(btn => {
    btn.style.borderColor = '#e5e7eb';
    btn.style.borderWidth = '1px';
    btn.style.color = '#6b7280';
    btn.style.background = '#fff';
  });
  const active = document.getElementById(`ab-pay-${method}`);
  if (active) {
    active.style.borderColor = '#E8751A';
    active.style.borderWidth = '2px';
    active.style.color = '#1a2332';
    active.style.background = 'rgba(232,117,26,0.08)';
  }
}

async function abSubmitBooking() {
  // Collect per-guest names
  const abGuests = [];
  for (let i = 1; i <= abGuestCount; i++) {
    abGuests.push({
      firstName: (document.getElementById(`ab-first-${i}`)?.value || '').trim(),
      lastName:  (document.getElementById(`ab-last-${i}`)?.value  || '').trim(),
    });
  }
  const firstName = abGuests[0]?.firstName || '';
  const lastName  = abGuests[0]?.lastName  || '';
  const email      = (document.getElementById('ab-email')?.value || '').trim();
  const phonePrefix = document.getElementById('ab-phone-prefix')?.value || '+48';
  const phoneNumber = (document.getElementById('ab-phone')?.value || '').trim();
  const phone       = phoneNumber ? (phonePrefix + ' ' + phoneNumber) : '';
  const notes       = (document.getElementById('ab-notes')?.value || '').trim();
  const errEl     = document.getElementById('ab-error');
  const btn       = document.getElementById('ab-submit-btn');

  errEl.classList.add('hidden');
  if (!isValidName(firstName) || !isValidName(lastName)) {
    errEl.textContent = 'Please enter a valid first and last name (letters, spaces, hyphens and apostrophes only).';
    errEl.classList.remove('hidden'); return;
  }
  // Validate all additional guests too
  for (let gi = 1; gi < abGuests.length; gi++) {
    const g = abGuests[gi];
    if (abCurrentTour?.requireGuestNames && (!g.firstName || !g.lastName)) {
      errEl.textContent = `Please enter a full name for Guest ${gi + 1} — required for this tour.`;
      errEl.classList.remove('hidden'); return;
    }
    if ((g.firstName || g.lastName) && (!isValidName(g.firstName) || !isValidName(g.lastName))) {
      errEl.textContent = `Please enter a valid name for Guest ${gi + 1} (letters, spaces, hyphens and apostrophes only).`;
      errEl.classList.remove('hidden'); return;
    }
  }
  if (!email) {
    errEl.textContent = 'Guest email is required.';
    errEl.classList.remove('hidden'); return;
  }
  if (!phoneNumber) {
    errEl.textContent = 'Guest phone number is required.';
    errEl.classList.remove('hidden'); return;
  }
  const abPhoneDigits = phoneNumber.replace(/[\s\-\(\)]/g, '');
  if (!/^\d{7,15}$/.test(abPhoneDigits)) {
    errEl.textContent = 'Please enter a valid phone number (7–15 digits).';
    errEl.classList.remove('hidden'); return;
  }

  btn.disabled = true;
  btn.textContent = 'Creating booking…';

  const additionalGuestsStr = abGuests.slice(1).map(g => `${g.firstName} ${g.lastName}`.trim()).filter(Boolean).join(', ');
  const rateTitle = abSelectedRate?.title || abRateSelections?.[0]?.rate?.title || '';
  const detectedLanguage = LANGUAGE_KEYWORDS.find(l => rateTitle.toLowerCase().includes(l.toLowerCase())) || null;
  const _abPickupVal = document.querySelector('input[name="ab-pickup"]:checked')?.value || 'meeting';
  const _abRateTitleForTransport = abSelectedRate?.title || abRateSelections?.[0]?.rate?.title || '';
  const _abCommForTransport = allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour?.configId && _abNorm(c.title) === _abNorm(_abRateTitleForTransport));
  const _abTransportPln = _abCommForTransport?.transport_price_pln || 0;
  const _abTransportSurcharge = _abPickupVal === 'hotel' ? _abTransportPln * abGuestCount : 0;
  const _abPickupAddress = (document.getElementById('ab-pickup-address')?.value || '').trim();
  const _abPickupDesc = _abPickupVal === 'hotel'
    ? (_abPickupAddress || `Hotel pickup${_abTransportPln ? ' (+' + _abTransportPln + ' PLN/os.)' : ''}`)
    : (abCurrentTour?.meetingPoint || 'Meeting point — no hotel transport');

  const bookingId = crypto.randomUUID();
  const dateStr = abSelectedDate;
  const guest = `${firstName} ${lastName}`;
  const tour = abCurrentTour.dbTitle || abCurrentTour.title;

  // ── Price calculation ──
  const _hasRates = abRateSelections.some(r => r.count > 0);
  const _hasCats  = abCategorySelections.some(c => c.count > 0);
  const _standardBaseTotal = abComputeBaseTotal(true);
  const _basePriceTotal = abComputeBaseTotal(false);
  const _priceWasOverridden = _basePriceTotal !== _standardBaseTotal;
  const _originalInsertTotal = _basePriceTotal + _abTransportSurcharge;
  const insertTotal = applyDiscountToTotal(_originalInsertTotal, abAppliedDiscountPct);
  const insertDiscountAmount = abAppliedDiscountPct ? (_originalInsertTotal - insertTotal) : null;
  const _commEntry2 = (abCurrentTour?.configId
    ? allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour.configId)
    : null) || abLookupCommEntry(tour, abCurrentTour?.configId);
  const _commBasePln = _commEntry2?.commission_pln || abLookupComm(tour, abCurrentTour?.configId) || 0;
  const _abTransportCommPln = _abCommForTransport?.transport_commission_pln || 0;
  const _abTransportCommSurcharge = _abPickupVal === 'hotel' ? _abTransportCommPln * abGuestCount : 0;
  const insertComm = (_hasRates
    ? abRateSelections.reduce((s, x) => s + x.count * (abLookupComm(x.rate.title, abCurrentTour?.configId) || _commBasePln), 0)
    : _commBasePln * (_hasCats ? abCategorySelections.filter(c=>c.count>0).reduce((s,c)=>s+c.count,0) : abGuestCount)) + _abTransportCommSurcharge;
  const abPackageLines = _hasRates
    ? abRateSelections.filter(r=>r.count>0).map(r=>`${r.count}x ${r.rate.title}`).join(', ')
    : _hasCats
      ? abCategorySelections.filter(c=>c.count>0).map(c=>`${c.count}x ${c.category.pricingCategoryTitle||c.category.title}`).join(', ')
      : null;

  let bokunReservationCode = null, bokunConfirmationCode = null, bokunBookingId = null;
  let bokunErrMsg = null, bokunFieldErr = null;
  _clearBokunFieldErrors();

  // ── Bokun booking ──
  if (abCurrentTour.bokunId && abSelectedSlot?.startTimeId) {
    try {
      const effectiveRateId = abCurrentTour.bokunForceRateId || abSelectedRate?.id || null;

      const abBuildPassengers = () => {
        const _getGuest = (idx) => {
          const g = abGuests[idx] || abGuests[0] || { firstName, lastName };
          return [
            { questionId: 'firstName', values: [g.firstName || firstName] },
            { questionId: 'lastName',  values: [g.lastName  || lastName]  },
          ];
        };
        if (abCategorySelections.some(c=>c.count>0)) {
          let gIdx = 0;
          return abCategorySelections.filter(c=>c.count>0).flatMap(c =>
            Array.from({ length: c.count }, () => ({
              pricingCategoryId: c.category.id,
              groupSize: 1,
              passengerDetails: _getGuest(gIdx++),
              answers: [], extras: []
            }))
          );
        }
        // abCurrentTour.pricing comes from the activity-detail endpoint and can be empty for
        // activities whose categories only show up in the per-slot availability data — fall
        // back to that before giving up (an empty passengers array is rejected by Bokun).
        const _abFallbackCat = abSelectedRate?.pricesByCategory?.[0] || abSelectedSlot?.rates?.[0]?.pricesByCategory?.[0];
        const catId = abCurrentTour.pricing?.[0]?.id ?? (_abFallbackCat?.pricingCategoryId ?? _abFallbackCat?.id);
        return catId != null
          ? Array.from({ length: abGuestCount }, (_, i) => ({
              pricingCategoryId: catId, groupSize: 1,
              passengerDetails: _getGuest(i),
              answers: [], extras: []
            }))
          : [];
      };

      const optionsPayload = {
        activityId: parseInt(abCurrentTour.bokunId),
        startTimeId: abSelectedSlot.startTimeId,
        ...(effectiveRateId ? { rateId: effectiveRateId } : {}),
        date: dateStr,
        passengers: abBuildPassengers(),
      };
      const { data: optionsRes } = await invokeEdge('bokun-sync', {
        body: { path: '/checkout.json/options/booking-request', method: 'POST', payload: optionsPayload }
      });
      const checkoutOptions = optionsRes?.body?.options || [];
      const checkoutOption = checkoutOptions.find(o => o.type === 'CUSTOMER_NO_PAYMENT') || checkoutOptions[0];
      const optionAnswers = (checkoutOption?.questions || []).map(q => ({
        questionId: q.questionId, values: [q.defaultValue ?? 'false']
      }));

      const _payLabels = { driver: 'Pay at driver', hotel: 'Pay at hotel', link: 'Payment link' };
      const bookingNote = [
        _payLabels[abPayment] || '',
        abRateSelections.filter(r=>r.count>0).map(r=>`${r.count}x ${r.rate.title}`).join(', ') ||
        abCategorySelections.filter(c=>c.count>0).map(c=>`${c.count}x ${c.category.pricingCategoryTitle||c.category.title}`).join(', ') ||
        (abSelectedNonBokunPkg ? abSelectedNonBokunPkg.title : ''),
        additionalGuestsStr ? `Guests: ${additionalGuestsStr}` : '',
        notes
      ].filter(Boolean).join(' | ');

      const submitPayload = {
        source: 'DIRECT_REQUEST',
        checkoutOption: 'CUSTOMER_FULL_PAYMENT',
        paymentMethod: 'RESERVE_FOR_EXTERNAL_PAYMENT',
        sendNotificationToMainContact: false,
        directBooking: {
          mainContactDetails: [
            { questionId: 'firstName', values: [firstName] },
            { questionId: 'lastName',  values: [lastName] },
            { questionId: 'email', values: [email] },
            { questionId: 'phoneNumber', values: [phone] },
            { questionId: 'nationality', values: ['GB'] },
            ...(abCurrentTour?.bokunRequiresDob ? [{ questionId: 'dateOfBirth', values: ['1990-01-01'] }] : []),
          ],
          promoCode: 'HOTELBOOKING',
          activityBookings: [{
            activityId: parseInt(abCurrentTour.bokunId),
            startTimeId: abSelectedSlot.startTimeId,
            ...(effectiveRateId ? { rateId: effectiveRateId } : {}),
            date: dateStr,
            passengers: abBuildPassengers(),
            note: bookingNote || undefined,
            answers: [],
            ...(abCurrentTour?.bokunForcePickupPlaceId ? { pickupPlaceId: parseInt(abCurrentTour.bokunForcePickupPlaceId) } : {}),
            pickupAnswers: abCurrentTour?.bokunForcePickupPlaceId ? [] : [{ questionId: 'pickupPlaceDescription', values: [_abPickupDesc] }],
            dropoffAnswers: [],
          }],
        },
      };
      const { data: submitRes } = await invokeEdge('bokun-sync', {
        body: { path: '/checkout.json/submit', method: 'POST', payload: submitPayload }
      });
      const submitBody = submitRes?.body;
      const reservedCode = submitBody?.booking?.confirmationCode || submitBody?.confirmationCode;
      if (reservedCode) {
        bokunReservationCode = reservedCode;
        if (abPayment !== 'link') {
          const { data: confirmRes } = await invokeEdge('bokun-sync', {
            body: { path: `/checkout.json/confirm-reserved/${reservedCode}`, method: 'POST', payload: { sendNotificationToMainContact: false } }
          });
          const confirmBody = confirmRes?.body;
          bokunConfirmationCode = confirmBody?.booking?.confirmationCode || confirmBody?.confirmationCode || reservedCode;
          bokunBookingId = confirmBody?.booking?.bookingId || confirmBody?.booking?.id || submitBody?.booking?.bookingId || submitBody?.booking?.id || null;
        }
      } else {
        console.warn('[abBooking] submit failed — raw Bokun response:', JSON.stringify(submitBody));
        const msgStr = submitBody?.message || '';
        const minMatch = msgStr.match(/min participants \((\d+) passengers?\)/);
        const minPax = minMatch ? parseInt(minMatch[1]) : null;
        if (minPax) {
          bokunErrMsg = `This tour requires a minimum of ${minPax} participant${minPax>1?'s':''}.`;
        } else {
          bokunFieldErr = _resolveBokunFieldError(submitBody, {
            phone: 'ab-phone', email: 'ab-email',
            firstName: 'ab-first-1', lastName: 'ab-last-1',
          });
          bokunErrMsg = bokunFieldErr?.userMsg || msgStr || null;
        }
      }
    } catch(e) { bokunErrMsg = 'Bokun error: ' + e.message; }
  }

  // Guard: Bokun tour must have confirmation
  if (abCurrentTour.bokunId && !(abPayment === 'link' ? !!bokunReservationCode : !!bokunConfirmationCode)) {
    errEl.textContent = bokunErrMsg || 'Booking failed — the reservation was not created. Please try again or contact Thousand Miles support.';
    errEl.classList.remove('hidden');
    if (bokunFieldErr?.fieldId) _showBokunFieldError(bokunFieldErr.fieldId, bokunFieldErr.userMsg);
    btn.disabled = false;
    btn.textContent = 'Confirm booking';
    return;
  }

  // ── Supabase insert (before Stripe, so create-stripe-session reads the already-discounted total from DB) ──
  const insertStatus = abPayment === 'link' ? 'payment_pending' : abPayment === 'hotel' ? 'paid' : 'to_be_paid';
  const _abRawTime = abSelectedSlot?.startTime || '';
  const timeStr = _abRawTime ? (_abRawTime.length > 8 ? _abRawTime.slice(11,16) : _abRawTime.slice(0,5)) : null;

  const { error: dbErr } = await db.from('bookings').insert({
    id: bookingId,
    tour,
    date: dateStr,
    time: timeStr,
    guest,
    email: email || null,
    phone: phone || null,
    pax: abGuestCount,
    total: insertTotal || null,
    comm: insertComm || null,
    payment_method: abPayment,
    status: insertStatus,
    stripe_session_id: null,
    stripe_session_url: null,
    pickup: _abPickupDesc,
    partner_id: null,
    bokun_confirmation_code: abPayment === 'link' ? (bokunReservationCode || null) : (bokunConfirmationCode || null),
    bokun_booking_id: bokunBookingId,
    notes: notes || null,
    additional_guests: additionalGuestsStr || null,
    language: detectedLanguage,
    source: 'admin',
    package_lines: abPackageLines || null,
    created_by_name: currentAdminName || currentAdminEmail || null,
    start_time_id: abSelectedSlot?.startTimeId != null ? String(abSelectedSlot.startTimeId) : null,
    discount_code: abAppliedDiscountCode || null,
    discount_pct: abAppliedDiscountPct || null,
    discount_amount: insertDiscountAmount,
    price_overridden: _priceWasOverridden,
    price_override_original_total: _priceWasOverridden ? (_standardBaseTotal + _abTransportSurcharge) : null,
  });

  if (dbErr) {
    btn.disabled = false;
    btn.textContent = 'Confirm booking';
    errEl.textContent = 'Database error: ' + dbErr.message;
    errEl.classList.remove('hidden');
    return;
  }

  // ── Stripe (payment link) — created after insert so the edge function reads the correct, already-discounted total ──
  let stripeSessionUrl = null, stripeSessionId = null;
  if (abPayment === 'link' && bokunReservationCode) {
    try {
      const { data: stripeRes } = await invokeEdge('create-stripe-session', {
        body: { booking_id: bookingId, bokun_reservation_code: bokunReservationCode, pax: abGuestCount, tour_name: tour, date: dateStr, guest_name: guest, guest_email: email }
      });
      stripeSessionUrl = stripeRes?.session_url;
      stripeSessionId  = stripeRes?.session_id || null;
      if (stripeSessionId) {
        await db.from('bookings').update({ stripe_session_id: stripeSessionId, stripe_session_url: stripeSessionUrl || null }).eq('id', bookingId);
      }
    } catch(e) { /* non-fatal */ }
  }

  btn.disabled = false;
  btn.textContent = 'Confirm booking';

  abLastBookingData = {
    bookingId,
    bokunConfirmationCode,
    bokunBookingId,
    tourName: tour,
    date: dateStr,
    time: timeStr,
    guestName: guest,
    email, phone, pax: abGuestCount,
    total: null,
    pickup: null,
    emailBlocks: abCurrentTour?.emailBlocks || [],
    payment: abPayment,
    status: insertStatus,
    packageLines: abPackageLines || null,
  };

  logActivity('admin_booking_created',
    `${tour} · ${dateStr} · ${abGuestCount} pax · ${abPayment} · ${bokunConfirmationCode || bokunReservationCode || bookingId}`,
    bookingId
  ).catch(() => {});

  const refLabel = bokunConfirmationCode || (bokunBookingId ? 'TM-'+bokunBookingId : '#'+bookingId.split('-')[0].toUpperCase());
  document.getElementById('ab-success-ref').textContent = `Booking reference: ${refLabel}`;
  document.getElementById('ab-modal-form-section')?.classList.add('hidden');
  document.getElementById('ab-step-success')?.classList.remove('hidden');
  document.getElementById('ab-step-success')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  // Odśwież All Bookings i Hotel Bookings w tle
  loadBookings().then(() => { _lastDashRender = 0; }).catch(() => {});
  _hbLoaded = false;

  if (abPayment === 'link' && stripeSessionUrl) {
    document.getElementById('ab-success-ref').innerHTML =
      `Booking reference: ${refLabel}<br><a href="${stripeSessionUrl}" target="_blank" class="text-brand underline mt-2 inline-block">Payment link →</a>`;
  }

  if (email && (abPayment === 'driver' || abPayment === 'hotel')) {
    invokeEdge('send-booking-confirmation', { body: {
      booking_id: bookingId,
      bokun_booking_id: bokunBookingId || null,
      bokun_confirmation_code: bokunConfirmationCode || null,
