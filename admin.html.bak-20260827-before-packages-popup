    <p id="modal-confirm-msg" style="font-size:14px;line-height:1.6;margin:0 0 24px;white-space:pre-line;color:#e2e8f0"></p>
    <div style="display:flex;gap:12px;justify-content:flex-end">
      <button id="modal-confirm-cancel" style="padding:8px 16px;font-size:14px;font-weight:600;border-radius:10px;border:none;cursor:pointer;background:rgba(255,255,255,0.08);color:#94a3b8">Cancel</button>
      <button id="modal-confirm-ok" style="padding:8px 16px;font-size:14px;font-weight:600;border-radius:10px;border:none;cursor:pointer;background:#dc2626;color:#fff">OK</button>
    </div>
  </div>
</div>

<!-- CUSTOM PROMPT DIALOG — must be last child of body for correct stacking -->
<div id="modal-prompt" style="position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.75)">
  <div style="background:#1a2332;border:1px solid rgba(255,255,255,0.08);border-radius:16px;box-shadow:0 25px 50px rgba(0,0,0,0.5);padding:24px;width:320px;max-width:90vw">
    <p id="modal-prompt-msg" style="font-size:14px;line-height:1.6;margin:0 0 12px;white-space:pre-line;color:#e2e8f0"></p>
    <input id="modal-prompt-input" type="text" style="width:100%;box-sizing:border-box;padding:9px 12px;font-size:14px;border-radius:10px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);color:#f1f5f9;outline:none;margin-bottom:20px" onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('modal-prompt-ok').click();}if(event.key==='Escape')document.getElementById('modal-prompt-cancel').click();">
    <div style="display:flex;gap:12px;justify-content:flex-end">
      <button id="modal-prompt-cancel" style="padding:8px 16px;font-size:14px;font-weight:600;border-radius:10px;border:none;cursor:pointer;background:rgba(255,255,255,0.08);color:#94a3b8">Cancel</button>
      <button id="modal-prompt-ok" style="padding:8px 16px;font-size:14px;font-weight:600;border-radius:10px;border:none;cursor:pointer;background:#E8751A;color:#fff">OK</button>
    </div>
  </div>
</div>

<div id="admin-comm-tip" style="position:fixed;width:230px;background:#111827;color:#cbd5e1;font-size:11px;line-height:1.55;border-radius:10px;padding:10px 12px;box-shadow:0 4px 20px rgba(0,0,0,0.5);opacity:0;pointer-events:none;transition:opacity 0.15s;z-index:99999;text-align:left">Booking created in the admin panel — no hotel partner receives this commission.</div>

</body>
</html>
