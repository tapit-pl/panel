  async function loadTickets() {
    const myEmail = currentAdminEmail || '';
    const { data, error } = await db.from('support_tickets')
      .select('*, support_messages(id, created_at, sender_type)')
      .order('updated_at', { ascending: false });
    if (error) { console.error('tickets:', error); return; }

    const ticketIds = (data||[]).map(t => t.id);
    let readMap = {};
    if (ticketIds.length > 0 && myEmail) {
      const { data: reads } = await db.from('support_reads').select('ticket_id, last_read_at').eq('user_email', myEmail).in('ticket_id', ticketIds);
      (reads||[]).forEach(r => { readMap[r.ticket_id] = r.last_read_at; });
    }

    allTickets.length = 0;
    (data||[]).forEach(t => {
      const msgs = t.support_messages || [];
      const lastPartner = msgs.filter(m => m.sender_type==='partner').sort((a,b) => b.created_at.localeCompare(a.created_at))[0];
      const myLastRead  = readMap[t.id] ? new Date(readMap[t.id]).getTime() : 0;
      const lastMsgTs   = lastPartner ? new Date(lastPartner.created_at).getTime() : 0;
      allTickets.push({
        id:            t.id,
        partner:       t.partner_name || t.partner_email || '—',
        partner_email: t.partner_email || '',
        subject:       t.subject,
        category:      t.category,
        priority:      t.priority,
        status:        t.status,
        msgCount:      msgs.length,
        received:      new Date(t.created_at).toLocaleDateString('en',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}),
        updated:       new Date(t.updated_at).toLocaleDateString('en',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}),
        createdAtRaw:  t.created_at,
        unread:        lastMsgTs > myLastRead
      });
    });

    const categories = [...new Set(allTickets.map(t => t.category))].filter(Boolean).sort();
    mselSetOptions('msel-ticket-category', categories.map(c => ({ value: c, label: c })));
    const partners = [...new Set(allTickets.map(t => t.partner))].filter(Boolean).sort();
    mselSetOptions('msel-ticket-partner', partners.map(p => ({ value: p, label: p })));
    applyTicketFilters();
  }

