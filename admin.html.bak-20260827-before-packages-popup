  async function saveContactEdit() {
    const b = allBookings.find(x => x.id === editingContactId);
    if (!b) return;
    const fn    = document.getElementById('cem-firstname').value.trim();
    const ln    = document.getElementById('cem-lastname').value.trim();
    const email = document.getElementById('cem-email').value.trim();
    const phone = document.getElementById('cem-phone').value.trim();
    const guest = [fn, ln].filter(Boolean).join(' ');

    const btn = document.getElementById('cem-save-btn');
    btn.disabled = true;
    btn.textContent = 'Saving…';

    const { error } = await db.from('bookings').update({ guest, email: email || null, phone: phone || null }).eq('id', editingContactId);


    if (!error) {
      Object.assign(b, { guest, email, phone });
      renderBookingsTable();

      if (b._bokunBookingId) {
        try {
          const { data: bokunRes, error: bokunErr } = await invokeEdge('bokun-sync', {
            body: { path: `/booking.json/${b._bokunBookingId}/customer`, method: 'PUT', payload: { firstName: fn, lastName: ln, email: email || undefined, phoneNumber: phone || undefined } },
          });
        } catch(e) { console.warn('[Bokun] customer update failed:', e?.message); }
      } else {
        console.warn('[Bokun] skipped — no _bokunBookingId for booking', editingContactId);
      }
    }

    btn.disabled = false;
    btn.textContent = 'Save changes';
    if (!error) closeContactEdit();
    else showToast('Failed to save contact. Please try again.', 'error');

    const toast = document.createElement('div');
    toast.className = `fixed bottom-6 right-6 z-50 ${!error?'bg-green-500':'bg-red-500'} text-white text-sm font-semibold px-5 py-3.5 rounded-xl shadow-xl flex items-center gap-2 fade-in`;
    toast.innerHTML = !error
      ? '<i class="fa-solid fa-check"></i> Guest details updated'
      : '<i class="fa-solid fa-triangle-exclamation"></i> Update failed';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

