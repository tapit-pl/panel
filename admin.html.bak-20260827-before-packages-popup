  async function quickMarkPaid(id) {
    const b0 = allBookings.find(x => x.id === id);
    const guestLabel = b0?.guest ? ` for ${b0.guest}` : '';
    if (!await showConfirm(`Mark booking${guestLabel} as Paid?`, { okLabel: 'Mark as paid', okColor: '#22c55e' })) return;
    const { error } = await db.from('bookings').update({ status: 'paid' }).eq('id', id);
    if (error) { showToast('Failed to mark as paid.', 'error', error.message); return; }
    const b = allBookings.find(x => x.id === id);
    if (b) b.status = 'paid';
    const pb = partnerBookings.find(x => x.id === id);
    if (pb) pb.status = 'paid';
    filterAllBookings();
    if (_hbLoaded) filterHotelBookings();
    showToast('Oznaczono jako Paid ✓');
    logActivity('booking_quick_paid', `Booking ${b?.bokun_confirmation_code || id} (${b?.guest || ''}) marked paid`, id).catch(() => {});
  }

  document.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-action="cancel"]');
    if (!btn) return;
    cancelBooking(btn.dataset.id, btn.dataset.guest, btn.dataset.hasStripe === 'true', true);
  });

  async function cancelBooking(id, guestName, hasStripe, isDbBooking = true) {
    if (currentAdminRole === 'staff') { showToast('Manager or admin role required.', 'error'); return; }
    const refundMsg = hasStripe ? ' and refund the Stripe payment' : '';
    if (!await showConfirm(`Cancel booking for ${guestName}${refundMsg}?\n\nThis cannot be undone.`, { okLabel: 'Cancel booking', okColor: '#dc2626' })) return;
    const btn = document.querySelector(`[data-action="cancel"][data-id="${id}"]`);
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin text-xs"></i>'; }
    try {
      const body = isDbBooking ? { booking_id: id } : { bokun_confirmation_code: id };
      const { data, error } = await invokeEdge('cancel-booking', { body });
      if (error || !data?.success) {
        showToast('Failed to cancel booking.', 'error', error?.message || data?.error);
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-xmark text-xs"></i>'; }
        return;
      }
      if (data?.bokun?.ok === false) {
        showToast('Cancelled in system — Bokun cancellation failed. Cancel manually in Bokun.', 'error');
      }
      const b = allBookings.find(x => x.id === id);
      if (b) b.status = 'cancelled';
      const pb = partnerBookings.find(x => x.id === id);
      if (pb) pb.status = 'cancelled';
      logActivity('booking_cancelled', `Booking ${allBookings.find(x=>x.id===id)?.bokun_confirmation_code||id} (${guestName}) cancelled`, id).catch(() => {});
      filterAllBookings();
      if (_hbLoaded) filterHotelBookings();
    } catch(e) {
      showToast('Failed to cancel booking.', 'error', e.message);
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-xmark text-xs"></i>'; }
    }
  }

  async function forceUnlockBooking(id) {
    if (currentAdminRole !== 'admin') { showToast('Admin role required.', 'error'); return; }
    const b = allBookings.find(x => x.id === id) || partnerBookings.find(x => x.id === id);
    if (!await showConfirm(`Force unlock booking for ${b?.guest || id}?\n\nThis sets status back to 'paid'. You may need to handle the cancellation or refund manually.`, { okLabel: 'Unlock', okColor: '#e8751a' })) return;
    const { error } = await db.from('bookings').update({ status: 'paid' }).eq('id', id).eq('status', 'cancelling');
    if (error) { showToast('Failed to unlock booking.', 'error', error.message); return; }
    if (b) b.status = 'paid';
    const pb = partnerBookings.find(x => x.id === id);
    if (pb) pb.status = 'paid';
    filterAllBookings();
    if (_hbLoaded) filterHotelBookings();
    showToast('Booking unlocked — status set to Paid');
    logActivity('booking_force_unlocked', `Booking ${b?.bokun_confirmation_code || id} (${b?.guest || ''}) force-unlocked from cancelling`, id).catch(() => {});
  }

