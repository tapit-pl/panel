async function mbFetchAvailabilityForMonth() {
  const m = mbCurrentMonth;
  const year = m.getFullYear(), month = m.getMonth();
  const firstDay = `${year}-${String(month+1).padStart(2,'0')}-01`;
  const daysInMonth = new Date(year, month+1, 0).getDate();
  const lastDay = `${year}-${String(month+1).padStart(2,'0')}-${String(daysInMonth).padStart(2,'0')}`;

  if (mbCurrentTour.bokunId) {
    const loadEl = document.getElementById('mb-cal-loading');
    if (loadEl) { loadEl.style.display = 'block'; }
    try {
      const { data: avail } = await invokeEdge('bokun-sync', {
        body: { path: `/activity.json/${mbCurrentTour.bokunId}/availabilities?start=${firstDay}&end=${lastDay}`, method: 'GET' }
      });
      const items = avail?.body;
      if (Array.isArray(items) && items.length > 0) {
        items.forEach(entry => {
          if (entry.unavailable || entry.soldOut) return;
          const d = new Date(entry.date).toISOString().slice(0, 10);
          if (!d) return;
          if (!mbAvailability[d]) mbAvailability[d] = [];
          const rates = (entry.rates || []).map(r => {
            const priceInfo = (entry.pricesByRate || []).find(p => p.activityRateId === r.id);
            const cats = priceInfo?.pricePerCategoryUnit || [];
            return { id: r.id, title: r.title.trim(), price: cats[0]?.amount, pricesByCategory: cats };
          });
          mbAvailability[d].push({
            startTime: entry.startTime || '',
            startTimeId: entry.startTimeId,
            availabilityCount: entry.availabilityCount || 0,
            rates,
          });
        });
      }
    } catch(e) {}
    if (loadEl) { loadEl.style.display = 'none'; }
  } else {
    // Non-Bokun tour: all future dates
    const manualSlots = mbCurrentTour.manualSlots?.length
      ? mbCurrentTour.manualSlots.map(s => ({ startTime: s.time || null, startTimeId: s.id || 'manual', availabilityCount: null }))
      : [{ startTime: null, startTimeId: 'manual', availabilityCount: null }];
    const today = new Date().toISOString().slice(0, 10);
    const cur = new Date(firstDay + 'T12:00:00');
    const end = new Date(lastDay + 'T12:00:00');
    while (cur <= end) {
      const ds = cur.toISOString().slice(0, 10);
      if (ds >= today) mbAvailability[ds] = manualSlots;
      cur.setDate(cur.getDate() + 1);
    }
  }
  mbRenderCalendar();
}

function mbRenderCalendar() {
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const m = mbCurrentMonth;
  document.getElementById('mb-month-label').textContent = `${MONTHS[m.getMonth()]} ${m.getFullYear()}`;
  const today = new Date().toISOString().slice(0,10);
  const firstDow = (new Date(m.getFullYear(), m.getMonth(), 1).getDay() + 6) % 7;
  const days = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
  let html = '';
  for (let i = 0; i < firstDow; i++) html += '<div></div>';
  for (let d = 1; d <= days; d++) {
    const ds = `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const avail = mbAvailability[ds];
    const past = ds < today, sel = ds === mbSelectedDate, isToday = ds === today;
    let style = 'width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin:auto;font-size:12px;';
    let onclick = '';
    if (sel) style += 'background:#E8751A;color:#fff;font-weight:700;cursor:pointer;';
    else if (avail && !past) {
      style += 'background:#FFF3EA;color:#E8751A;font-weight:600;cursor:pointer;';
      if (isToday) style += 'outline:1.5px solid #E8751A;';
      onclick = `onclick="mbSelectDate('${ds}')"`;
    } else if (past) style += 'color:#e5e7eb;';
    else style += 'color:#d1d5db;';
    html += `<div style="display:flex;align-items:center;justify-content:center;"><div style="${style}" ${onclick}>${d}</div></div>`;
  }
  document.getElementById('mb-calendar-grid').innerHTML = html;
}

