  function activityChangePage(delta) {
    const totalPages = Math.max(1, Math.ceil(activityTotalCount / ACTIVITY_PAGE_SIZE));
    activityPage = Math.min(totalPages - 1, Math.max(0, activityPage + delta));
    applyActivityFilters(true);
  }

  function renderActivityPager() {
    const list = document.getElementById('activity-log-list');
    if (!list) return;
    const totalPages = Math.max(1, Math.ceil(activityTotalCount / ACTIVITY_PAGE_SIZE));
    const start = activityPage * ACTIVITY_PAGE_SIZE;
    let pager = document.getElementById('activity-pager');
    if (totalPages > 1) {
      if (!pager) {
        pager = document.createElement('div');
        pager.id = 'activity-pager';
        pager.className = 'flex items-center justify-between px-5 py-3 border-t border-gray-100 text-xs text-gray-500';
        list.parentElement.appendChild(pager);
      }
      pager.innerHTML = `<span>${activityTotalCount === 0 ? 0 : start + 1}–${Math.min(start + ACTIVITY_PAGE_SIZE, activityTotalCount)} of ${activityTotalCount}</span>
        <div class="flex gap-2">
          <button onclick="activityChangePage(-1)" class="px-3 py-1.5 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-40" ${activityPage === 0 ? 'disabled' : ''}>← Previous</button>
          <button onclick="activityChangePage(1)" class="px-3 py-1.5 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-40" ${activityPage >= totalPages - 1 ? 'disabled' : ''}>Next →</button>
        </div>`;
    } else if (pager) {
      pager.remove();
    }
  }

