function applyDiscountToTotal(total, pct) {
  if (!pct) return total;
  return Math.max(0, Math.round(total * (1 - pct / 100)));
}

// Current price line items regardless of which UI shape produced the selection
// (rate/package picker, category picker, non-Bokun package, or flat fallback).
function abGetPriceLineItems() {
  if (abSelectedNonBokunPkg) {
    return [{ key: `pkg:${abSelectedNonBokunPkg.id}`, label: abSelectedNonBokunPkg.title,
      defaultPrice: abSelectedNonBokunPkg.price_pln || 0, count: abCurrentTour?.pricingType === 'package' ? 1 : abGuestCount,
      isPackageTotal: abCurrentTour?.pricingType === 'package' }];
  }
  const hasRates = abRateSelections.some(r => r.count > 0);
  const hasCats  = abCategorySelections.some(c => c.count > 0);
  if (hasRates) {
    return abRateSelections.filter(r => r.count > 0).map(r => ({
      key: `rate:${r.rate.id}`, label: r.rate.title,
      defaultPrice: abLookupPln(r.rate.title, abCurrentTour?.configId) || abLookupPln(abCurrentTour?.title, abCurrentTour?.configId) || 0, count: r.count }));
  }
  const commEntry = (abCurrentTour?.configId
    ? allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour.configId)
    : null) || abLookupCommEntry(abCurrentTour?.title, abCurrentTour?.configId);
  if (hasCats) {
    return abCategorySelections.filter(c => c.count > 0).map(c => {
      const catTitle = c.category.title || c.category.pricingCategoryTitle || 'Guest';
      return { key: `cat:${c.category.id}`, label: catTitle,
        defaultPrice: abCategoryPln(commEntry, catTitle) ?? (commEntry?.price_pln || abLookupPln(abCurrentTour?.title, abCurrentTour?.configId) || 0), count: c.count };
    });
  }
  return [{ key: 'flat', label: abCurrentTour?.title || 'Guest',
    defaultPrice: commEntry?.price_pln || abLookupPln(abCurrentTour?.title, abCurrentTour?.configId) || 0, count: abGuestCount }];
}

// ignoreOverrides=true → standard price (used as the "before override" reference point)
function abComputeBaseTotal(ignoreOverrides) {
  return abGetPriceLineItems().reduce((sum, item) => {
    const unit = ignoreOverrides ? item.defaultPrice : (abPriceOverrides[item.key] ?? item.defaultPrice);
    return sum + (item.isPackageTotal ? unit : unit * item.count);
  }, 0);
}

function abRenderPriceOverrideSection() {
  const container = document.getElementById('ab-price-override-rows');
  if (!container) return;
  container.innerHTML = abGetPriceLineItems().map(item => {
    const val = abPriceOverrides[item.key] ?? item.defaultPrice;
    const countLabel = (!item.isPackageTotal && item.count > 1) ? ` <span class="text-gray-400">×${item.count}</span>` : '';
    return `<div class="flex items-center justify-between gap-3 py-1">
      <div class="text-sm text-dark">${escapeHtml(item.label)}${countLabel}</div>
      <div class="flex items-center gap-1.5">
        <input type="number" min="0" step="1" value="${val}"
          oninput="abSetPriceOverride('${item.key.replace(/'/g,"\\'")}', this.value)"
          class="w-24 text-sm text-right border border-gray-200 rounded-lg px-2 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand/30">
        <span class="text-xs text-gray-400">PLN</span>
      </div>
    </div>`;
  }).join('');
}

function abSetPriceOverride(key, val) {
  const n = parseFloat(val);
  if (isNaN(n) || n < 0) return;
  abPriceOverrides[key] = n;
  abUpdateTransportPrice();
}
const LANGUAGE_KEYWORDS = ['English','Polish','German','French','Spanish','Italian','Czech','Slovak','Hungarian','Russian','Ukrainian','Chinese','Japanese','Korean','Portuguese','Dutch','Swedish','Norwegian','Danish','Hebrew','Arabic','Romanian','Bulgarian','Croatian','Serbian','Turkish'];


function _abNorm(n) { return (n||'').toLowerCase().replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim(); }
// configId, when passed, restricts the search pool to packages belonging to that tour only —
// without it, a rate title can fuzzy-match a same-named package configured under a different tour.
function _abCommPool(configId) {
  if (!allCommissions?.length) return [];
  return configId ? allCommissions.filter(c => c.tour_config_id === configId) : allCommissions;
}
function abLookupPln(name, configId) {
  const pool = _abCommPool(configId);
  if (!name || !pool.length) return null;
  const key = _abNorm(name);
  const exact = pool.find(c => _abNorm(c.title) === key && c.active);
  if (exact) return exact.price_pln || null;
  const words = key.split(' ').filter(w => w.length > 2);
  if (!words.length) return null;
  const fwd = pool.find(c => c.active && words.every(w => _abNorm(c.title).includes(w)));
  if (fwd) return fwd.price_pln || null;
  const rev = pool.find(c => {
    if (!c.active) return false;
    const kw = _abNorm(c.title).split(' ').filter(w => w.length > 2);
    return kw.length > 0 && kw.every(w => key.includes(w));
  });
  return rev?.price_pln || null;
}
function abLookupCommEntry(name, configId) {
  const pool = _abCommPool(configId);
  if (!name || !pool.length) return null;
  const key = _abNorm(name);
  const exact = pool.find(c => _abNorm(c.title) === key && c.active);
  if (exact) return exact;
  const words = key.split(' ').filter(w => w.length > 2);
  if (!words.length) return null;
  const fwd = pool.find(c => c.active && words.every(w => _abNorm(c.title).includes(w)));
  if (fwd) return fwd;
  return pool.find(c => {
    if (!c.active) return false;
    const kw = _abNorm(c.title).split(' ').filter(w => w.length > 2);
    return kw.length > 0 && kw.every(w => key.includes(w));
  }) || null;
}
function abCategoryPln(commEntry, categoryTitle) {
  if (!commEntry) return null;
  const t = (categoryTitle || '').toLowerCase();
  if (t.includes('child') || t.includes('kid')) return commEntry.price_child ?? null;
  if (t.includes('infant') || t.includes('baby')) return commEntry.price_infant ?? null;
  if (t.includes('student')) return commEntry.price_student ?? null;
  if (t.includes('senior')) return commEntry.price_senior ?? null;
  return commEntry.price_pln ?? null;
}
function abLookupComm(name, configId) {
  const pool = _abCommPool(configId);
  if (!name || !pool.length) return null;
  const key = _abNorm(name);
  const exact = pool.find(c => _abNorm(c.title) === key && c.active);
  if (exact) return exact.commission_pln || null;
  const words = key.split(' ').filter(w => w.length > 2);
  if (!words.length) return null;
  const fwd = pool.find(c => c.active && words.every(w => _abNorm(c.title).includes(w)));
  if (fwd) return fwd.commission_pln || null;
  const rev = pool.find(c => {
    if (!c.active) return false;
    const kw = _abNorm(c.title).split(' ').filter(w => w.length > 2);
    return kw.length > 0 && kw.every(w => key.includes(w));
  });
  return rev?.commission_pln || null;
}

