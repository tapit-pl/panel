function isValidName(v) {
  if (!v || v.length < 2) return false;
  if (!/\p{L}/u.test(v)) return false;
  if (/[^\p{L}\s'''.\-]/u.test(v)) return false;
  if (/\s{2}/.test(v)) return false;
  return true;
}

// ── Bokun field-error helpers ──────────────────────────────────────────────
const _BOKUN_ERR_RULES = [
  { match: ['not a valid phone', 'phone number', 'phone'],    field: 'phone',     msg: 'This phone number is not accepted. Enter a full number with country code, e.g. +48 600 100 200.' },
  { match: ['email'],                                          field: 'email',     msg: 'This e-mail address was rejected. Please check it and try again.' },
  { match: ['first name', 'firstname'],                        field: 'firstName', msg: "Please check the guest's first name." },
  { match: ['last name', 'lastname'],                          field: 'lastName',  msg: "Please check the guest's last name." },
  { match: ['too long', 'maximum length', 'max length'],      field: null,        msg: 'One of the fields is too long. Please shorten the text.' },
  { match: ['sold out', 'no availability', 'not available', 'fully booked', 'no seats'],
                                                               field: 'date',      msg: 'This departure is no longer available. Please choose another date or time.' },
];

const _BOKUN_QID_FIELD = { phoneNumber: 'phone', phone: 'phone', email: 'email', firstName: 'firstName', lastName: 'lastName' };
const _BOKUN_QID_MSG  = {
  phone:     'This phone number is not accepted. Enter a full number with country code, e.g. +48 600 100 200.',
  email:     'This e-mail address was rejected. Please check it and try again.',
  firstName: "Please check the guest's first name.",
  lastName:  "Please check the guest's last name.",
};
function _resolveBokunFieldError(submitBody, fieldIds) {
  // 1. Structured: fields.errors[].questionId
  const fieldErrors = submitBody?.fields?.errors;
  if (Array.isArray(fieldErrors) && fieldErrors.length) {
    for (const fe of fieldErrors) {
      const key = _BOKUN_QID_FIELD[fe.questionId];
      if (key) return { fieldId: fieldIds[key] || null, userMsg: _BOKUN_QID_MSG[key] || fe.message };
      const raw = (fe.message || '').toLowerCase();
      for (const rule of _BOKUN_ERR_RULES) {
        if (rule.match.some(p => raw.includes(p))) {
          return { fieldId: rule.field ? (fieldIds[rule.field] || null) : null, userMsg: rule.msg };
        }
      }
    }
  }
  // 2. Fallback: top-level message text
  const raw = (submitBody?.message || submitBody?.error || '').toLowerCase();
  if (!raw) return null;
  for (const rule of _BOKUN_ERR_RULES) {
    if (rule.match.some(p => raw.includes(p))) {
      return { fieldId: rule.field ? (fieldIds[rule.field] || null) : null, userMsg: rule.msg };
    }
  }
  return null;
}

function _showBokunFieldError(fieldId, msg) {
  if (!fieldId) return;
  const el = document.getElementById(fieldId);
  if (!el) return;
  el.style.borderColor = '#ef4444';
  el.style.boxShadow = '0 0 0 3px rgba(239,68,68,0.15)';
  const errId = '__bferr_' + fieldId;
  let errDiv = document.getElementById(errId);
  if (!errDiv) {
    errDiv = document.createElement('div');
    errDiv.id = errId;
    errDiv.style.cssText = 'font-size:12px;color:#ef4444;margin-top:4px;';
    el.insertAdjacentElement('afterend', errDiv);
  }
  errDiv.textContent = msg;
  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function _clearBokunFieldErrors() {
  document.querySelectorAll('[id^="__bferr_"]').forEach(el => el.remove());
  ['mb-first','mb-last','mb-email','mb-phone',
   'ab-first-1','ab-last-1','ab-email','ab-phone',
   'ord-guest-firstname','ord-guest-surname','ord-guest-email','ord-guest-phone'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.style.borderColor = ''; el.style.boxShadow = ''; }
  });
}
