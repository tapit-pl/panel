  async function renderEntityTimeline(containerId, ref) {
    const el = document.getElementById(containerId);
    if (!el || !ref) return;
    el.innerHTML = '<div style="font-size:12px;color:#64748b">Loading…</div>';
    const { data, error } = await db.from('audit_log').select('*').eq('ref', ref).order('created_at', { ascending: false });
    if (error) { el.innerHTML = ''; return; }
    if (!data || data.length === 0) {
      el.innerHTML = '<div style="font-size:12px;color:#475569;font-style:italic">No activity recorded for this item.</div>';
      return;
    }
    el.innerHTML = data.map(l => {
      const meta = ACTION_LABELS[l.action] || { label: l.action, icon: 'fa-circle' };
      const dt = new Date(l.created_at);
      const dateStr = dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      const timeStr = dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      return `<div style="font-size:12px;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05)">
        <div style="display:flex;align-items:center;gap:6px;color:#e2e8f0;font-weight:600">
          <i class="fa-solid ${meta.icon}" style="font-size:10px;opacity:0.7"></i>${escapeHtml(meta.label)}
          <span style="font-weight:400;color:#64748b;margin-left:auto">${dateStr} ${timeStr}</span>
        </div>
        ${l.details ? `<div style="color:#94a3b8;margin-top:2px">${escapeHtml(l.details)}</div>` : ''}
        ${l.user_email ? `<div style="color:#475569;margin-top:1px;font-size:11px">by ${escapeHtml(l.user_email)}</div>` : ''}
      </div>`;
    }).join('');
  }

  let allTourConfig = [];
  let allCategories = [];
  let allDiscountCodes = [];
  let tourConfigLoaded = false;
  // True once allTourConfig holds full rows (id, groups, etc.) — NOT just the early
  // `title, email_blocks`-only preload done at dashboard init. Guards ensureTourConfigLoaded()
  // so it isn't fooled by that partial preload into thinking full data is already present.
  let _tourConfigFullyLoaded = false;
  let editingTourId = null;
  let editingEmailBlocks = [];
  let _editTourPhotoUrl = null;
  let _addTourPhotoUrl = null;

  const GROUP_PALETTE = ['bg-blue-100 text-blue-700','bg-green-100 text-green-700','bg-red-100 text-red-700','bg-yellow-100 text-yellow-700','bg-purple-100 text-purple-700','bg-pink-100 text-pink-700','bg-indigo-100 text-indigo-700','bg-orange-100 text-orange-700'];
  const groupColor = (() => { const map = {}; let i = 0; return g => { if (!map[g]) map[g] = GROUP_PALETTE[i++ % GROUP_PALETTE.length]; return map[g]; }; })();
  const groupChip = g => `<span class="px-2 py-0.5 rounded-full text-xs font-medium ${groupColor(g)}">${escapeHtml(g)}</span>`;

  function renderCategories() {
    const list = document.getElementById('categories-list');
    if (!list) return;
    const locked = currentAdminRole === 'staff' || !editingUnlocked;
    list.innerHTML = allCategories.map(c => `
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium ${c.is_default ? 'bg-gray-100 text-gray-500' : 'bg-brand/10 text-brand'}">
        ${escapeHtml(c.label)}
        <button data-cat-id="${escapeHtml(c.id)}" data-cat-label="${escapeHtml(c.label)}" onclick="editCategory(this.dataset.catId,this.dataset.catLabel)" title="Rename" ${locked ? 'disabled' : ''} class="opacity-40 hover:opacity-100 ml-0.5 leading-none ${locked ? 'pointer-events-none' : ''}">✏</button>
        <button data-cat-id="${escapeHtml(c.id)}" data-cat-slug="${escapeHtml(c.slug)}" onclick="deleteCategory(this.dataset.catId,this.dataset.catSlug)" ${locked ? 'disabled' : ''} class="hover:text-red-500 font-bold leading-none opacity-40 hover:opacity-100 ${locked ? 'pointer-events-none' : ''}">×</button>
      </span>`).join('');
  }

  async function addCustomCategory() {
    if (!editingUnlocked) return;
    const input = document.getElementById('new-cat-input');
    const label = input.value.trim();
    if (!label) return;
    const slug = label.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    if (allCategories.some(c => c.slug === slug)) { showToast('Category already exists.', 'error'); return; }
    const maxOrder = Math.max(...allCategories.map(c => c.sort_order || 0), 0);
    const { data } = await db.from('tour_categories')
      .insert({ slug, label, sort_order: maxOrder + 10, is_default: false })
      .select().single();
    if (data) { allCategories.push(data); renderCategories(); renderTourConfigTable(); }
    input.value = '';
    if (data) logActivity('tour_category_added', `Category "${label}" added`, data.id).catch(() => {});
  }

  async function deleteCategory(id, slug) {
    if (currentAdminRole !== 'admin') { showToast('Admin role required.', 'error'); return; }
    const inUse = allTourConfig.some(t => (t.categories || []).includes(slug));
    if (inUse && !await showConfirm(`Some tours use "${slug}". Delete anyway?`)) return;
    const cat = allCategories.find(c => c.id === id);
    await db.from('tour_categories').delete().eq('id', id);
    allCategories = allCategories.filter(c => c.id !== id);
    renderCategories();
    renderTourConfigTable();
    logActivity('tour_category_deleted', `Category "${cat?.label || slug}" deleted`, id).catch(() => {});
  }

  async function editCategory(id, currentLabel) {
    const newLabel = await showPrompt('Category name:', currentLabel);
    if (!newLabel || newLabel.trim() === currentLabel) return;
    const label = newLabel.trim();
    await db.from('tour_categories').update({ label }).eq('id', id);
    const cat = allCategories.find(c => c.id === id);
    if (cat) { cat.label = label; renderCategories(); renderTourConfigTable(); }
    logActivity('tour_category_edited', `Category "${currentLabel}" → "${label}"`, id).catch(() => {});
  }

  function renderDiscountCodes() {
    const list = document.getElementById('discount-codes-list');
    const empty = document.getElementById('discount-codes-empty');
    if (!list) return;
    const locked = currentAdminRole === 'staff' || !editingUnlocked;
    const lockCls = locked ? 'opacity-40 pointer-events-none' : '';
    if (allDiscountCodes.length === 0) {
      list.innerHTML = '';
      if (empty) empty.classList.remove('hidden');
      return;
    }
    if (empty) empty.classList.add('hidden');
    list.innerHTML = allDiscountCodes.map(d => `
      <div class="flex items-center justify-between gap-3 px-3 py-2 rounded-xl border border-gray-100 hover:bg-gray-50">
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs font-bold text-dark">${escapeHtml(d.code)}</span>
          <span class="text-xs text-brand font-semibold">-${d.discount_pct}%</span>
          <button onclick="toggleDiscountCodeActive('${d.id}')" ${locked ? 'disabled' : ''} class="text-xs px-2 py-0.5 rounded-full font-medium ${lockCls} ${d.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'}">${d.active ? 'Active' : 'Inactive'}</button>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="openEditDiscountCodeModal('${d.id}')" ${locked ? 'disabled' : ''} class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 text-gray-400 ${lockCls}"><i class="fa-solid fa-pen text-xs"></i></button>
          <button onclick="deleteDiscountCode('${d.id}')" ${locked ? 'disabled' : ''} class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-red-50 text-gray-400 hover:text-red-500 ${lockCls}"><i class="fa-solid fa-trash text-xs"></i></button>
        </div>
      </div>`).join('');
  }

  function openAddDiscountCodeModal() { openDiscountCodeModal(null); }

  function openEditDiscountCodeModal(id) { openDiscountCodeModal(id); }

  function openDiscountCodeModal(editId) {
    if (!editingUnlocked || currentAdminRole === 'staff') return;
    const d = editId ? allDiscountCodes.find(x => x.id === editId) : null;
    document.getElementById('disc-editing-id').value = editId || '';
    document.getElementById('disc-modal-title').textContent = d ? 'Edit discount code' : 'Add discount code';
    document.getElementById('disc-modal-btn').textContent = d ? 'Save changes' : 'Add code';
    document.getElementById('disc-code').value = d?.code || '';
    document.getElementById('disc-pct').value = d?.discount_pct ?? '';
    document.getElementById('disc-active').checked = d ? !!d.active : true;
    const err = document.getElementById('disc-error');
    if (err) { err.classList.add('hidden'); err.textContent = ''; }
    document.getElementById('modal-discount-code').classList.remove('hidden');
    setTimeout(() => document.getElementById('disc-code')?.focus(), 50);
  }

  function closeDiscountCodeModal() {
    document.getElementById('modal-discount-code').classList.add('hidden');
  }

  async function saveDiscountCode() {
    const code = document.getElementById('disc-code').value.trim().toUpperCase();
    const pct = parseFloat(document.getElementById('disc-pct').value);
    const active = document.getElementById('disc-active').checked;
    const editId = document.getElementById('disc-editing-id').value;
    const errEl = document.getElementById('disc-error');
    if (!code) { errEl.textContent = 'Code is required.'; errEl.classList.remove('hidden'); return; }
    if (!(pct > 0) || pct > 100) { errEl.textContent = 'Discount % must be between 0 and 100.'; errEl.classList.remove('hidden'); return; }
    errEl.classList.add('hidden');
    const payload = { code, discount_pct: pct, active };
    if (editId) {
      const { data, error } = await db.from('discount_codes').update(payload).eq('id', editId).select().single();
      if (error) { errEl.textContent = error.code === '23505' ? 'This code already exists.' : ('Error: ' + error.message); errEl.classList.remove('hidden'); return; }
      const idx = allDiscountCodes.findIndex(x => x.id === editId);
      if (idx >= 0) allDiscountCodes[idx] = data;
      closeDiscountCodeModal();
      renderDiscountCodes();
      logActivity('discount_code_edited', `Discount code "${code}" updated`);
    } else {
      const { data, error } = await db.from('discount_codes').insert(payload).select().single();
      if (error) { errEl.textContent = error.code === '23505' ? 'This code already exists.' : ('Error: ' + error.message); errEl.classList.remove('hidden'); return; }
      allDiscountCodes.unshift(data);
      closeDiscountCodeModal();
      renderDiscountCodes();
      logActivity('discount_code_added', `Discount code "${code}" added (${pct}%)`);
    }
  }

  async function toggleDiscountCodeActive(id) {
    if (!editingUnlocked || currentAdminRole === 'staff') return;
    const d = allDiscountCodes.find(x => x.id === id);
    if (!d) return;
    const { error } = await db.from('discount_codes').update({ active: !d.active }).eq('id', id);
    if (error) { showToast('Failed to update discount code.', 'error', error.message); return; }
    d.active = !d.active;
    renderDiscountCodes();
  }

  async function deleteDiscountCode(id) {
    if (currentAdminRole !== 'admin') { showToast('Admin role required.', 'error'); return; }
    const d = allDiscountCodes.find(x => x.id === id);
    if (!await showConfirm(`Delete discount code "${d?.code || 'this code'}"?`, { okLabel: 'Delete' })) return;
    const { error } = await db.from('discount_codes').delete().eq('id', id);
    if (error) { showToast('Failed to delete discount code.', 'error', error.message); return; }
    allDiscountCodes = allDiscountCodes.filter(x => x.id !== id);
    renderDiscountCodes();
    logActivity('discount_code_deleted', `Discount code "${d?.code}" deleted`);
  }

  // Lightweight loader for places that only need tour group names (e.g. partner editing) —
  // skips the commissions/categories table re-render and the background Bokun pricing-category
  // sync that loadTourConfig() triggers, which was freezing the page when opened mid-session.
  async function ensureTourConfigLoaded() {
    if (_tourConfigFullyLoaded) return;
    const { data, error } = await db.from('tour_config').select('*').order('sort_order');
    if (error) { console.error('tour_config (lightweight):', error); return; }
    allTourConfig = data || [];
    _tourConfigFullyLoaded = true;
  }

  async function loadTourConfig() {
    const [tourRes, commRes, catRes, discRes] = await Promise.all([
      db.from('tour_config').select('*').order('sort_order'),
      db.from('tour_commissions').select('*').order('sort_order'),
      db.from('tour_categories').select('*').order('sort_order'),
      db.from('discount_codes').select('*').order('created_at', { ascending: false }),
    ]);
    if (tourRes.error) { console.error('tour_config:', tourRes.error); }
    allTourConfig   = tourRes.data || [];
    allCommissions  = commRes.data || [];
    allCategories   = catRes.data || [];
    allDiscountCodes = discRes.data || [];
    tourConfigLoaded = true;
    _tourConfigFullyLoaded = true;
    renderCategories();
    renderTourConfigTable();
    renderDiscountCodes();
    renderTourOverridesOverview();
    // Fetch missing Bokun pricing categories in background
    refreshBokunPricingCategories();
  }

  function bokunTimeToHHMM(val) {
    if (!val && val !== 0) return '';
    const mins = val > 1440 ? Math.round(val / 60) : val;
    return String(Math.floor(mins / 60)).padStart(2, '0') + ':' + String(mins % 60).padStart(2, '0');
  }

  async function refreshBokunPricingCategories() {
    const missing = allTourConfig.filter(t => t.bokun_id && !t.bokun_pricing_categories);
    if (missing.length === 0) return;
    await Promise.all(missing.map(async t => {
      try {
        const { data } = await invokeEdge('bokun-sync', { body: { path: `/activity.json/${t.bokun_id}`, method: 'GET' } });
        const cats = (data?.body?.pricingCategories || []).map(c => c.title).filter(Boolean);
        const startTimes = (data?.body?.startTimes || []).map(s => ({
          id: s.id,
          time: bokunTimeToHHMM(s.startTime),
          label: s.externalLabel || s.label || bokunTimeToHHMM(s.startTime),
        })).filter(s => s.id);
        await db.from('tour_config').update({ bokun_pricing_categories: cats, start_times: startTimes.length ? startTimes : null }).eq('id', t.id);
        t.bokun_pricing_categories = cats;
        t.start_times = startTimes.length ? startTimes : null;
      } catch(e) {}
    }));
    renderTourConfigTable();
  }

  function bokunHasCat(tourId, keyword) {
    const t = allTourConfig.find(x => x.id === tourId);
    if (!t?.bokun_pricing_categories) return null; // unknown — not fetched yet
    return t.bokun_pricing_categories.some(title => title.toLowerCase().includes(keyword));
  }

  function catWarning(tourId, keyword, label) {
    const has = bokunHasCat(tourId, keyword);
    if (has === null) return '';
    if (has) return '';
    return `<button onclick="openCatPopover(event,'${label}')" class="ml-0.5 text-amber-500 hover:text-amber-600 text-xs font-bold leading-none cursor-pointer" title="Category missing in Bokun">⚠ <span class="underline font-normal">info</span></button>`;
  }

  function openCatPopover(e, label) {
    e.stopPropagation();
    const pop = document.getElementById('bokun-cat-popover');
    document.getElementById('bokun-cat-popover-label').textContent = `The "${label}" pricing category doesn't exist in Bokun for this tour — the price won't be shown to partners until you add it there.`;
    const rect = e.target.closest('button').getBoundingClientRect();
    pop.classList.remove('hidden');
    const top = rect.bottom + window.scrollY + 6;
    let left = rect.left + window.scrollX - 80;
    left = Math.max(16, Math.min(left, window.innerWidth - 336));
    pop.style.top = top + 'px';
    pop.style.left = left + 'px';
  }

  function closeCatPopover() {
    document.getElementById('bokun-cat-popover').classList.add('hidden');
  }

  document.addEventListener('click', e => {
    const pop = document.getElementById('bokun-cat-popover');
    if (pop && !pop.contains(e.target)) pop.classList.add('hidden');
  });

  function renderTourConfigTable() {
    if (currentAdminRole === 'staff') {
      document.getElementById('tours-locked-banner')?.classList.add('hidden');
      document.getElementById('tours-unlocked-banner')?.classList.add('hidden');
      document.getElementById('tour-groups-card')?.classList.add('hidden');
      document.getElementById('tour-categories-card')?.classList.add('hidden');
      document.getElementById('discount-codes-card')?.classList.add('hidden');
    }
    renderTourGroupsSection();
    const loading  = document.getElementById('tour-config-loading');
    const table    = document.getElementById('tour-config-table');
    const empty    = document.getElementById('tour-config-empty');
    const subtitle = document.getElementById('tours-config-subtitle');
    if (loading) loading.classList.add('hidden');
    const totalPkgs    = allCommissions.filter(c => c.active).length;
    const activeTours  = allTourConfig.filter(t => t.active).length;
    const inactiveTours = allTourConfig.length - activeTours;
    if (subtitle) subtitle.textContent = `${activeTours} active · ${inactiveTours} inactive · ${totalPkgs} package${totalPkgs !== 1 ? 's' : ''}`;
    if (allTourConfig.length === 0) {
      if (table) table.classList.add('hidden');
      if (empty) empty.classList.remove('hidden');
      return;
    }
    if (table) table.classList.remove('hidden');
    if (empty) empty.classList.add('hidden');
    const tbody = document.getElementById('tour-config-tbody');
    tbody.innerHTML = '';
    const isStaffRole = currentAdminRole === 'staff';
    const locked = isStaffRole || !editingUnlocked;
    const lockCls = locked ? 'opacity-40 pointer-events-none select-none' : '';
    const calLocked = !isStaffRole && !editingUnlocked;
    const calLockCls = calLocked ? 'opacity-40 pointer-events-none select-none' : '';
    const tq = (document.getElementById('tours-search')?.value || '').toLowerCase();
    const displayTours = [...allTourConfig].sort((a, b) => {
      if (b.active !== a.active) return b.active ? 1 : -1;
      return (a.sort_order || 0) - (b.sort_order || 0);
    }).filter(t => !tq || (t.title||'').toLowerCase().includes(tq) || (t.bokun_id||'').toString().includes(tq) || (t.groups||[]).some(g=>(g||'').toLowerCase().includes(tq)) || (t.categories||[]).some(c=>(c||'').toLowerCase().includes(tq)));
    displayTours.forEach((t, idx) => {
      const groups   = (t.groups || []).length > 0 ? t.groups.map(groupChip).join('') : '<span class="text-gray-300 text-xs">all partners</span>';
      const packages = allCommissions.filter(c => c.tour_config_id === t.id).sort((a,b) => (a.sort_order||0)-(b.sort_order||0));

      // ── Main tour row ──────────────────────────────────────────────
      tbody.insertAdjacentHTML('beforeend', `
        <tr draggable="${!locked}" data-tour-id="${t.id}"
            ondragstart="tourDragStart(event,'${t.id}')"
            ondragover="tourDragOver(event,'${t.id}')"
            ondragleave="tourDragLeave(event,'${t.id}')"
            ondrop="tourDrop(event,'${t.id}')"
            ondragend="tourDragEnd(event)"
            class="border-t-4 border-gray-200 ${t.active ? 'bg-white' : 'bg-gray-50 opacity-60'}">
          <td colspan="5" class="px-0 py-0 border-l-4 border-brand">
            <div class="flex items-center gap-3 px-3 py-4 hover:bg-gray-50 transition-colors">
              <span class="text-gray-300 flex-shrink-0 flex items-center gap-1 ${!locked ? 'cursor-grab' : ''}">
                <i class="fa-solid fa-grip-vertical text-xs ${locked ? 'opacity-0' : ''}"></i>
                <input type="number" min="1" max="${allTourConfig.length}" value="${idx + 1}"
                  onclick="event.stopPropagation()"
                  onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}"
                  onblur="moveTourToPosition('${t.id}', this.value)"
                  ${locked ? 'disabled' : ''}
                  style="width:32px;text-align:center;font-size:11px;border:0;background:transparent;color:${locked ? 'transparent' : '#9ca3af'};outline:none;padding:0;-moz-appearance:textfield">
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-dark text-sm">${escapeHtml(t.title)}</span>
                  <span class="font-mono text-xs text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded">${t.bokun_id ? escapeHtml(String(t.bokun_id)) : '<span class="text-red-300 bg-red-50 px-1 rounded">no id</span>'}</span>
                  ${groups}
                </div>
                ${allCategories.length > 0 ? `<div class="flex flex-wrap gap-1 mt-3">
                  ${allCategories.map(c => {
                    const active = (t.categories || []).includes(c.slug);
                    return `<button data-tour-id="${escapeHtml(t.id)}" data-cat-slug="${escapeHtml(c.slug)}" onclick="toggleTourCat(this.dataset.tourId,this.dataset.catSlug,this)" ${locked ? 'disabled' : ''}
                      class="text-xs px-2 py-0.5 rounded-full font-medium transition-colors ${active ? 'bg-brand text-white' : 'bg-gray-100 text-gray-400 hover:bg-gray-200'} ${lockCls}">
                      ${escapeHtml(c.label)}</button>`;
                  }).join('')}
                </div>` : ''}
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <label class="relative inline-flex ${lockCls} cursor-pointer" title="${t.active ? 'Active' : 'Inactive'}">
                  <input type="checkbox" class="sr-only" ${t.active ? 'checked' : ''} ${locked ? 'disabled' : ''} onchange="toggleTourActive('${t.id}', this.checked)">
                  <div class="w-9 h-5 rounded-full transition-colors" style="background-color:${t.active ? '#22c55e' : '#d1d5db'}"></div>
                  <div class="absolute top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform" style="left:${t.active ? '1.125rem' : '0.125rem'}"></div>
                </label>
                <div class="h-5 w-px bg-gray-200 mx-1"></div>
                <button onclick="openEditTour('${t.id}')" title="Edit tour" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-100 text-gray-400 ${lockCls}"><i class="fa-solid fa-pen text-sm"></i></button>
                <button onclick="openTourInfoBlocks('${t.id}')" title="Info blocks" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-blue-50 text-gray-400 hover:text-blue-500 ${lockCls}"><i class="fa-solid fa-layer-group text-sm"></i></button>
                <button onclick="toggleTourPricing('${t.id}', this)" title="Pricing" id="pricing-btn-${t.id}" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-orange-50 text-gray-400 hover:text-brand ${lockCls}"><i class="fa-solid fa-coins text-sm"></i></button>
                ${(t.bokun_id != null || (t.manual_slots && t.manual_slots.length)) ? `<button onclick="tsaOpenModal('${t.id}')" title="Slot availability by date" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-100 text-gray-400 hover:text-brand ${calLockCls}"><i class="fa-solid fa-calendar-days text-sm"></i></button>` : ''}
                ${t.bokun_id != null ? `<button title="Bokun-linked — cannot delete" class="w-9 h-9 flex items-center justify-center rounded-xl text-gray-300 cursor-not-allowed" disabled><i class="fa-solid fa-trash text-sm"></i></button>` : `<button onclick="deleteTour('${t.id}')" title="Delete" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-red-50 text-gray-200 hover:text-red-400 ${lockCls}"><i class="fa-solid fa-trash text-sm"></i></button>`}
              </div>
            </div>
          </td>
        </tr>`);

      // ── Pricing expanded row (hidden by default) ────────────────────
      const pkgRows = packages.length > 0 ? packages.map(pkg => `
        <tr class="divide-x divide-gray-100 ${pkg.active ? '' : 'opacity-50'}">
          <td class="px-3 py-1.5 min-w-32">
            <input type="text" value="${pkg.title.replace(/"/g, '&quot;')}" ${locked ? 'disabled' : ''}
              class="w-full text-xs font-semibold text-gray-900 bg-transparent border border-transparent rounded px-1.5 py-1 hover:border-gray-300 focus:border-brand/40 focus:outline-none focus:ring-1 focus:ring-brand/40 focus:bg-white ${locked ? 'cursor-default' : ''}"
              onchange="quickSavePkg('${pkg.id}', 'title', this.value.trim())"
              onblur="quickSavePkg('${pkg.id}', 'title', this.value.trim())">
