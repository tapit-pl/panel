  async function loadActivityLog() {
    // Cheap, single-column, unbounded fetch — just to populate the "User" filter dropdown
    // with every distinct user ever logged, independent of whatever filters/page are active.
    const { data: userRows } = await db.from('audit_log').select('user_email');
