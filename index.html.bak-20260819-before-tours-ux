  function renderTodaysDepartures() {
    const today = new Date().toISOString().slice(0, 10);
    const nowMins = new Date().getHours() * 60 + new Date().getMinutes();
    const todayBookings = (partnerBookings || [])
      .filter(b => b.date === today && !['cancelled','no_show'].includes((b.status||'').toLowerCase()))
      .sort((a, b) => (a.time || '').localeCompare(b.time || ''));

    const totalPax = todayBookings.reduce((s, b) => s + (b.pax || 0), 0);
    const dateLabel = new Date(today + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    const cards = todayBookings.map(b => {
      const timeParts = (b.time || '').match(/(\d{1,2}):(\d{2})/);
      const bookingMins = timeParts ? parseInt(timeParts[1]) * 60 + parseInt(timeParts[2]) : null;
      const departed = bookingMins !== null && bookingMins < nowMins;
      const timeLabel = b.time ? b.time.slice(0, 5) : '—';
      const statusBadge = departed
        ? `<span class="flex items-center gap-1.5 text-xs text-gray-400 font-medium"><span class="w-2 h-2 bg-gray-400 rounded-full inline-block"></span> Departed</span>`
        : `<span class="flex items-center gap-1.5 text-xs text-green-600 font-semibold"><span class="w-2 h-2 bg-green-500 rounded-full inline-block"></span> Upcoming</span>`;
      const timeBox = departed
        ? `<div class="w-16 h-16 bg-gray-200 rounded-2xl flex items-center justify-center"><span class="text-sm font-bold text-gray-500">${timeLabel}</span></div>`
        : `<div class="w-16 h-16 bg-brand rounded-2xl flex items-center justify-center"><span class="text-sm font-bold text-white">${timeLabel}</span></div>`;
