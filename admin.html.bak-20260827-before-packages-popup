async function submitEditStaff() {
  const email = document.getElementById('edit-staff-email-hidden').value;
  const firstName = document.getElementById('edit-staff-firstname').value.trim();
  const lastName = document.getElementById('edit-staff-lastname').value.trim();
  const role = document.getElementById('edit-staff-role').value;
  const password = document.getElementById('edit-staff-password').value;

  if (password && password.length < 8) { showToast('Password must be at least 8 characters', 'error'); return; }

  const btn = document.getElementById('edit-staff-submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Saving...';

  let hasError = false;

  // Update profile + role
  const { error: roleErr } = await db.from('admin_users').update({ role, first_name: firstName || null, last_name: lastName || null }).eq('email', email);
  if (roleErr) { showToast('Failed to update: ' + roleErr.message, 'error'); hasError = true; }

  // Update password if provided
  if (!hasError && password) {
    const { data: result, error: fnError } = await invokeEdge('create-partner', {
      body: { action: 'set_password', partner_email: email, new_password: password },
    });
    const err = fnError || result?.error;
    if (err) {
      const msg = fnError?.body?.error || fnError?.message || (typeof result?.error === 'string' ? result.error : null) || 'Unknown error';
      showToast('Failed to update password: ' + msg, 'error');
      hasError = true;
    }
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save changes';

  if (!hasError) {
    showToast('Staff member updated', 'success');
    const pwNote = password ? ' + password changed' : '';
    logActivity('staff_edited', `${email} updated — role: ${role}${pwNote}`, email);
    closeEditStaffModal();
    loadStaffUsers();
  }
}

