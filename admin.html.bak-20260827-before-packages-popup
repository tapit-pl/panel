  // Custom .cdrop dropdowns only refresh their visible label on user click — setting
  // select.value programmatically (e.g. pre-filling a modal from data) leaves the old
  // label showing even though the real value is correct. Call this after such an assignment.
  function syncFselLabel(selectId) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    const val = sel.closest('.cdrop')?.querySelector('.cdrop-val');
    if (val) val.textContent = sel.options[sel.selectedIndex]?.text || '';
