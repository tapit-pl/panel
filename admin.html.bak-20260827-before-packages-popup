  async function saveAdminPassword() {
    const currentPw = document.getElementById('admin-current-password').value;
    const pw        = document.getElementById('admin-new-password').value.trim();
    const repeatPw  = document.getElementById('admin-repeat-password').value.trim();
    const errEl     = document.getElementById('admin-pw-error');
    const okEl      = document.getElementById('admin-pw-success');
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    if (!currentPw) {
      errEl.textContent = 'Enter your current password.';
      errEl.classList.remove('hidden'); return;
    }
    if (pw.length < 8) {
      errEl.textContent = 'New password must be at least 8 characters.';
      errEl.classList.remove('hidden'); return;
    }
    if (pw !== repeatPw) {
      errEl.textContent = 'Passwords do not match.';
      errEl.classList.remove('hidden'); return;
    }

    // Weryfikuj aktualne hasło przez sign-in
    const { error: signInErr } = await db.auth.signInWithPassword({ email: currentAdminEmail, password: currentPw });
    if (signInErr) {
      errEl.textContent = 'Current password is incorrect.';
      errEl.classList.remove('hidden'); return;
    }

    // Zmień hasło przez edge function z service role — omija wymóg AAL2 przy MFA
    const { data, error: updateErr } = await invokeEdge('create-partner', {
      body: { action: 'set_password', new_password: pw }
    });
    const err = updateErr || (data?.error ? { message: data.error } : null);
    if (err) {
      errEl.textContent = err.message || 'Failed to change password.';
      errEl.classList.remove('hidden');
    } else {
      okEl.innerHTML = 'Password changed successfully. You will be logged out in <strong id="pw-countdown">5</strong>s — please log in again with your new password.';
      okEl.classList.remove('hidden');
      await db.auth.signOut();
      let _pwCount = 5;
      const _pwTimer = setInterval(() => {
        _pwCount--;
        const el = document.getElementById('pw-countdown');
        if (el) el.textContent = _pwCount;
        if (_pwCount <= 0) {
          clearInterval(_pwTimer);
          window.location.replace('/');
        }
      }, 1000);
    }
  }

  function initDashMonthSelector() {
    const sel = document.getElementById('dash-month-select');
    if (!sel) return;
    const now = new Date();
    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    sel.innerHTML = '';
    for (let i = 0; i < 24; i++) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const val = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      const label = MONTHS[d.getMonth()] + ' ' + d.getFullYear();
      sel.insertAdjacentHTML('beforeend', `<option value="${val}"${i===0?' selected':''}>${label}</option>`);
    }
    sel.insertAdjacentHTML('beforeend', `<option value="custom">Custom range…</option>`);
  }

  async function onDashMonthChange() {
    const sel = document.getElementById('dash-month-select');
    const customWrap = document.getElementById('dash-custom-range-wrap');
    if (sel?.value === 'custom') {
      if (customWrap) { customWrap.classList.remove('hidden'); customWrap.classList.add('flex'); }
      applyCustomDashRange();
      return;
    }
    if (customWrap) { customWrap.classList.add('hidden'); customWrap.classList.remove('flex'); }
    if (dashFilter === 'seller' && !customToursLoaded) await loadCustomTours();
    updateDashboardKPIs();
    if (dashFilter === 'seller') loadStaffPerformance();
  }

  function applyCustomDashRange() {
    const from = document.getElementById('dash-custom-from')?.value;
    const to   = document.getElementById('dash-custom-to')?.value;
    if (!from || !to) return;
    document.getElementById('chart-date-from').value = from;
    document.getElementById('chart-date-to').value = to;
    renderDashboardChart();
  }

  function getSelectedMonthRange() {
    const sel = document.getElementById('dash-month-select');
    const val = sel?.value || new Date().toISOString().slice(0,7);
    const [y, m] = val.split('-').map(Number);
    const start = new Date(y, m-1, 1).getTime();
    const end   = new Date(y, m, 1).getTime();
    const prevStart = new Date(y, m-2, 1).getTime();
    return { start, end, prevStart, prevEnd: start, y, m };
  }

  async function loadStaffPerformance() {
    const section = document.getElementById('dash-staff-section');
    if (!section) return;
    // Only visible to admin/manager
    if (currentAdminRole === 'staff') { section.style.display = 'none'; return; }
    section.style.display = '';

    const loading = document.getElementById('dash-staff-loading');
    const content = document.getElementById('dash-staff-content');
    const empty   = document.getElementById('dash-staff-empty');
    const detailsEl = document.getElementById('dash-staff-details');
    loading.classList.remove('hidden');
    content.classList.add('hidden');
    empty.classList.add('hidden');
    if (detailsEl) detailsEl.innerHTML = '<div class="text-xs text-slate-500">Loading…</div>';

    const { y, m } = getSelectedMonthRange();
    const pad2 = n => String(n).padStart(2, '0');
    const monthStr = `${y}-${pad2(m)}`;
    const monthStart = `${y}-${pad2(m)}-01`;
    const monthEnd   = new Date(y, m, 1).toISOString().slice(0,10);
    document.getElementById('dash-staff-period').textContent = new Date(y, m-1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    // Fetch all packages for the month (by tour date, not creation date)
    const { data: packages } = await db.from('custom_packages')
      .select('sold_by_email,sold_by_name,guest_price,commission_amount,status')
      .gte('date', monthStart)
      .lt('date', monthEnd)
      .not('sold_by_email', 'is', null);

    loading.classList.add('hidden');

    if (!packages?.length) { empty.classList.remove('hidden'); if (detailsEl) detailsEl.innerHTML = '<div class="text-xs text-slate-500">No data for this period.</div>'; return; }

    const targetMap = {};

    // Group by seller
    const sellers = {};
    packages.forEach(p => {
      const key = p.sold_by_email;
      if (!key) return;
      if (!sellers[key]) sellers[key] = { name: p.sold_by_name || p.sold_by_email, confirmed: 0, total: 0, value: 0, commission: 0, email: key };
      sellers[key].total++;
      if (p.status === 'paid' || p.status === 'confirmed' || p.status === 'arrived') {
        sellers[key].confirmed++;
        sellers[key].value += p.guest_price || 0;
        sellers[key].commission += p.commission_amount || 0;
      }
    });

    const sorted = Object.values(sellers).sort((a, b) => b.value - a.value);
    if (!sorted.length) { empty.classList.remove('hidden'); return; }

    const medals = ['🥇', '🥈', '🥉'];
    const maxValue = sorted[0].value || 1;

    document.getElementById('dash-staff-ranking').innerHTML = sorted.map((s, i) => {
      const pct = Math.round((s.value / maxValue) * 100);
      const target = targetMap[s.email] || 0;
      const targetPct = target > 0 ? Math.min(100, Math.round((s.value / target) * 100)) : null;
      return `<div class="flex gap-3 items-start">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-base leading-none">${medals[i] || '<span style="color:#64748b;font-size:11px;font-weight:700">#' + (i+1) + '</span>'}</span>
            <span class="text-sm font-semibold text-white">${escapeHtml(s.name)}</span>
          </div>
          <div class="w-full rounded-full h-1.5" style="background:rgba(255,255,255,0.08)">
            <div class="h-1.5 rounded-full bg-brand" style="width:${pct}%"></div>
          </div>
          ${targetPct !== null ? `<div class="text-xs text-slate-500 mt-1">Target: <span class="${targetPct >= 100 ? 'text-green-400' : 'text-amber-400'}">${targetPct >= 100 ? '✓ Achieved!' : targetPct + '%'}</span> of ${fmtPln(target)}</div>` : ''}
        </div>
        <div class="text-right flex-shrink-0 w-32">
          <div class="text-sm font-mono font-bold text-white">${fmtPln(s.value)}</div>
          <div class="text-xs text-slate-400">${s.confirmed} pkg · ${fmtPln(s.commission)}</div>
        </div>
      </div>`;
    }).join('');

    document.getElementById('dash-staff-details').innerHTML = sorted.map(s => {
      const convRate = s.total > 0 ? Math.round((s.confirmed / s.total) * 100) : 0;
      const convColor = convRate >= 80 ? 'text-green-400' : convRate >= 50 ? 'text-amber-400' : 'text-red-400';
      return `<div class="flex items-center justify-between rounded-lg px-3 py-2.5" style="background:rgba(255,255,255,0.05)">
        <div>
          <div class="text-xs font-semibold text-white">${escapeHtml(s.name)}</div>
          <div class="text-xs text-slate-400 mt-0.5">${s.total} created · ${s.confirmed} confirmed</div>
        </div>
        <div class="text-right">
          <div class="text-sm font-bold ${convColor}">${convRate}%</div>
          <div class="text-xs text-slate-500">conv. rate</div>
        </div>
      </div>`;
    }).join('');

    content.classList.remove('hidden');
  }

