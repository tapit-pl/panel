  function renderPartnerTickets() {
    const section         = document.getElementById('st-tickets-section');
    const list            = document.getElementById('st-tickets-list');
    const resolvedSection = document.getElementById('st-resolved-section');
    const resolvedList    = document.getElementById('st-resolved-list');

    const statusLabel = { open: 'Open', in_progress: 'In Progress', resolved: 'Resolved' };
    const statusColor = {
      open:        'background:#FEF3C7;color:#92400E',
      in_progress: 'background:#DBEAFE;color:#1E40AF',
      resolved:    'background:#D1FAE5;color:#065F46',
    };

    const activeTickets   = partnerTickets.filter(t => t.status === 'open' || t.status === 'in_progress');
    const resolvedTickets = partnerTickets.filter(t => t.status === 'resolved');

    const buildCard = (t) => {
      const msgs      = t.support_messages || [];
      const adminMsgs = msgs.filter(m => m.sender_type === 'admin');
      const hasReply  = adminMsgs.length > 0;
      const sc        = statusColor[t.status] || statusColor.open;
      const sl        = statusLabel[t.status] || t.status;
      const date      = new Date(t.updated_at || t.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

      const readAt        = partnerReadMap[t.id] ? new Date(partnerReadMap[t.id]).getTime() : 0;
      const latestAdminAt = hasReply ? Math.max(...adminMsgs.map(m => new Date(m.created_at).getTime())) : 0;
      const isUnread      = latestAdminAt > readAt;
      const cardOpacity   = isUnread ? '' : 'opacity-50';
      const newAdminMsgs  = adminMsgs.filter(m => new Date(m.created_at).getTime() > readAt);

      return `<div onclick="openTicketPanel('${t.id}')"
          class="bg-white rounded-xl shadow-sm p-4 flex items-start gap-3 cursor-pointer hover:shadow-md transition-shadow ${cardOpacity}">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:#FFF3EA">
            <i class="fa-solid fa-ticket text-brand text-xs"></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-semibold text-dark truncate">${escapeHtml(t.subject)}</span>
            </div>
            <div class="flex items-center gap-2 mt-1 flex-wrap">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full" style="${sc}">${sl}</span>
              <span class="text-xs text-gray-400">${escapeHtml(t.category || '')}</span>
              <span class="text-xs text-gray-300">·</span>
              <span class="text-xs text-gray-400">${date}</span>
              ${newAdminMsgs.length > 0 ? `<span class="text-xs text-brand font-medium">${newAdminMsgs.length} new repl${newAdminMsgs.length > 1 ? 'ies' : 'y'}</span>` : ''}
            </div>
          </div>
          <i class="fa-solid fa-chevron-right text-gray-300 text-xs mt-1 shrink-0"></i>
        </div>`;
    };

    if (activeTickets.length) {
      section.classList.remove('hidden');
      list.innerHTML = activeTickets.map(buildCard).join('');
    } else {
      section.classList.add('hidden');
    }

    if (resolvedTickets.length) {
      resolvedSection.classList.remove('hidden');
      const LIMIT = 3;
      const visible = resolvedTickets.slice(0, LIMIT);
      const hidden  = resolvedTickets.slice(LIMIT);
      const seeAllBtn = hidden.length > 0
        ? `<button onclick="stShowAllResolved()" id="st-see-all-btn" class="mt-2 text-xs font-semibold text-brand hover:text-brand-dark transition-colors flex items-center gap-1">
            <i class="fa-solid fa-chevron-down text-xs"></i> See all (${resolvedTickets.length})
           </button>`
        : '';
      resolvedList.innerHTML = visible.map(buildCard).join('') + seeAllBtn;
      resolvedList._hiddenCards = hidden.map(buildCard).join('');
    } else {
      resolvedSection.classList.add('hidden');
    }
  }

