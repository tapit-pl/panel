let _bkdCurrentId = null;

function openBookingDetail(id) {
  const b = allBookings.find(x => x.id === id) || partnerBookings.find(x => x.id === id);
  if (!b) return;
  _bkdCurrentId = id;

  // Header
  const set = (elId, val) => { const el = document.getElementById(elId); if (el) el.textContent = val || '—'; };
  const show = (elId, vis) => { const el = document.getElementById(elId); if (el) el.classList.toggle('hidden', !vis); };

  set('bkd-tour', b.tour);
  document.getElementById('bkd-ref').textContent = '#' + (b.displayId || b.id);
  document.getElementById('bkd-status').innerHTML = statusBadge(b.status);

  // Guest
  set('bkd-guest', b.guest);
  set('bkd-pax', b.pax);
  const emailEl = document.getElementById('bkd-email');
  const phoneEl = document.getElementById('bkd-phone');
  const emailLink = document.getElementById('bkd-email-link');
  const phoneLink = document.getElementById('bkd-phone-link');
  if (emailEl) emailEl.textContent = b.email || '—';
  if (emailLink) { emailLink.href = b.email ? 'mailto:' + b.email : '#'; show('bkd-email-link', !!b.email); }
  if (phoneEl) phoneEl.textContent = b.phone || '—';
  if (phoneLink) { phoneLink.href = b.phone ? 'tel:' + b.phone : '#'; show('bkd-phone-link', !!b.phone); }
  const extraWrap = document.getElementById('bkd-extra-guests-wrap');
  if (extraWrap) {
    const extras = b.additional_guests || b.extraGuests;
    if (extras) { extraWrap.textContent = 'Additional: ' + (typeof extras === 'string' ? extras : extras.join(', ')); extraWrap.classList.remove('hidden'); }
    else extraWrap.classList.add('hidden');
  }

  // Details
  set('bkd-tour-date', b.date);
  set('bkd-time', b.time);
  set('bkd-language', b.language);
  set('bkd-date-booked', b._creationTs ? new Date(b._creationTs).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) : null);
  set('bkd-pickup', b.pickup);
  set('bkd-partner', b.hotel);
  set('bkd-source', b.source === 'admin' ? 'Admin' : (b.source || '—'));

  // Payment
  document.getElementById('bkd-payment').innerHTML = b.payment_method ? paymentMethodCell(b) : '—';
  const totalAmt = toPlnAmount(b);
  set('bkd-total', Math.round(totalAmt).toLocaleString('pl') + ' PLN');
  {
    const discWrap = document.getElementById('bkd-discount-wrap');
    if (discWrap) {
      if (b.discount_code) {
        discWrap.classList.remove('hidden');
        set('bkd-discount', `${b.discount_code} (−${b.discount_pct}%, −${Math.round(b.discount_amount || 0).toLocaleString('pl')} PLN)`);
      } else {
        discWrap.classList.add('hidden');
      }
    }
  }
  {
    const priceOvWrap = document.getElementById('bkd-price-override-wrap');
    if (priceOvWrap) {
      if (b.price_overridden) {
        priceOvWrap.classList.remove('hidden');
        set('bkd-price-override', `Manually set by ${b.created_by_name || 'admin'} — standard price: ${Math.round(b.price_override_original_total || 0).toLocaleString('pl')} PLN`);
      } else {
        priceOvWrap.classList.add('hidden');
      }
    }
  }
  {
    const _commEl = document.getElementById('bkd-comm');
    if (_commEl) {
      if (b.comm != null) {
        const _commTxt = Math.round(b.comm).toLocaleString('pl') + ' PLN';
        if (b.source === 'admin') {
          _commEl.innerHTML = `<span style="color:#94a3b8">${_commTxt}</span><span style="display:inline-flex;align-items:center;cursor:help;margin-left:6px;vertical-align:middle" onmouseenter="const r=this.getBoundingClientRect();const t=document.getElementById('admin-comm-tip');t.style.top=(r.top-8-t.offsetHeight)+'px';t.style.left=Math.min(r.left,window.innerWidth-250)+'px';t.style.opacity=1" onmouseleave="document.getElementById('admin-comm-tip').style.opacity=0"><i class="fa-solid fa-circle-question" style="color:#475569;font-size:11px"></i></span>`;
        } else {
          _commEl.style.color = '#f1f5f9';
          _commEl.textContent = _commTxt;
        }
      } else {
        _commEl.style.color = '#f1f5f9';
        _commEl.textContent = '—';
      }
    }
  }
  const bokunCode = b._bokunCode || b.bokun_confirmation_code || b.displayId;
  const bokunWrap = document.getElementById('bkd-bokun-wrap');
  if (bokunWrap) { bokunWrap.classList.toggle('hidden', !bokunCode); }
  set('bkd-bokun', bokunCode);

  // Package / Rates
  const pkgWrap = document.getElementById('bkd-package-wrap');
  if (pkgWrap) {
    const pkg = b.package_lines || null;
    pkgWrap.classList.toggle('hidden', !pkg);
    if (pkg) set('bkd-package', pkg);
  }

  // Notes
  const notesWrap = document.getElementById('bkd-notes-wrap');
  const notesEl = document.getElementById('bkd-notes');
  if (notesWrap && notesEl) {
    if (b.notes) { notesEl.textContent = b.notes; notesWrap.classList.remove('hidden'); }
    else notesWrap.classList.add('hidden');
  }

  // Action buttons
  const st = (b.status || '').toLowerCase();
  const isDb = !!b._dbBooking;
  const isCancelled = ['cancelled','cancelling'].includes(st);
  const isPaid = ['paid','confirmed','arrived'].includes(st);
  const isDriverPay = ['to_be_paid','pending'].includes(st);
  const isLinkPending = ['payment_pending','pending_payment'].includes(st);

  const btnVoucher = document.getElementById('bkd-btn-voucher');
  const btnEdit    = document.getElementById('bkd-btn-edit');
  const btnPaid    = document.getElementById('bkd-btn-paid');
  const btnLink    = document.getElementById('bkd-btn-link');
  const btnCancel  = document.getElementById('bkd-btn-cancel');

  const btnResend = document.getElementById('bkd-btn-resend');

  if (btnVoucher) { btnVoucher.classList.toggle('hidden', !isDb); btnVoucher.onclick = () => { closeBookingDetail(); openVoucher(id); }; }
  if (btnEdit)    { btnEdit.classList.toggle('hidden', !isDb); btnEdit.onclick = () => { closeBookingDetail(); openEditBooking(id); }; }
  if (btnPaid)    { btnPaid.classList.toggle('hidden', !isDb || (!isDriverPay && !isLinkPending)); btnPaid.onclick = () => { quickMarkPaid(id); closeBookingDetail(); }; }
  if (btnResend)  { btnResend.classList.toggle('hidden', !isDb || !b.email); btnResend.onclick = () => resendConfirmationEmailForBooking(b); }
  if (btnLink)    { btnLink.classList.toggle('hidden', !isDb || !isLinkPending || !b.email); btnLink.onclick = () => { adminResendPaymentLink(id); }; }
  if (btnCancel)  {
    btnCancel.classList.toggle('hidden', !isDb || isCancelled);
    btnCancel.onclick = () => {
      closeBookingDetail();
      cancelBooking(id, b.guest || '', !!b._stripeSessionId, true);
    };
  }

  renderEntityTimeline('bkd-timeline', id);

  document.getElementById('booking-detail-panel').classList.remove('hidden');
  document.getElementById('booking-detail-panel').classList.add('flex');
}

function closeBookingDetail() {
  document.getElementById('booking-detail-panel').classList.add('hidden');
  document.getElementById('booking-detail-panel').classList.remove('flex');
  _bkdCurrentId = null;
}
