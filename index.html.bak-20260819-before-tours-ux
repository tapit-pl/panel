  async function loadToursFromBokun() {
    const grid = document.getElementById('tour-grid');
    if (!grid) return;
    if (bokunProducts.length > 0) { renderTourGrid(); return; }

    const partnerGroups = currentPartner?.tour_groups || [];

    try {
      const { data: tours, error } = await db.from('tour_config').select('*').eq('active', true).order('sort_order');
      if (error) throw error;

      const { data: commLinks } = await db.from('tour_commissions')
        .select('tour_config_id').eq('active', true).not('tour_config_id', 'is', null);
      const commConfigIds = new Set((commLinks || []).map(c => c.tour_config_id));

      const visible = (tours || []).filter(t => {
        if (partnerGroups.length === 0) return true; // partner bez grup → widzi wszystkie
        if (!t.groups || t.groups.length === 0) return false; // partner z grupami → ukryj wycieczki bez grupy
        return t.groups.some(g => partnerGroups.includes(g));
      });

      if (visible.length === 0) {
        bokunProducts = [];
        renderTourGrid();
        return;
      }

      bokunProducts = await Promise.all(visible.map(async (t, idx) => {
        const base = {
          id: idx, configId: t.id, bokunId: t.bokun_id || null, title: t.title,
          description: '', photo: t.photo_url || getTourPhoto(t.title), cat: (t.categories && t.categories.length ? t.categories : (t.category ? [t.category] : [])),
          durationMins: null, maxPax: null, pricing: [],
          hasPackage: commConfigIds.has(t.id),
          hiddenSlotIds: (t.hidden_slot_ids || []).map(String),
          emailBlocks: t.email_blocks || [],
          meetingPoint: t.meeting_point || null,
          bokunForceRateId: t.bokun_force_rate_id || null,
          bokunForcePickupPlaceId: t.bokun_force_pickup_place_id || null,
          bokunRequiresDob: t.bokun_requires_dob || false,
          allowHotelPickup: t.allow_hotel_pickup ?? true,
          allowMeetingPoint: t.allow_meeting_point ?? true,
          pricingType: t.pricing_type || 'per_person',
        };
        if (!t.bokun_id) return {
          ...base,
          photo: t.photo_url || getTourPhoto(t.title),
          description: t.description || '',
          durationMins: t.duration_mins || null,
          maxPax: t.max_pax || null,
          pricing: [],
          manualSlots: t.manual_slots || [],
        };
        try {
          const { data: det } = await db.functions.invoke('bokun-sync', {
            body: { path: `/activity.json/${t.bokun_id}`, method: 'GET' }
          });
          if (det?.body && ![400, 401, 403, 404].includes(det.body?.status)) {
            const d = det.body;
            if (!d.photos?.length) console.warn('[Tours] No photos for bokun_id', t.bokun_id, t.title);
            else if (!d.photos.find(x=>x.featured)?.originalUrl && !d.photos[0]?.originalUrl) console.warn('[Tours] Photos exist but no originalUrl for bokun_id', t.bokun_id, JSON.stringify(d.photos[0]));
            const pickPhoto = (p) => p?.originalUrl || p?.largeUrl || p?.mediumUrl || p?.url || null;
            const featuredPhoto = (d.photos||[]).find(x=>x.featured);
            const photo = pickPhoto(featuredPhoto) || pickPhoto(d.photos?.[0]) || getTourPhoto(t.title);
            return {
              ...base,
              title: d.title || t.title,
              description: d.shortDescription || d.description || '',
              photo,
              durationMins: d.durationInMinutes || null,
              maxPax: d.maxParticipants || null,
              pricing: d.pricingCategories || [],
            };
          }
          console.warn('[Tours] Bokun returned error for ID', t.bokun_id, det?.body?.status, det?.status);
        } catch(e) { console.warn('[Tours] Bokun fetch failed for ID', t.bokun_id, e?.message); }
        return base;
      }));

      console.log('[Tours] Loaded', bokunProducts.length, 'tours from tour_config');
      renderTourGrid();
    } catch(e) {
      console.error('[Tours]', e);
      const loading = document.getElementById('tours-loading');
      if (loading) loading.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-2xl text-red-400 block mb-2"></i><div class="text-sm text-red-400">Could not load tours. Please refresh.</div>`;
    }
  }

