async function mbSubmitBooking() {
  const firstName = (document.getElementById('mb-first')?.value||'').trim();
  const lastName  = (document.getElementById('mb-last')?.value||'').trim();
  const email     = (document.getElementById('mb-email')?.value||'').trim();
  const prefix    = document.getElementById('mb-phone-prefix')?.value||'+48';
  const phone     = (document.getElementById('mb-phone')?.value||'').trim();
  const fullPhone = phone ? prefix + ' ' + phone : '';
  const errEl     = document.getElementById('mb-form-error');
  const btn       = document.getElementById('mb-submit-btn');
  errEl.classList.add('hidden');
  if (!isValidName(firstName) || !isValidName(lastName)) {
    errEl.textContent = 'Please enter a valid first and last name (letters, spaces, hyphens and apostrophes only).';
    errEl.classList.remove('hidden');
    return;
  }
  if (phone) {
    const phoneDigits = phone.replace(/[\s\-\(\)]/g, '');
    if (!/^\d{7,15}$/.test(phoneDigits)) {
      errEl.textContent = 'Please enter a valid phone number (7–15 digits).';
      errEl.classList.remove('hidden');
      return;
    }
  }
  if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { errEl.textContent = 'Invalid email address.'; errEl.classList.remove('hidden'); return; }

  // Collect and validate extra guests
  const extraGuests = [];
  for (let i = 0; i < mbGuestCount - 1; i++) {
    const ef = (document.getElementById(`mb-extra-first-${i}`)?.value||'').trim();
    const el = (document.getElementById(`mb-extra-last-${i}`)?.value||'').trim();
    if (mbCurrentTour?.requireGuestNames && (!ef || !el)) {
      errEl.textContent = `Please enter a full name for Guest ${i + 2} — required for this tour.`;
      errEl.classList.remove('hidden');
      return;
    }
    if ((ef || el) && (!isValidName(ef) || !isValidName(el))) {
      errEl.textContent = `Please enter a valid first and last name for Guest ${i + 2}.`;
      errEl.classList.remove('hidden');
      return;
    }
    if (ef || el) extraGuests.push(`${ef} ${el}`.trim());
  }

  btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Creating booking…';

  const bookingId = crypto.randomUUID();
  const dateStr = mbSelectedDate;
  const guest = `${firstName} ${lastName}`;
  const tour = mbCurrentTour.title;
  const mbHasRates = mbRateSelections.some(r=>r.count>0);
  const mbHasCats  = mbCategorySelections.some(c=>c.count>0);
  const mbPackageLines = mbHasRates
    ? mbRateSelections.filter(r=>r.count>0).map(r=>`${r.count}x ${r.rate.title}`).join(', ')
    : mbHasCats
      ? mbCategorySelections.filter(c=>c.count>0).map(c=>`${c.count}x ${c.category.pricingCategoryTitle||c.category.title}`).join(', ')
      : null;
  let bokunReservationCode=null, bokunConfirmationCode=null, bokunBookingId=null, bokunErrMsg=null, bokunFieldErr=null;
  _clearBokunFieldErrors();

  if (mbCurrentTour.bokunId && mbSelectedSlot?.startTimeId) {
    try {
      const effectiveRateId = mbCurrentTour.bokunForceRateId || mbSelectedRate?.id || null;
      const mbBuildPassengers = () => {
        if (mbCategorySelections.some(c=>c.count>0)) {
          return mbCategorySelections.filter(c=>c.count>0).flatMap(c =>
            Array.from({length:c.count}, ()=>({ pricingCategoryId:c.category.id, groupSize:1,
              passengerDetails:[{questionId:'firstName',values:[firstName]},{questionId:'lastName',values:[lastName]}],
              answers:[], extras:[] })));
        }
        const cat = mbCurrentTour.pricing?.[0];
        return cat ? Array.from({length:mbGuestCount}, ()=>({ pricingCategoryId:cat.id, groupSize:1,
          passengerDetails:[{questionId:'firstName',values:[firstName]},{questionId:'lastName',values:[lastName]}],
          answers:[], extras:[] })) : [];
      };
      const { data: optRes } = await invokeEdge('bokun-sync', {
        body: { path:'/checkout.json/options/booking-request', method:'POST', payload:{
          activityId: parseInt(mbCurrentTour.bokunId), startTimeId: mbSelectedSlot.startTimeId,
          ...(effectiveRateId?{rateId:effectiveRateId}:{}), date:dateStr, passengers:mbBuildPassengers()
        }}
      });
      const submitPayload = {
        source:'DIRECT_REQUEST', checkoutOption:'CUSTOMER_FULL_PAYMENT',
        paymentMethod:'RESERVE_FOR_EXTERNAL_PAYMENT', sendNotificationToMainContact:false,
        directBooking:{
          mainContactDetails:[
            {questionId:'firstName',values:[firstName]},{questionId:'lastName',values:[lastName]},
            ...(email?[{questionId:'email',values:[email]}]:[]),
            ...(fullPhone?[{questionId:'phoneNumber',values:[fullPhone]}]:[]),
          ],
          promoCode:'HOTELBOOKING',
          activityBookings:[{
            activityId:parseInt(mbCurrentTour.bokunId), startTimeId:mbSelectedSlot.startTimeId,
            ...(effectiveRateId?{rateId:effectiveRateId}:{}), date:dateStr,
            passengers:mbBuildPassengers(), answers:[], pickupAnswers:[], dropoffAnswers:[],
            note: extraGuests.length ? 'Guests: '+[guest,...extraGuests].join(', ') : undefined,
          }],
        },
      };
      const { data: subRes } = await invokeEdge('bokun-sync', {
        body:{ path:'/checkout.json/submit', method:'POST', payload:submitPayload }
      });
      const subBody = subRes?.body;
      const resCode = subBody?.booking?.confirmationCode || subBody?.confirmationCode;
      if (resCode) {
        bokunReservationCode = resCode;
        const { data: confRes } = await invokeEdge('bokun-sync', {
          body:{ path:`/checkout.json/confirm-reserved/${resCode}`, method:'POST', payload:{sendNotificationToMainContact:false} }
        });
        const confBody = confRes?.body;
        bokunConfirmationCode = confBody?.booking?.confirmationCode || confBody?.confirmationCode || resCode;
        bokunBookingId = confBody?.booking?.bookingId || confBody?.booking?.id || subBody?.booking?.bookingId || subBody?.booking?.id || null;
      } else {
        console.warn('[mbBooking] submit failed — raw Bokun response:', JSON.stringify(subBody));
        const msg = subBody?.message || '';
        const m = msg.match(/min participants \((\d+) passengers?\)/);
        if (m) {
          bokunErrMsg = `Minimum ${m[1]} participant${parseInt(m[1])>1?'s':''} required.`;
        } else {
          bokunFieldErr = _resolveBokunFieldError(subBody, {
            phone: 'mb-phone', email: 'mb-email',
            firstName: 'mb-first', lastName: 'mb-last',
          });
          bokunErrMsg = bokunFieldErr?.userMsg || msg || null;
        }
      }
    } catch(e) { bokunErrMsg = e.message; }
  }

  if (mbCurrentTour.bokunId && !bokunConfirmationCode) {
    errEl.textContent = bokunErrMsg || 'Booking failed — the reservation was not created. Please try again or contact Thousand Miles support.';
    errEl.classList.remove('hidden');
    if (bokunFieldErr?.fieldId) _showBokunFieldError(bokunFieldErr.fieldId, bokunFieldErr.userMsg);
    btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check mr-2"></i>Create a booking';
    return;
  }

  const timeStr = mbSelectedSlot?.startTime ? mbSelectedSlot.startTime.slice(11,16) : null;
  const { error: dbErr } = await db.from('bookings').insert({
    id: bookingId, tour, date: dateStr, time: timeStr,
    guest, email: email||null, phone: fullPhone||null,
    pax: mbGuestCount, total: null, comm: null,
    payment_method: 'driver', status: 'to_be_paid',
    partner_id: null, source: 'admin',
    bokun_confirmation_code: bokunConfirmationCode||null,
    bokun_booking_id: bokunBookingId,
    notes: extraGuests.length ? 'Guests: '+[guest,...extraGuests].join(', ') : null,
    additional_guests: extraGuests.length ? extraGuests.join(', ') : null,
    package_lines: mbPackageLines || null,
    start_time_id: mbSelectedSlot?.startTimeId != null ? String(mbSelectedSlot.startTimeId) : null,
  });

  btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check mr-2"></i>Create a booking';
  if (dbErr) { errEl.textContent = 'Database error: '+dbErr.message; errEl.classList.remove('hidden'); return; }

  mbLastBookingData = {
    bookingId, bokunConfirmationCode, bokunBookingId,
    tourName: tour, date: dateStr, time: timeStr,
    guestName: guest, extraGuests, email, phone: fullPhone,
    pax: mbGuestCount, total: null, pickup: null, emailBlocks: [],
    payment: 'driver', status: 'to_be_paid',
    packageLines: mbPackageLines || null,
  };
  const ref = bokunConfirmationCode || (bokunBookingId?'TM-'+bokunBookingId:'#'+bookingId.split('-')[0].toUpperCase());
  document.getElementById('mb-success-ref').textContent = `Booking reference: ${ref}`;
  mbNavTo('mb-step-success');
  loadBookings().then(() => { _lastDashRender = 0; }).catch(() => {});
}

function mbViewVoucher() {
  if (!mbLastBookingData) return;
  fillAndShowVoucher(mbLastBookingData, null);
}
</script>

