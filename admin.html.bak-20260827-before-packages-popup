  function describeChanges(before, after, labels) {
    const changed = [];
    for (const key in after) {
      if (JSON.stringify(before[key]) !== JSON.stringify(after[key])) changed.push(labels?.[key] || key);
    }
    return changed.length ? changed.join(', ') : 'no changes';
  }

