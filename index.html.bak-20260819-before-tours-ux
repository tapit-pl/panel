  async function refreshTicketThread(ticketId) {
    const msgsEl = document.getElementById('tp-messages');
    const { data: msgs } = await db.from('support_messages')
      .select('*').eq('ticket_id', ticketId).order('created_at', { ascending: true });
    if (!msgs || msgs.length === 0) {
      msgsEl.innerHTML = '<div class="text-center text-xs text-gray-400 py-8">No messages yet.</div>';
      return;
    }
    msgsEl.innerHTML = msgs.map(m => {
      const isAdmin   = m.sender_type === 'admin';
      const time      = new Date(m.created_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      const name      = isAdmin ? (m.sender_name || 'Thousand Miles') : (m.sender_name || 'You');
      const bubbleBg  = isAdmin ? 'background:#FFF3EA;border:1px solid rgba(232,117,26,0.2)' : 'background:#F8FAFC;border:1px solid #e2e8f0';
      const nameCls   = isAdmin ? 'color:#E8751A' : 'color:#1a2332';
      return `<div class="flex ${isAdmin ? 'justify-end' : 'justify-start'}">
          <div style="max-width:85%;${bubbleBg};border-radius:14px;padding:10px 14px">
            <div class="text-xs font-semibold mb-1" style="${nameCls}">${escapeHtml(name)}</div>
            <div class="text-sm text-dark whitespace-pre-wrap leading-relaxed">${escapeHtml(m.message || '')}</div>
            <div class="text-xs text-gray-400 mt-1.5 text-right">${time}</div>
          </div>
        </div>`;
    }).join('');
    msgsEl.scrollTop = msgsEl.scrollHeight;
  }

