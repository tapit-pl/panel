async function saveCpEdit(id) {
  const p = cpData.find(x => x.id === id);
  if (!p) return;

  const errEl = document.getElementById('cpe-edit-error');
  const showErr = msg => { if (errEl) { errEl.textContent = msg; errEl.classList.remove('hidden'); } };
  if (errEl) errEl.classList.add('hidden');

  if (!cpeServices.length) { showErr('Add at least one service.'); return; }

  const firstName = document.getElementById('cpe-firstname').value.trim();
  const lastName  = document.getElementById('cpe-lastname').value.trim();
  const guestName = [firstName, lastName].filter(Boolean).join(' ');
  const pax = parseInt(document.getElementById('cpe-pax').value) || 1;
  const commRate = parseFloat(document.getElementById('cpe-commission-rate').value) || 0;
  const paymentMethod = document.getElementById('cpe-payment-method').value;

  const totalNet    = parseFloat(cpeServices.reduce((s, x) => s + (x.net || 0), 0).toFixed(2));
  const totalGross  = parseFloat(cpeServices.reduce((s, x) => s + (x.gross || 0), 0).toFixed(2));
  const totalMargin = parseFloat(cpeServices.reduce((s, x) => s + (x.margin_gross ?? x.margin ?? 0), 0).toFixed(2));
  const guestPrice  = parseFloat((totalGross + totalMargin).toFixed(2));
  const commAmount  = parseFloat((totalMargin * commRate / 100).toFixed(2));

  if (guestPrice <= 0) { showErr('Total guest price must be greater than 0.'); return; }

  const switchingToStripe = paymentMethod === 'stripe' && p.payment_method !== 'stripe';
  if (switchingToStripe && guestPrice < 2) {
    showErr('Stripe requires a minimum payment of 2 PLN. Increase the price or keep the current payment method.');
    return;
  }
  const switchingToBankTransfer = paymentMethod === 'bank_transfer' && p.payment_method !== 'bank_transfer';
  const btBank    = document.getElementById('cpe-bt-bank')?.value.trim()    || 'mBank S.A.';
  const btAccount = document.getElementById('cpe-bt-account')?.value.trim() || 'PL20 1140 2004 0000 3102 7618 3204';

  if (switchingToStripe) {
    const confirmMsg = p.guest_email
      ? `Switching to Stripe will immediately email a new payment link to ${p.guest_email}. Continue?`
      : 'Switching to Stripe will generate a new payment link. No guest email is set, so you will need to copy it manually. Continue?';
    if (!await showConfirm(confirmMsg, { okLabel: 'Save & send link', okColor: '#635BFF' })) return;
  } else if (switchingToBankTransfer) {
    const confirmMsg = p.guest_email
      ? `Switching to Bank transfer will immediately email the bank details to ${p.guest_email}. Continue?`
      : 'Switching to Bank transfer will not notify the guest — no guest email is set. Continue?';
    if (!await showConfirm(confirmMsg, { okLabel: 'Save & send details', okColor: '#0891b2' })) return;
  }

  const fields = {
    package_name:      document.getElementById('cpe-name').value.trim(),
    guest_name:        guestName,
    guest_phone:       document.getElementById('cpe-guest-phone').value.trim(),
    guest_email:       document.getElementById('cpe-guest-email').value.trim(),
    date:              document.getElementById('cpe-date').value,
    time:              document.getElementById('cpe-time').value.trim(),
    meeting_point:     document.getElementById('cpe-meeting').value.trim(),
    status:            document.getElementById('cpe-status').value,
    notes:             document.getElementById('cpe-notes').value.trim(),
    guest_note:        document.getElementById('cpe-guest-note').value.trim() || null,
    services:          cpeServices,
    commission_rate:   commRate,
    pax,
    payment_method:    paymentMethod,
    total_net:         totalNet,
    total_gross:       totalGross,
    total_margin:      totalMargin,
    guest_price:       guestPrice,
    commission_amount: commAmount,
  };

  const btn = document.getElementById('cpe-save-btn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin mr-1.5"></i>Saving…'; }

  const { error } = await db.from('custom_packages').update(fields).eq('id', id);
  if (error) {
    showErr('Error: ' + error.message);
    if (btn) { btn.disabled = false; btn.textContent = 'Save changes'; }
    return;
  }

  const cpeChangeLabels = {
    package_name: 'name', guest_name: 'guest name', guest_phone: 'phone', guest_email: 'email',
    date: 'date', time: 'time', meeting_point: 'meeting point', status: 'status', notes: 'notes',
    guest_note: 'guest note', services: 'services', commission_rate: 'commission rate', pax: 'pax',
    payment_method: 'payment method', guest_price: 'guest price',
  };
  const cpeChanges = describeChanges(p, fields, cpeChangeLabels);
  logActivity('custom_package_edited', `Package "${fields.package_name}" — changed: ${cpeChanges}`, id).catch(() => {});

  if (switchingToStripe) {
    if (btn) btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin mr-1.5"></i>Generating Stripe link…';
    const { data: stripeRes, error: stripeErr } = await invokeEdge('create-stripe-session', {
      body: {
        custom_package_id: id,
        tour_name: fields.package_name,
        date: fields.date || '',
        pax: fields.pax,
        guest_name: fields.guest_name,
        guest_email: fields.guest_email || null,
      }
    });
    if (stripeErr || !stripeRes?.session_url) {
      const errMsg = stripeErr?.body?.error || stripeErr?.message || 'No session URL';
      showToast('Package saved, but Stripe link failed: ' + errMsg, 'error');
      console.error('[saveCpEdit] stripe err:', stripeErr, 'data:', stripeRes);
    } else if (!fields.guest_email) {
      await navigator.clipboard.writeText(stripeRes.session_url).catch(() => {});
      showToast('Package updated. Payment link copied to clipboard (no guest email set).');
    } else {
      showToast('Package updated. Payment link sent to ' + fields.guest_email);
    }
  } else if (switchingToBankTransfer && fields.guest_email) {
    if (btn) btn.innerHTML = '<i class="fa-solid fa-circle-notch animate-spin mr-1.5"></i>Sending bank details…';
    const shortId = 'TM-PKG-' + id.split('-')[0].toUpperCase();
    const btTitle  = document.getElementById('cpe-bt-title')?.value.trim() || shortId;
    const btAmount = guestPrice.toFixed(2) + ' PLN';
    const { error: sendErr } = await invokeEdge('send-booking-confirmation', {
      body: {
        booking_id: shortId,
        tour_name: fields.package_name,
        date: fields.date || '',
        time: fields.time,
        guest_name: fields.guest_name,
        guest_email: fields.guest_email,
        phone: fields.guest_phone,
        pax: fields.pax,
        total: fields.guest_price,
        pickup: fields.meeting_point,
        payment_type: 'bank_transfer',
        email_blocks: [{ name: 'Bank transfer details:', info: `Bank: ${btBank}\nAccount: ${btAccount}\nTitle: ${btTitle}\nAmount: ${btAmount}` }],
        guest_note: fields.guest_note,
      }
    });
    if (sendErr) {
      showToast('Package saved, but sending bank details failed: ' + (sendErr.message || 'Unknown error'), 'error');
      console.error('[saveCpEdit] bank transfer email err:', sendErr);
    } else {
      showToast('Package updated. Bank details sent to ' + fields.guest_email);
    }
  } else if (switchingToBankTransfer) {
    showToast('Package updated. No guest email set — bank details not sent.');
  } else {
    showToast('Package updated.');
  }

  document.getElementById('cp-edit-modal')?.remove();
  await loadCustomTours();
}

async function sendCpVoucherEmail(id) {
  const p = cpData.find(x => x.id === id);
  if (!p || !p.guest_email) { showToast('No guest email on this package.', 'error'); return; }
  const shortId = 'TM-PKG-' + p.id.split('-')[0].toUpperCase();
  if (!await showConfirm(`Send voucher to ${p.guest_email}?`, { okLabel: 'Send', okColor: '#e8751a' })) return;
  const isCancelled = p.status === 'cancelled';
  const isPaid = p.status === 'paid' || p.status === 'confirmed';
  const paymentType = isCancelled ? 'cancelled' : isPaid ? 'cash' : p.payment_method === 'bank_transfer' ? 'bank_transfer' : 'cash';
  const btBank    = document.getElementById('bt-bank')?.value.trim()    || cpBankDefaults.bank;
  const btAccount = document.getElementById('bt-account')?.value.trim() || cpBankDefaults.account;
  const btTitle   = document.getElementById('bt-title')?.value.trim()   || shortId;
  const btAmount  = (p.guest_price || 0).toFixed(2) + ' PLN';
  const emailBlocks = (!isCancelled && !isPaid && p.payment_method === 'bank_transfer')
    ? [{ name: 'Bank transfer details:', info: `Bank: ${btBank}\nAccount: ${btAccount}\nTitle: ${btTitle}\nAmount: ${btAmount}` }]
    : null;
  const { data, error } = await invokeEdge('send-booking-confirmation', { body: {
    booking_id: shortId,
    tour_name: p.package_name,
    date: p.date || '',
    time: p.time || null,
    guest_name: p.guest_name || null,
    guest_email: p.guest_email,
    phone: p.guest_phone || null,
    pax: p.pax ?? 1,
    total: p.guest_price || null,
    pickup: p.meeting_point || null,
    payment_type: paymentType,
    email_blocks: emailBlocks,
    guest_note: p.guest_note || null,
  }});
  if (error || data?.sent === false) {
    showToast('Error sending email: ' + (error?.message || 'Unknown error'), 'error');
  } else {
    showToast(`Voucher sent to ${p.guest_email}`);
    logActivity('custom_package_voucher_sent', `Voucher sent for package "${p.package_name}" (${p.guest_name}) to ${p.guest_email}`, id).catch(() => {});
  }
}

