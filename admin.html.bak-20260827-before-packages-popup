  async function saveChangePin() {
    const current  = document.getElementById('change-pin-current').value;
    const newPin   = document.getElementById('change-pin-new').value;
    const confirm  = document.getElementById('change-pin-confirm').value;
    const errEl    = document.getElementById('change-pin-error');
    errEl.classList.add('hidden');
    if (!newPin || newPin.length < 4) { errEl.textContent = 'New PIN must be at least 4 characters.'; errEl.classList.remove('hidden'); return; }
