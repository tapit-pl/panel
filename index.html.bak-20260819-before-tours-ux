<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thousand Miles – Hotel Booking Panel</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        brand: '#E8751A',
        'brand-dark': '#C4611A',
        'brand-light': '#FFF3E8',
        dark: '#3A3A3A',
      },
      fontFamily: { sans: ['Inter', 'sans-serif'] }
    }
  }
}
</script>
<style>
  body { font-family: 'Inter', sans-serif; }
  .screen { display: none !important; }
  .screen.active { display: flex !important; }
  .fade-in { animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .slide-in { animation: slideIn 0.3s ease; }
  @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  .modal-bg { backdrop-filter: blur(4px); }
  .tour-card:hover .tour-img { transform: scale(1.05); }
  .tour-img { transition: transform 0.4s ease; }
  .slot-btn.selected { background: #E8751A; color: white; border-color: #E8751A; }
  .package-card.selected { border-color: #E8751A; background: #FFF3E8; }
  .package-card.selected .pkg-check { display: flex; }
  .pkg-check { display: none; }
.marketing-banner { background: linear-gradient(135deg, #1e3a5f 0%, #2d5282 100%); }
  .pickup-option.selected-pickup { border-color: #E8751A; background: #FFF3E8; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .calendar-day:hover { background: #FFF3E8; }
  .calendar-day.available { cursor: pointer; }
  .calendar-day.unavailable { opacity: 0.35; cursor: not-allowed; }
  .calendar-day.selected { background: #E8751A !important; color: white !important; }
  .tab-btn.active { border-bottom: 3px solid #E8751A; color: #E8751A; }
  .voucher-print { background: linear-gradient(135deg, #E8751A, #C4611A); }
  @media print {
    @page { margin: 0; size: A4; }
    body > *:not(#modal-voucher) { display: none !important; }
    #modal-voucher { display: block !important; position: static !important; background: none !important; padding: 0 !important; }
    #voucher-actions-dialog { display: none !important; }
    #modal-voucher .hidden { display: block !important; }
    #modal-voucher > .hidden > div { box-shadow: none !important; }
  }
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">

<!-- ===================== SCREEN 1: LOGIN ===================== -->
<div id="screen-login" class="screen min-h-screen bg-gradient-to-br from-gray-900 to-gray-800 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 fade-in">
    <div class="text-center mb-8">
      <div class="flex justify-center mb-2">
        <img src="assets/logo.png" alt="Thousand Miles" class="h-20 object-contain">
      </div>
      <p class="text-gray-500 text-sm mt-3">Booking panel for hotels and partners</p>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
        <div class="relative">
          <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input id="login-email" type="email" placeholder="email@example.com" autocomplete="username" class="w-full pl-9 pr-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm bg-gray-50" onkeydown="if(event.key==='Enter')doLogin()">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
        <div class="relative">
          <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input id="login-password" type="password" placeholder="••••••••" class="w-full pl-9 pr-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand text-sm bg-gray-50" onkeydown="if(event.key==='Enter')doLogin()">
        </div>
      </div>
      <div id="login-error" class="hidden bg-red-50 border border-red-200 text-red-600 text-xs rounded-xl px-4 py-3 flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation"></i>
        Incorrect login or password.
      </div>
      <button onclick="doLogin()" class="w-full bg-brand hover:bg-brand-dark text-white font-semibold py-3.5 rounded-xl transition-colors text-sm mt-2">
        Log in
      </button>
    </div>

    <div class="mt-6 pt-6 border-t text-center">
      <p class="text-xs text-gray-400">Having trouble logging in? <span class="text-brand cursor-pointer hover:underline" onclick="openContactModal()">Contact the office</span></p>
    </div>
  </div>
</div>

<!-- ===================== SCREEN: LOADING ===================== -->
<div id="screen-loading" class="screen active fixed inset-0 z-50 items-center justify-center" style="background:#1a2332">
  <div class="text-center">
    <img src="assets/logo.png" alt="Thousand Miles" class="h-16 object-contain mx-auto mb-6 opacity-90">
    <div class="w-6 h-6 border-2 border-white/20 border-t-white rounded-full animate-spin mx-auto"></div>
  </div>
</div>

<!-- ===================== SCREEN: WELCOME ===================== -->
<div id="screen-welcome" class="screen fixed inset-0 z-50 items-center justify-center" style="background: linear-gradient(135deg, #0d1520 0%, #1a2d45 50%, #0d1520 100%);">
  <!-- subtle pattern -->
  <div class="absolute inset-0 opacity-5" style="background-image: repeating-linear-gradient(45deg, #c9a96e 0, #c9a96e 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>

  <div class="relative text-center px-8 fade-in">
    <!-- top line -->
    <div class="flex items-center justify-center gap-4 mb-10">
      <div class="h-px w-16" style="background: linear-gradient(to right, transparent, #c9a96e)"></div>
      <div>
        <span class="text-xs tracking-[0.35em] uppercase block" style="color:#c9a96e">Thousand Miles</span>
        <span class="text-xs tracking-[0.2em] uppercase block mt-1" style="color:#4a6080">Booking System</span>
      </div>
      <div class="h-px w-16" style="background: linear-gradient(to left, transparent, #c9a96e)"></div>
    </div>

    <!-- greeting -->
    <p class="text-sm tracking-[0.2em] uppercase mb-3" style="color:#8a9bb0">Welcome to your partner panel</p>
    <h1 id="welcome-contact" class="text-4xl font-light text-white mb-1" style="letter-spacing:0.02em">—</h1>
    <p id="welcome-name" class="text-sm mb-12" style="color:#c9a96e; letter-spacing:0.15em"></p>

    <!-- divider -->
    <div class="flex items-center justify-center gap-3 mb-12">
      <div class="h-px w-12" style="background:#c9a96e; opacity:0.4"></div>
      <div class="w-1.5 h-1.5 rounded-full" style="background:#c9a96e; opacity:0.6"></div>
      <div class="h-px w-12" style="background:#c9a96e; opacity:0.4"></div>
    </div>

    <p class="text-sm mb-10 max-w-xs mx-auto leading-relaxed" style="color:#8a9bb0">
      Your panel is ready. Here you will find bookings, notifications and direct contact with our team.
    </p>

    <button onclick="finishWelcome()" class="px-10 py-3.5 text-sm font-semibold tracking-widest uppercase transition-all duration-300 hover:opacity-80" style="background:#c9a96e; color:#0d1520; border-radius:4px; letter-spacing:0.15em">
      Enter panel
    </button>

    <!-- bottom line -->
    <p class="text-xs mt-12 tracking-widest uppercase" style="color:#2a3d55">Kraków · Poland</p>
  </div>
</div>

<!-- ===================== MODAL: CONTACT ===================== -->
<div id="modal-contact" class="fixed inset-0 z-50 hidden modal-bg bg-black/50 items-center justify-center p-4" onclick="if(event.target===this)closeContactModal()">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-8 fade-in text-center relative">
    <button onclick="closeContactModal()" class="absolute top-4 right-4 w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center text-gray-500 transition-colors">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>

    <div class="w-16 h-16 bg-brand/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
      <i class="fa-solid fa-headset text-brand text-2xl"></i>
    </div>

    <h2 class="text-xl font-bold text-dark mb-1">Need help?</h2>
    <p class="text-gray-500 text-sm mb-6">Our team is at your disposal.</p>

    <a href="tel:+48607896523" class="flex items-center justify-center gap-3 bg-brand hover:bg-brand-dark text-white font-bold py-4 px-6 rounded-xl transition-colors text-lg tracking-wide mb-3">
      <i class="fa-solid fa-phone"></i>
      +48 607 896 523
    </a>

    <p class="text-xs text-gray-400">Available 7:30–21:00</p>
  </div>
</div>

<!-- ===================== SCREEN 2: DASHBOARD ===================== -->
<div id="screen-dashboard" class="screen min-h-screen bg-gray-50 flex-col">

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center cursor-pointer" onclick="goToTours()">
        <img src="assets/logo.png" alt="Thousand Miles" class="h-8 object-contain">
      </div>


      <div class="flex items-center gap-3">
        <!-- Partner badge -->
        <div class="flex items-center gap-2" id="partner-header-badge" title="">
          <span id="partner-header-initials" class="inline-flex w-8 h-8 rounded-full items-center justify-center text-xs font-bold select-none flex-shrink-0" style="background:#9ca3af;color:#fff;letter-spacing:.02em;">??</span>
          <span id="partner-header-name" class="text-xs font-semibold text-gray-700 max-w-[140px] truncate hidden sm:inline-block leading-tight"></span>
        </div>
        <!-- User -->
        <div class="flex items-center gap-2">
          <button onclick="doPartnerLogout()" class="text-gray-400 hover:text-gray-600" title="Log out">
            <i class="fa-solid fa-right-from-bracket text-sm"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full">

    <!-- Marketing Banner (dynamic, managed from admin Notifications) -->
    <div id="partner-banner" class="marketing-banner rounded-2xl p-5 mb-6 text-white relative overflow-hidden" style="display:none"></div>

    <!-- Notification Banner -->
    <div id="notif-home-banner" style="display:none" class="flex items-start gap-3 p-4 mb-5 rounded-2xl">
      <i class="fa-solid fa-bell text-sm mt-0.5 shrink-0" style="color:#E8751A"></i>
      <div id="notif-home-banner-content" class="flex-1 min-w-0"></div>
      <button onclick="document.getElementById('notif-home-banner').style.display='none'; localStorage.setItem('dismissed_notif_id', document.getElementById('notif-home-banner').dataset.notifId||'')" class="shrink-0 text-gray-400 hover:text-gray-600 text-sm">✕</button>
    </div>

    <!-- Tabs -->
    <div class="flex gap-0 border-b border-gray-200 mb-6 overflow-x-auto scrollbar-hide">
      <button class="tab-btn active whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-tours')">Tours</button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-bookings')">My bookings</button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-departures')">Today's departures</button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-updates')">Updates <span id="notif-badge-tab" class="ml-1 bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full hidden"></span></button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-faq')">Commissions</button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" onclick="setTab(this, 'tab-tailor')">Tailor made</button>
      <button class="tab-btn whitespace-nowrap px-4 py-2.5 text-xs font-medium text-gray-600 hover:text-brand transition-colors" id="nav-btn-support" onclick="setTab(this, 'tab-support')">Support <span id="support-tab-badge" class="ml-1 bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full hidden"></span></button>
    </div>

    <!-- TAB: UPDATES -->
    <div id="tab-updates" class="hidden fade-in max-w-3xl">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base font-semibold text-dark">Updates & Announcements</h2>
        <span class="text-xs text-gray-400">From Thousand Miles</span>
      </div>
      <div class="space-y-4" id="updates-list">
        <div id="updates-empty" class="text-center py-12 text-gray-400 text-sm">No announcements yet.</div>
      </div>
    </div>

    <!-- TAB: TOURS -->
    <div id="tab-tours" class="fade-in">
      <!-- Search + filters row -->
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <div class="relative flex-1 min-w-56">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input id="tour-search" type="text" placeholder="Search tours..." oninput="filterTours()" class="w-full pl-8 pr-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand bg-white">
        </div>
        <div id="tour-cat-filters" class="flex gap-2 flex-wrap">
          <button onclick="filterTourCat(this,'all')" class="tour-cat-btn text-xs px-3 py-2 bg-brand text-white rounded-lg font-medium">All</button>
        </div>
        <span id="tour-count" class="text-xs text-gray-400 ml-auto">0 tours</span>
      </div>

      <div id="tour-no-results" class="hidden text-center py-16 text-gray-400">
        <i class="fa-solid fa-magnifying-glass text-3xl text-gray-300 block mb-3"></i>
        No tours match your search.
      </div>

      <div id="tour-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <div id="tours-loading" class="col-span-4 py-16 text-center text-gray-400">
          <i class="fa-solid fa-spinner animate-spin text-3xl text-brand block mb-3"></i>
          <div class="text-sm">Loading tours...</div>
        </div>
      </div>
    </div>

    <!-- TAB: BOOKINGS -->
    <div id="tab-bookings" class="hidden fade-in">
      <!-- Stats row -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-5">
        <div class="bg-white rounded-2xl shadow-sm p-4 text-center">
          <div id="stat-total" class="text-2xl font-bold text-dark">—</div>
          <div class="text-xs text-gray-400 mt-1">Total bookings</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-4 text-center">
          <div id="stat-paid" class="text-2xl font-bold text-green-600">—</div>
          <div class="text-xs text-gray-400 mt-1">Paid</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-4 text-center">
          <div id="stat-pending" class="text-2xl font-bold text-yellow-600">—</div>
          <div class="text-xs text-gray-400 mt-1">Pending</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-4 text-center">
          <div id="stat-cancelled" class="text-2xl font-bold text-red-500">—</div>
          <div class="text-xs text-gray-400 mt-1">Cancelled</div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm p-4 text-center">
          <div id="stat-noshow" class="text-2xl font-bold text-red-400">—</div>
          <div class="text-xs text-gray-400 mt-1">No Show</div>
        </div>
      </div>

      <!-- Filter bar -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="relative flex-1 min-w-48">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          <input id="booking-search" type="text" placeholder="Search by guest, tour, phone, email, #..." oninput="searchBookings()" class="w-full pl-8 pr-3 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand bg-white">
        </div>
        <div class="flex gap-2 flex-wrap">
          <button onclick="filterBookings('all', this)" class="booking-filter-btn text-xs px-3 py-2 bg-brand text-white rounded-lg font-medium">All</button>
          <button onclick="filterBookings('paid', this)" class="booking-filter-btn text-xs px-3 py-2 bg-gray-100 text-gray-500 rounded-lg hover:bg-gray-200">Paid</button>
          <button onclick="filterBookings('pending', this)" class="booking-filter-btn text-xs px-3 py-2 bg-gray-100 text-gray-500 rounded-lg hover:bg-gray-200">Pending</button>
          <button onclick="filterBookings('cancelled', this)" class="booking-filter-btn text-xs px-3 py-2 bg-gray-100 text-gray-500 rounded-lg hover:bg-gray-200">Cancelled</button>
          <button onclick="filterBookings('no_show', this)" class="booking-filter-btn text-xs px-3 py-2 bg-gray-100 text-gray-500 rounded-lg hover:bg-gray-200">No Show</button>
        </div>
      </div>

      <!-- Booking list -->
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="divide-y divide-gray-50" id="booking-list">
          <div class="p-8 text-center text-gray-400 text-sm">Loading bookings...</div>
        </div>
        <div id="booking-no-results" class="hidden text-center py-12 text-gray-400">
          <i class="fa-solid fa-magnifying-glass text-3xl text-gray-300 block mb-3"></i>
          <p class="text-sm">No bookings match your search.</p>
        </div>
      </div>
    </div>

    <!-- TAB: GUEST VOUCHERS (removed) -->
    <div id="tab-vouchers" class="hidden fade-in max-w-3xl" style="display:none!important">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-base font-semibold text-dark">Guest Voucher Lookup</h2>
          <p class="text-xs text-gray-400 mt-0.5">Find a guest's voucher by name or booking number</p>
        </div>
        <div class="w-12 h-12 bg-brand/10 rounded-2xl flex items-center justify-center">
          <i class="fa-solid fa-ticket text-brand text-xl"></i>
        </div>
      </div>

      <!-- Info hint -->
      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-3.5 flex gap-3 text-sm text-blue-700 mb-5">
        <i class="fa-solid fa-circle-info text-blue-400 mt-0.5 shrink-0"></i>
        <span>Type to search — results are filtered in real time</span>
      </div>

      <!-- Search area -->
      <div class="flex gap-3 mb-6">
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input id="voucher-search" type="text" placeholder="Type guest last name or booking number (e.g. TM-2026-0847)..." oninput="filterVouchers()" class="w-full pl-11 pr-4 py-3.5 border border-gray-200 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand bg-white shadow-sm">
        </div>
        <button onclick="filterVouchers()" class="bg-brand hover:bg-brand-dark text-white px-6 py-3.5 rounded-2xl font-semibold text-sm transition-colors flex items-center gap-2">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </div>

      <!-- Voucher cards -->
      <div class="space-y-4" id="voucher-list">

        <!-- Voucher 1 -->
        <div class="voucher-card bg-white rounded-2xl shadow-sm p-5 flex items-center gap-4" data-search="tm-2026-0847 jan kowalski zakopane kowalski">
          <div class="w-12 h-12 bg-brand rounded-xl flex items-center justify-center text-white font-bold text-lg shrink-0">JK</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-gray-400 font-mono">#TM-2026-0847</span>
              <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-semibold">Paid ✓</span>
            </div>
            <div class="font-semibold text-dark text-sm">Jan Kowalski</div>
            <div class="text-sm text-gray-600">Trip to Zakopane</div>
            <div class="text-xs text-gray-400 mt-0.5">Apr 8, 2026 · 07:00 · 2 pax</div>
          </div>
          <button onclick="printVoucher()" class="bg-brand hover:bg-brand-dark text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors flex items-center gap-2 shrink-0">
            <i class="fa-solid fa-print"></i> Print Voucher
          </button>
        </div>

        <!-- Voucher 2 -->
        <div class="voucher-card bg-white rounded-2xl shadow-sm p-5 flex items-center gap-4" data-search="tm-2026-0851 anna nowak auschwitz nowak">
          <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center text-white font-bold text-lg shrink-0">AN</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-gray-400 font-mono">#TM-2026-0851</span>
              <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full font-semibold">Pending</span>
            </div>
            <div class="font-semibold text-dark text-sm">Anna Nowak</div>
            <div class="text-sm text-gray-600">Auschwitz-Birkenau</div>
            <div class="text-xs text-gray-400 mt-0.5">Apr 10, 2026 · 09:00 · 4 pax</div>
          </div>
          <button onclick="printVoucher()" class="bg-brand hover:bg-brand-dark text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors flex items-center gap-2 shrink-0">
            <i class="fa-solid fa-print"></i> Print Voucher
          </button>
        </div>

