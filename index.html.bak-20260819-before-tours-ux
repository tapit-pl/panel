              const d = i + 1;
              const isPast = (year === todayY && month === todayM && d < todayD) || (year < todayY) || (year === todayY && month < todayM);
              const dateStr = year + '-' + String(month+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
              const slots = currentTourAvailability[dateStr];
              const _hiddenIds = new Set((tdCurrentTour?.hiddenSlotIds || []).map(String));
              const _visibleSlots = (slots || []).filter(s => !_hiddenIds.has(String(s.startTimeId)));
              const isAvailable = _visibleSlots.some(s => s.availabilityCount === null || (s.availabilityCount || 0) > 0);
              let cls, tooltip = '';
