  function completeBooking() {
    const items = cart.length > 0 ? cart : [{name:'Trip to Zakopane', guests:2}];
    let errors = [];

    items.forEach((item, idx) => {
      const first = document.getElementById('bk-first-' + idx)?.value.trim();
      const last  = document.getElementById('bk-last-' + idx)?.value.trim();
      const email = document.getElementById('bk-email-' + idx)?.value.trim();
      if (!first || !last) errors.push(`${item.name}: main guest name required`);
      if (!email) errors.push(`${item.name}: e-mail required`);

      for (let p = 2; p <= (item.guests || 1); p++) {
        const pf = document.getElementById('bk-p-first-' + idx + '-' + p)?.value.trim();
        const pl = document.getElementById('bk-p-last-'  + idx + '-' + p)?.value.trim();
        if (!pf || !pl) errors.push(`${item.name}: Participant ${p} name required`);
      }
    });

    if (errors.length > 0) {
      items.forEach((item, idx) => {
        ['bk-first-'+idx,'bk-last-'+idx,'bk-email-'+idx].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.borderColor = el.value.trim() ? '' : '#ef4444';
        });
        for (let p = 2; p <= (item.guests || 1); p++) {
          ['bk-p-first-'+idx+'-'+p, 'bk-p-last-'+idx+'-'+p].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.style.borderColor = el.value.trim() ? '' : '#ef4444';
          });
        }
      });
      items.forEach((_, idx) => {
        const sec = document.getElementById('bk-section-' + idx);
        if (sec) sec.classList.remove('hidden');
      });
      return;
    }

    const firstItem = items[0] || {};
    const firstName = document.getElementById('bk-first-0')?.value.trim() || '';
    const lastName  = document.getElementById('bk-last-0')?.value.trim() || '';
    const email     = document.getElementById('bk-email-0')?.value.trim() || '';
    closeBookingForm();
    cart = [];
    updateCartUI();
    const refEl = document.getElementById('modal-confirm-ref');
    if (refEl) refEl.textContent = `${firstName} ${lastName}${email ? ' · ' + email : ''}${firstItem.name ? ' · ' + firstItem.name : ''}`;
    document.getElementById('modal-confirm').classList.remove('hidden');
    document.getElementById('modal-confirm').classList.add('flex');
