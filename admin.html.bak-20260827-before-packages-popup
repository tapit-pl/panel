  if (!e.target.closest('#ab-cdrop-phone')) {
    const list = document.getElementById('ab-phone-prefix-list');
    if (list) { list.style.display = 'none'; document.getElementById('ab-phone-prefix-btn')?.classList.remove('open'); }
