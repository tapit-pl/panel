  function closeAddTourModal() {
    document.getElementById('modal-add-tour').classList.add('hidden');
  }
  function addTourHasData() {
    const ids = ['add-tour-title','add-tour-description','add-tour-bokun-id','add-tour-meeting-point','add-tour-cutoff-hours','add-tour-slot-capacity'];
    if (ids.some(id => (document.getElementById(id)?.value || '').trim())) return true;
    if (_addTourPhotoUrl) return true;
    if (document.getElementById('add-tour-slots-list')?.children.length) return true;
    if (document.querySelectorAll('#add-tour-groups-wrap .tg-group-cb:checked').length) return true;
    if (document.querySelectorAll('#add-tour-categories-wrap .atc-cat-cb:checked').length) return true;
    return false;
  }
  async function tryCloseAddTourModal() {
    if (addTourHasData()) {
      const ok = await showConfirm('You have unsaved changes.\nLeave without saving?', { okLabel: 'Leave', okColor: '#dc2626', cancelLabel: 'Stay' });
      if (!ok) return;
    }
    closeAddTourModal();
  }

  function renderAddTourCategories(selectedSlugs) {
    const wrap = document.getElementById('add-tour-categories-wrap');
    if (!wrap) return;
    if (allCategories.length === 0) {
      wrap.innerHTML = '<span style="font-size:11px;color:#475569;font-style:italic">No categories defined yet — add them below in Tour Categories</span>';
      return;
    }
    wrap.innerHTML = allCategories.map(c => {
      const checked = selectedSlugs.includes(c.slug);
      return `<label style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:99px;border:1px solid ${checked ? 'rgba(232,117,26,0.5)' : 'rgba(255,255,255,0.1)'};background:${checked ? 'rgba(232,117,26,0.15)' : 'rgba(255,255,255,0.04)'};cursor:pointer;transition:all 0.15s" onclick="toggleEditTourGroup(this)">
        <input type="checkbox" value="${escapeHtml(c.slug)}" ${checked ? 'checked' : ''} class="atc-cat-cb sr-only">
        <span style="font-size:12px;font-weight:500;color:${checked ? '#E8751A' : '#94a3b8'}">${escapeHtml(c.label)}</span>
      </label>`;
    }).join('');
  }

  async function handleAddTourPhotoUpload(input) {
    const file = input.files[0];
    if (!file) return;
    const statusEl = document.getElementById('add-tour-photo-status');
    statusEl.textContent = 'Uploading…';
    try {
      const ext = file.name.split('.').pop().toLowerCase();
      const path = `tour-new-${Date.now()}.${ext}`;
      const { error } = await db.storage.from('tour-photos').upload(path, file, { upsert: true });
      if (error) throw error;
      const { data } = db.storage.from('tour-photos').getPublicUrl(path);
      _addTourPhotoUrl = data.publicUrl;
      const photoImg = document.getElementById('add-tour-photo-img');
      photoImg.src = _addTourPhotoUrl;
      photoImg.classList.remove('hidden');
      document.getElementById('add-tour-photo-placeholder').classList.add('hidden');
      statusEl.textContent = 'Uploaded ✓';
    } catch (e) {
      statusEl.textContent = 'Upload failed';
    }
  }

  function addTourPickupToggle() {
    const hotelCb = document.getElementById('add-tour-allow-hotel-pickup');
    const meetingCb = document.getElementById('add-tour-allow-meeting-point');
    const mpRow = document.getElementById('add-tour-meeting-point-row');
    if (!hotelCb || !meetingCb || !mpRow) return;
    if (!hotelCb.checked && !meetingCb.checked) meetingCb.checked = true;
