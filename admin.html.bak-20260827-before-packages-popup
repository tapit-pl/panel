  function setPricingType(prefix, val) {
    const input = document.getElementById(prefix + '-tour-pricing-type');
    if (input) input.value = val;
    const isDark = prefix === 'edit' || prefix === 'add';
    document.querySelectorAll('.' + prefix + '-pricing-btn').forEach(btn => {
      const isActive = btn.dataset.val === val;
      btn.style.background = isActive ? '#E8751A' : (isDark ? 'rgba(255,255,255,0.05)' : '#fff');
      btn.style.color = isActive ? '#fff' : (isDark ? '#64748b' : '#6b7280');
      btn.style.fontWeight = isActive ? '600' : '';
    });
  }

  function openAddTourModal() {
    document.getElementById('add-tour-title').value = '';
    document.getElementById('add-tour-description').value = '';
