  function openBookingVoucher(id) {
    const b = (partnerBookings || []).find(x => x.id === id);
    if (!b) return;
    const tour = (bokunProducts || []).find(t => t.title === b.tour);
    const isStripe = !!b.stripe_session_id;
    const payment = (isStripe || b.payment_type === 'hotel' || b.payment_method === 'hotel') ? 'hotel' : 'driver';
    const extraGuestsArr = b.additional_guests
      ? b.additional_guests.split(',').map(s => s.trim()).filter(Boolean)
      : null;
    fillAndShowVoucher({
      bokunConfirmationCode: b.bokun_confirmation_code || null,
      bokunBookingId: b.bokun_booking_id || null,
      bookingId: b.id,
      tourName: b.tour,
      pax: b.pax,
      total: b.total ? Math.round(b.total) : null,
      date: b.date,
      guestName: b.guest || null,
      time: b.time || null,
      pickup: b.pickup || null,
      phone: b.phone || null,
      email: b.email || null,
      emailBlocks: tour?.emailBlocks || [],
      payment,
      status: b.status || null,
      extraGuests: extraGuestsArr,
      packageLines: b.package_lines || null,
    });
  }

