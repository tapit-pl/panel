  // ===== MULTI-SELECT COMPONENT =====
  const _msel = {};

  function mselInit(id, defaultLabel, changeFn) {
    _msel[id] = { vals: new Set(), cb: changeFn, label: defaultLabel || 'All' };
  }

  function mselSetOptions(id, options) {
    if (!_msel[id]) return;
    const optsEl = document.getElementById(id + '-opts');
    if (!optsEl) return;
    optsEl.innerHTML = options.map(o => {
      const checked = _msel[id].vals.has(String(o.value));
      return `<label class="msel-opt${checked ? ' checked' : ''}"><input type="checkbox" value="${escapeHtml(String(o.value))}" ${checked ? 'checked' : ''} onchange="mselCheck('${id}',this)"><span>${escapeHtml(o.label)}</span></label>`;
    }).join('');
    mselUpdateLabel(id);
  }

  function mselCheck(id, cb) {
    if (!_msel[id]) return;
    if (cb.checked) { _msel[id].vals.add(cb.value); cb.closest('.msel-opt').classList.add('checked'); }
    else { _msel[id].vals.delete(cb.value); cb.closest('.msel-opt').classList.remove('checked'); }
    mselUpdateLabel(id);
    _msel[id].cb?.();
  }

  function mselToggle(id) {
    const panel = document.getElementById(id + '-panel');
    if (!panel) return;
    const isOpen = panel.classList.contains('open');
    document.querySelectorAll('.msel-panel.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.cdrop-list.open').forEach(l => { l.classList.remove('open'); l.closest('.cdrop')?.querySelector('.cdrop-btn')?.classList.remove('open'); });
    if (!isOpen) { panel.classList.add('open'); panel.querySelector('.msel-search')?.focus(); }
  }

  function mselSearch(id, q) {
    const optsEl = document.getElementById(id + '-opts');
    if (!optsEl) return;
    const ql = q.toLowerCase();
    optsEl.querySelectorAll('.msel-opt').forEach(opt => {
      opt.style.display = (opt.querySelector('span')?.textContent || '').toLowerCase().includes(ql) ? '' : 'none';
    });
  }

  function mselClear(id, silent) {
    if (!_msel[id]) return;
    _msel[id].vals.clear();
    const optsEl = document.getElementById(id + '-opts');
    if (optsEl) optsEl.querySelectorAll('.msel-opt').forEach(opt => { opt.classList.remove('checked'); const cb = opt.querySelector('input'); if (cb) cb.checked = false; });
    mselUpdateLabel(id);
    if (!silent) _msel[id].cb?.();
  }

  function mselGetVals(id) { return [...(_msel[id]?.vals || new Set())]; }

  function mselUpdateLabel(id) {
    const s = _msel[id];
    if (!s) return;
    const btn = document.querySelector(`#${id} > .cdrop-btn`);
    const lbl = btn?.querySelector('.cdrop-val');
    if (!lbl) return;
    if (s.vals.size === 0) { lbl.textContent = s.label; btn.classList.remove('has-sel'); }
    else { lbl.textContent = `${s.vals.size} selected`; btn.classList.add('has-sel'); }
  }

