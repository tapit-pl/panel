  function addManualSlot(prefix, listId) {
    const list = document.getElementById(listId || prefix + '-tour-slots-list');
    if (!list) return;
    const div = document.createElement('div');
    div.className = 'flex items-center gap-2';
    const isDark = prefix === 'edit' || prefix === 'add';
    if (isDark) {
      div.innerHTML = `<input type="time" class="manual-slot-time" style="font-size:12px;padding:6px 8px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.05);color:#f1f5f9;outline:none">
        <input type="text" class="manual-slot-label" style="flex:1;font-size:12px;padding:6px 8px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.05);color:#f1f5f9;outline:none" placeholder="Label (optional)">
        <button type="button" onclick="this.parentElement.remove()" style="color:#475569;background:none;border:none;cursor:pointer;font-size:12px" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='#475569'"><i class="fa-solid fa-xmark"></i></button>`;
    } else {
