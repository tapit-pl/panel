  async function calculateSettlement() {
    const partnerId = document.getElementById('settle-hotel').value;
    if (!partnerId) { showToast('Please select a partner first.', 'error'); return; }

    const calcBtn = document.getElementById('settle-calc-btn');
    const calcBtnHtml = calcBtn?.innerHTML;
    if (calcBtn) { calcBtn.disabled = true; calcBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>Calculating...'; }
    try {

    const isAllPartners = partnerId === 'all';
    const isMonthMode = settleMode === 'month';

    let from, to, periodLabel, period;
    if (isMonthMode) {
      period = document.getElementById('settle-month').value;
      const [yr, mo] = period.split('-').map(Number);
      from = `${yr}-${String(mo).padStart(2,'0')}-01`;
      const lastDay = new Date(yr, mo, 0).getDate();
      to = `${yr}-${String(mo).padStart(2,'0')}-${lastDay}`;
      periodLabel = new Date(yr, mo-1).toLocaleDateString('en', { month: 'long', year: 'numeric' });
    } else {
      from = document.getElementById('settle-date-from').value;
      to = document.getElementById('settle-date-to').value;
      if (!from || !to) { showToast('Please select a date range.', 'error'); return; }
      if (from > to) { showToast('"From" date must be before "To" date.', 'error'); return; }
      const fmtDate = d => new Date(d+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
      periodLabel = `${fmtDate(from)} – ${fmtDate(to)}`;
    }

    const partner = isAllPartners ? null : allPartners.find(p => p.id === partnerId);

    // Mark as settled: only available for specific partner + month mode
    const canSettle = !isAllPartners && isMonthMode;
    const btnSettle = document.getElementById('btn-mark-settled');
    if (btnSettle) btnSettle.classList.toggle('hidden', !canSettle);

    // Query bookings
    let query = db.from('bookings').select('*').gte('date', from).lte('date', to).order('date');
    if (isAllPartners) {
      query = query.not('partner_id', 'is', null);
    } else {
      query = query.eq('partner_id', partnerId);
    }
    const { data: bookings, error: bookingsErr } = await query;
    if (bookingsErr || !bookings) { showToast('Failed to load bookings data.', 'error'); return; }

    // Settlement history only for specific partner + month mode
    let history = [];
    let settledAmount = 0;
    if (!isAllPartners && isMonthMode) {
      const { data: hist } = await db.from('settlements')
        .select('*').eq('partner_id', partnerId)
        .order('created_at', { ascending: false });
      history = hist || [];
      settledAmount = history.filter(s => s.period === period).reduce((s, r) => s + parseFloat(r.amount||0), 0);
    }

    const rows = bookings || [];
    const COMMISSION_STATUSES = ['confirmed', 'paid', 'arrived', 'no_show'];
    const confirmedRows = rows.filter(b => COMMISSION_STATUSES.includes((b.status||'').toLowerCase()));

    // hotel payment: guest paid hotel → hotel owes TM (total - comm)
    // cash/link: guest paid TM → TM owes hotel (comm)
    // no_show: hotel owes TM (total - comm) — commission excluded since hotel never earned it
    let hotelOwesTM = 0, tmOwesHotel = 0;
    for (const b of confirmedRows) {
      const total = parseFloat(b.total||0), comm = parseFloat(b.comm||0);
      if ((b.status||'').toLowerCase() === 'no_show') hotelOwesTM += total - comm;
      else if (resolvePaymentMethod(b) === 'hotel') hotelOwesTM += total - comm;
      else tmOwesHotel += comm;
    }
    const netToSettle = hotelOwesTM - tmOwesHotel;
    const toSettle = netToSettle - settledAmount;
    const alreadySettled = canSettle && Math.abs(toSettle) < 0.01;

    currentSettlement = {
      partnerId: isAllPartners ? null : partnerId,
      partnerName: isAllPartners ? 'All partners' : (partner?.name||''),
      partnerAddress: partner?.address||'',
      period: isMonthMode ? period : null,
      periodLabel,
      total: toSettle,
      rows
    };

    if (btnSettle && canSettle) {
      btnSettle.disabled = alreadySettled;
      btnSettle.innerHTML = alreadySettled
        ? '<i class="fa-solid fa-check"></i>Already settled'
        : '<i class="fa-solid fa-check"></i>Mark as settled';
    }

    const titleName = isAllPartners ? 'All partners' : (partner?.name||'');
    document.getElementById('settlement-result-title').textContent = `${titleName} · ${periodLabel}`;

    const direction = toSettle > 0 ? 'Hotel pays TM' : toSettle < 0 ? 'TM pays hotel' : 'Settled';
    let subtitle;
    if (isAllPartners) {
      subtitle = `${confirmedRows.length} confirmed booking${confirmedRows.length!==1?'s':''} · ${rows.length} total`;
    } else if (settledAmount !== 0) {
      subtitle = `${confirmedRows.length} booking${confirmedRows.length!==1?'s':''} · ${Math.abs(settledAmount)} pln already settled`;
    } else {
      subtitle = `${confirmedRows.length} booking${confirmedRows.length!==1?'s':''} · ${direction}`;
    }
    document.getElementById('settlement-result-subtitle').textContent = subtitle;

    // Summary stats strip
    const statsEl = document.getElementById('settlement-stats');
    if (statsEl) {
      statsEl.classList.remove('hidden');
      document.getElementById('stats-bookings').textContent = confirmedRows.length;
      const totalSales = confirmedRows.reduce((s, b) => s + parseFloat(b.total||0), 0);
      document.getElementById('stats-total').textContent = Math.round(totalSales).toLocaleString('pl') + ' pln';
      const netEl = document.getElementById('stats-net');
      netEl.textContent = Math.abs(Math.round(toSettle)).toLocaleString('pl') + ' pln';
      netEl.className = 'text-2xl font-bold tabular-nums ' + (toSettle > 0.01 ? 'text-brand' : toSettle < -0.01 ? 'text-blue-400' : 'text-gray-400');
      document.getElementById('stats-net-label').textContent = toSettle > 0.01 ? 'Hotel → TM' : toSettle < -0.01 ? 'TM → Hotel' : 'Settled ✓';
    }

    const totalEl = document.getElementById('settlement-total');
    const dirEl = document.getElementById('settlement-direction');
    const absAmt = Math.abs(toSettle);
    if (toSettle > 0.01) {
      totalEl.textContent = `${absAmt} pln`;
      totalEl.className = 'px-5 py-3.5 text-right font-bold text-lg text-brand';
      dirEl.textContent = 'Hotel → TM';
      dirEl.className = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-green-500/20 text-green-400';
    } else if (toSettle < -0.01) {
      totalEl.textContent = `${absAmt} pln`;
      totalEl.className = 'px-5 py-3.5 text-right font-bold text-lg text-blue-400';
      dirEl.textContent = 'TM → Hotel';
      dirEl.className = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400';
    } else {
      totalEl.textContent = isAllPartners ? '—' : '0 pln';
      totalEl.className = 'px-5 py-3.5 text-right font-bold text-lg text-gray-400';
      dirEl.textContent = isAllPartners ? '' : 'Settled';
      dirEl.className = 'ml-2 text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-500/20 text-gray-400';
    }

    // Update table header (Partner column only in all-partners mode)
    const theadRow = document.querySelector('#settlement-result thead tr');
    if (theadRow) {
      if (isAllPartners) {
        theadRow.innerHTML = `
          <th class="text-left px-5 py-3 text-gray-400 font-semibold">Tour</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Partner</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Guest</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Date</th>
          <th class="text-center px-4 py-3 text-gray-400 font-semibold">Pax</th>
          <th class="text-right px-4 py-3 text-gray-400 font-semibold">Total</th>
          <th class="text-right px-5 py-3 text-gray-400 font-semibold">Settlement</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Payment</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Status</th>`;
      } else {
        theadRow.innerHTML = `
          <th class="text-left px-5 py-3 text-gray-400 font-semibold">Tour</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Guest</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Date</th>
          <th class="text-center px-4 py-3 text-gray-400 font-semibold">Pax</th>
          <th class="text-right px-4 py-3 text-gray-400 font-semibold">Total</th>
          <th class="text-right px-5 py-3 text-gray-400 font-semibold">Settlement</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Payment</th>
          <th class="text-left px-4 py-3 text-gray-400 font-semibold">Status</th>`;
      }
    }

    const _statusRank = s => { const v = (s||'').toLowerCase(); if(v==='paid')return 0; if(v==='to_be_paid')return 1; if(v==='cancelled')return 99; return 2; };
    const sortedRows = [...rows].sort((a,b) => _statusRank(a.status) - _statusRank(b.status) || (a.date||'').localeCompare(b.date||''));

    const tbody = document.getElementById('settlement-tbody');
    tbody.innerHTML = sortedRows.length === 0
      ? `<tr><td colspan="8" class="px-5 py-8 text-center text-gray-400">No bookings in this period.</td></tr>`
      : sortedRows.map(b => {
          const cancelled = (b.status||'').toLowerCase() === 'cancelled';
          const dateStr = b.date ? new Date(b.date+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'}) : '—';
          const total = parseFloat(b.total||0), comm = parseFloat(b.comm||0);
          const isHotel = resolvePaymentMethod(b) === 'hotel';
          const settlementAmt = isHotel ? (total - comm) : comm;
          const _pm = resolvePaymentMethod(b);
          const pmLabel = _pm === 'hotel' ? 'Reception' : _pm === 'driver' ? 'Driver' : _pm === 'link' ? 'Online' : '—';
          const commCell = cancelled
            ? `<td class="px-5 py-3 text-right font-bold text-gray-300 line-through">${settlementAmt||'—'} pln</td>`
            : `<td class="px-5 py-3 text-right font-bold text-dark">${settlementAmt||'—'} pln</td>`;
          if (isAllPartners) {
            const partnerName = allPartners.find(p => p.id === b.partner_id)?.name || '—';
            return `<tr class="hover:bg-gray-50${cancelled?' opacity-50':''}">
              <td class="px-5 py-3 font-medium text-dark text-xs">${b.tour ? escapeHtml(b.tour) : '—'}</td>
              <td class="px-4 py-3 text-gray-500 text-xs">${escapeHtml(partnerName)}</td>
              <td class="px-4 py-3 text-gray-600">${b.guest ? escapeHtml(b.guest) : '—'}</td>
              <td class="px-4 py-3 text-gray-500 whitespace-nowrap">${dateStr}</td>
              <td class="px-4 py-3 text-center text-dark">${b.pax||'—'}</td>
              <td class="px-4 py-3 text-right text-gray-600">${b.total ? b.total+' pln' : '—'}</td>
              ${commCell}
              <td class="px-4 py-3 text-xs text-gray-400">${pmLabel}</td>
              <td class="px-4 py-3">${statusBadge(b.status)}</td>
            </tr>`;
          } else {
            return `<tr class="hover:bg-gray-50${cancelled?' opacity-40':''}">
              <td class="px-5 py-3 font-medium text-dark text-xs max-w-xs">${b.tour ? escapeHtml(b.tour) : '—'}</td>
              <td class="px-4 py-3 text-gray-600 text-xs">${b.guest ? escapeHtml(b.guest) : '—'}</td>
              <td class="px-4 py-3 text-gray-500 whitespace-nowrap text-xs">${dateStr}</td>
              <td class="px-4 py-3 text-center text-dark text-xs">${b.pax||'—'}</td>
              <td class="px-4 py-3 text-right text-gray-600 text-xs tabular-nums">${b.total ? b.total+' pln' : '—'}</td>
              ${commCell}
              <td class="px-4 py-3 text-xs text-gray-400">${pmLabel}</td>
              <td class="px-4 py-3">${statusBadge(b.status)}</td>
            </tr>`;
          }
        }).join('');

    // Settlement history sidebar
    const histList = document.getElementById('settlement-history-list');
    if (histList) {
      if (isAllPartners || !isMonthMode) {
        histList.innerHTML = '<p class="text-xs text-gray-400 text-center py-4">Settlement history is available for specific partner · monthly view only.</p>';
      } else {
        histList.innerHTML = history.length === 0
          ? '<p class="text-xs text-gray-400 text-center py-4">No settlements yet.</p>'
          : history.map(s => {
              const d = s.settled_date ? new Date(s.settled_date+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '—';
              const p = s.period ? new Date(s.period+'-01').toLocaleDateString('en',{month:'long',year:'numeric'}) : s.period;
              return `<div class="flex justify-between items-center py-2 border-b border-gray-50 last:border-0">
                <div>
                  <div class="text-xs font-semibold text-dark">${p}</div>
                  <div class="text-xs text-gray-400">${d}</div>
                </div>
                <div class="flex items-center gap-2">
                  <div class="text-sm font-bold text-brand">${s.amount||0} pln</div>
                  <button onclick="deleteSettlement('${s.id}')" title="Delete" class="w-5 h-5 flex items-center justify-center rounded hover:bg-red-50 text-gray-400 hover:text-red-500 transition-colors"><i class="fa-solid fa-trash text-xs"></i></button>
                </div>
              </div>`;
            }).join('');
      }
    }

    // Driver-pay warning
    const DRIVER_PAY_STATUSES = ['to_be_paid', 'pending'];
    const driverPending = rows.filter(b => DRIVER_PAY_STATUSES.includes((b.status||'').toLowerCase()));
    const warnEl  = document.getElementById('settlement-driver-warning');
    const warnTxt = document.getElementById('settlement-driver-warning-text');
    const warnList = document.getElementById('settlement-driver-warning-list');
    if (warnEl && warnTxt) {
      if (driverPending.length > 0) {
        const n = driverPending.length;
        warnTxt.textContent = `${n} booking${n > 1 ? 's' : ''} with "Pay at driver" status found in this period — ${n > 1 ? 'they are' : 'it is'} not included in the calculation. Mark each as Paid or No Show below, or in All Bookings.`;
        warnEl.classList.remove('hidden');
        if (warnList) {
          warnList.innerHTML = driverPending.map(b => {
            const dateStr = b.date ? new Date(b.date+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short'}) : '—';
            const enriched = allBookings.find(x => x.id === b.id) || b;
            const noShowBtn = canMarkNoShow(enriched)
              ? `<button onclick="markNoShow('${b.id}').then(()=>calculateSettlement())" class="text-xs font-semibold px-2 py-1 rounded-lg bg-red-100 hover:bg-red-200 text-red-700 transition-colors">No show</button>`
              : '';
            return `<div class="flex items-center justify-between gap-2 bg-white bg-opacity-60 rounded-lg px-3 py-1.5">
              <span class="text-xs truncate" style="color:#78350f">${escapeHtml(b.tour||'—')} — ${escapeHtml(b.guest||'—')} · ${dateStr}</span>
              <div class="flex gap-1.5 shrink-0">
                <button onclick="quickMarkPaid('${b.id}').then(()=>calculateSettlement())" class="text-xs font-semibold px-2 py-1 rounded-lg bg-green-100 hover:bg-green-200 text-green-700 transition-colors">Mark paid</button>
                ${noShowBtn}
              </div>
            </div>`;
          }).join('');
        }
      } else {
        warnEl.classList.add('hidden');
        if (warnList) warnList.innerHTML = '';
      }
    }

    document.getElementById('settlement-empty').classList.add('hidden');
    document.getElementById('settlement-result').classList.remove('hidden');
    document.getElementById('settlement-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
    const cashBtn = document.getElementById('btn-cash-settlement');
    if (cashBtn) cashBtn.classList.toggle('hidden', !isAllPartners);
    } finally {
      if (calcBtn) { calcBtn.disabled = false; calcBtn.innerHTML = calcBtnHtml; }
    }
  }

  function buildPartnerSheet(wb, ws, partnerName, partnerAddress, allRows, addLogoToSheet) {
    const thin = { style: 'thin' };
    const border = { top: thin, left: thin, bottom: thin, right: thin };
    ws.columns = [
      { width: 7 }, { width: 30 }, { width: 10 }, { width: 10 }, { width: 13 },
      { width: 18 }, { width: 16 }, { width: 18 }, { width: 22 }, { width: 3 }, { width: 30 },
    ];
    ws.addRow([]); ws.addRow([]); ws.addRow([]);
    ws.getRow(1).height = 18; ws.getRow(2).height = 18; ws.getRow(3).height = 18;
    addLogoToSheet(ws);

    const nameRow = ws.addRow(['', 'Obiekt:', partnerName]);
    nameRow.getCell(2).font = { bold: true };
    const addrRow = ws.addRow(['', 'Adres:', partnerAddress]);
    addrRow.getCell(2).font = { bold: true };
    ws.addRow([]);

    const HEADERS = ['Data', 'Pakiet', 'Cena', 'Ilość os.', 'Total cena', 'Prowizja za os.', 'Prowizja total', 'Forma płatności', 'Do odbioru z recepcji'];
    const LEGEND = ['pay at hotel = płatność na recepcji', 'pay at driver = zapłacone u kierowcy', 'online = płatność online'];
    const headerRow = ws.addRow([...HEADERS, '', LEGEND[0]]);
    headerRow.height = 28;
    headerRow.eachCell((cell, col) => {
      if (col <= 9) {
        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFCC99' } };
        cell.font = { bold: true };
        cell.border = border;
        cell.alignment = { vertical: 'middle', wrapText: false };
      }
      if (col === 11) cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFF99' } };
    });
    const headerRowNum = headerRow.number;
    const COLS = ['A','B','C','D','E','F','G','H','I'];

    const ACTIVE_STATUSES = ['confirmed', 'paid', 'arrived', 'no_show'];
    const rows = (allRows || []).filter(b => ACTIVE_STATUSES.includes((b.status||'').toLowerCase()));
    let totalComm = 0, hotelOwesTM = 0, tmOwesHotel = 0;
    let nextRow = headerRowNum + 1;

    for (const b of rows) {
      const day = b.date ? new Date(b.date + 'T12:00:00').getDate() : '';
      const pkg = allCommissions.find(c => c.title === b.tour);
      const pricePerPerson = pkg?.price_pln ?? '';
      const commPerPerson = b.pax ? Math.round(parseFloat(b.comm||0) / b.pax) : (pkg?.commission_pln ?? 0);
      const total = parseFloat(b.total || 0);
      const comm  = parseFloat(b.comm  || 0);
      const isNoShow = (b.status||'').toLowerCase() === 'no_show';
      const isHotel = !isNoShow && resolvePaymentMethod(b) === 'hotel';
      const _pmEx = resolvePaymentMethod(b);
      const pmLabel = isNoShow ? 'no show' : isHotel ? 'pay at hotel' : _pmEx === 'driver' ? 'pay at driver' : 'online';
      const doOdbioru = isNoShow ? Math.round(total - comm) : isHotel ? Math.round(total - comm) : 0;
      if (isNoShow) hotelOwesTM += Math.round(total - comm);
      else { totalComm += comm; if (isHotel) hotelOwesTM += Math.round(total - comm); else tmOwesHotel += Math.round(comm); }
      const vals = [day, b.tour||'', pricePerPerson, b.pax||'', total, commPerPerson, comm, pmLabel, doOdbioru];
      COLS.forEach((col, i) => {
        const cell = ws.getCell(`${col}${nextRow}`);
        cell.value = vals[i];
        cell.border = border;
      });
      nextRow++;
    }

    for (let i = rows.length; i < 10; i++) {
      COLS.forEach(col => { ws.getCell(`${col}${nextRow}`).border = border; });
      nextRow++;
    }

    nextRow += 2;
    const netSettlement = hotelOwesTM - tmOwesHotel;
    const summaryRows = [
      { label: 'Zarobek hotelu (prowizja):', value: Math.round(totalComm), fill: 'FFE2EFDA', color: 'FF375623' },
      { label: 'Hotel płaci TM (z recepcji):', value: hotelOwesTM, fill: 'FFDAE3F3', color: 'FF1F3864' },
      { label: 'TM płaci hotelowi:', value: tmOwesHotel, fill: 'FFFCE4D6', color: 'FF833C00' },
      { label: netSettlement >= 0 ? 'ROZLICZENIE NETTO (hotel → TM):' : 'ROZLICZENIE NETTO (TM → hotel):', value: Math.abs(netSettlement), fill: netSettlement >= 0 ? 'FF70AD47' : 'FF4472C4', color: 'FFFFFFFF' },
    ];
    for (const sr of summaryRows) {
      ws.getCell(`B${nextRow}`).value = sr.label;
      ws.getCell(`B${nextRow}`).font = { bold: true };
      ws.getCell(`B${nextRow}`).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: sr.fill } };
      ws.getCell(`G${nextRow}`).value = sr.value;
      ws.getCell(`G${nextRow}`).font = { bold: true, color: { argb: sr.color } };
      ws.getCell(`G${nextRow}`).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: sr.fill } };
      ws.getCell(`G${nextRow}`).numFmt = '#,##0 "PLN"';
      ['B','C','D','E','F','G','H','I'].forEach(c => {
        const cell = ws.getCell(`${c}${nextRow}`);
        if (!cell.value) cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: sr.fill } };
        cell.border = border;
      });
      nextRow++;
    }

    [LEGEND[1], LEGEND[2]].forEach((txt, i) => {
      const cell = ws.getCell(`K${headerRowNum + 1 + i}`);
      cell.value = txt;
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFF99' } };
    });
  }

  function buildSummarySheet(wb, summaryData, periodLabel, addLogoToSheet) {
    const ws = wb.addWorksheet('Podsumowanie');
    const thin = { style: 'thin' };
    const border = { top: thin, left: thin, bottom: thin, right: thin };
    ws.columns = [
      { width: 32 }, { width: 32 }, { width: 13 }, { width: 20 }, { width: 18 }, { width: 20 }, { width: 22 },
    ];
    ws.addRow([]); ws.addRow([]); ws.addRow([]);
    ws.getRow(1).height = 18; ws.getRow(2).height = 18; ws.getRow(3).height = 18;
    addLogoToSheet(ws);

    const titleRow = ws.addRow(['Podsumowanie rozliczeń — ' + periodLabel]);
    titleRow.getCell(1).font = { bold: true, size: 13 };
    ws.addRow([]);

    const HEADERS = ['Hotel', 'Adres', 'Rezerwacje', 'Zarobek prowizji', 'Hotel płaci TM', 'TM płaci hotelowi', 'Rozliczenie netto'];
    const headerRow = ws.addRow(HEADERS);
    headerRow.height = 28;
    headerRow.eachCell((cell, col) => {
      if (col <= 7) {
        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFCC99' } };
        cell.font = { bold: true };
        cell.border = border;
        cell.alignment = { vertical: 'middle' };
      }
    });

    const ACTIVE_STATUSES = ['confirmed', 'paid', 'arrived', 'no_show'];
    let totComm = 0, totHotelOwes = 0, totTmOwes = 0, totBookings = 0;

    for (const s of summaryData) {
      const activeCount = s.pRows.filter(b => ACTIVE_STATUSES.includes((b.status||'').toLowerCase())).length;
      const net = s.netSettlement;
      const dataRow = ws.addRow([s.pName, s.pAddress, activeCount, Math.round(s.totalComm), s.hotelOwesTM, s.tmOwesHotel, Math.abs(net)]);
      dataRow.eachCell((cell, col) => { if (col <= 7) cell.border = border; });
      [4, 5, 6].forEach(c => { dataRow.getCell(c).numFmt = '#,##0 "PLN"'; });
      const netCell = dataRow.getCell(7);
      netCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: net >= 0 ? 'FF70AD47' : 'FF4472C4' } };
      netCell.font = { bold: true, color: { argb: 'FFFFFFFF' } };
      netCell.numFmt = '#,##0 "PLN"';
      totComm += s.totalComm;
      totHotelOwes += s.hotelOwesTM;
      totTmOwes += s.tmOwesHotel;
      totBookings += activeCount;
    }

    ws.addRow([]);
    const totalNet = totHotelOwes - totTmOwes;
    const totalRow = ws.addRow(['RAZEM', '', totBookings, Math.round(totComm), totHotelOwes, totTmOwes, Math.abs(totalNet)]);
    totalRow.eachCell((cell, col) => {
      if (col <= 7) {
        cell.font = { bold: true };
        cell.border = border;
        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF2CC' } };
      }
    });
    [4, 5, 6, 7].forEach(c => { totalRow.getCell(c).numFmt = '#,##0 "PLN"'; });
  }

  async function downloadCashSettlementExcel() {
    if (!currentSettlement?.rows) { showToast('Please calculate commission first.', 'error'); return; }
    const ExcelJS = window.ExcelJS;
    if (!ExcelJS) { showToast('Excel library not loaded yet, please try again.', 'error'); return; }

    // Ensure partners list is loaded
    if (!allPartners || allPartners.length === 0) {
      const { data } = await db.from('partners').select('id, name').order('name');
      if (data) { allPartners.length = 0; data.forEach(p => allPartners.push(p)); }
    }

    const ACTIVE_STATUSES = ['confirmed', 'paid', 'arrived', 'no_show'];
    const activeRows = (currentSettlement.rows || []).filter(b => ACTIVE_STATUSES.includes((b.status||'').toLowerCase()));

    // Compute tmOwesHotel and hotelOwesTM per partner
    const perPartner = {};
    for (const b of activeRows) {
      const pid = b.partner_id;
      if (!pid) continue;
      if (!perPartner[pid]) perPartner[pid] = { tmOwesHotel: 0, hotelOwesTM: 0 };
      const total = parseFloat(b.total || 0);
      const comm  = parseFloat(b.comm  || 0);
      const isNoShow = (b.status||'').toLowerCase() === 'no_show';
      const isHotel  = !isNoShow && resolvePaymentMethod(b) === 'hotel';
      if (isNoShow)     perPartner[pid].hotelOwesTM += Math.round(total - comm);
      else if (isHotel) perPartner[pid].hotelOwesTM += Math.round(total - comm);
      else              perPartner[pid].tmOwesHotel += Math.round(comm);
    }

    // Build sorted partner list (all partners, even those with 0)
    const partners = allPartners.slice().sort((a, b) => (a.name||'').localeCompare(b.name||''));

    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet('Cash Settlement');

    // Column widths
    ws.getColumn(1).width = 28;  // A – FV dla obiektów
    ws.getColumn(2).width = 14;  // B – kwota
    ws.getColumn(3).width = 3;   // C – spacer
    ws.getColumn(4).width = 28;  // D – Prowizja do hotelu
    ws.getColumn(5).width = 14;  // E – kwota
    ws.getColumn(6).width = 3;   // F – spacer
    ws.getColumn(7).width = 34;  // G – Prowizja do odbioru
    ws.getColumn(8).width = 14;  // H – kwota
    ws.getColumn(9).width = 3;   // I – spacer
    ws.getColumn(10).width = 28; // J – FV do opłacenia
    ws.getColumn(11).width = 14; // K – kwota

    const headerFill   = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1F3864' } };
    const headerFont   = { bold: true, color: { argb: 'FFFFFFFF' }, size: 10 };
    const sumFill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF2CC' } };
    const sumFont      = { bold: true, size: 10 };
    const bodyFont     = { size: 10 };
    const numFmt       = '#,##0 "zł"';
    const thin         = { style: 'thin' };
    const border       = { top: thin, left: thin, bottom: thin, right: thin };
    const centerAlign  = { horizontal: 'center', vertical: 'middle' };
    const leftAlign    = { horizontal: 'left',   vertical: 'middle' };

    const setHeader = (cell, text) => {
      const c = ws.getCell(cell);
      c.value = text; c.fill = headerFill; c.font = headerFont;
      c.alignment = leftAlign; c.border = border;
    };

    // Row 1 — section headers
    setHeader('A1', 'FV dla obiektów:');
    setHeader('B1', 'Kwota:');
    setHeader('D1', 'Prowizja do hotelu w gotówce:');
    setHeader('E1', 'Kwota:');
    setHeader('G1', 'Prowizja do odbioru z hotelu w gotówce:');
    setHeader('H1', 'Kwota:');
    setHeader('J1', 'FV do opłacenia:');
    setHeader('K1', 'Kwota:');

    // Data rows — one per partner
    let sumTmOwes = 0, sumHotelOwes = 0;
    partners.forEach((p, i) => {
      const row = i + 2;
      const d = perPartner[p.id] || { tmOwesHotel: 0, hotelOwesTM: 0 };

      // Col D/E — Prowizja do hotelu (TM pays hotel)
      const dCell = ws.getCell(row, 4);
      dCell.value = p.name; dCell.font = bodyFont; dCell.alignment = leftAlign; dCell.border = border;
      const eCell = ws.getCell(row, 5);
      if (d.tmOwesHotel > 0) {
        eCell.value = d.tmOwesHotel; eCell.numFmt = numFmt;
        sumTmOwes += d.tmOwesHotel;
      }
      eCell.font = bodyFont; eCell.alignment = leftAlign; eCell.border = border;

      // Col G/H — Prowizja do odbioru (hotel pays TM)
      const gCell = ws.getCell(row, 7);
      gCell.value = p.name; gCell.font = bodyFont; gCell.alignment = leftAlign; gCell.border = border;
      const hCell = ws.getCell(row, 8);
      if (d.hotelOwesTM > 0) {
        hCell.value = d.hotelOwesTM; hCell.numFmt = numFmt;
        sumHotelOwes += d.hotelOwesTM;
      }
      hCell.font = bodyFont; hCell.alignment = leftAlign; hCell.border = border;
    });

    // SUMA row
    const sumaRow = partners.length + 2;
    const applySum = (colIdx, value, isLabel) => {
      const c = ws.getCell(sumaRow, colIdx);
      c.value = isLabel ? 'SUMA:' : value;
      if (!isLabel && value > 0) c.numFmt = numFmt;
      c.fill = sumFill; c.font = sumFont; c.alignment = leftAlign; c.border = border;
    };
    applySum(4, 0, true);          // D — "SUMA:"
    applySum(5, sumTmOwes, false);  // E — suma tmOwesHotel
    applySum(7, 0, true);           // G — "SUMA:"
    applySum(8, sumHotelOwes, false); // H — suma hotelOwesTM

    // Period label in title row (row 1, col A note)
    ws.getCell('A1').value = `FV dla obiektów: (${currentSettlement.periodLabel || ''})`;

    // Generate file
    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url;
    const period = (currentSettlement.periodLabel || 'period').replace(/\s+/g, '_');
    a.download = `cash_settlement_${period}.xlsx`;
    a.click(); URL.revokeObjectURL(url);
  }

  async function downloadSettlementExcel() {
    if (!currentSettlement?.rows) { showToast('Please calculate commission first.', 'error'); return; }
    const ExcelJS = window.ExcelJS;
    if (!ExcelJS) { showToast('Excel library not loaded yet, please try again.', 'error'); return; }

    const isAllPartners = !currentSettlement.partnerId;
    const wb = new ExcelJS.Workbook();

    let logoImgId = null;
    try {
      const logoRes = await fetch('assets/logo.png');
      const logoBuffer = await logoRes.arrayBuffer();
      logoImgId = wb.addImage({ buffer: logoBuffer, extension: 'png' });
    } catch(e) { /* skip if unavailable */ }
    const addLogoToSheet = (ws) => {
      if (logoImgId !== null) ws.addImage(logoImgId, { tl: { col: 0, row: 0 }, ext: { width: 190, height: 62 } });
    };

    if (isAllPartners) {
      // Load partners for settlement — use local variable, never overwrite global allPartners
      let settlementPartners = allPartners.length > 0 ? allPartners : [];
      if (settlementPartners.length === 0) {
        const { data } = await db.from('partners').select('id, name, address').order('name');
        if (data) settlementPartners = data;
      }

      const ACTIVE_STATUSES = ['confirmed', 'paid', 'arrived', 'no_show'];
      const activeRows = (currentSettlement.rows || []).filter(b => ACTIVE_STATUSES.includes((b.status||'').toLowerCase()));

      // Group by partner_id
      const partnerMap = {};
      for (const b of activeRows) {
        const pid = b.partner_id || '__unknown__';
        if (!partnerMap[pid]) partnerMap[pid] = [];
        partnerMap[pid].push(b);
      }

      // Build per-partner totals
      const summaryData = [];
      for (const [pid, pRows] of Object.entries(partnerMap)) {
        const partner = settlementPartners.find(p => p.id === pid);
        const pName = partner?.name || 'Unknown';
        const pAddress = partner?.address || '';
        let totalComm = 0, hotelOwesTM = 0, tmOwesHotel = 0;
        for (const b of pRows) {
          const comm = parseFloat(b.comm || 0);
          const total = parseFloat(b.total || 0);
          const isNoShow = (b.status||'').toLowerCase() === 'no_show';
          const isHotel = !isNoShow && resolvePaymentMethod(b) === 'hotel';
          if (isNoShow) hotelOwesTM += Math.round(total - comm);
          else { totalComm += comm; if (isHotel) hotelOwesTM += Math.round(total - comm); else tmOwesHotel += Math.round(comm); }
        }
        summaryData.push({ pid, pName, pAddress, pRows, totalComm, hotelOwesTM, tmOwesHotel, netSettlement: hotelOwesTM - tmOwesHotel });
      }
      summaryData.sort((a, b) => a.pName.localeCompare(b.pName, 'pl'));

      // First tab: summary
      buildSummarySheet(wb, summaryData, currentSettlement.periodLabel, addLogoToSheet);

      // One tab per partner
      const usedNames = new Set(['Podsumowanie']);
      for (const s of summaryData) {
        let baseName = s.pName.replace(/[\\\/\*\?\:\[\]]/g, '').substring(0, 31);
        let sheetName = baseName;
        let counter = 2;
        while (usedNames.has(sheetName)) { sheetName = baseName.substring(0, 28) + ` ${counter++}`; }
        usedNames.add(sheetName);
        const ws = wb.addWorksheet(sheetName);
        buildPartnerSheet(wb, ws, s.pName, s.pAddress, s.pRows, addLogoToSheet);
      }

    } else {
      const ws = wb.addWorksheet('Rozliczenie');
      buildPartnerSheet(wb, ws, currentSettlement.partnerName, currentSettlement.partnerAddress, currentSettlement.rows, addLogoToSheet);
    }

    const buffer = await wb.xlsx.writeBuffer();
    const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const period = (currentSettlement.period || currentSettlement.periodLabel).replace(/[^a-zA-Z0-9]/g,'_');
    a.download = isAllPartners
      ? `rozliczenie_wszystkie_${period}.xlsx`
      : `rozliczenie_${(currentSettlement.partnerName||'partner').replace(/\s+/g,'_')}_${period}.xlsx`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function _csvEscape(v) {
    const s = String(v ?? '');
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }

  function downloadSettlementCsv() {
    if (!currentSettlement?.rows) { showToast('Please calculate commission first.', 'error'); return; }
    const isAllPartners = !currentSettlement.partnerId;
    const _statusRank = s => { const v = (s||'').toLowerCase(); if(v==='paid')return 0; if(v==='to_be_paid')return 1; if(v==='cancelled')return 99; return 2; };
    const sortedRows = [...currentSettlement.rows].sort((a,b) => _statusRank(a.status) - _statusRank(b.status) || (a.date||'').localeCompare(b.date||''));
    const headers = isAllPartners
      ? ['Tour','Partner','Guest','Date','Pax','Total','Settlement','Payment','Status']
      : ['Tour','Guest','Date','Pax','Total','Settlement','Payment','Status'];
    const lines = [headers.join(',')];
    for (const b of sortedRows) {
      const total = parseFloat(b.total||0), comm = parseFloat(b.comm||0);
      const isHotel = resolvePaymentMethod(b) === 'hotel';
      const settlementAmt = isHotel ? (total - comm) : comm;
      const pm = resolvePaymentMethod(b);
      const pmLabel = pm === 'hotel' ? 'Reception' : pm === 'driver' ? 'Driver' : pm === 'link' ? 'Online' : '';
      const row = isAllPartners
        ? [b.tour||'', allPartners.find(p => p.id === b.partner_id)?.name||'', b.guest||'', b.date||'', b.pax||'', total||0, settlementAmt||0, pmLabel, b.status||'']
        : [b.tour||'', b.guest||'', b.date||'', b.pax||'', total||0, settlementAmt||0, pmLabel, b.status||''];
      lines.push(row.map(_csvEscape).join(','));
    }
    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const period = (currentSettlement.period || currentSettlement.periodLabel || 'export').replace(/[^a-zA-Z0-9]/g,'_');
    a.download = isAllPartners ? `settlement_all_${period}.csv` : `settlement_${(currentSettlement.partnerName||'partner').replace(/\s+/g,'_')}_${period}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  async function deleteSettlement(id) {
    if (currentAdminRole !== 'admin') { showToast('Admin role required.', 'error'); return; }
    if (!await showConfirm('Delete this settlement record?', { okLabel: 'Delete' })) return;
    const { error } = await db.from('settlements').delete().eq('id', id);
    if (error) { showToast('Failed to delete settlement record.', 'error', error.message); return; }
    logActivity('settlement_deleted', `Settlement ${id} deleted`, id).catch(() => {});
    if (currentSettlement) await calculateSettlement();
  }

  async function markSettled() {
    if (!currentSettlement) return;
    const settleBtn = document.getElementById('btn-mark-settled');
    const settleBtnHtml = settleBtn?.innerHTML;
    if (settleBtn) settleBtn.disabled = true;
    const { partnerId, partnerName, period, periodLabel, total } = currentSettlement;
    const { error } = await db.from('settlements').insert({
      partner_id: partnerId,
      period,
      amount: total,
      settled_date: new Date().toISOString().slice(0,10),
    });
    if (error) {
      showToast('Failed to mark as settled.', 'error', error.message);
      if (settleBtn) { settleBtn.disabled = false; settleBtn.innerHTML = settleBtnHtml; }
      return;
    }
    const txt = document.getElementById('modal-settled-text');
    if (txt) {
      txt.textContent = '';
      const strong = document.createElement('strong');
      strong.className = 'text-dark';
      strong.textContent = `${total} pln`;
      txt.append(`${partnerName} · ${periodLabel} · `, strong, ' has been marked as settled.');
    }
    const m = document.getElementById('modal-settled');
    m.classList.remove('hidden'); m.classList.add('flex');
    document.getElementById('btn-mark-settled').disabled = true;
    document.getElementById('btn-mark-settled').innerHTML = '<i class="fa-solid fa-check"></i>Already settled';
    logActivity('settlement_created', `${partnerName} · ${periodLabel} · ${total} pln`).catch(() => {});
    await calculateSettlement();
  }
</script>

