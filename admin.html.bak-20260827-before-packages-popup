function abRateCount(i, delta) {
  const maxSlot = abSelectedSlot?.availabilityCount ?? abCurrentTour?.maxPax ?? 999;
  const totalOthers = abRateSelections.reduce((s, x, idx) => idx === i ? s : s + x.count, 0);
  abRateSelections[i].count = Math.max(0, Math.min(maxSlot - totalOthers, abRateSelections[i].count + delta));
  const el = document.getElementById(`ab-rate-count-${i}`);
  if (el) el.textContent = abRateSelections[i].count;
  abUpdateProceedBtn();
  abUpdateTransportPrice();
  abSyncFormSummary();
}

function abShowCategoryPicker(rate, categoriesToShow, slotCatPrices) {
  abSelectedRate = rate;
  slotCatPrices = slotCatPrices || rate?.pricesByCategory || [];
  const cats = (categoriesToShow || []).map(c => {
    const priceEntry = slotCatPrices.find(p => String(p.pricingCategoryId || p.id) === String(c.id));
    return { category: c, count: 0, amount: priceEntry?.amount };
  });
  if (cats.length === 0) { abShowForm(); return; }
  abCategorySelections = cats;
  const commEntry = (abCurrentTour?.configId
    ? allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour.configId)
    : null) || abLookupCommEntry(abCurrentTour?.title, abCurrentTour?.configId);
  const container = document.getElementById('ab-rates-container');
  container.innerHTML = `<div class="text-sm font-semibold text-dark mb-3">Number of guests</div>
    <div class="rounded-2xl border border-gray-200 overflow-hidden divide-y divide-gray-100">` +
    abCategorySelections.map((cs, i) => {
      const catTitle = cs.category.title || cs.category.pricingCategoryTitle || 'Guest';
      const pln = abCategoryPln(commEntry, catTitle);
      const priceStr = pln != null ? `<span style="color:#E8751A;font-weight:600;font-size:14px;">${pln} pln</span> <span style="color:#94a3b8;font-size:12px;">/os.</span>` : '';
      return `
      <div class="px-4 py-3 bg-white flex items-center justify-between">
        <div class="flex-1 min-w-0 mr-3">
          <div class="text-dark text-sm font-semibold">${escapeHtml(catTitle)}</div>
          ${priceStr ? `<div class="flex items-center gap-1 mt-0.5">${priceStr}</div>` : ''}
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button onclick="abCatCount(${i},-1)" class="w-8 h-8 border-2 border-gray-200 rounded-lg flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">−</button>
          <span id="ab-cat-count-${i}" class="w-6 text-center text-sm font-bold text-dark">${cs.count}</span>
          <button onclick="abCatCount(${i},1)" class="w-8 h-8 border-2 border-gray-200 rounded-lg flex items-center justify-center text-gray-500 hover:border-brand hover:text-brand transition-colors font-bold text-lg leading-none">+</button>
        </div>
      </div>`;
    }).join('') + `</div>`;
  const ratesSection = document.getElementById('ab-modal-rates-section');
  ratesSection.classList.remove('hidden');
  ratesSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function abUpdateProceedBtn() {
  const total = abRateSelections.reduce((s,r) => s+r.count, 0) +
                abCategorySelections.reduce((s,c) => s+c.count, 0);
  const btn = document.getElementById('ab-proceed-btn');
  if (!btn) return;
  if (total === 0) {
    btn.disabled = true;
    btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-gray-100 text-gray-400 cursor-not-allowed';
  } else {
    btn.disabled = false;
    btn.className = 'px-5 py-2.5 rounded-xl text-sm font-semibold transition-all text-white cursor-pointer';
    btn.style.background = '#E8751A';
  }
}
function abCatCount(i, delta) {
  const maxSlot = abSelectedSlot?.availabilityCount ?? abCurrentTour?.maxPax ?? 999;
  const totalOthers = abCategorySelections.reduce((s, x, idx) => idx === i ? s : s + x.count, 0);
  abCategorySelections[i].count = Math.max(0, Math.min(maxSlot - totalOthers, abCategorySelections[i].count + delta));
  const el = document.getElementById(`ab-cat-count-${i}`);
  if (el) el.textContent = abCategorySelections[i].count;
  abUpdateProceedBtn();
  abUpdateTransportPrice();
  abSyncFormSummary();
}

function abSyncFormSummary() {
  const formSection = document.getElementById('ab-modal-form-section');
  if (!formSection || formSection.classList.contains('hidden')) return;
  const hasRates = abRateSelections.some(r => r.count > 0);
  const hasCats  = abCategorySelections.some(c => c.count > 0);
  if (!hasRates && !hasCats) return;
  abGuestCount = hasRates
    ? abRateSelections.reduce((s,r) => s+r.count, 0)
    : abCategorySelections.reduce((s,c) => s+c.count, 0);
  const summary = hasRates
    ? abRateSelections.filter(r=>r.count>0).map(r=>`${r.count}× ${r.rate.title}`).join(', ')
    : abCategorySelections.filter(c=>c.count>0).map(c=>`${c.count}× ${c.category.pricingCategoryTitle||c.category.title}`).join(', ');
  const summaryEl = document.getElementById('ab-category-summary');
  if (summaryEl) { summaryEl.textContent = summary; summaryEl.classList.remove('hidden'); }
}

function abProceedFromRates() {
  if (abSelectedNonBokunPkg) { abProceedFromNonBokunPkg(); return; }
  const total = abRateSelections.reduce((s,r) => s+r.count, 0) +
                abCategorySelections.reduce((s,c) => s+c.count, 0);
  if (total === 0) return;
  abGuestCount = total;
  abShowForm();
}

