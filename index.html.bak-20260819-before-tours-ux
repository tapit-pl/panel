  async function submitSupportTicket() {
    const subject  = (document.getElementById('st-subject')?.value || '').trim();
    const category = document.getElementById('st-category')?.value || '';
    const priority = document.querySelector('input[name="st-priority"]:checked')?.value || 'normal';
    const bookingRef = (document.getElementById('st-booking-ref')?.value || '').trim();
    const rawMessage = (document.getElementById('st-message')?.value || '').trim();
    const errEl    = document.getElementById('st-error');
    const btn      = document.getElementById('st-submit-btn');

    errEl.classList.add('hidden');
    if (!category) { document.getElementById('st-category').style.borderColor = '#E8751A'; errEl.textContent = 'Please choose a category.'; errEl.classList.remove('hidden'); return; }
    if (!subject) { document.getElementById('st-subject').style.borderColor = '#E8751A'; errEl.textContent = 'Subject is required.'; errEl.classList.remove('hidden'); return; }
    if (!rawMessage) { document.getElementById('st-message').style.borderColor = '#E8751A'; errEl.textContent = 'Message is required.'; errEl.classList.remove('hidden'); return; }
    document.getElementById('st-category').style.borderColor = '';
    document.getElementById('st-subject').style.borderColor = '';
    document.getElementById('st-message').style.borderColor = '';

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting…';

    const message = bookingRef ? `Booking reference: ${bookingRef}\n\n${rawMessage}` : rawMessage;

    try {
      const { data: ticket, error } = await db.from('support_tickets').insert({
        subject,
        category,
        priority,
        status: 'open',
        partner_email: currentPartner?.email || '',
        partner_name:  currentPartner?.name  || '',
      }).select('id').single();

      if (error) throw error;

      if (ticket?.id && message) {
        await db.from('support_messages').insert({
          ticket_id:    ticket.id,
          sender_type:  'partner',
          sender_email: currentPartner?.email || '',
          sender_name:  currentPartner?.name  || '',
          message,
        });
      }

      // Upload screenshots for Technical category
      if (ticket?.id && category === 'Technical') {
        const fileInput = document.getElementById('st-files');
        const files = fileInput ? Array.from(fileInput.files).slice(0, 3) : [];
        for (const file of files) {
          try {
            const path = `${ticket.id}/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, '_')}`;
            const { data: uploadData, error: uploadErr } = await db.storage.from('support-attachments').upload(path, file, { upsert: true });
            if (!uploadErr && uploadData) {
              const { data: { publicUrl } } = db.storage.from('support-attachments').getPublicUrl(uploadData.path);
              await db.from('support_messages').insert({
                ticket_id:       ticket.id,
                sender_type:     'partner',
                sender_email:    currentPartner?.email || '',
                sender_name:     currentPartner?.name  || '',
                message:         '',
                attachment_url:  publicUrl,
                attachment_name: file.name,
              });
            }
          } catch (uploadEx) { console.warn('Screenshot upload failed:', uploadEx); }
        }
      }

      document.getElementById('support-tab-form').classList.add('hidden');
      const confirmMsg = document.getElementById('st-confirm-msg');
      if (confirmMsg) confirmMsg.textContent = priority === 'urgent'
        ? 'Urgent ticket submitted. We\'ll respond as soon as possible — today.'
        : 'Your ticket has been submitted. We\'ll get back to you within 1–2 business days.';
      document.getElementById('st-confirm').classList.remove('hidden');
      await loadPartnerTickets();
      // After submit: collapse form wrap, tickets list is now visible
      setTimeout(() => {
        document.getElementById('support-tab-form-wrap')?.classList.add('hidden');
        const btn = document.getElementById('st-new-btn');
        if (btn) btn.innerHTML = '<i class="fa-solid fa-plus"></i> New ticket';
      }, 2500);
    } catch(e) {
      console.error('submitSupportTicket', e);
      errEl.textContent = 'Failed to submit. Please try again or call us directly.';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit ticket';
    }
  }

  function resetSupportTab() {
    document.getElementById('st-subject').value = '';
    document.getElementById('st-message').value = '';
    document.getElementById('st-category').value = '';
    document.querySelector('input[name="st-priority"][value="normal"]').checked = true;
    document.getElementById('st-error').classList.add('hidden');
    document.getElementById('st-confirm').classList.add('hidden');
    const bookingRef = document.getElementById('st-booking-ref'); if (bookingRef) bookingRef.value = '';
    const filesInput = document.getElementById('st-files'); if (filesInput) filesInput.value = '';
    const filesPreview = document.getElementById('st-files-preview'); if (filesPreview) { filesPreview.innerHTML = ''; filesPreview.classList.add('hidden'); }
    document.getElementById('st-booking-ref-wrap')?.classList.add('hidden');
    document.getElementById('st-files-wrap')?.classList.add('hidden');
    const btn = document.getElementById('st-submit-btn');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit ticket';
    document.getElementById('support-tab-form').classList.remove('hidden');
    document.getElementById('support-tab-form-wrap').classList.remove('hidden');
    const newBtn = document.getElementById('st-new-btn');
    if (newBtn) newBtn.innerHTML = '<i class="fa-solid fa-minus"></i> Cancel';
  }

  // Quick book from commission tab — opens the real tour drawer
  function quickBook(tourName) {
    const idx = (bokunProducts || []).findIndex(p => p.title === tourName);
    if (idx >= 0) {
      setTab(document.querySelector('.tab-btn[onclick*="tab-tours"]'), 'tab-tours');
      setTimeout(() => openTour(idx), 100);
    } else {
      alert('Tour not found in booking system. Please book via the Tours tab.');
    }
  }
</script>
