async function saveStripeExpirySettings() {
  if (currentAdminRole === 'staff') { showToast('Manager or admin role required', 'error'); return; }
  const long = parseFloat(document.getElementById('ses-long').value);
  const short = parseFloat(document.getElementById('ses-short').value);
  const errEl = document.getElementById('ses-error');
  if (!(long > 0) || !(short > 0)) { errEl.textContent = 'Both values must be greater than 0.'; errEl.classList.remove('hidden'); return; }
  if (long > 24) { errEl.textContent = "Full window can't exceed 24h — that's Stripe's own limit."; errEl.classList.remove('hidden'); return; }
  if (short > long) { errEl.textContent = "Short window can't be larger than the full window."; errEl.classList.remove('hidden'); return; }
  errEl.classList.add('hidden');
  const value = JSON.stringify({ longWindowHours: long, shortWindowHours: short });
  await db.from('app_settings').delete().eq('key', 'stripe_expiry_settings');
  const { error } = await db.from('app_settings').insert({ key: 'stripe_expiry_settings', value });
  if (error) { errEl.textContent = 'Error: ' + error.message; errEl.classList.remove('hidden'); return; }
  document.getElementById('stripe-expiry-modal')?.remove();
  showToast('Payment link settings saved.');
  logActivity('stripe_expiry_settings_updated', `Payment link settings updated: full ${long}h, short ${short}h`);
}

function fmtPln(n) {
  return Number(n || 0).toFixed(2).replace('.', ',') + ' PLN';
}

// --- Services ---
function addCpService() {
  cpServices.push({ name: '', net: 0, vat: 23, gross: 0, margin_net: 0, margin_vat: 23, margin_gross: 0 });
  renderCpServiceRows();
  recalcOrder();
}

function removeCpService(idx) {
  cpServices.splice(idx, 1);
  renderCpServiceRows();
  recalcOrder();
}

function updateCpService(idx, field, val) {
  if (!cpServices[idx]) return;
  if (field === 'name') { cpServices[idx].name = val; return; }
  cpServices[idx][field] = parseFloat(val) || 0;
  if (field === 'net' || field === 'vat') {
    cpServices[idx].gross = parseFloat((cpServices[idx].net * (1 + cpServices[idx].vat / 100)).toFixed(2));
    const el = document.getElementById('cp-gross-' + idx);
    if (el) el.textContent = fmtPln(cpServices[idx].gross);
  }
  if (field === 'margin_net' || field === 'margin_vat') {
    cpServices[idx].margin_gross = parseFloat((cpServices[idx].margin_net * (1 + cpServices[idx].margin_vat / 100)).toFixed(2));
    const el = document.getElementById('cp-margin-gross-' + idx);
    if (el) el.textContent = fmtPln(cpServices[idx].margin_gross);
  }
  recalcOrder();
}

function cpApplyPerPerson(i) {
  const ppInput = document.getElementById('cp-pp-' + i);
  const countInput = document.getElementById('cp-pp-count-' + i);
  const perPerson = parseFloat(ppInput?.value) || 0;
  const count = parseInt(countInput?.value) || 0;
  if (!perPerson || !count) return;
  const total = parseFloat((perPerson * count).toFixed(2));
  const netInput = document.getElementById('cp-net-' + i);
  if (netInput) netInput.value = total;
  updateCpService(i, 'net', total);
}

