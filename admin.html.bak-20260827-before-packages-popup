  function mapBokunBooking(item) {
    const pb = item.productBookings?.[0];
    if (!pb) return null;
    const startMs = pb.startDate || pb.startDateTime;
    const dateStr = startMs ? new Date(startMs).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) : '—';
    const channel = item.seller?.title || item.channel?.title || 'Bokun';
    const channelShort = channel.includes('Viator') ? 'Viator'
      : channel.includes('GetYourGuide') ? 'GYG'
      : channel.includes('Klook') ? 'Klook'
      : channel.includes('Expedia') ? 'Expedia'
      : channel.includes('Thousand Miles') ? 'Old TM System'
      : (channel !== 'Bokun' ? channel : 'Bokun');
    const statusMap = { CONFIRMED: 'paid', CANCELLED: 'cancelled', PENDING: 'to_be_paid' };
    const codePrefix = (item.confirmationCode || '').replace(/^#/, '').split('-')[0].toUpperCase();
    const isOtaPln = ['VIA', 'GET', 'GYG', 'KLO', 'EXP'].includes(codePrefix);

    // Bokun does NOT populate resellerInvoice amounts for Musement/Hotelbeds (gross, unreconciled).
    // Musement commission rate is 25% — net = customerInvoice.total × 0.75.
    // Hotelbeds commission rate is 35% — net = customerInvoice.total × 0.65.
    const MUSEMENT_NET_RATE = 0.75;
    const HOTELBEDS_NET_RATE = 0.65;
    const riTotal = pb.resellerInvoice?.total ?? pb.resellerInvoice?.totalAmount
      ?? pb.sellerInvoice?.total ?? pb.sellerInvoice?.totalAmount
      ?? item.sellerInvoice?.total ?? item.resellerInvoice?.total;
    const riCurrency = pb.resellerInvoice?.currency ?? pb.sellerInvoice?.currency
      ?? item.sellerInvoice?.currency ?? item.resellerInvoice?.currency;
    const ciTotal = pb.customerInvoice?.total;
    const ciCurrency = pb.customerInvoice?.currency;
    let total, currency;
    if (isOtaPln) {
      const ciCurrUp = (ciCurrency || '').toUpperCase();
      if (item.totalPriceConverted > 0) {
        total = item.totalPriceConverted;                                      // Bokun already converted to PLN
      } else if (ciCurrUp === 'PLN' && typeof ciTotal === 'number' && ciTotal > 0) {
        total = ciTotal;                                                        // customerInvoice is PLN (GYG)
      } else if (typeof ciTotal === 'number' && ciTotal > 0) {
        total = Math.round(ciTotal * (_eurPlnRate || 4.25) * 100) / 100;       // Viator: EUR→PLN via NBP rate
      } else {
        total = item.totalPrice || pb.totalPrice || 0;
      }
      currency = 'PLN';
    } else if (codePrefix === 'MUS' && typeof ciTotal === 'number' && ciTotal > 0) {
      // MUS check BEFORE riTotal: Bokun sets resellerInvoice.total = customerInvoice.total (gross),
      // so riTotal is unreliable for Musement. Always use ciTotal × 0.75 (25% commission).
      const netEur = (typeof pb.resellerInvoice?.totalSansCommission === 'number' && pb.resellerInvoice.totalSansCommission > 0)
        ? pb.resellerInvoice.totalSansCommission
        : ciTotal * MUSEMENT_NET_RATE;
      total = Math.round(netEur * (_eurPlnRate || 4.25) * 100) / 100;
      currency = 'PLN';
    } else if (codePrefix === 'HOT' && typeof ciTotal === 'number' && ciTotal > 0) {
      // HOT check BEFORE riTotal: Bokun sets resellerInvoice.total = customerInvoice.total (gross),
      // so riTotal is unreliable for Hotelbeds. Always use ciTotal × 0.65 (35% commission).
      const netEur = (typeof pb.resellerInvoice?.totalSansCommission === 'number' && pb.resellerInvoice.totalSansCommission > 0)
        ? pb.resellerInvoice.totalSansCommission
        : ciTotal * HOTELBEDS_NET_RATE;
      total = Math.round(netEur * (_eurPlnRate || 4.25) * 100) / 100;
      currency = 'PLN';
    } else if (typeof riTotal === 'number' && riTotal > 0) {
      total = riTotal;
      currency = riCurrency || 'EUR';
    } else if (typeof ciTotal === 'number' && ciTotal > 0) {
      total = ciTotal;
      currency = ciCurrency || 'EUR';
    } else {
      total = item.totalPriceConverted || item.totalPrice || pb.totalPrice || 0;
      currency = item.currency || 'EUR';
    }
    return {
      id: item.confirmationCode || String(item.id),
      tour: pb.product?.title?.trim() || '—',
      guest: [item.customer?.firstName, item.customer?.lastName].filter(Boolean).join(' ') || '—',
      email: item.customer?.email || '',
      phone: item.customer?.phoneNumber || '',
      hotel: '—',
      date: dateStr,
      time: pb.fields?.startTimeStr || '—',
      language: pb.fields?.startTimeStr ? (pb.fields.startTimeStr.includes(' - ') ? pb.fields.startTimeStr.split(' - ').slice(1).join(' - ') : '') : '',
      pickup: pb.fields?.pickupPlaceDescription || '—',
      pax: pb.totalParticipants || pb.fields?.totalParticipants || 1,
      total: total,
      currency: currency,
      totalCurrency: currency,
      comm: 0,
      source: channelShort,
      status: statusMap[pb.status] || pb.status || 'Pending',
      notes: '',
      _startTs: (() => { if (!startMs) return 0; if (typeof startMs === 'string') return new Date(startMs).getTime() || 0; return startMs > 1e10 ? startMs : startMs * 1000; })(),
      _creationTs: (() => { const cd = item.creationDate; if (!cd) return 0; if (typeof cd === 'string') return new Date(cd).getTime() || 0; return cd > 1e10 ? cd : cd * 1000; })(),
      _bokun: true
    };
  }

  async function loadBookings() {
    _bookingsLoaded = false;
    showBookingsLoading();
    await getEurPlnRate();
    allBookings.length = 0;

    const { data: dbRows } = await db.from('bookings').select('*').order('created_at', { ascending: false }).limit(50000);
    const otaPlnPrefixes = ['VIA', 'GET', 'GYG', 'MUS', 'KLO', 'EXP'];
    (dbRows || []).forEach(b => {
      const partner = allPartners.find(p => p.id === b.partner_id);
      const dateFormatted = b.date ? new Date(b.date + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const source = partner ? 'Partner Panel' : (b.partner_id ? 'Partner Panel' : (b.source || 'TM Panel'));
      const codeP = (b.bokun_confirmation_code || '').replace(/^#/, '').split('-')[0].toUpperCase();
      const idP = String(b.id || '').replace(/^#/, '').split('-')[0].toUpperCase();
      const isMus = codeP === 'MUS' || idP === 'MUS' || (b.source || '') === 'Musement';
      const isHot = codeP === 'HOT' || idP === 'HOT';
      let dbTotal = b.total || 0;
      let dbCurrency;
      if (otaPlnPrefixes.includes(codeP)) {
        dbCurrency = 'PLN';
      } else if (isMus && (b.currency || 'EUR').toUpperCase() === 'EUR' && dbTotal > 0) {
        dbTotal = Math.round(dbTotal * 0.75 * (_eurPlnRate || 4.25) * 100) / 100;
        dbCurrency = 'PLN';
      } else if (isHot && (b.currency || 'EUR').toUpperCase() === 'EUR' && dbTotal > 0) {
        dbTotal = Math.round(dbTotal * 0.65 * (_eurPlnRate || 4.25) * 100) / 100;
        dbCurrency = 'PLN';
      } else {
        dbCurrency = b.currency || 'EUR';
      }
      allBookings.push({
        id: b.id, displayId: b.bokun_confirmation_code || b.id, tour: b.tour, guest: b.guest, email: b.email, phone: b.phone,
        hotel: partner?.name || '—', date: dateFormatted, time: b.time, pickup: b.pickup,
        language: b.language || '',
        pax: b.pax, total: dbTotal, currency: dbCurrency, comm: b.comm, source, status: b.status, notes: b.notes || '',
        additional_guests: b.additional_guests || '', payment_method: b.payment_method || '',
        package_lines: b.package_lines || null,
        _dbBooking: true, _stripeSessionId: b.stripe_session_id, _bokunCode: b.bokun_confirmation_code,
        _bokunBookingId: b.bokun_booking_id || null, _paymentType: b.payment_type || null,
        _creationTs: b.created_at ? new Date(b.created_at).getTime() : 0,
        _startTs: b.date ? new Date(b.date).getTime() : 0,
      });
    });

    try {
      const today = new Date();
      const past = new Date(today); past.setFullYear(past.getFullYear() - 1);
      const future = new Date(today); future.setDate(future.getDate() + 360);
      const fmt = d => d.toISOString().slice(0, 10);

      // Map confirmation code → index in allBookings for DB bookings (to fix creation date)
      // Index both '#TMK-xxx' and 'TMK-xxx' since webhook stores with # but search API returns without
      const bokunCodeIndex = new Map();
      allBookings.forEach((b, i) => {
        if (b._bokunCode) {
          bokunCodeIndex.set(b._bokunCode, i);
          bokunCodeIndex.set(b._bokunCode.replace(/^#/, ''), i);
        }
      });

      const seenIds = new Set([
        ...allBookings.map(b => b.id),
        ...allBookings.filter(b => b._bokunCode).map(b => b._bokunCode),
        ...allBookings.filter(b => b._bokunCode).map(b => b._bokunCode.replace(/^#/, '')),
      ]);
      let page = 0;
      while (page < 19) {
        const { data: bokunResp, error: bokunErr } = await invokeEdge('bokun-sync', {
          body: {
            path: '/booking.json/booking-search',
            method: 'POST',
            payload: { startDate: fmt(past), endDate: fmt(future), pageSize: 500, page }
          }
        });
        if (bokunErr) {
          const status = bokunErr.context?.status ?? bokunErr.status ?? '?';
          let body = '';
          try { body = await bokunErr.context?.json?.() ?? ''; } catch {}
          console.warn('[Bokun] invoke error status:', status, 'body:', body, 'err:', bokunErr);
          break;
        }
        if (!bokunResp?.body?.items) { console.warn('[Bokun] no items in response. status:', bokunResp?.status, 'body:', JSON.stringify(bokunResp?.body).slice(0, 400)); break; }
        const items = bokunResp.body.items;
        let added = 0;
        items.forEach(item => {
          const mapped = mapBokunBooking(item);
          if (!mapped) return;

          if (bokunCodeIndex.has(mapped.id)) {
            const idx = bokunCodeIndex.get(mapped.id);
            if (mapped._creationTs > 1577836800000) allBookings[idx]._creationTs = mapped._creationTs; // only update if sane (>=2020)
            // Fix source: if DB has generic default ('TM Panel') but Bokun knows the real OTA channel, update it
            const dbSrc = allBookings[idx].source;
            if (mapped.source && (dbSrc === 'TM Panel' || dbSrc === 'bokun_ota') && !DIRECT_SOURCES.has(mapped.source)) {
              allBookings[idx].source = mapped.source;
            }
            // Partner Panel bookings use their own PLN amount from DB; all OTA sources use API
            if (allBookings[idx].source !== 'Partner Panel') {
              const pfx = (allBookings[idx]._bokunCode || mapped.id || '').replace(/^#/, '').split('-')[0].toUpperCase();
              const forcePln = otaPlnPrefixes.includes(pfx);
              if (mapped.total > 0) {
                const mappedIsEur = (mapped.currency || '').toUpperCase() !== 'PLN';
                allBookings[idx].total = (forcePln && mappedIsEur)
                  ? Math.round(mapped.total * (_eurPlnRate || 4.25) * 100) / 100
                  : mapped.total;
              }
              allBookings[idx].currency = forcePln ? 'PLN' : (mapped.totalCurrency || 'EUR');
            }
            return;
          }
          if (!seenIds.has(mapped.id)) {
            seenIds.add(mapped.id);
            const newPfx = (mapped.id || '').replace(/^#/, '').split('-')[0].toUpperCase();
            if (otaPlnPrefixes.includes(newPfx) && (mapped.currency || '').toUpperCase() !== 'PLN') {
              mapped.total = Math.round((mapped.total || 0) * (_eurPlnRate || 4.25) * 100) / 100;
              mapped.currency = 'PLN';
            }
            allBookings.push(mapped);
            added++;
          }
        });
        if (items.length < 500) break;
        page++;
      }
    } catch(e) { console.warn('Bokun load error:', e); }

    const SOURCE_LABELS = { 'GYG': 'GetYourGuide', 'TM Panel': 'TM Panel', 'Partner Panel': 'Partner Panel' };
    const abTours = [...new Set(allBookings.map(b => b.tour).filter(Boolean))].sort();
    mselSetOptions('msel-ab-tour', abTours.map(t => ({value: t, label: t})));
    const abSources = [...new Set(allBookings.map(b => b.source).filter(Boolean))].sort();
    mselSetOptions('msel-ab-source', abSources.map(s => ({value: s, label: SOURCE_LABELS[s] || s})));


    _bookingsLoaded = true;
    hideBookingsLoading();
    setBookingView('recent');

    const kpiBk = document.getElementById('kpi-bookings');
    if (kpiBk) kpiBk.textContent = allBookings.filter(b => (b.status||'').toLowerCase() !== 'cancelled').length;
  }

