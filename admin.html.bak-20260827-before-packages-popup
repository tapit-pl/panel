  async function setDashFilter(f) {
    dashFilter = f;
    document.querySelectorAll('.dash-tab').forEach(b => {
      b.style.background = 'rgba(255,255,255,0.06)';
      b.style.color = '#94a3b8';
    });
    const active = document.getElementById('dtab-' + f);
    if (active) { active.style.background = '#f97316'; active.style.color = '#fff'; }

    const isSeller = f === 'seller';
    const isHotel  = f === 'hotel';
    const partnerSec   = document.getElementById('dash-partner-section');
    const staffSec     = document.getElementById('dash-staff-section');
    const chSec        = document.getElementById('dash-channel-section');
    const depSec       = document.getElementById('dash-departures-section');
    const toursCard    = document.getElementById('dash-right-card-tours');
    const sellerCard   = document.getElementById('dash-right-card-seller');

    if (partnerSec)  partnerSec.style.display  = isHotel ? '' : 'none';
    if (staffSec)    staffSec.style.display    = isSeller ? 'grid' : 'none';
    if (chSec)       chSec.style.display       = isSeller ? 'none' : '';
    if (depSec)      depSec.style.display      = isSeller ? 'none' : '';
    if (toursCard)   toursCard.style.display   = isSeller ? 'none' : 'block';
    if (sellerCard)  sellerCard.style.display  = isSeller ? 'block' : 'none';
    const liveFeedEl = document.getElementById('dash-live-feed');
    if (liveFeedEl) liveFeedEl.style.display = isSeller ? 'none' : '';

    // Load cpData BEFORE rendering KPIs so the seller summary has data
    if (isSeller && !customToursLoaded) await loadCustomTours();

    updateDashboardKPIs();
    if (isSeller) loadStaffPerformance();
  }

  let _lastDashRender = 0;
  function updateDashboardKPIs() {
    _lastDashRender = Date.now();
    const { start: monthStart, end: monthEnd, y, m } = getSelectedMonthRange();
    const now = new Date();
    const pad2 = n => String(n).padStart(2, '0');
    const todayStr    = `${now.getFullYear()}-${pad2(now.getMonth()+1)}-${pad2(now.getDate())}`;
    const tomorrow    = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    const tomorrowStr = `${tomorrow.getFullYear()}-${pad2(tomorrow.getMonth()+1)}-${pad2(tomorrow.getDate())}`;
    const todayStart    = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    const todayEnd      = todayStart + 86400000;
    const tomorrowStart = todayEnd;
    const tomorrowEnd   = tomorrowStart + 86400000;

    const active = b => (b.status||'').toLowerCase() !== 'cancelled';

    // Normalize a custom_packages row into a structure compatible with allBookings
    const cpAsBooking = p => ({
      _creationTs: p._creationTs || 0,
      _startTs: p.date ? new Date(p.date + 'T00:00:00').getTime() : 0,
      pax: p.pax || 0,
      status: p.status,
      tour: p.package_name || '—',
      source: 'Seller Panel',
      _plnAmount: p.guest_price || 0,
      _isCp: true,
    });

    let todayB, monthB, monthRev;
    if (dashFilter === 'seller') {
      todayB  = cpData.filter(p => (p._creationTs||0) >= todayStart && (p._creationTs||0) < todayEnd && p.status !== 'cancelled');
      monthB  = cpData.filter(p => (p._creationTs||0) >= monthStart && (p._creationTs||0) < monthEnd && p.status !== 'cancelled');
      monthRev = monthB.reduce((s,p) => s + (p.guest_price||0), 0);
    } else {
      const fb = getFilteredBookings();
      const cpExtra = dashFilter === 'all' ? cpData.filter(p => p.status !== 'cancelled').map(cpAsBooking) : [];
      const combined = [...fb, ...cpExtra];
      todayB   = combined.filter(b => active(b) && (b._creationTs||0) >= todayStart && (b._creationTs||0) < todayEnd);
      monthB   = combined.filter(b => active(b) && (b._creationTs||0) >= monthStart && (b._creationTs||0) < monthEnd);
      monthRev = monthB.reduce((s,b) => s + (b._plnAmount != null ? b._plnAmount : toPlnAmount(b)), 0);
    }
    const el = id => document.getElementById(id);

    // Today KPIs
    const todayRev = dashFilter === 'seller'
      ? todayB.reduce((s,p) => s + (p.guest_price||0), 0)
      : todayB.reduce((s,b) => s + (b._plnAmount != null ? b._plnAmount : toPlnAmount(b)), 0);
    const todayPax = todayB.reduce((s,b) => s + (Number(b.pax)||0), 0);
    // tours today = unique tours with START date = today (not creation date)
    const depSrcToday = dashFilter === 'seller' ? [] : (() => {
      const fb = getFilteredBookings();
      const cpExtra = dashFilter === 'all' ? cpData.filter(p => p.status !== 'cancelled').map(cpAsBooking) : [];
      return [...fb, ...cpExtra];
    })();
    const toursToday = new Set(depSrcToday.filter(b => active(b) && b._startTs > 0 && b._startTs >= todayStart && b._startTs < todayEnd).map(b => b.tour)).size;

    if (el('kpi-today-bookings')) el('kpi-today-bookings').textContent = todayB.length;
    if (el('kpi-today-revenue'))  el('kpi-today-revenue').innerHTML = Math.round(todayRev).toLocaleString('pl') + ' <span class="text-base font-normal text-slate-400">zł</span>';
    if (el('kpi-today-pax'))      el('kpi-today-pax').textContent = todayPax;
    if (el('kpi-tours-today'))    el('kpi-tours-today').textContent = toursToday;

    // Update tab buttons with today's booking counts so All = OTA + Hotel + Seller + Direct is transparent
    {
      const todayAllB = allBookings.filter(b => active(b) && b._creationTs >= todayStart && b._creationTs < todayEnd);
      const cntOta    = todayAllB.filter(b => !DIRECT_SOURCES.has(b.source)).length;
      const cntHotel  = todayAllB.filter(b => b.source === 'Partner Panel').length;
      const cntSeller = customToursLoaded ? cpData.filter(p => (p._creationTs||0) >= todayStart && (p._creationTs||0) < todayEnd && p.status !== 'cancelled').length : null;
      const cntOldTm  = todayAllB.filter(b => b.source === 'Old TM System' || b.source === 'Website').length;
      const tabAll    = document.getElementById('dtab-all');
      const tabHotel  = document.getElementById('dtab-hotel');
      const tabOta    = document.getElementById('dtab-ota');
      const tabDirect = document.getElementById('dtab-direct');
      const tabSeller = document.getElementById('dtab-seller');
      if (tabAll)    tabAll.textContent    = 'All';
      if (tabHotel)  tabHotel.textContent  = 'Hotel Partners';
      if (tabOta)    tabOta.textContent    = 'OTA';
      if (tabDirect) tabDirect.textContent = 'Old TM / Website';
      if (tabSeller) tabSeller.textContent = 'Seller Panel';
    }

    const tourCounts = {};
    if (dashFilter === 'seller') {
      monthB.forEach(p => { const k = p.package_name || '—'; tourCounts[k] = (tourCounts[k]||0) + 1; });
    } else {
      monthB.forEach(b => { tourCounts[b.tour] = (tourCounts[b.tour]||0) + 1; });
    }
    const topTours = Object.entries(tourCounts).sort((a,b)=>b[1]-a[1]).slice(0,5);
    const maxTour = topTours[0]?.[1] || 1;
    const toursEl = el('dash-top-tours');
    if (toursEl) toursEl.innerHTML = topTours.length ? topTours.map(([name,count]) => `
      <div>
        <div class="flex items-center justify-between text-xs mb-1.5">
          <span class="font-medium text-white">${escapeHtml(name)}</span>
          <span class="text-slate-400 shrink-0 ml-2">${count} booking${count!==1?'s':''}</span>
        </div>
        <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.1)">
          <div class="h-full bg-brand rounded-full" style="width:${Math.round(count/maxTour*100)}%"></div>
        </div>
      </div>`).join('') : '<div class="text-xs text-slate-500">No bookings this month yet</div>';

    // Seller Panel — monthly pipeline summary (replaces Top Tours for dashFilter==='seller')
    const summaryEl = el('dash-seller-summary');
    if (summaryEl && dashFilter === 'seller') {
      const confirmed = monthB.filter(p => p.status === 'paid' || p.status === 'confirmed' || p.status === 'arrived');
      const pending   = monthB.filter(p => p.status !== 'paid' && p.status !== 'confirmed' && p.status !== 'arrived' && p.status !== 'cancelled');
      const confRev   = confirmed.reduce((s,p) => s + (p.guest_price||0), 0);
      const pendRev   = pending.reduce((s,p) => s + (p.guest_price||0), 0);
      const avgVal    = confirmed.length ? confRev / confirmed.length : 0;
      const row = (label, count, value, color) =>
        `<div class="flex items-center justify-between rounded-lg px-3 py-2.5" style="background:rgba(255,255,255,0.05)">
          <div>
            <div class="text-xs font-semibold text-white">${label}</div>
            <div class="text-xs text-slate-500 mt-0.5">${count} pkg</div>
          </div>
          <span class="text-sm font-bold" style="color:${color}">${Math.round(value).toLocaleString('pl')} zł</span>
        </div>`;
      summaryEl.innerHTML = monthB.length
        ? row('Confirmed', confirmed.length, confRev, '#4ade80')
          + row('Pending', pending.length, pendRev, '#facc15')
          + (() => {
              const totalMargin = confirmed.reduce((s, p) => s + (p.services || []).reduce((sm, svc) => sm + (svc.margin_gross || svc.margin || 0), 0), 0);
              const totalComm   = confirmed.reduce((s, p) => s + (p.commission_amount || 0), 0);
              const tmNet       = totalMargin - totalComm;
              const pipeline    = confRev + pendRev;
              return `<div style="border-top:1px solid rgba(255,255,255,0.07);margin-top:8px;padding-top:8px" class="space-y-2">
                <div class="rounded-lg px-3 py-2.5" style="background:rgba(255,255,255,0.05)">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="text-xs font-semibold text-white">TM margin</div>
                      <div class="text-xs text-slate-500 mt-0.5">seller commission</div>
                    </div>
                    <div class="text-right">
                      <div class="text-sm font-bold" style="color:#4ade80">${Math.round(tmNet).toLocaleString('pl')} zł</div>
                      <div class="text-xs text-slate-400">−${Math.round(totalComm).toLocaleString('pl')} zł</div>
                    </div>
                  </div>
                </div>
                <div class="flex items-center justify-between rounded-lg px-3 py-2.5" style="background:rgba(255,255,255,0.05)">
                  <div>
                    <div class="text-xs font-semibold text-white">Total pipeline</div>
                    <div class="text-xs text-slate-500 mt-0.5">${confirmed.length + pending.length} pkg</div>
                  </div>
                  <span class="text-sm font-bold text-white">${Math.round(pipeline).toLocaleString('pl')} zł</span>
                </div>
              </div>`;
            })()
        : '<div class="text-xs text-slate-500">No packages this month yet</div>';
    }

    const channelCounts = {};
    monthB.forEach(b => { const ch = b.source || '—'; channelCounts[ch] = (channelCounts[ch]||0)+1; });
    const totalCh = monthB.length || 1;
    const chEl = el('dash-channels');
    if (chEl) chEl.innerHTML = Object.entries(channelCounts).sort((a,b)=>b[1]-a[1]).filter(([,cnt]) => Math.round(cnt/totalCh*100) > 0).map(([ch,cnt]) => `
      <div class="flex items-center justify-between text-xs text-slate-300">
        <span>${escapeHtml(ch)}</span>
        <span class="font-semibold text-white">${Math.round(cnt/totalCh*100)}%</span>
      </div>`).join('') || '<div class="text-xs text-slate-500">No data</div>';

    // Today's departures
    const depStatusStyle = s => { const l=(s||'').toLowerCase(); return l==='confirmed'?'background:rgba(21,128,61,0.3);color:#4ade80':l==='paid'?'background:rgba(29,78,216,0.3);color:#60a5fa':l==='cancelled'?'background:rgba(153,27,27,0.3);color:#f87171':l==='arrived'?'background:rgba(109,40,217,0.3);color:#c084fc':l==='to_be_paid'?'background:rgba(161,98,7,0.3);color:#facc15':'background:rgba(51,65,85,0.5);color:#94a3b8'; };
    const depRow = b => {
      const guestLine = b.guest || '—';
      const phoneHtml = b.phone ? `<span style="color:#60a5fa">${escapeHtml(b.phone)}</span>` : `<span style="color:#475569">no phone</span>`;
      const pickupHtml = b.pickup ? `<div class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-location-dot text-slate-600 mr-1" style="font-size:9px"></i>${escapeHtml(b.pickup)}</div>` : '';
      const voucherBtn = b._dbBooking ? `<button onclick="openVoucher('${b.id}')" title="Voucher" style="background:none;border:none;cursor:pointer;color:#64748b;padding:0 2px" onmouseover="this.style.color='#f97316'" onmouseout="this.style.color='#64748b'"><i class="fa-solid fa-file-pdf text-xs"></i></button>` : '';
      const paidBtn = b._dbBooking && ['to_be_paid','pending','payment_pending','pending_payment'].includes((b.status||'').toLowerCase()) ? `<button onclick="quickMarkPaid('${b.id}')" title="Mark as paid" style="background:none;border:none;cursor:pointer;padding:0 2px"><i class="fa-solid fa-circle-check text-xs" style="color:#22c55e"></i></button>` : '';
      const noShowBtn = b._dbBooking && canMarkNoShow(b) ? `<button onclick="markNoShow('${b.id}')" title="No show" style="background:none;border:none;cursor:pointer;padding:0 2px"><i class="fa-solid fa-user-slash text-xs" style="color:#ef4444"></i></button>` : '';
      return `<div class="rounded-xl mb-1.5" style="padding:8px 10px;background:rgba(255,255,255,0.04)">
        <div class="flex items-center gap-1.5 mb-1">
          <span class="text-xs font-bold flex-shrink-0" style="color:#f97316">${b.time || '—'}</span>
          <span class="text-xs font-semibold text-white flex-1 truncate" title="${escapeHtml(b.tour)}">${escapeHtml(b.tour)}</span>
        </div>
        <div class="text-xs text-slate-300 mb-0.5">${escapeHtml(guestLine)}</div>
        <div class="text-xs mb-0.5">${phoneHtml}</div>
        <div class="text-xs text-slate-500 mb-0.5"><span class="text-slate-600">By:</span> ${escapeHtml(b.hotel || '—')}</div>
        ${pickupHtml}
        <div class="flex items-center gap-1 mt-1.5">${statusBadge(b.status)}${voucherBtn}${paidBtn}${noShowBtn}</div>
      </div>`;
    };
    // 7-day departures
    if (dashFilter !== 'seller') render7DayDepartures(depRow, getFilteredBookings(), active);

    // Live feed
    renderLiveFeed();


    // Partner leaderboard — top 5 this month (partner panel bookings only)
    const partnerCounts = {};
    monthB.filter(b => b._dbBooking).forEach(b => {
      const key = b.hotel || '—';
      partnerCounts[key] = (partnerCounts[key]||0) + 1;
    });
    const topPartners = Object.entries(partnerCounts).filter(([k])=>k!=='—').sort((a,b)=>b[1]-a[1]).slice(0,5);
    const maxP = topPartners[0]?.[1] || 1;
    const lbEl = el('dash-leaderboard');
    if (lbEl) lbEl.innerHTML = topPartners.length ? topPartners.map(([name, count], i) => `
      <div class="flex items-center gap-3">
        <div class="w-5 text-center text-xs font-bold ${i===0?'text-yellow-400':i===1?'text-slate-300':i===2?'text-amber-600':'text-slate-500'}">${i+1}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between text-xs mb-1">
            <span class="font-medium text-white truncate">${escapeHtml(name)}</span>
            <span class="text-slate-400 shrink-0 ml-2">${count}</span>
          </div>
          <div class="h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.1)">
            <div class="h-full rounded-full" style="width:${Math.round(count/maxP*100)}%;background:var(--brand,#E8751A)"></div>
          </div>
        </div>
      </div>`).join('')
      : '<div class="text-xs text-slate-500">No partner bookings this month</div>';

    // Silent partners — active partners with no booking in 30+ days
    const thirtyDaysAgo = Date.now() - 30 * 86400000;
    const silentList = allPartners.filter(p => p.active).map(p => {
      const lastB = allBookings.filter(b => b._dbBooking && b.hotel === p.name).sort((a,x) => x._creationTs - a._creationTs)[0];
      const lastTs = lastB?._creationTs || 0;
      return { name: p.name, lastTs };
    }).filter(p => p.lastTs < thirtyDaysAgo).sort((a,b) => a.lastTs - b.lastTs);
    const silentEl = el('dash-silent-partners');
    if (silentEl) {
      if (!silentList.length) {
        silentEl.innerHTML = '<div class="text-xs text-slate-500">All partners active recently</div>';
      } else {
        const renderSilent = (limit) => {
          const visible = limit ? silentList.slice(0, limit) : silentList;
          silentEl.innerHTML = visible.map(p => {
            const days = p.lastTs ? Math.floor((Date.now() - p.lastTs) / 86400000) : null;
            const label = days ? `${days}d ago` : 'Never';
            return `<div class="flex items-center justify-between text-xs py-1.5 border-b border-white/5 last:border-0">
              <span class="text-white font-medium">${escapeHtml(p.name)}</span>
              <span class="text-slate-500">${label}</span>
            </div>`;
          }).join('');
          if (limit && silentList.length > limit) {
            const btn = document.createElement('button');
            btn.className = 'mt-2 text-xs text-slate-400 hover:text-brand transition-colors w-full text-left';
            btn.textContent = `See more (${silentList.length - limit} more)`;
            btn.onclick = () => renderSilent(null);
            silentEl.appendChild(btn);
          }
        };
        renderSilent(5);
      }
    }

    const fromEl = el('chart-date-from');
    const toEl   = el('chart-date-to');
    if (fromEl) fromEl.value = `${y}-${pad2(m)}-01`;
    if (toEl)   toEl.value   = `${y}-${pad2(m)}-${String(new Date(y, m, 0).getDate()).padStart(2,'0')}`;
    renderDashboardChart({ b: monthB.length, r: monthRev });
  }

  function render7DayDepartures(depRow, fb, active) {
    const container = document.getElementById('dash-7day-departures');
    if (!container) return;
    const now = new Date();
    const DAY = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    let html = '';
    for (let i = 0; i < 7; i++) {
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
      const ds = d.getTime(), de = ds + 86400000;
      const deps = fb.filter(b => active(b) && b._startTs > 0 && b._startTs >= ds && b._startTs < de)
                     .sort((a,b) => (a.time||'').localeCompare(b.time||''));
      const label = i===0 ? 'Today' : i===1 ? 'Tomorrow' : DAY[d.getDay()];
      const dateStr = `${d.getDate()} ${MON[d.getMonth()]}`;
      const labelColor = i===0 ? '#f97316' : i===1 ? '#60a5fa' : '#94a3b8';
      const uid = 'dep7-' + i;
      if (i > 0) html += `<div style="border-top:1px solid rgba(255,255,255,0.05);margin:8px 0"></div>`;
      html += `<div>
        <div class="flex items-center gap-2 mb-1.5" style="cursor:pointer" onclick="document.getElementById('${uid}').classList.toggle('hidden')">
          <span class="text-xs font-bold" style="color:${labelColor}">${label} · ${dateStr}</span>
          <span class="text-xs text-slate-500">${deps.length} departure${deps.length!==1?'s':''}</span>
          ${deps.length ? '<span class="text-xs text-slate-300" style="margin-left:auto">▼</span>' : ''}
        </div>
        <div id="${uid}" class="hidden space-y-1.5">
          ${deps.length ? deps.map(b => depRow(b)).join('') : '<div class="text-xs italic" style="padding:3px 0;color:#475569">No departures scheduled</div>'}
        </div>
      </div>`;
    }
    container.innerHTML = html;
  }

  function renderLiveFeed() {
    const listEl = document.getElementById('dash-live-list');
    if (!listEl) return;
    const src = dashFilter === 'seller' ? [] : getFilteredBookings();
    const recent = [...src].sort((a,b) => b._creationTs - a._creationTs).slice(0, 10);
    if (!recent.length) { listEl.innerHTML = '<div class="text-xs text-slate-500">No bookings yet</div>'; return; }
    const now = Date.now();
    const ago = ts => { const m=Math.floor((now-ts)/60000); return m<60?m+'m ago':m<1440?Math.floor(m/60)+'h ago':Math.floor(m/1440)+'d ago'; };
    const srcColors = { Viator:'#f472b6', GYG:'#facc15', Klook:'#f87171', Musement:'#c084fc', Expedia:'#60a5fa', 'Partner Panel':'#38bdf8', 'TM Panel':'#94a3b8', 'Old TM System':'#64748b' };
    listEl.innerHTML = recent.map(b => {
      const c = srcColors[b.source] || '#94a3b8';
      return `<div class="flex items-center gap-2 rounded-lg mb-1" style="padding:5px 8px;background:rgba(255,255,255,0.04)">
        <span class="text-xs text-slate-500 flex-shrink-0" style="width:52px">${ago(b._creationTs)}</span>
        <span class="text-xs font-semibold flex-shrink-0" style="color:${c};width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(b.source||'—')}</span>
        <span class="text-xs text-slate-200 flex-1 truncate">${escapeHtml(b.guest||'—')}</span>
        <span class="text-xs text-slate-500 truncate" style="max-width:220px">${escapeHtml(b.tour||'—')}</span>
        <span class="text-xs font-bold flex-shrink-0" style="color:#f97316;min-width:64px;text-align:right">${Math.round(toPlnAmount(b)).toLocaleString('pl')} zł</span>
      </div>`;
    }).join('');
  }

  function globalSearch(q) {
    if (!q.trim()) return;
    showSection('bookings');
    const searchEl = document.getElementById('booking-search');
    if (searchEl) { searchEl.value = q; filterAllBookings(); }
  }

