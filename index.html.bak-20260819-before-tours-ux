    document.getElementById('tp-subject').textContent = ticket.subject;
    const badge = document.getElementById('tp-status-badge');
    badge.textContent = statusLabel[ticket.status] || ticket.status;
    badge.style.cssText = statusColor[ticket.status] || statusColor.open;
