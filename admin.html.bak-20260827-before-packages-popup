function abSelectDate(dateStr) {
  abSelectedDate = dateStr;
  abSelectedSlot = null; abSelectedRate = null; abRateSelections = []; abCategorySelections = [];
  abRenderCalendar();
  const slots = (abAvailability[dateStr] || []).filter((s,i,a) => a.findIndex(x => x.startTimeId === s.startTimeId) === i);
  // Reset sections below
  ['ab-modal-rates-section','ab-modal-form-section','ab-step-success'].forEach(id => {
    document.getElementById(id)?.classList.add('hidden');
  });
  if (slots.length === 0) return;
  abCurrentTour._abSlots = slots;
  // Auto-select only when the single slot has no real departure time (matches partner panel)
  if (slots.length === 1 && (!slots[0].startTime || slots[0].startTimeId === 'manual')) { abSelectSlot(0); return; }
  const list = document.getElementById('ab-slot-list');
  list.innerHTML = slots.flatMap((s, i) => {
    const t = s.startTime || '';
    const timeStr = t ? (t.length > 8 ? t.slice(11,16) : t.slice(0,5)) : 'Flexible time';
    const cnt = s.availabilityCount;
    const seatLabel = cnt === 0 ? `<span class="text-xs font-normal text-red-500">Full</span>`
      : cnt !== null && cnt <= 4 ? `<span class="text-xs font-normal text-orange-500">Only ${cnt} left</span>`
      : cnt !== null ? `<span class="text-xs font-normal text-gray-400">${cnt} seats</span>`
      : '';
    const isFull = cnt === 0;
    const disabledAttr = isFull ? 'disabled' : '';
    const cls = isFull
      ? 'border-gray-100 opacity-40 cursor-not-allowed'
      : 'border-gray-200 hover:border-brand hover:bg-brand/5 cursor-pointer';
    const baseCls = `px-4 py-2.5 rounded-xl border-2 ${cls} text-sm font-semibold text-dark transition-all flex flex-col items-center gap-0.5`;

    const slotUniqueRates = (s.rates || []).filter((r,idx,a) => a.findIndex(x=>x.id===r.id)===idx);
    const langRates = slotUniqueRates.filter(r => LANGUAGE_KEYWORDS.some(l => r.title.includes(l)));
    const nonLangRates = slotUniqueRates.filter(r => !LANGUAGE_KEYWORDS.some(l => r.title.includes(l)));

    if (langRates.length > 1) {
      // Expand: one button per language rate + one per non-language rate (matches partner panel)
      return [
        ...langRates.map(r => {
          const lang = LANGUAGE_KEYWORDS.find(l => r.title.toLowerCase().includes(l.toLowerCase())) || r.title;
          return `<button onclick="abSelectSlotWithRate(${i}, ${r.id})" data-slot-key="${i}-${r.id}" ${disabledAttr} class="${baseCls}">
            <span>${timeStr}</span>
            <span class="text-xs font-normal text-gray-400">${escapeHtml(lang)}</span>
            ${seatLabel}
          </button>`;
        }),
        ...nonLangRates.map(r => `<button onclick="abSelectSlotWithRate(${i}, ${r.id})" data-slot-key="${i}-${r.id}" ${disabledAttr} class="${baseCls}">
            <span>${timeStr}</span>
            <span class="text-xs font-normal text-gray-400">${escapeHtml(r.title)}</span>
            ${seatLabel}
          </button>`)
      ];
    }

    const slotLang = langRates.length === 1
      ? (LANGUAGE_KEYWORDS.find(l => langRates[0].title.toLowerCase().includes(l.toLowerCase())) || null)
      : null;
    const slotPackageLabel = !slotLang && nonLangRates.length === 1 ? nonLangRates[0].title : null;
    const slotBtnOnclick = slotPackageLabel ? `abSelectSlotWithRate(${i}, ${nonLangRates[0].id})` : `abSelectSlot(${i})`;
    const slotBtnDataKey = slotPackageLabel ? `${i}-${nonLangRates[0].id}` : `${i}-`;
    return [`<button onclick="${slotBtnOnclick}" data-slot-key="${slotBtnDataKey}" ${disabledAttr} class="${baseCls}">
      <span>${timeStr}</span>
      ${(slotLang || slotPackageLabel) ? `<span class="text-xs font-normal text-gray-400">${escapeHtml(slotLang || slotPackageLabel)}</span>` : ''}
      ${seatLabel}
    </button>`];
  }).join('');
  document.getElementById('ab-modal-timeslot-date').textContent = abSelectedDate;
  const timeslotSection = document.getElementById('ab-modal-timeslot-section');
  timeslotSection.classList.remove('hidden');
  timeslotSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function abSelectSlot(slotIdx) {
  abSelectedSlot = abCurrentTour._abSlots[slotIdx];
  document.querySelectorAll('#ab-slot-list button').forEach(btn => {
    const isSelected = btn.dataset.slotKey === `${slotIdx}-`;
    btn.classList.toggle('border-brand', isSelected);
    btn.classList.toggle('bg-brand/5', isSelected);
  });
  abDecideAfterSlot();
}

function abSelectSlotWithRate(slotIdx, rateId) {
  abSelectedSlot = abCurrentTour._abSlots[slotIdx];
  abSelectedRate = (abSelectedSlot?.rates || []).find(r => r.id === rateId) || null;
  abRateSelections = []; abCategorySelections = [];
  document.querySelectorAll('#ab-slot-list button').forEach(btn => {
    const isSelected = btn.dataset.slotKey === `${slotIdx}-${rateId}`;
    btn.classList.toggle('border-brand', isSelected);
    btn.classList.toggle('bg-brand/5', isSelected);
  });
  document.getElementById('ab-modal-rates-section')?.classList.add('hidden');
  document.getElementById('ab-modal-form-section')?.classList.add('hidden');
  const slotCatPrices = abSelectedRate?.pricesByCategory || [];
  const categoriesToShow = _abResolveCategoriesToShow(slotCatPrices);
  if (categoriesToShow.length > 0) { abShowCategoryPicker(abSelectedRate, categoriesToShow, slotCatPrices); return; }
  abShowForm();
}


function _abResolveCategoriesToShow(slotCatPrices) {
  const tourName = abCurrentTour?.title || '';
  const commEntry = (abCurrentTour?.configId
    ? allCommissions.find(c => c.active && c.tour_config_id === abCurrentTour.configId)
    : null) || abLookupCommEntry(tourName, abCurrentTour?.configId);

  if (!abCurrentTour?.bokunId) {
    // Non-Bokun tour: build categories from commission config columns
    if (!commEntry) return [];
    return [
      commEntry.price_pln    != null ? {id:'adult',   title:'Adult'}   : null,
      commEntry.price_student != null ? {id:'student', title:'Student'} : null,
      commEntry.price_child  != null ? {id:'child',   title:'Child'}   : null,
      commEntry.price_infant != null ? {id:'infant',  title:'Infant'}  : null,
      commEntry.price_senior != null ? {id:'senior',  title:'Senior'}  : null,
    ].filter(Boolean);
  }

  // Bokun tour: use pricing categories, filtered to those with PLN config
  const allBokunCats = (abCurrentTour?.pricing || []).filter(c => !c.internalUseOnly);
  if (allBokunCats.length === 0 && slotCatPrices.length > 0) {
    return slotCatPrices.map(c => ({id: c.pricingCategoryId || c.id, title: c.pricingCategoryTitle || 'Guest'}));
  }
  if (!commEntry) return allBokunCats;
  return allBokunCats.filter(c => abCategoryPln(commEntry, c.title) != null);
}

function abDecideAfterSlot() {
  const rates = abSelectedSlot?.rates || [];
  let uniqueRates = rates
    .filter((r,i,a) => a.findIndex(x => x.id === r.id) === i)
    .filter(r => !r.title.toLowerCase().includes('meeting point'));

  // Non-Bokun multi-package picker (like partner panel)
  if (!abCurrentTour.bokunId) {
    const pkgs = allCommissions.filter(c => c.active && c.tour_config_id === abCurrentTour.configId);
    if (pkgs.length >= 2) { abShowNonBokunPackagePicker(pkgs); return; }
  } else {
    // Bokun tour: only offer rates that have a matching configured package in Tours & Pricing —
    // same rule the partner panel already applies (COMM_PACKAGES_BY_TOUR filter in index.html),
    // so Create Booking stops showing every Bokun rate variant that was never priced/commissioned here.
    const tourPkgs = allCommissions.filter(c => c.active && c.tour_config_id === abCurrentTour.configId);
    if (tourPkgs.length > 0) {
      const filtered = uniqueRates.filter(r => {
        const key = _abNorm(r.title);
        const words = key.split(' ').filter(w => w.length > 2);
        return tourPkgs.some(p => {
          const pk = _abNorm(p.title);
          if (pk === key) return true;
          return words.length > 0 && words.every(w => pk.includes(w));
        });
      });
      // No configured package matched any live Bokun rate title (naming mismatch) — fall back to
      // showing everything rather than presenting a dead end with zero selectable options.
      if (filtered.length > 0) uniqueRates = filtered;
    }
  }

  if (uniqueRates.length > 1) {
    if (_abAreLanguageRates(uniqueRates)) { abShowLanguagePicker(uniqueRates); return; }
    abShowRatePicker(uniqueRates); return;
  }

  abSelectedRate = uniqueRates[0] || null;
  const slotCatPrices = uniqueRates[0]?.pricesByCategory || [];
  const categoriesToShow = _abResolveCategoriesToShow(slotCatPrices);
  if (categoriesToShow.length > 0) { abShowCategoryPicker(uniqueRates[0], categoriesToShow, slotCatPrices); return; }
  abShowForm();
}

function _abAreLanguageRates(rates) {
  return rates.length > 1 && rates.every(r => LANGUAGE_KEYWORDS.some(lang => r.title.includes(lang)));
}

