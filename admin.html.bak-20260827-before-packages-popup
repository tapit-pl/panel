  async function loadEditTourSlots(t) {
    const slotsList = document.getElementById('edit-tour-slots-list');
    const hiddenIds = (t.hidden_slot_ids || []).map(String);
    try {
      const today  = new Date().toISOString().slice(0, 10);
      const inWeek = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);
      const { data } = await invokeEdge('bokun-sync', {
        body: { path: `/activity.json/${t.bokun_id}/availabilities?start=${today}&end=${inWeek}`, method: 'GET' }
      });
      const items = data?.body || [];
      const seen  = new Map();
      items.forEach(entry => {
        if (!entry.startTimeId || seen.has(entry.startTimeId)) return;
        seen.set(entry.startTimeId, entry.startTime || String(entry.startTimeId));
      });
      if (seen.size === 0) {
        slotsList.innerHTML = '<span class="text-xs text-gray-400">No slots in next 14 days</span>';
        return;
      }
      slotsList.innerHTML = Array.from(seen.entries()).map(([sid, stime]) => {
        const isHidden = hiddenIds.includes(String(sid));
        return `<label style="display:flex;align-items:center;gap:8px;padding:2px 0;cursor:pointer;user-select:none">
          <input type="checkbox" value="${sid}" ${!isHidden ? 'checked' : ''} class="edit-tour-slot-cb accent-brand">
          <span style="font-size:13px;font-weight:600;color:#e2e8f0">${stime}</span>
        </label>`;
      }).join('');
    } catch(e) {
      slotsList.innerHTML = '<span class="text-xs text-red-400">Failed to load slots</span>';
    }
  }

