  async function savePartnerDetail() {
    const p = allPartners.find(x => x.id === editingPartnerId);
    if (!p) return;
    const partnerEditBefore = { name: p.name, phone: p.phone, email: p.email, address: p.address,
      notes: p.notes, tourGroups: [...(p.tourGroups||[])], paymentOptions: [...(p.paymentOptions||[])],
      hotel_pickup_enabled: p.hotel_pickup_enabled };
    const oldEmail = p.email;
    p.name           = document.getElementById('pd-edit-name').value;
    p.phone          = document.getElementById('pd-edit-phone').value;
    p.email          = document.getElementById('pd-edit-email').value;
    p.address        = document.getElementById('pd-edit-address').value;
    p.notes          = document.getElementById('pd-edit-notes').value;
    p.tourGroups     = [...document.querySelectorAll('#pd-tour-groups-wrap .partner-tour-group-cb:checked')].map(cb => cb.value);
    const payOpts = [];
    if (document.getElementById('pd-pay-driver').checked) payOpts.push('driver');
    if (document.getElementById('pd-pay-hotel').checked)  payOpts.push('hotel');
