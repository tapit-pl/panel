  const allTailorEnquiries = [];
  let currentTailorId = null;

  const TAILOR_TYPE_LABELS = {
    group: 'Group Tour', corporate: 'Corporate Event', bachelor: 'Bachelor / Bachelorette',
    teambuilding: 'Team Building', private: 'Private Tour', other: 'Other',
  };
  const TAILOR_URGENCY_LABELS = { '24h': 'Within 24h', '3days': '2–3 days', 'relaxed': 'No rush' };
  const TAILOR_URGENCY_CLASS  = { '24h': 'bg-red-50 text-red-600', '3days': 'bg-orange-50 text-orange-600', 'relaxed': 'bg-green-50 text-green-700' };

  async function loadTailorEnquiries() {
    const { data, error } = await db.from('tailor_enquiries').select('*').order('created_at', { ascending: false });
    if (error) { console.error('[tailor]', error); return; }

    const myEmail = currentAdminEmail || '';
    const ids = (data||[]).map(e => e.id);
    let readMap = {};
    if (ids.length && myEmail) {
      const { data: reads } = await db.from('tailor_reads').select('enquiry_id, last_read_at').eq('user_email', myEmail).in('enquiry_id', ids);
      (reads||[]).forEach(r => { readMap[r.enquiry_id] = r.last_read_at; });
    }

    allTailorEnquiries.length = 0;
    (data||[]).forEach(e => {
      const readAt    = readMap[e.id] ? new Date(readMap[e.id]).getTime() : 0;
      const createdAt = new Date(e.created_at).getTime();
      allTailorEnquiries.push({
        id:           e.id,
        partner:      e.partner_name || e.partner_email || '—',
        partner_email:e.partner_email || '',
        client_name:  e.client_name || '—',
        enquiry_type: TAILOR_TYPE_LABELS[e.enquiry_type] || e.enquiry_type || '—',
        pax:          e.pax || '—',
        date_from:    e.date_from || '—',
        budget:       e.budget || '',
        urgency:      e.urgency || 'relaxed',
        message:      e.message || '',
