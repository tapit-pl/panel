    ${canRestore ? `<button onclick="restoreCp('${p.id}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(217,119,6,0.15);color:#fbbf24" onmouseover="this.style.background='rgba(217,119,6,0.25)'" onmouseout="this.style.background='rgba(217,119,6,0.15)'"><i class="fa-solid fa-rotate-left"></i>Restore booking</button>` : ''}
    ${!isCancelledPkg && p.payment_method === 'stripe' && p.status !== 'paid' && p.status !== 'confirmed' ? `<button onclick="resendCpStripeLink('${p.id}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors" style="background:rgba(59,130,246,0.12);color:#60a5fa" onmouseover="this.style.background='rgba(59,130,246,0.22)'" onmouseout="this.style.background='rgba(59,130,246,0.12)'"><i class="fa-solid fa-paper-plane"></i>Send payment link</button>` : ''}
    ${!isCancelledPkg ? `<button onclick="cancelCpFromDetail('${p.id}','${escapeHtml(p.guest_name||'')}')" class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl transition-colors ml-auto" style="background:rgba(220,38,38,0.15);color:#f87171" onmouseover="this.style.background='rgba(220,38,38,0.25)'" onmouseout="this.style.background='rgba(220,38,38,0.15)'"><i class="fa-solid fa-xmark"></i>Cancel booking</button>` : ''}`;

  renderEntityTimeline('cpd-timeline', p.id);

  const panel = document.getElementById('cp-detail-panel');
  panel.classList.remove('hidden');
  panel.classList.add('flex');
