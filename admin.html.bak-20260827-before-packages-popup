  async function startRenameTourGroup(oldName) {
    const newName = await showPrompt(`Rename group "${oldName}" to:`, oldName);
    if (!newName || newName.trim().toLowerCase() === oldName) return;
    renameTourGroup(oldName, newName.trim().toLowerCase());
