async function saveAddSupplier() {
  const name = document.getElementById('sup-name').value.trim();
  const errEl = document.getElementById('sup-error');
  const editId = document.getElementById('sup-editing-id').value;
  if (!name) { errEl.textContent = 'Company name is required.'; errEl.classList.remove('hidden'); return; }
  errEl.classList.add('hidden');
  const payload = {
    name,
    category: document.getElementById('sup-category').value.trim() || null,
    website: document.getElementById('sup-website').value.trim() || null,
    email: document.getElementById('sup-email').value.trim() || null,
    phone: document.getElementById('sup-phone').value.trim() || null,
    notes: document.getElementById('sup-notes').value.trim() || null,
  };
  if (editId) {
    const { data, error } = await db.from('suppliers').update(payload).eq('id', editId).select().single();
    if (error) { errEl.textContent = 'Error: ' + error.message; errEl.classList.remove('hidden'); return; }
    const idx = allSuppliers.findIndex(x => x.id === editId);
    if (idx >= 0) allSuppliers[idx] = { ...allSuppliers[idx], ...data };
    closeAddSupplierModal();
    renderSuppliers();
    logActivity('supplier_edited', `Supplier "${name}" updated`);
  } else {
    payload.sort_order = allSuppliers.length + 1;
    const { data, error } = await db.from('suppliers').insert(payload).select().single();
    if (error) { errEl.textContent = 'Error: ' + error.message; errEl.classList.remove('hidden'); return; }
    allSuppliers.push(data);
    closeAddSupplierModal();
    renderSuppliers();
    logActivity('supplier_added', `Supplier "${name}" added`);
  }
}

