  function filterCommTable() {
    const q = document.getElementById('comm-search').value.toLowerCase();
    const topOnly = document.getElementById('comm-top-only').checked;
    const rows = document.querySelectorAll('#comm-tbody .comm-row');
    const groups = document.querySelectorAll('#comm-tbody .comm-group-row');
    let visible = 0;

    rows.forEach(row => {
      const name = row.dataset.name || '';
      const cat = row.dataset.cat || '';
      const comm = parseInt(row.dataset.comm || '0');
      const matchSearch = name.includes(q);
      const matchCat = commActiveCat === 'all' || cat === commActiveCat;
      const matchTop = !topOnly || comm >= 100;
      const show = matchSearch && matchCat && matchTop;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // hide group headers if all rows in group are hidden
    groups.forEach(g => {
      const cat = g.dataset.cat;
      const anyVisible = [...document.querySelectorAll(`.comm-row[data-cat="${cat}"]`)]
        .some(r => r.style.display !== 'none');
      g.style.display = anyVisible ? '' : 'none';
    });

    document.getElementById('comm-no-results').classList.toggle('hidden', visible > 0);
  }

  function filterCommCategory(btn, cat) {
    commActiveCat = cat;
    document.querySelectorAll('.comm-cat-btn').forEach(b => {
      b.classList.remove('bg-brand', 'text-white');
      b.classList.add('bg-gray-100', 'text-gray-600');
    });
    btn.classList.add('bg-brand', 'text-white');
    btn.classList.remove('bg-gray-100', 'text-gray-600');
    filterCommTable();
  }

  function sortCommTable(col) {
    if (commSortCol === col) commSortAsc = !commSortAsc;
    else { commSortCol = col; commSortAsc = true; }

    const tbody = document.getElementById('comm-tbody');
    const groups = [...tbody.querySelectorAll('.comm-group-row')];
    groups.forEach(g => {
      const cat = g.dataset.cat;
      const rows = [...tbody.querySelectorAll(`.comm-row[data-cat="${cat}"]`)];
      rows.sort((a, b) => {
        let va = a.cells[col]?.textContent.replace(/[^\d.]/g,'') || '';
        let vb = b.cells[col]?.textContent.replace(/[^\d.]/g,'') || '';
        const na = parseFloat(va), nb = parseFloat(vb);
        if (!isNaN(na) && !isNaN(nb)) return commSortAsc ? na - nb : nb - na;
        return commSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
      });
      let ref = g.nextSibling;
      while (ref && ref.classList && ref.classList.contains('comm-row')) ref = ref.nextSibling;
      rows.forEach(r => tbody.insertBefore(r, ref));
    });
  }

