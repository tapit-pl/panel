  async function applyActivityFilters(keepPage) {
    if (!keepPage) activityPage = 0;
    const search    = (document.getElementById('activity-search')?.value || '').trim();
    const userVals  = mselGetVals('msel-activity-user');
    const typeVals  = mselGetVals('msel-activity-type');
    const fromFilter = document.getElementById('activity-filter-from')?.value || '';
    const toFilter   = document.getElementById('activity-filter-to')?.value || '';

    let q = db.from('audit_log').select('*', { count: 'exact' }).order('created_at', { ascending: false });
    if (userVals.length) q = q.in('user_email', userVals);
    if (typeVals.length) q = q.or(typeVals.map(t => `action.like.${t}%`).join(','));
    if (fromFilter) q = q.gte('created_at', fromFilter);
    if (toFilter)   q = q.lte('created_at', toFilter + 'T23:59:59');
    if (search) {
      // Commas/parens would break PostgREST's .or() filter syntax — strip them, keep the rest.
      const s = search.replace(/[,()%_]/g, ' ').trim();
      if (s) q = q.or(`details.ilike.%${s}%,user_email.ilike.%${s}%,ref.ilike.%${s}%,action.ilike.%${s}%`);
    }
    const start = activityPage * ACTIVITY_PAGE_SIZE;
    q = q.range(start, start + ACTIVITY_PAGE_SIZE - 1);

    const { data, error, count } = await q;
    if (error) { console.error('audit_log:', error); return; }
    allActivityLogs = data || [];
    activityTotalCount = count || 0;
    renderActivityLog(allActivityLogs);
    renderActivityPager();
  }

