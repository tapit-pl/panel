  }

  function updatePayOptStyles() { selectTdPayment(tdPayment); }

  // ── Bokun field-error helpers ──────────────────────────────────────────────
  const _BOKUN_ERR_RULES = [
    { match: ['not a valid phone', 'phone number', 'phone'],     field: 'phone',     msg: 'This phone number is not accepted. Enter a full number with country code, e.g. +48 600 100 200.' },
    { match: ['email'],                                           field: 'email',     msg: 'This e-mail address was rejected. Please check it and try again.' },
    { match: ['first name', 'firstname'],                         field: 'firstName', msg: "Please check the guest's first name." },
    { match: ['last name', 'lastname'],                           field: 'lastName',  msg: "Please check the guest's last name." },
    { match: ['too long', 'maximum length', 'max length'],       field: null,        msg: 'One of the fields is too long. Please shorten the text.' },
    { match: ['sold out', 'no availability', 'not available', 'fully booked', 'no seats'],
                                                                  field: 'date',      msg: 'This departure is no longer available. Please choose another date or time.' },
  ];

  const _BOKUN_QID_FIELD = { phoneNumber: 'phone', phone: 'phone', email: 'email', firstName: 'firstName', lastName: 'lastName' };
  const _BOKUN_QID_MSG  = {
    phone:     'This phone number is not accepted. Enter a full number with country code, e.g. +48 600 100 200.',
    email:     'This e-mail address was rejected. Please check it and try again.',
    firstName: "Please check the guest's first name.",
    lastName:  "Please check the guest's last name.",
  };
  function _resolveBokunFieldError(submitBody, fieldIds) {
    // 1. Structured: fields.errors[].questionId (Bokun validation exceptions)
    const fieldErrors = submitBody?.fields?.errors;
    if (Array.isArray(fieldErrors) && fieldErrors.length) {
      for (const fe of fieldErrors) {
        const key = _BOKUN_QID_FIELD[fe.questionId];
        if (key) return { fieldId: fieldIds[key] || null, userMsg: _BOKUN_QID_MSG[key] || fe.message };
        // questionId not recognised — try matching the error's message text
        const raw = (fe.message || '').toLowerCase();
        for (const rule of _BOKUN_ERR_RULES) {
          if (rule.match.some(p => raw.includes(p))) {
            return { fieldId: rule.field ? (fieldIds[rule.field] || null) : null, userMsg: rule.msg };
          }
        }
      }
    }
    // 2. Fallback: top-level message text
    const raw = (submitBody?.message || submitBody?.error || '').toLowerCase();
    if (!raw) return null;
    for (const rule of _BOKUN_ERR_RULES) {
      if (rule.match.some(p => raw.includes(p))) {
        return { fieldId: rule.field ? (fieldIds[rule.field] || null) : null, userMsg: rule.msg };
      }
    }
    return null;
  }

  function _showBokunFieldError(fieldId, msg) {
    if (!fieldId) return;
    const el = document.getElementById(fieldId);
    if (!el) return;
    el.style.borderColor = '#ef4444';
    el.style.boxShadow = '0 0 0 3px rgba(239,68,68,0.15)';
    const errId = '__bferr_' + fieldId;
    let errDiv = document.getElementById(errId);
    if (!errDiv) {
      errDiv = document.createElement('div');
      errDiv.id = errId;
      errDiv.style.cssText = 'font-size:12px;color:#ef4444;margin-top:4px;';
      el.insertAdjacentElement('afterend', errDiv);
    }
    errDiv.textContent = msg;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function _clearBokunFieldErrors() {
    document.querySelectorAll('[id^="__bferr_"]').forEach(el => el.remove());
    ['td-first','td-last','td-email','td-phone-number'].forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.style.borderColor = ''; el.style.boxShadow = ''; }
    });
  }
  // ────────────────────────────────────────────────────────────────────────────

  // Name validation: Unicode letters, spaces, apostrophes, hyphens, dots; min 2 chars; no double spaces
  function isValidName(v) {
    if (!v || v.length < 2) return false;
    if (!/\p{L}/u.test(v)) return false;
    if (/[^\p{L}\s'‘’.\-]/u.test(v)) return false;
    if (/\s{2}/.test(v)) return false;
    return true;
  }

  function tdValidateName(inputId, errId) {
    const val = (document.getElementById(inputId)?.value || '').trim();
    const err = document.getElementById(errId);
    if (!err) return;
    if (val && !isValidName(val)) {
      err.classList.remove('hidden');
    } else {
      err.classList.add('hidden');
    }
  }

  function tdUpdateNotesCounter() {
    const el = document.getElementById('td-notes');
    const counter = document.getElementById('td-notes-counter');
    if (!el || !counter) return;
    const len = el.value.length;
    counter.textContent = `${len}/500`;
    counter.classList.toggle('hidden', len < 400);
  }

  async function submitTourBooking() {
    const form = document.getElementById('td-booking-form');
    const dateStr = form.dataset.date;
    const firstName = document.getElementById('td-first').value.trim();
    const lastName  = document.getElementById('td-last').value.trim();
    const email     = document.getElementById('td-email').value.trim();
    const phonePrefix = document.getElementById('td-phone-prefix')?.value || '+48';
    const phoneNumber = document.getElementById('td-phone-number')?.value?.trim() || '';
    const phone = phoneNumber ? phonePrefix + ' ' + phoneNumber : '';
    const nationality = document.getElementById('td-nationality').value.trim();
    const notes     = document.getElementById('td-notes').value.trim();
    const payment   = tdPayment || 'driver';
    const errEl     = document.getElementById('td-booking-error');

    if (!isValidName(firstName)) {
      document.getElementById('td-first-err')?.classList.remove('hidden');
      errEl.textContent = 'Please enter a valid first name (letters, spaces, hyphens and apostrophes only).';
      errEl.classList.remove('hidden');
      document.getElementById('td-first')?.focus();
      return;
    }
    document.getElementById('td-first-err')?.classList.add('hidden');
    if (!isValidName(lastName)) {
      document.getElementById('td-last-err')?.classList.remove('hidden');
      errEl.textContent = 'Please enter a valid last name (letters, spaces, hyphens and apostrophes only).';
      errEl.classList.remove('hidden');
      document.getElementById('td-last')?.focus();
      return;
    }
    document.getElementById('td-last-err')?.classList.add('hidden');
    if (!email) {
      errEl.textContent = 'Please enter the guest\'s email address.';
      errEl.classList.remove('hidden');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = 'Please enter a valid email address (e.g. guest@email.com).';
      errEl.classList.remove('hidden');
      return;
    }
    if (!phoneNumber) {
      errEl.textContent = 'Please enter the guest\'s phone number.';
      errEl.classList.remove('hidden');
      return;
    }
    const phoneDigits = phoneNumber.replace(/[\s\-\(\)]/g, '');
    if (!/^\d{7,15}$/.test(phoneDigits)) {
      errEl.textContent = 'Please enter a valid phone number (7–15 digits, e.g. 600 123 456).';
      errEl.classList.remove('hidden');
      return;
    }
    if (!dateStr) {
      errEl.textContent = 'Please select a date from the calendar.';
      errEl.classList.remove('hidden');
      return;
    }

    for (let i = 0; i < tdGuestCount - 1; i++) {
      const ef = (document.getElementById(`td-extra-first-${i}`)?.value || '').trim();
      const el = (document.getElementById(`td-extra-last-${i}`)?.value || '').trim();
      if (!isValidName(ef) || !isValidName(el)) {
        errEl.textContent = `Please enter a valid first and last name for Guest ${i + 2} (letters, spaces, hyphens and apostrophes only).`;
        errEl.classList.remove('hidden');
        return;
      }
    }

    const btn = document.getElementById('td-submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> Saving...';
    errEl.classList.add('hidden');

    const tour = tdCurrentTour?.title || '';
    const guest = `${firstName} ${lastName}`;
    const extraGuests = Array.from({ length: tdGuestCount - 1 }, (_, i) => {
      const f = document.getElementById(`td-extra-first-${i}`)?.value.trim();
      const l = document.getElementById(`td-extra-last-${i}`)?.value.trim();
      return (f || l) ? `${f} ${l}`.trim() : null;
    }).filter(Boolean);

    // Determine total pax and participants
    const hasPackages = tdRateSelections.some(x => x.count > 0);
    const hasCategories = tdCategorySelections.some(x => x.count > 0);
    if (hasPackages) tdGuestCount = tdRateSelections.reduce((s, x) => s + x.count, 0);
    if (hasCategories) tdGuestCount = tdCategorySelections.reduce((s, x) => s + x.count, 0);

    const payLabel = { driver: 'Pay at driver', hotel: 'Pay at hotel', link: 'Payment link' }[payment] || payment;
    const packageLines = _selectedNonBokunPkg
      ? _selectedNonBokunPkg.originalName
      : hasPackages
        ? tdRateSelections.filter(x => x.count > 0).map(x => `${x.count}x ${x.rate.title}`).join(', ')
        : null;
    const categoryLines = hasCategories
      ? tdCategorySelections.filter(x => x.count > 0).map(x => `${x.count}x ${x.category.title}`).join(', ')
      : null;

    let bokunConfirmationCode = null;
    let bokunReservationCode = null;
    let bokunBookingId = null;

    // Verify partner account still exists before calling Bokun
    const { data: partnerCheck } = await db.from('partners').select('id').eq('id', currentPartner.id).maybeSingle()
    if (!partnerCheck) {
      errEl.textContent = 'Your account has been deactivated. Please contact support.'
      errEl.classList.remove('hidden')
      btn.disabled = false
      setTimeout(async () => { await db.auth.signOut(); window.location.reload() }, 2000)
      return
    }

    _clearBokunFieldErrors();
    let bokunErrMsg = null;
    let bokunFieldErr = null;
    if (tdCurrentTour?.bokunId && tdSelectedTimeSlot?.startTimeId) {
      try {
        const mainPassengerDetails = [
          { questionId: 'firstName', values: [firstName] },
          { questionId: 'lastName',  values: [lastName]  },
        ];
        const buildPassengers = () => {
          if (hasCategories) {
            return tdCategorySelections
              .filter(x => x.count > 0)
              .flatMap(x => Array.from({ length: x.count }, () => ({
                pricingCategoryId: x.category.id, groupSize: 1,
                passengerDetails: mainPassengerDetails, answers: [], extras: []
              })));
          }
          const pricingCat = tdCurrentTour.pricing?.[0];
          return pricingCat
            ? Array.from({ length: tdGuestCount }, () => ({
                pricingCategoryId: pricingCat.id, groupSize: 1,
                passengerDetails: mainPassengerDetails, answers: [], extras: []
              }))
            : [];
        };

        const effectiveRateId = tdCurrentTour?.bokunForceRateId || tdSelectedRate?.id || null;
        const optionsPayload = {
          activityId: parseInt(tdCurrentTour.bokunId),
          startTimeId: tdSelectedTimeSlot.startTimeId,
          ...(effectiveRateId ? { rateId: effectiveRateId } : {}),
          date: dateStr,
          passengers: buildPassengers(),
        };
        const { data: optionsRes } = await db.functions.invoke('bokun-sync', {
          body: { path: '/checkout.json/options/booking-request', method: 'POST', payload: optionsPayload }
        });
        const optionsBody = optionsRes?.body;
        console.log('[Booking] options response:', JSON.stringify(optionsBody));
        const checkoutOptions = optionsBody?.options || [];
        const availableTypes = checkoutOptions.map(o => o.type);
        console.log('[Booking] available checkoutOptions:', availableTypes);
        const checkoutOptionType = availableTypes.includes('CUSTOMER_NO_PAYMENT') ? 'CUSTOMER_NO_PAYMENT' : 'CUSTOMER_FULL_PAYMENT';
        const checkoutOption = checkoutOptions.find(o => o.type === checkoutOptionType) || checkoutOptions[0];
        console.log('[Booking] using checkoutOptionType:', checkoutOptionType);
        const optionAnswers = (checkoutOption?.questions || []).map((q) => ({
          questionId: q.questionId,
          values: [q.defaultValue ?? 'false'],
        }));

        const mainContactDetails = [
          { questionId: 'firstName', values: [firstName] },
          { questionId: 'lastName',  values: [lastName] },
          email && { questionId: 'email', values: [email] },
          phone && { questionId: 'phoneNumber', values: [phone] },
          tdCurrentTour?.bokunRequiresDob && { questionId: 'dateOfBirth', values: ['1990-01-01'] },
          nationality && { questionId: 'nationality', values: [nationality] },
        ].filter(Boolean);

        const bookingNote = [payLabel, packageLines || categoryLines,
          extraGuests.length ? 'Guests: ' + [guest, ...extraGuests].join(', ') : null, notes
        ].filter(Boolean).join(' | ');

        const pickupDesc = tdGetPickupDescription() || currentPartner?.name || 'Hotel pickup';
        const forcePickupId = tdCurrentTour?.bokunForcePickupPlaceId;
        const pickupAnswers = forcePickupId
          ? []
          : [{ questionId: 'pickupPlaceDescription', values: [pickupDesc] }];
        const submitPayload = {
          source: 'DIRECT_REQUEST',
          checkoutOption: 'CUSTOMER_FULL_PAYMENT',
          paymentMethod: 'RESERVE_FOR_EXTERNAL_PAYMENT',
          sendNotificationToMainContact: false,
          directBooking: {
            mainContactDetails,
            promoCode: 'HOTELBOOKING',
            activityBookings: [{
              activityId: parseInt(tdCurrentTour.bokunId),
              startTimeId: tdSelectedTimeSlot.startTimeId,
              ...(effectiveRateId ? { rateId: effectiveRateId } : {}),
              ...(forcePickupId ? { pickupPlaceId: parseInt(forcePickupId) } : {}),
              date: dateStr,
              passengers: buildPassengers(),
              note: bookingNote || undefined,
              answers: [],
              pickupAnswers: pickupAnswers,
              dropoffAnswers: [],
            }],
          },
        };
        const { data: submitRes } = await db.functions.invoke('bokun-sync', {
          body: { path: '/checkout.json/submit', method: 'POST', payload: submitPayload }
        });
        const submitBody = submitRes?.body;
        console.log('[Booking] submit response:', JSON.stringify(submitBody));
        const reservedCode = submitBody?.booking?.confirmationCode || submitBody?.confirmationCode;
        if (reservedCode) {
          bokunReservationCode = reservedCode;
          console.log('[Booking] confirming reserved booking:', reservedCode);
          const { data: confirmRes } = await db.functions.invoke('bokun-sync', {
            body: { path: `/checkout.json/confirm-reserved/${reservedCode}`, method: 'POST', payload: { sendNotificationToMainContact: false } }
          });
          const confirmBody = confirmRes?.body;
          console.log('[Booking] confirm response:', JSON.stringify(confirmBody));
          bokunConfirmationCode = confirmBody?.booking?.confirmationCode || confirmBody?.confirmationCode || reservedCode;
          bokunBookingId = confirmBody?.booking?.bookingId || confirmBody?.booking?.id || confirmBody?.bookingId || confirmBody?.id || submitBody?.booking?.bookingId || submitBody?.booking?.id || submitBody?.bookingId || submitBody?.id || null;
          console.log('[Booking] bokun booking id resolved:', bokunBookingId);
        } else {
          console.warn('[Booking] submit failed — raw Bokun response:', JSON.stringify(submitBody));
          const msgStr = submitBody?.message || '';
          const minMatch = msgStr.match(/min participants \((\d+) passengers?\)/);
          const minPax = minMatch ? parseInt(minMatch[1]) : null;
          if (minPax) {
            bokunErrMsg = `This tour requires a minimum of ${minPax} participant${minPax > 1 ? 's' : ''}. Please increase the number of guests.`;
          } else {
            bokunFieldErr = _resolveBokunFieldError(submitBody, {
              phone: 'td-phone-number',
              email: 'td-email',
              firstName: 'td-first',
              lastName: 'td-last',
            });
            bokunErrMsg = bokunFieldErr?.userMsg || null;
          }
        }
      } catch(e) { console.warn('[Booking] Bokun creation failed:', e.message); }
    }

    const insertStatus = payment === 'link' ? 'payment_pending'
      : payment === 'hotel' ? 'paid'
      : 'to_be_paid';

    const _pickupVal = document.querySelector('input[name="td-pickup"]:checked')?.value;
    const _rateForTransport = tdSelectedRate?.title || tdRateSelections?.find(r => r.count > 0)?.rate?.title || '';
    const _transportPln = lookupCommTransportPln(_rateForTransport) || 0;
    const _transportSurcharge = _pickupVal === 'hotel' ? _transportPln * tdGuestCount : 0;

    const _pkgPricePln = _selectedNonBokunPkg?.pricePln || 0;
    const _pkgCommPln  = _selectedNonBokunPkg?.commPln  || 0;
    const _pkgIsFixed  = _selectedNonBokunPkg && tdCurrentTour?.pricingType === 'package';
    const insertTotal = (_selectedNonBokunPkg
      ? (_pkgIsFixed ? _pkgPricePln : _pkgPricePln * Math.max(tdGuestCount, 1))
      : hasPackages
        ? tdRateSelections.reduce((s, x) => s + x.count * (lookupCommPln(x.rate.title) || 0), 0)
        : hasCategories
          ? tdCategorySelections.filter(x => x.count > 0).reduce((s, x) => {
              const pln = x.configPln !== undefined ? (x.configPln || 0) : (lookupCommPln(tdCurrentTour?.title || '') || 0);
              return s + x.count * pln;
            }, 0)
          : (lookupCommPln(tdCurrentTour?.title || '') || 0) * tdGuestCount) + _transportSurcharge;

    const insertComm = (_selectedNonBokunPkg
      ? (_pkgIsFixed ? _pkgCommPln : _pkgCommPln * Math.max(tdGuestCount, 1))
      : hasPackages
        ? tdRateSelections.reduce((s, x) => s + x.count * (lookupCommCommissionPln(x.rate.title) || 0), 0)
        : hasCategories
          ? tdCategorySelections.filter(x => x.count > 0).reduce((s, x) => {
              return s + x.count * (lookupCommCommissionPln(tdCurrentTour?.title || '') || 0);
            }, 0)
          : (lookupCommCommissionPln(tdCurrentTour?.title || '') || 0) * tdGuestCount);

    const bookingId = crypto.randomUUID();

    if (tdCurrentTour?.bokunId && !(payment === 'link' ? !!bokunReservationCode : !!bokunConfirmationCode)) {
      errEl.textContent = bokunErrMsg || 'Booking failed — the reservation was not created. Please try again or contact Thousand Miles support.';
      errEl.classList.remove('hidden');
      if (bokunFieldErr?.fieldId) _showBokunFieldError(bokunFieldErr.fieldId, bokunFieldErr.userMsg);
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm booking';
      return;
    }

    // Insert booking first so create-stripe-session can read bookingRow.total from DB
    const { error } = await db.from('bookings').insert({
      id: bookingId,
      tour,
      date: dateStr,
      time: tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime || null,
      language: (() => {
        // 1. Z tytułu wybranego rate (np. "English Adult")
        const rateTitle = tdSelectedRate?.title || '';
        const fromRate = LANGUAGE_KEYWORDS.find(l => rateTitle.toLowerCase().includes(l.toLowerCase()));
        if (fromRate) return fromRate;
        // 2. Ze slotu — jeśli wszystkie raty w slocie mają ten sam język (np. "English Adult" + "English Child")
        const slotRates = (tdSelectedTimeSlot?.rates || []).filter((r, i, a) => a.findIndex(x => x.id === r.id) === i);
        const slotLangs = slotRates.map(r => LANGUAGE_KEYWORDS.find(l => r.title.toLowerCase().includes(l.toLowerCase()))).filter(Boolean);
        if (slotLangs.length > 0 && slotLangs.every(l => l === slotLangs[0])) return slotLangs[0];
        return null;
      })(),
      guest,
      email: email || null,
      phone: phone || null,
      pax: tdGuestCount,
      total: insertTotal || null,
      comm: insertComm || null,
      payment_method: payment || null,
      status: insertStatus,
      stripe_session_id: null,
      stripe_session_url: null,
      pickup: tdGetPickupDescription() || null,
      partner_id: currentPartner?.id,
      staff_id: currentPartner?._staffId || null,
      bokun_confirmation_code: bokunConfirmationCode || bokunReservationCode || null,
      bokun_booking_id: bokunBookingId,
      notes: notes || null,
      additional_guests: extraGuests.length ? extraGuests.join(', ') : null,
      package_lines: packageLines || categoryLines || null,
      created_by_name: currentPartner?.name || null,
    });

    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm booking';

    if (error) {
      console.error('[Booking] DB insert error:', JSON.stringify(error));
      if (error.message?.includes('partner_id')) {
        errEl.textContent = 'Your account has been deactivated. Please contact support.'
        setTimeout(async () => { await db.auth.signOut(); window.location.reload() }, 2000)
      } else {
        errEl.textContent = 'Error saving booking: ' + error.message
      }
      errEl.classList.remove('hidden')
      btn.disabled = false
      return
    }

    // Create Stripe session after booking is in DB (so edge function can read bookingRow.total)
    let stripeSessionUrl = null;
    let stripeSessionId = null;
    if (payment === 'link' && (!tdCurrentTour?.bokunId || !!bokunReservationCode)) {
      try {
        const { data: stripeRes, error: stripeErr } = await db.functions.invoke('create-stripe-session', {
          body: { booking_id: bookingId, bokun_reservation_code: bokunReservationCode, pax: tdGuestCount, tour_name: tour, date: dateStr, guest_name: guest, guest_email: email, pickup_mode: _pickupVal || null }
        });
        console.log('[Stripe] response:', JSON.stringify(stripeRes), 'error:', JSON.stringify(stripeErr));
        if (stripeErr?.context) { try { const eb = await stripeErr.context.json(); console.error('[Stripe] edge error body:', JSON.stringify(eb)); } catch(_){} }
        stripeSessionUrl = stripeRes?.session_url;
        stripeSessionId = stripeRes?.session_id || null;
        if (stripeSessionId) {
          await db.from('bookings').update({ stripe_session_id: stripeSessionId, stripe_session_url: stripeSessionUrl || null }).eq('id', bookingId);
        }
      } catch(e) { console.warn('[Stripe] error:', e.message); }
    }

    const bokunOk = payment === 'link' ? !!bokunReservationCode : !!bokunConfirmationCode;

    logPartnerActivity('booking_created', `${tour} · ${dateStr} · ${tdGuestCount} pax · ${payLabel} · ${bokunOk ? (bokunConfirmationCode || bokunReservationCode) : 'no Bokun'} · ${guest}`).catch(() => {});

    if (payment === 'driver' || payment === 'hotel') {
      fillAndShowVoucher({
        bookingId,
        bokunBookingId,
        bokunConfirmationCode,
        tourName: tour,
        date: dateStr,
        time: tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime || null,
        guestName: guest,
        extraGuests: extraGuests.length ? extraGuests : null,
        email,
        phone: phone || null,
        pax: tdGuestCount,
        total: insertTotal || null,
        pickup: tdGetPickupDescription() || null,
        emailBlocks: tdCurrentTour?.emailBlocks || [],
        payment,
        packageLines: packageLines || null,
        categoryLines: categoryLines || null,
        rateName: (!packageLines && !categoryLines) ? (tdSelectedRate?.title || null) : null,
      });
      if (email) {
        db.functions.invoke('send-booking-confirmation', { body: {
          booking_id: bookingId,
          bokun_booking_id: bokunBookingId || null,
          bokun_confirmation_code: bokunConfirmationCode || null,
          tour_name: tour,
          date: dateStr,
          time: tdSelectedTimeSlot?._displayTime || tdSelectedTimeSlot?.startTime || null,
          guest_name: guest,
          guest_email: email,
          phone: phone || null,
          pax: tdGuestCount,
          total: insertTotal || null,
          pickup: tdGetPickupDescription() || null,
          email_blocks: tdCurrentTour?.emailBlocks?.length ? tdCurrentTour.emailBlocks : null,
          payment_type: payment,
        }}).catch(e => console.warn('[TD] confirmation email failed:', e?.message));
      }
    }

    form.classList.add('hidden');
    const success = document.getElementById('td-booking-success');
    success.classList.remove('hidden');
    let statusLine;
    if (payment === 'link') {
      statusLine = stripeSessionUrl
        ? ` · Payment link sent to ${email}`
        : ` · Bokun reserved #${bokunReservationCode} · Payment link failed`;
    } else {
      statusLine = ` · Bokun #${bokunConfirmationCode}`;
    }
