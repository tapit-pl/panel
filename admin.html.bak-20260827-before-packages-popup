  function initCustomDropdown(sel) {
    const wrap = sel.closest('.cdrop');
    if (!wrap || wrap._cdropDone) return;
    wrap._cdropDone = true;
    sel.style.display = 'none';

    const btn = document.createElement('div');
    btn.className = 'cdrop-btn';
    btn.tabIndex = 0;

    const val = document.createElement('span');
    val.className = 'cdrop-val';
    btn.appendChild(val);

    const arrow = document.createElement('span');
    arrow.className = 'cdrop-arrow';
    btn.appendChild(arrow);

    const list = document.createElement('div');
    list.className = 'cdrop-list';

    wrap.appendChild(btn);
    wrap.appendChild(list);

    function getLabel() {
      const opt = sel.options[sel.selectedIndex];
      return opt ? opt.text : '—';
    }

    function buildList(filterQ) {
      list.innerHTML = '';
      const searchable = wrap.hasAttribute('data-searchable');
      let inp = null;
      if (searchable) {
        inp = document.createElement('input');
        inp.type = 'text';
        inp.placeholder = 'Szukaj partnera…';
        inp.className = 'cdrop-search';
        inp.value = filterQ || '';
        inp.addEventListener('input', () => buildList(inp.value));
        inp.addEventListener('mousedown', e => e.stopPropagation());
        inp.addEventListener('click', e => e.stopPropagation());
        inp.addEventListener('keydown', e => { if (e.key === 'Escape') closeList(); e.stopPropagation(); });
        list.appendChild(inp);
        setTimeout(() => inp.focus(), 0);
      }
      const itemsWrap = document.createElement('div');
      itemsWrap.className = 'cdrop-items';
      list.appendChild(itemsWrap);
      const q = (filterQ || '').toLowerCase();
      Array.from(sel.options).forEach(opt => {
        if (q && !opt.text.toLowerCase().includes(q)) return;
        const item = document.createElement('div');
        item.className = 'cdrop-item' + (opt.value === sel.value ? ' active' : '');
        item.textContent = opt.text;
        item.addEventListener('mousedown', e => {
          e.preventDefault();
          sel.value = opt.value;
          sel.dispatchEvent(new Event('change'));
          val.textContent = opt.text;
          closeList();
        });
        itemsWrap.appendChild(item);
      });
    }

    function openList() {
      document.querySelectorAll('.cdrop-list.open').forEach(l => {
        l.classList.remove('open');
        l.closest('.cdrop')?.querySelector('.cdrop-btn')?.classList.remove('open');
      });
      buildList();
      list.classList.add('open');
      btn.classList.add('open');
    }

    function closeList() {
      list.classList.remove('open');
      btn.classList.remove('open');
    }

    btn.addEventListener('click', e => {
      e.stopPropagation();
      list.classList.contains('open') ? closeList() : openList();
    });
    btn.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); list.classList.contains('open') ? closeList() : openList(); }
      if (e.key === 'Escape') closeList();
    });
    document.addEventListener('click', closeList);

    // Refresh label when options change (dynamic population)
    const obs = new MutationObserver(() => { val.textContent = getLabel(); });
    obs.observe(sel, { childList: true });

    val.textContent = getLabel();
  }

  function initAllCustomDropdowns() {
