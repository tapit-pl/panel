    if (n.includes('transfer')) return 'transfers';
    if (n.includes('museum') || n.includes('underground') || n.includes('castle') || n.includes('cathedral') || n.includes('schindler') || n.includes('ghetto') || n.includes('jewish') || n.includes('auschwitz') || n.includes('wieliczka') || n.includes('bochnia') || n.includes('kazimierz') || n.includes('plaszow') || n.includes('rynek') || n.includes('wawel')) return 'museums';
